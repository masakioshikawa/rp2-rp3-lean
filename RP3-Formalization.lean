/- ===== RP3/LocalLimitExistence.lean ===== -/
section StandalonePart74

/-! Proofs contributed in the Claude Opus review supplied by the user on
11 October 2026, integrated and checked against this pinned development.
See REVIEW-RESPONSE.md for scope and attribution. -/
noncomputable section
open MeasureTheory Filter RP3
open scoped InnerProductSpace BigOperators Matrix Topology

namespace RP3

open Classical in
/-- The full box `[-n,n]²` with every positively oriented nearest-neighbour bond. -/
def exhaustionBox (n : ℕ) : Fourier.LatticeGraph where
  vertices := Finset.Icc (-(n : ℤ)) n ×ˢ Finset.Icc (-(n : ℤ)) n
  edges := (Finset.univ : Finset (_ × _)).filter
    (fun e => Fourier.PositiveNeighbor e.1.val e.2.val)
  nearest := by
    intro e he
    exact (Finset.mem_filter.mp he).2

theorem box_exhausts (z : Fourier.Site) : ∀ᶠ n in atTop, z ∈ (exhaustionBox n).vertices := by
  refine eventually_atTop.mpr ⟨(max |z.1| |z.2|).toNat, fun n hn => ?_⟩
  have h1 : |z.1| ≤ n := by
    have := Int.self_le_toNat (max |z.1| |z.2|)
    have := le_max_left |z.1| |z.2|
    omega
  have h2 : |z.2| ≤ n := by
    have := Int.self_le_toNat (max |z.1| |z.2|)
    have := le_max_right |z.1| |z.2|
    omega
  simp only [exhaustionBox, Finset.mem_product, Finset.mem_Icc]
  constructor <;> constructor <;> [linarith [neg_abs_le z.1]; linarith [le_abs_self z.1];
    linarith [neg_abs_le z.2]; linarith [le_abs_self z.2]]

/-- Any exhausting sequence with admissible signed couplings has a local limit. -/
theorem exists_signed_local_limit_of_sequence (β : ℝ) (G : ℕ → Fourier.LatticeGraph)
    (b : ∀ n, (G n).edges → ℝ) (hb : ∀ n e, |b n e| ≤ β)
    (hexhaust : ∀ z : Fourier.Site, ∀ᶠ n in atTop, z ∈ (G n).vertices) (s₀ : Spin) :
    ∃ μ : ProbabilityMeasure InfiniteConfiguration, IsSignedFreeBoundaryLocalLimit β μ := by
  obtain ⟨μ, -, φ, hφ, hlim⟩ :=
    (isCompact_univ (X := ProbabilityMeasure InfiniteConfiguration)).tendsto_subseq
      (x := fun n => extendedFreeGibbsWith (G n) (b n) (fun _ => s₀)) (fun _ => Set.mem_univ _)
  exact ⟨μ, isSignedFreeBoundaryLocalLimit_of_weak_limit_with β (fun n => G (φ n))
    (fun n => b (φ n)) (fun n e => hb (φ n) e)
    (fun z => hφ.tendsto_atTop.eventually (hexhaust z)) (fun _ _ => s₀) μ hlim⟩

/-- **Suggested witness.** The local-limit endpoint applies to an actual measure. -/
theorem local_limit_endpoint_nonvacuous_with_spin (β : ℝ) (hβ : 0 ≤ β) (s₀ : Spin) :
    ∃ C : ℝ, 0 < C ∧ ∃ c : ℝ, 0 < c ∧
      ∃ μ : ProbabilityMeasure InfiniteConfiguration, IsSignedFreeBoundaryLocalLimit β μ ∧
      ∀ x y : Fourier.Site, |infiniteCorrelation μ x y| ≤
        C * Real.exp (-c * (Real.log (2 + (Fourier.siteRadius x y : ℝ))) ^ 2) := by
  obtain ⟨C, hC, c, hc, h⟩ := log_square_quadrupolar_decay_local_limit_signed β hβ
  obtain ⟨μ, hμ⟩ := exists_signed_local_limit_of_sequence β exhaustionBox (fun _ _ => β)
    (fun _ _ => by rw [abs_of_nonneg hβ]) box_exhausts s₀
  exact ⟨C, hC, c, hc, μ, hμ, h μ hμ⟩


/-- A concrete unit director supplies the outside filling without an extra
inhabitedness hypothesis in the public existence theorems. -/
def identitySpin : Spin := by
  let v : E4 := WithLp.toLp 2 ![1, 0, 0, 0]
  have h : ‖v‖ ^ 2 = 1 := by
    norm_num [EuclideanSpace.real_norm_sq_eq, v, Fin.sum_univ_four]
  exact ⟨v, mem_sphere_zero_iff_norm.mpr (by nlinarith [norm_nonneg v])⟩

/-- The signed free-boundary local-limit class is nonempty for every β ≥ 0.
The witnessing finite models are full boxes with every coupling equal to β. -/
theorem exists_signed_free_boundary_local_limit (β : ℝ) (hβ : 0 ≤ β) :
    ∃ μ : ProbabilityMeasure InfiniteConfiguration, IsSignedFreeBoundaryLocalLimit β μ :=
  exists_signed_local_limit_of_sequence β exhaustionBox (fun _ _ => β)
    (fun _ _ => by rw [abs_of_nonneg hβ]) box_exhausts identitySpin

/-- The ferromagnetic class also has a witness, obtained from full boxes
with coupling β on every nearest-neighbor bond. -/
theorem exists_free_boundary_local_limit (β : ℝ) (hβ : 0 ≤ β) :
    ∃ μ : ProbabilityMeasure InfiniteConfiguration, IsFreeBoundaryLocalLimit β μ := by
  obtain ⟨μ, -, φ, hφ, hlim⟩ :=
    (isCompact_univ (X := ProbabilityMeasure InfiniteConfiguration)).tendsto_subseq
      (x := fun n => extendedFreeGibbsWith (exhaustionBox n) (fun _ => β)
        (fun _ => identitySpin)) (fun _ => Set.mem_univ _)
  exact ⟨μ, isFreeBoundaryLocalLimit_of_weak_limit_with β
    (fun n => exhaustionBox (φ n)) (fun _ _ => β) (fun _ _ => ⟨hβ, le_rfl⟩)
    (fun z => hφ.tendsto_atTop.eventually (box_exhausts z))
    (fun _ _ => identitySpin) μ hlim⟩

/-- The log-square local-limit endpoint has an actual probability-measure
witness, with no additional choice of a spin required from the caller. -/
theorem local_limit_endpoint_nonvacuous (β : ℝ) (hβ : 0 ≤ β) :
    ∃ C : ℝ, 0 < C ∧ ∃ c : ℝ, 0 < c ∧
      ∃ μ : ProbabilityMeasure InfiniteConfiguration, IsSignedFreeBoundaryLocalLimit β μ ∧
      ∀ x y : Fourier.Site, |infiniteCorrelation μ x y| ≤
        C * Real.exp (-c * (Real.log (2 + (Fourier.siteRadius x y : ℝ))) ^ 2) :=
  local_limit_endpoint_nonvacuous_with_spin β hβ identitySpin

end RP3

end
end StandalonePart74

/- ===== RP3/SO3.lean ===== -/
section StandalonePart75

/-! Proofs contributed in the Claude Opus review supplied by the user on
11 October 2026, integrated and checked against this pinned development.
See REVIEW-RESPONSE.md for scope and attribution. -/
noncomputable section
open MeasureTheory Filter RP3
open scoped InnerProductSpace BigOperators Matrix Topology

namespace RP3.SO3
open RP3.ModelWitnesses

/-- Rotation matrix of `q = q₀ + q₁ i + q₂ j + q₃ k` (unnormalized). -/
def rotMat (q : Fin 4 → ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  !![q 0 ^ 2 + q 1 ^ 2 - q 2 ^ 2 - q 3 ^ 2, 2 * (q 1 * q 2 - q 0 * q 3), 2 * (q 1 * q 3 + q 0 * q 2);
     2 * (q 1 * q 2 + q 0 * q 3), q 0 ^ 2 - q 1 ^ 2 + q 2 ^ 2 - q 3 ^ 2, 2 * (q 2 * q 3 - q 0 * q 1);
     2 * (q 1 * q 3 - q 0 * q 2), 2 * (q 2 * q 3 + q 0 * q 1), q 0 ^ 2 - q 1 ^ 2 - q 2 ^ 2 + q 3 ^ 2]

theorem trace_rotMat (u v : Fin 4 → ℝ) :
    Matrix.trace ((rotMat u)ᵀ * rotMat v) =
      4 * (∑ i, u i * v i) ^ 2 - (∑ i, u i ^ 2) * (∑ i, v i ^ 2) := by
  simp [Matrix.trace, Matrix.mul_apply, Fin.sum_univ_three, Fin.sum_univ_four, rotMat]
  ring

theorem rotMat_orthogonal (u : Fin 4 → ℝ) (hu : ∑ i, u i ^ 2 = 1) :
    (rotMat u)ᵀ * rotMat u = 1 := by
  simp [Fin.sum_univ_four] at hu
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_three, rotMat] <;>
    first
      | ring1
      | linear_combination (u 0 ^ 2 + u 1 ^ 2 + u 2 ^ 2 + u 3 ^ 2 + 1) * hu

theorem rotMat_det (u : Fin 4 → ℝ) (hu : ∑ i, u i ^ 2 = 1) : (rotMat u).det = 1 := by
  simp [Fin.sum_univ_four] at hu
  rw [Matrix.det_fin_three]
  simp [rotMat]
  linear_combination ((u 0 ^ 2 + u 1 ^ 2 + u 2 ^ 2 + u 3 ^ 2) ^ 2 +
    (u 0 ^ 2 + u 1 ^ 2 + u 2 ^ 2 + u 3 ^ 2) + 1) * hu

/-- `rotMat` is multiplicative: `R(p) R(q) = R(p q)` (Hamilton product). -/
theorem rotMat_mul (p q : Fin 4 → ℝ) :
    rotMat p * rotMat q = rotMat (lmulFun p q) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_three, rotMat, lmulFun] <;> ring

/-- The SO(3) rotation of an `S³` spin. -/
def rotOf (s : Spin) : Matrix (Fin 3) (Fin 3) ℝ := rotMat s.val

theorem rotOf_mem_SO3 (s : Spin) : rotOf s ∈ Matrix.specialOrthogonalGroup (Fin 3) ℝ := by
  rw [Matrix.mem_specialUnitaryGroup_iff, Matrix.mem_unitaryGroup_iff']
  refine ⟨?_, rotMat_det _ (spin_squares s)⟩
  rw [Matrix.star_eq_conjTranspose, Matrix.conjTranspose_eq_transpose_of_trivial]
  exact rotMat_orthogonal _ (spin_squares s)

theorem qPair_eq_trace (s t : Spin) :
    qPair s t = (1 / 4) * Matrix.trace ((rotOf s)ᵀ * rotOf t) := by
  rw [rotOf, rotOf, trace_rotMat, spin_squares, spin_squares, qPair, inner_eq_sum]
  ring

theorem inner_sq_eq_trace (s t : Spin) :
    ⟪s.val, t.val⟫_ℝ ^ 2 = (1 + Matrix.trace ((rotOf s)ᵀ * rotOf t)) / 4 := by
  rw [rotOf, rotOf, trace_rotMat, spin_squares, spin_squares, inner_eq_sum]
  ring

/-- The actual correlation, rewritten entirely in SO(3) variables. -/
theorem correlation_eq_so3 {V E : Type*} [Fintype V] [Fintype E]
    (edge : E → V × V) (b : E → ℝ) (x y : V) :
    correlation edge b x y =
      (∫ σ, (1 / 4 * Matrix.trace ((rotOf (σ x))ᵀ * rotOf (σ y))) *
          Real.exp (∑ e, b e *
            ((1 + Matrix.trace ((rotOf (σ (edge e).1))ᵀ * rotOf (σ (edge e).2))) / 4))
        ∂referenceLaw) /
      (∫ σ, Real.exp (∑ e, b e *
            ((1 + Matrix.trace ((rotOf (σ (edge e).1))ᵀ * rotOf (σ (edge e).2))) / 4))
        ∂referenceLaw) := by
  change (∫ σ, qPair (σ x) (σ y) * Real.exp (interaction edge b σ) ∂referenceLaw) /
    (∫ σ, Real.exp (interaction edge b σ) ∂referenceLaw) = _
  simp only [interaction, qPair_eq_trace, inner_sq_eq_trace]

/-- **Suggested restatement.** The log-square theorem for the SO(3) matrix model. -/
theorem so3_log_square_decay_signed (β : ℝ) (hβ : 0 ≤ β) :
    ∃ C : ℝ, 0 < C ∧ ∃ c : ℝ, 0 < c ∧
      ∀ (G : Fourier.LatticeGraph) (b : G.edges → ℝ), (∀ e, |b e| ≤ β) →
      ∀ (x y : G.vertices),
      |(∫ σ, (1 / 4 * Matrix.trace ((rotOf (σ x))ᵀ * rotOf (σ y))) *
          Real.exp (∑ e : G.edges, b e *
            ((1 + Matrix.trace ((rotOf (σ e.val.1))ᵀ * rotOf (σ e.val.2))) / 4))
        ∂referenceLaw) /
      (∫ σ, Real.exp (∑ e : G.edges, b e *
            ((1 + Matrix.trace ((rotOf (σ e.val.1))ᵀ * rotOf (σ e.val.2))) / 4))
        ∂referenceLaw)| ≤
        C * Real.exp (-c * Real.log (2 + (Fourier.siteRadius x.val y.val : ℝ)) ^ 2) := by
  obtain ⟨C, hC, c, hc, h⟩ := log_square_quadrupolar_decay_signed β hβ
  refine ⟨C, hC, c, hc, fun G b hb x y => ?_⟩
  have h1 := h G b hb x y
  rwa [correlation_eq_so3] at h1

/-- The pushforward of the uniform law under `rotOf` is left-invariant, hence Haar. -/
def HaarInvariance : Prop :=
  ∀ R ∈ Matrix.specialOrthogonalGroup (Fin 3) ℝ, ∀ f : C(Matrix (Fin 3) (Fin 3) ℝ, ℝ),
    ∫ s, f (R * rotOf s) ∂sphereProbability = ∫ s, f (rotOf s) ∂sphereProbability

/-- **Remaining target.** Every rotation comes from a unit quaternion. This is
classical: take `q₀ = √(1 + Tr R)/2` when `Tr R > -1`, and use the analogous
formulas from a dominant diagonal entry otherwise. -/
def RotOfSurjective : Prop :=
  ∀ R ∈ Matrix.specialOrthogonalGroup (Fin 3) ℝ, ∃ p : Spin, rotOf p = R

theorem continuous_rotOf : Continuous rotOf := by
  have hc : ∀ k : Fin 4, Continuous fun s : Spin => (s.val : E4) k := fun k =>
    (PiLp.continuous_apply 2 (fun _ : Fin 4 => ℝ) k).comp continuous_subtype_val
  have h0 := hc 0
  have h1 := hc 1
  have h2 := hc 2
  have h3 := hc 3
  refine continuous_matrix fun i j => ?_
  fin_cases i <;> fin_cases j <;> simp [rotOf, rotMat] <;> fun_prop

theorem rotOf_lmul (p s : Spin) :
    rotOf (Rotation.spinRotation (lmulIsoOf p.val (spin_squares p)) s) =
      rotOf p * rotOf s := by
  rw [rotOf, rotOf, rotOf, rotMat_mul]
  congr 1

/-- **Proved reduction.** Given surjectivity, the pushforward is left-invariant,
because `rotOf` is multiplicative and left multiplication by a unit quaternion
preserves the uniform law. -/
theorem haarInvariance_of_surjective (h : RotOfSurjective) : HaarInvariance := by
  intro R hR f
  obtain ⟨p, rfl⟩ := h R hR
  have hmp := Rotation.spinRotation_preserves_probability (lmulIsoOf p.val (spin_squares p))
  have hcont : Continuous fun s : Spin => f (rotOf s) := f.continuous.comp continuous_rotOf
  calc ∫ s, f (rotOf p * rotOf s) ∂sphereProbability
      = ∫ s, f (rotOf (Rotation.spinRotation (lmulIsoOf p.val (spin_squares p)) s))
          ∂sphereProbability := by simp_rw [rotOf_lmul]
    _ = ∫ s, f (rotOf s) ∂sphereProbability := by
        rw [← integral_map hmp.measurable.aemeasurable hcont.aestronglyMeasurable, hmp.map_eq]


end RP3.SO3

end
end StandalonePart75

/- ===== RP3/HighTemperature.lean ===== -/
section StandalonePart76

/-!
# The positive active-edge expansion of the actual RP³ model

This module develops the exact finite expansion and disconnected-component
cancellation used in a high-temperature argument. It does not assume a mixing
estimate. The bound at the end is a bound by the mass of connected active-edge
sets; independent-bond domination and path counting are separate steps.

The interaction may have either sign. Subtracting `min (b e) 0` from each edge
energy makes its activity nonnegative without changing the Gibbs probability.
-/

namespace RP3.HighTemperature

noncomputable section
open MeasureTheory Finset
open scoped BigOperators InnerProductSpace

variable {V E : Type*} [Fintype V] [Fintype E] [DecidableEq V] [DecidableEq E]

def edgeActivity (edge : E → V × V) (b : E → ℝ) (e : E) :
    C(Configuration V, ℝ) :=
  ⟨fun σ => Real.exp (b e * ⟪(σ (edge e).1).val, (σ (edge e).2).val⟫_ℝ ^ 2
    - min (b e) 0) - 1, by fun_prop⟩

def activeWeight (edge : E → V × V) (b : E → ℝ) (A : Finset E) :
    C(Configuration V, ℝ) := ∏ e ∈ A, edgeActivity edge b e

def expandedWeight (edge : E → V × V) (b : E → ℝ) :
    C(Configuration V, ℝ) := ∏ e : E, (1 + edgeActivity edge b e)

/-- A cut separates the endpoints and no selected edge crosses it. -/
def ActiveSeparated (edge : E → V × V) (A : Finset E) (x y : V) : Prop :=
  ∃ cut : Finset V, x ∈ cut ∧ y ∉ cut ∧
    ∀ e ∈ A, ((edge e).1 ∈ cut ↔ (edge e).2 ∈ cut)

/-- The cut characterization of connectivity avoids choosing a path. -/
def ActiveConnected (edge : E → V × V) (A : Finset E) (x y : V) : Prop :=
  ¬ ActiveSeparated edge A x y

def connectedMass (edge : E → V × V) (b : E → ℝ) (x y : V) : ℝ := by
  classical
  exact ∑ A ∈ (univ : Finset E).powerset,
    if ActiveConnected edge A x y then
      (integralOnCompact (referenceLaw (V := V))).linear (activeWeight edge b A)
    else 0

theorem edge_energy_nonneg (edge : E → V × V) (b : E → ℝ) (e : E)
    (σ : Configuration V) :
    0 ≤ b e * ⟪(σ (edge e).1).val, (σ (edge e).2).val⟫_ℝ ^ 2 - min (b e) 0 := by
  have hn := sq_nonneg ⟪(σ (edge e).1).val, (σ (edge e).2).val⟫_ℝ
  have ha := abs_real_inner_le_norm (σ (edge e).1).val (σ (edge e).2).val
  simp only [spin_norm, one_mul] at ha
  have hu := (sq_le_one_iff_abs_le_one _).mpr ha
  by_cases hb : 0 ≤ b e
  · rw [min_eq_right hb, sub_zero]
    exact mul_nonneg hb hn
  · have hb' : b e ≤ 0 := le_of_not_ge hb
    rw [min_eq_left hb']
    have hm := mul_le_mul_of_nonpos_left hu hb'
    nlinarith

theorem edgeActivity_nonneg (edge : E → V × V) (b : E → ℝ) (e : E)
    (σ : Configuration V) : 0 ≤ edgeActivity edge b e σ := by
  change 0 ≤ Real.exp _ - 1
  exact sub_nonneg.mpr (Real.one_le_exp_iff.mpr (edge_energy_nonneg edge b e σ))

theorem edge_energy_le_abs (edge : E → V × V) (b : E → ℝ) (e : E)
    (σ : Configuration V) :
    b e * ⟪(σ (edge e).1).val, (σ (edge e).2).val⟫_ℝ ^ 2 - min (b e) 0 ≤
      |b e| := by
  have hn := sq_nonneg ⟪(σ (edge e).1).val, (σ (edge e).2).val⟫_ℝ
  have ha := abs_real_inner_le_norm (σ (edge e).1).val (σ (edge e).2).val
  simp only [spin_norm, one_mul] at ha
  have hu := (sq_le_one_iff_abs_le_one _).mpr ha
  by_cases hb : 0 ≤ b e
  · rw [min_eq_right hb, sub_zero, abs_of_nonneg hb]
    simpa using mul_le_mul_of_nonneg_left hu hb
  · have hb' : b e ≤ 0 := le_of_not_ge hb
    rw [min_eq_left hb', abs_of_nonpos hb']
    have hm := mul_nonpos_of_nonpos_of_nonneg hb' hn
    linarith

/-- The elementary opening coefficient is valid pointwise, before integration. -/
theorem edgeActivity_le_opening_coefficient (edge : E → V × V) (b : E → ℝ)
    (e : E) (β : ℝ) (hb : |b e| ≤ β) (σ : Configuration V) :
    edgeActivity edge b e σ ≤
      (1 - Real.exp (-β)) * (1 + edgeActivity edge b e σ) := by
  have he := (edge_energy_le_abs edge b e σ).trans hb
  have hp : Real.exp (-β) *
      Real.exp (b e * ⟪(σ (edge e).1).val, (σ (edge e).2).val⟫_ℝ ^ 2 -
        min (b e) 0) ≤ 1 := by
    rw [← Real.exp_add]
    exact Real.exp_le_one_iff.mpr (by linarith)
  change Real.exp _ - 1 ≤ (1 - Real.exp (-β)) * (1 + (Real.exp _ - 1))
  nlinarith

theorem activeWeight_nonneg (edge : E → V × V) (b : E → ℝ) (A : Finset E)
    (σ : Configuration V) : 0 ≤ activeWeight edge b A σ := by
  simp only [activeWeight, ContinuousMap.prod_apply]
  exact prod_nonneg (fun e _ => edgeActivity_nonneg edge b e σ)

theorem expandedWeight_eq_sum (edge : E → V × V) (b : E → ℝ) :
    expandedWeight edge b =
      ∑ A ∈ (univ : Finset E).powerset, activeWeight edge b A := by
  exact prod_one_add (f := edgeActivity edge b) univ

theorem expandedWeight_eq_smul_weight (edge : E → V × V) (b : E → ℝ) :
    expandedWeight edge b =
      Real.exp (-∑ e : E, min (b e) 0) • weight edge b := by
  ext σ
  simp only [expandedWeight, ContinuousMap.prod_apply, ContinuousMap.add_apply,
    ContinuousMap.one_apply, edgeActivity, ContinuousMap.coe_mk,
    ContinuousMap.smul_apply, smul_eq_mul, weight]
  simp only [← add_sub_assoc, add_sub_cancel_left]
  rw [← Real.exp_sum]
  rw [← Real.exp_add]
  congr 1
  simp only [sum_sub_distrib, interaction]
  ring

theorem quaternion_inner (g : Quaternion) (s t : Spin) :
    ⟪(quaternionAction.move g s).val, (quaternionAction.move g t).val⟫_ℝ =
      ⟪s.val, t.val⟫_ℝ :=
  (quaternionLinearIsometry g).inner_map_map s.val t.val

theorem edgeActivity_onCut (edge : E → V × V) (b : E → ℝ) (e : E)
    (cut : Finset V) (hcut : (edge e).1 ∈ cut ↔ (edge e).2 ∈ cut)
    (g : Quaternion) (σ : Configuration V) :
    edgeActivity edge b e ((quaternionAction.onCut cut).move g σ) =
      edgeActivity edge b e σ := by
  by_cases hleft : (edge e).1 ∈ cut
  · have hright := hcut.mp hleft
    simp only [edgeActivity, ContinuousMap.coe_mk, FiniteAction.onCut_apply,
      hleft, hright, ite_true, quaternion_inner]
  · have hright : (edge e).2 ∉ cut := fun h => hleft (hcut.mpr h)
    simp only [edgeActivity, ContinuousMap.coe_mk, FiniteAction.onCut_apply,
      hleft, hright, ite_false]

theorem activeWeight_onCut (edge : E → V × V) (b : E → ℝ) (A : Finset E)
    (cut : Finset V)
    (hcut : ∀ e ∈ A, (edge e).1 ∈ cut ↔ (edge e).2 ∈ cut)
    (g : Quaternion) (σ : Configuration V) :
    activeWeight edge b A ((quaternionAction.onCut cut).move g σ) =
      activeWeight edge b A σ := by
  simp only [activeWeight, ContinuousMap.prod_apply]
  exact prod_congr rfl (fun e he => edgeActivity_onCut edge b e cut (hcut e he) g σ)

/-- Cancellation is proved separately in each disconnected expansion term. -/
theorem separated_numerator_zero (edge : E → V × V) (b : E → ℝ)
    (A : Finset E) (x y : V) (hsep : ActiveSeparated edge A x y) :
    (integralOnCompact (referenceLaw (V := V))).linear
      (observable x y * activeWeight edge b A) = 0 := by
  rcases hsep with ⟨cut, hx, hy, hcut⟩
  let I := integralOnCompact (referenceLaw (V := V))
  let action := quaternionAction.onCut cut
  have havg : action.average (activeWeight edge b A) = activeWeight edge b A :=
    action.average_of_invariant _ (activeWeight_onCut edge b A cut hcut)
  have hpres (f : C(Configuration V, ℝ)) : I.linear (action.average f) = I.linear f := by
    exact action.preserve_integral I (fun g f =>
      (quaternionAction.onCut_measurePreserving sphereProbability
        quaternionAction_measurePreserving cut g).integral_comp
        (action.toHomeomorph g).measurableEmbedding f) f
  calc
    _ = I.linear (activeWeight edge b A * observable x y) := by rw [mul_comm]
    _ = I.linear (action.average (activeWeight edge b A * observable x y)) :=
      (hpres _).symm
    _ = I.linear (activeWeight edge b A * action.average (observable x y)) := by
      rw [action.average_pull _ _ havg]
    _ = 0 := by
      rw [quaternionAction_cut_average_zero cut x y hx hy, mul_zero, map_zero]

theorem abs_expanded_numerator_le (edge : E → V × V) (b : E → ℝ) (x y : V) :
    |(integralOnCompact (referenceLaw (V := V))).linear
      (observable x y * expandedWeight edge b)| ≤
      (3 : ℝ) / 4 * connectedMass edge b x y := by
  classical
  let I := integralOnCompact (referenceLaw (V := V))
  rw [expandedWeight_eq_sum, mul_sum, map_sum]
  calc
    _ ≤ ∑ A ∈ (univ : Finset E).powerset,
        |I.linear (observable x y * activeWeight edge b A)| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ A ∈ (univ : Finset E).powerset,
        ((3 : ℝ) / 4) * (if ActiveConnected edge A x y then
          I.linear (activeWeight edge b A) else 0) := by
      apply sum_le_sum
      intro A hA
      by_cases h : ActiveConnected edge A x y
      · simp only [h, ite_true]
        exact I.abs_weighted_le _ _ (fun σ => abs_qPair_le (σ x) (σ y))
          (activeWeight_nonneg edge b A)
      · have hs : ActiveSeparated edge A x y := Classical.not_not.mp h
        rw [separated_numerator_zero edge b A x y hs]
        simp [h]
    _ = _ := by rw [← mul_sum]; rfl

theorem expanded_partition_pos (edge : E → V × V) (b : E → ℝ) :
    0 < (integralOnCompact (referenceLaw (V := V))).linear (expandedWeight edge b) := by
  rw [expandedWeight_eq_smul_weight, map_smul]
  exact mul_pos (Real.exp_pos _) (partition_pos edge b)

theorem correlation_eq_expanded (edge : E → V × V) (b : E → ℝ) (x y : V) :
    correlation edge b x y =
      (integralOnCompact (referenceLaw (V := V))).linear
          (observable x y * expandedWeight edge b) /
        (integralOnCompact (referenceLaw (V := V))).linear (expandedWeight edge b) := by
  rw [expandedWeight_eq_smul_weight, mul_smul_comm, map_smul, map_smul]
  simp only [smul_eq_mul, correlation, partition]
  rw [mul_div_mul_left _ _ (Real.exp_ne_zero _)]

/-- Exact bridge from the model to the mass of connected active-edge sets. -/
theorem abs_correlation_le_connected_mass (edge : E → V × V) (b : E → ℝ) (x y : V) :
    |correlation edge b x y| ≤
      ((3 : ℝ) / 4 * connectedMass edge b x y) /
        (integralOnCompact (referenceLaw (V := V))).linear (expandedWeight edge b) := by
  rw [correlation_eq_expanded, abs_div, abs_of_pos (expanded_partition_pos edge b)]
  exact div_le_div_of_nonneg_right (abs_expanded_numerator_le edge b x y)
    (expanded_partition_pos edge b).le

end
end RP3.HighTemperature
end StandalonePart76

/- ===== RP3/ActiveEdgeBounds.lean ===== -/
section StandalonePart77

/-! Elementary upper bounds for prescribed open edges and finite witness families.
No FKG property or stochastic-domination theorem is assumed. -/

namespace RP3.HighTemperature
noncomputable section
open Finset MeasureTheory
open scoped BigOperators

variable {V E : Type*} [Fintype V] [Fintype E] [DecidableEq V] [DecidableEq E]

theorem sum_supersets_prod (f : E → ℝ) (S : Finset E) :
    (∑ A ∈ (univ : Finset E).powerset, if S ⊆ A then ∏ e ∈ A, f e else 0) =
      ∏ e : E, (f e + if e ∈ S then 0 else 1) := by
  classical
  rw [prod_add]
  apply sum_congr rfl
  intro A hA
  have hprod : (∏ e ∈ (univ : Finset E) \ A, (if e ∈ S then (0 : ℝ) else 1)) =
      if S ⊆ A then 1 else 0 := by
    simp_rw [show (fun e : E => if e ∈ S then (0 : ℝ) else 1) =
      (fun e => if e ∉ S then 1 else 0) by funext e; split_ifs <;> simp_all]
    rw [prod_boole]
    congr 1
    simp only [mem_sdiff, mem_univ, true_and]
    apply propext
    constructor
    · intro h e he
      by_contra hn
      exact h e hn he
    · intro h e hn he
      exact hn (h he)
  rw [hprod]
  split_ifs <;> simp

theorem sum_supersets_prod_le (f : E → ℝ) (S : Finset E) (p : ℝ)
    (hf : ∀ e, 0 ≤ f e) (hp : 0 ≤ p)
    (hopen : ∀ e, f e ≤ p * (1 + f e)) :
    (∑ A ∈ (univ : Finset E).powerset, if S ⊆ A then ∏ e ∈ A, f e else 0) ≤
      p ^ S.card * ∏ e : E, (1 + f e) := by
  classical
  rw [sum_supersets_prod]
  calc
    _ ≤ ∏ e : E, (if e ∈ S then p else 1) * (1 + f e) := by
      apply prod_le_prod₀
      · intro e _
        split_ifs <;> linarith [hf e]
      · intro e _
        by_cases he : e ∈ S
        · simpa [he] using hopen e
        · simp [he, add_comm]
    _ = _ := by
      rw [prod_mul_distrib]
      congr 1
      rw [prod_ite]
      simp

def prescribedMass (edge : E → V × V) (b : E → ℝ) (S : Finset E) : ℝ :=
  ∑ A ∈ (univ : Finset E).powerset, if S ⊆ A then
    (integralOnCompact (referenceLaw (V := V))).linear (activeWeight edge b A) else 0

theorem prescribedMass_le (edge : E → V × V) (b : E → ℝ) (β : ℝ)
    (hβ : 0 ≤ β) (hb : ∀ e, |b e| ≤ β) (S : Finset E) :
    prescribedMass edge b S ≤ (1 - Real.exp (-β)) ^ S.card *
      (integralOnCompact (referenceLaw (V := V))).linear (expandedWeight edge b) := by
  classical
  let I := integralOnCompact (referenceLaw (V := V))
  have hp : 0 ≤ 1 - Real.exp (-β) := by
    exact sub_nonneg.mpr (Real.exp_le_one_iff.mpr (by linarith))
  have hpoint := I.mono (f := ∑ A ∈ (univ : Finset E).powerset,
      if S ⊆ A then activeWeight edge b A else 0)
    (g := ((1 - Real.exp (-β)) ^ S.card) • expandedWeight edge b) (fun σ => by
      simp only [ContinuousMap.sum_apply, ContinuousMap.smul_apply, smul_eq_mul,
        expandedWeight, ContinuousMap.prod_apply, ContinuousMap.add_apply,
        ContinuousMap.one_apply]
      have h := sum_supersets_prod_le (fun e => edgeActivity edge b e σ) S
        (1 - Real.exp (-β)) (fun e => edgeActivity_nonneg edge b e σ) hp
        (fun e => edgeActivity_le_opening_coefficient edge b e β (hb e) σ)
      simpa only [apply_ite (fun f : C(Configuration V, ℝ) => f σ),
        ContinuousMap.zero_apply, activeWeight, ContinuousMap.prod_apply] using h)
  simpa only [prescribedMass, map_sum, map_smul, smul_eq_mul, apply_ite I.linear, map_zero] using hpoint

theorem connectedMass_le_witness_sum (edge : E → V × V) (b : E → ℝ) (x y : V)
    (W : Finset (Finset E))
    (hW : ∀ A : Finset E, ActiveConnected edge A x y → ∃ S ∈ W, S ⊆ A) :
    connectedMass edge b x y ≤ ∑ S ∈ W, prescribedMass edge b S := by
  classical
  let I := integralOnCompact (referenceLaw (V := V))
  unfold connectedMass prescribedMass
  rw [sum_comm]
  apply sum_le_sum
  intro A hA
  have hn := I.nonneg (activeWeight edge b A) (activeWeight_nonneg edge b A)
  by_cases hc : ActiveConnected edge A x y
  · obtain ⟨S, hS, hSA⟩ := hW A hc
    simp only [hc, ite_true]
    apply le_trans ?_ (single_le_sum (fun T _ => by split_ifs <;> positivity) hS)
    simp [hSA]
  · simp only [hc, ite_false]
    exact sum_nonneg (fun S _ => by split_ifs <;> positivity)

theorem abs_correlation_le_witness_sum (edge : E → V × V) (b : E → ℝ)
    (β : ℝ) (hβ : 0 ≤ β) (hb : ∀ e, |b e| ≤ β) (x y : V)
    (W : Finset (Finset E))
    (hW : ∀ A : Finset E, ActiveConnected edge A x y → ∃ S ∈ W, S ⊆ A) :
    |correlation edge b x y| ≤ (3 : ℝ) / 4 *
      ∑ S ∈ W, (1 - Real.exp (-β)) ^ S.card := by
  let Z := (integralOnCompact (referenceLaw (V := V))).linear (expandedWeight edge b)
  have hZ : 0 < Z := expanded_partition_pos edge b
  have hw := connectedMass_le_witness_sum edge b x y W hW
  have hs := sum_le_sum (fun S (_ : S ∈ W) => prescribedMass_le edge b β hβ hb S)
  rw [← sum_mul] at hs
  have hc := abs_correlation_le_connected_mass edge b x y
  apply hc.trans
  apply (div_le_iff₀ hZ).mpr
  nlinarith [hw.trans hs]

end
end RP3.HighTemperature
end StandalonePart77

/- ===== RP3/ActivePaths.lean ===== -/
section StandalonePart78

/-! Finite simple-path witnesses for the positive active-edge expansion. -/
namespace RP3.HighTemperature
noncomputable section
open Finset
open scoped BigOperators Classical
variable {V E : Type*} [Fintype V] [Fintype E] [DecidableEq V] [DecidableEq E]

def activeGraph (edge : E → V × V) (A : Finset E) : SimpleGraph V where
  Adj x y := x ≠ y ∧ ∃ e ∈ A, s((edge e).1, (edge e).2) = s(x,y)
  symm := ⟨by
    intro x y h
    refine ⟨h.1.symm, ?_⟩
    obtain ⟨e, he, hp⟩ := h.2
    exact ⟨e, he, hp.trans Sym2.eq_swap⟩⟩
  loopless := ⟨by intro x; simp⟩

def fullGraph (edge : E → V × V) : SimpleGraph V := activeGraph edge univ

theorem activeGraph_le_full (edge : E → V × V) (A : Finset E) :
    activeGraph edge A ≤ fullGraph edge := by
  rintro x y ⟨hne,e,he,hpair⟩
  exact ⟨hne,e,mem_univ _,hpair⟩

theorem activeConnected_reachable (edge : E → V × V) (A : Finset E) (x y : V)
    (hc : ActiveConnected edge A x y) : (activeGraph edge A).Reachable x y := by
  by_contra hn
  apply hc
  refine ⟨univ.filter (fun v => (activeGraph edge A).Reachable x v), ?_, ?_, ?_⟩
  · simp
  · simpa using hn
  · intro e he
    have hr : (activeGraph edge A).Reachable (edge e).1 (edge e).2 := by
      by_cases hd : (edge e).1 = (edge e).2
      · rw [hd]
      · exact SimpleGraph.Adj.reachable ⟨hd,e,he,rfl⟩
    simp only [mem_filter, mem_univ, true_and]
    exact ⟨fun h => h.trans hr, fun h => h.trans hr.symm⟩

def adjacencyEdge (edge : E → V × V) {x y : V} (h : (fullGraph edge).Adj x y) : E :=
  Classical.choose h.2

theorem adjacencyEdge_spec (edge : E → V × V) {x y : V}
    (h : (fullGraph edge).Adj x y) :
    s((edge (adjacencyEdge edge h)).1, (edge (adjacencyEdge edge h)).2) = s(x,y) :=
  (Classical.choose_spec h.2).2

def walkEdgeSet (edge : E → V × V) {x y : V} : (fullGraph edge).Walk x y → Finset E
  | .nil => ∅
  | .cons h p => insert (adjacencyEdge edge h) (walkEdgeSet edge p)

theorem mem_walkEdgeSet_iff (edge : E → V × V)
    (hi : Function.Injective (fun e => s((edge e).1, (edge e).2)))
    {x y : V} (p : (fullGraph edge).Walk x y) (e : E) :
    e ∈ walkEdgeSet edge p ↔ s((edge e).1, (edge e).2) ∈ p.edges := by
  induction p with
  | nil => simp [walkEdgeSet]
  | @cons u v w h p ih =>
    simp only [walkEdgeSet, mem_insert, SimpleGraph.Walk.edges_cons, List.mem_cons, ih]
    rw [← adjacencyEdge_spec edge h]
    exact or_congr hi.eq_iff.symm Iff.rfl

theorem card_walkEdgeSet (edge : E → V × V)
    (hi : Function.Injective (fun e => s((edge e).1, (edge e).2)))
    {x y : V} (p : (fullGraph edge).Walk x y) (hp : p.IsTrail) :
    (walkEdgeSet edge p).card = p.length := by
  induction p with
  | nil => simp [walkEdgeSet]
  | cons h p ih =>
    obtain ⟨hp, hn⟩ := (SimpleGraph.Walk.isTrail_cons h p).mp hp
    have he : adjacencyEdge edge h ∉ walkEdgeSet edge p := by
      rw [mem_walkEdgeSet_iff edge hi p, adjacencyEdge_spec]
      exact hn
    simp [walkEdgeSet, he, ih hp]

theorem walkEdgeSet_subset_of_active (edge : E → V × V)
    (hi : Function.Injective (fun e => s((edge e).1, (edge e).2))) (A : Finset E)
    {x y : V} (p : (activeGraph edge A).Walk x y) :
    walkEdgeSet edge (p.mapLe (activeGraph_le_full edge A)) ⊆ A := by
  intro e he
  rw [mem_walkEdgeSet_iff edge hi, SimpleGraph.Walk.edges_mapLe_eq_edges] at he
  have hAdj := p.adj_of_mem_edges he
  obtain ⟨_, f, hf, hsym⟩ := hAdj
  have hef : e = f := hi hsym.symm
  simpa only [hef] using hf

/-- The total number of length-n walks is bounded by the maximum degree to power n. -/
theorem total_walk_count_le (H : SimpleGraph V) [DecidableRel H.Adj]
    (D : ℕ) (hd : ∀ v, Fintype.card (H.neighborSet v) ≤ D) (n : ℕ) (x : V) :
    ∑ y : V, (H.finsetWalkLength n x y).card ≤ D ^ n := by
  induction n generalizing x with
  | zero =>
    have heq (y : V) : (H.finsetWalkLength 0 x y).card = if y = x then 1 else 0 := by
      by_cases h : x = y
      · subst y; simp [SimpleGraph.finsetWalkLength]
      · simp [SimpleGraph.finsetWalkLength, h, Ne.symm h]
    simp [heq]
  | succ n ih =>
    calc
      _ ≤ ∑ y : V, ∑ z : H.neighborSet x, (H.finsetWalkLength n z y).card := by
        apply sum_le_sum
        intro y _
        simp only [SimpleGraph.finsetWalkLength]
        apply (card_biUnion_le).trans
        simp only [card_map]
        rfl
      _ = ∑ z : H.neighborSet x, ∑ y : V, (H.finsetWalkLength n z y).card := sum_comm
      _ ≤ ∑ z : H.neighborSet x, D ^ n := sum_le_sum (fun z _ => ih z)
      _ ≤ D ^ (n+1) := by
        simp only [sum_const, card_univ, smul_eq_mul, pow_succ]
        exact Nat.mul_le_mul_right _ (hd x) |>.trans_eq (Nat.mul_comm _ _)

def pathWitnesses (edge : E → V × V) (n : ℕ) (x : V) : Finset (Finset E) :=
  univ.biUnion (fun y => ((fullGraph edge).finsetWalkLength n x y).filter
    SimpleGraph.Walk.IsPath |>.image (walkEdgeSet edge))

theorem mem_pathWitnesses (edge : E → V × V) (n : ℕ) (x : V) (S : Finset E) :
    S ∈ pathWitnesses edge n x ↔
      ∃ y, ∃ p : (fullGraph edge).Walk x y, p.length = n ∧ p.IsPath ∧ walkEdgeSet edge p = S := by
  simp only [pathWitnesses, mem_biUnion, mem_univ, true_and, mem_image,
    mem_filter, SimpleGraph.mem_finsetWalkLength_iff]
  tauto

theorem pathWitnesses_card_le (edge : E → V × V) (D : ℕ)
    (hd : ∀ v, Fintype.card ((fullGraph edge).neighborSet v) ≤ D) (n : ℕ) (x : V) :
    (pathWitnesses edge n x).card ≤ D ^ n := by
  apply (card_biUnion_le).trans
  apply le_trans (sum_le_sum (fun y _ => (card_image_le).trans (card_filter_le _ _)))
  exact total_walk_count_le (fullGraph edge) D hd n x

theorem card_mem_pathWitnesses (edge : E → V × V)
    (hi : Function.Injective (fun e => s((edge e).1, (edge e).2)))
    (n : ℕ) (x : V) (S : Finset E) (hS : S ∈ pathWitnesses edge n x) : S.card = n := by
  obtain ⟨y,p,hlen,hpath,rfl⟩ := (mem_pathWitnesses edge n x S).mp hS
  exact (card_walkEdgeSet edge hi p hpath.isTrail).trans hlen

theorem connected_has_pathWitness (edge : E → V × V)
    (hi : Function.Injective (fun e => s((edge e).1, (edge e).2)))
    (n : ℕ) (x y : V)
    (hlen : ∀ p : (fullGraph edge).Walk x y, n ≤ p.length)
    (A : Finset E) (hc : ActiveConnected edge A x y) :
    ∃ S ∈ pathWitnesses edge n x, S ⊆ A := by
  obtain ⟨p, hp⟩ := (activeConnected_reachable edge A x y hc).exists_isPath
  let q := p.take n
  let q' := q.mapLe (activeGraph_le_full edge A)
  have hnp : n ≤ p.length := by simpa using hlen (p.mapLe (activeGraph_le_full edge A))
  refine ⟨walkEdgeSet edge q', ?_, walkEdgeSet_subset_of_active edge hi A q⟩
  apply (mem_pathWitnesses edge n x _).mpr
  refine ⟨p.getVert n, q', ?_, (hp.take n).mapLe _, rfl⟩
  simp [q', q, SimpleGraph.Walk.take_length, Nat.min_eq_left hnp]

/-- A complete exponential bound in graph distance, using at most D choices per step. -/
theorem abs_correlation_le_degree_pow (edge : E → V × V)
    (hi : Function.Injective (fun e => s((edge e).1, (edge e).2)))
    (D : ℕ) (hd : ∀ v, Fintype.card ((fullGraph edge).neighborSet v) ≤ D)
    (b : E → ℝ) (β : ℝ) (hβ : 0 ≤ β) (hb : ∀ e, |b e| ≤ β) (n : ℕ) (x y : V)
    (hlen : ∀ p : (fullGraph edge).Walk x y, n ≤ p.length) :
    |correlation edge b x y| ≤ (3 : ℝ) / 4 * (D * (1 - Real.exp (-β))) ^ n := by
  have hp : 0 ≤ 1 - Real.exp (-β) :=
    sub_nonneg.mpr (Real.exp_le_one_iff.mpr (by linarith))
  apply (abs_correlation_le_witness_sum edge b β hβ hb x y (pathWitnesses edge n x)
    (connected_has_pathWitness edge hi n x y hlen)).trans
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  calc
    _ = (pathWitnesses edge n x).card * (1 - Real.exp (-β)) ^ n := by
      rw [sum_congr rfl (fun S hS => by rw [card_mem_pathWitnesses edge hi n x S hS])]
      simp
    _ ≤ (D ^ n : ℕ) * (1 - Real.exp (-β)) ^ n := by
      apply mul_le_mul_of_nonneg_right _ (pow_nonneg hp _)
      exact_mod_cast pathWitnesses_card_le edge D hd n x
    _ = _ := by simp only [Nat.cast_pow, mul_pow]

end
end RP3.HighTemperature
end StandalonePart78

/- ===== RP3/HighTemperatureDecay.lean ===== -/
section StandalonePart79

/-! Unconditional exponential decay by elementary active-edge path counting.
This module does not use the sharper, external square-lattice FK theorem. -/
namespace RP3.HighTemperature
noncomputable section
open Finset
open RP3.Fourier
open scoped BigOperators Classical

namespace Lattice

def edge (G : LatticeGraph) : G.edges → G.vertices × G.vertices := fun e => e.val

theorem edgeSym_injective (G : LatticeGraph) :
    Function.Injective (fun e : G.edges => s((edge G e).1, (edge G e).2)) := by
  intro e f h
  rcases Sym2.eq_iff.mp h with h | h
  · exact Subtype.ext (Prod.ext h.1 h.2)
  · have he := G.nearest e.val e.property
    have hf := G.nearest f.val f.property
    have h1 : e.val.1.val = f.val.2.val := congrArg Subtype.val h.1
    have h2 : e.val.2.val = f.val.1.val := congrArg Subtype.val h.2
    simp only [PositiveNeighbor] at he hf
    rcases he with he | he <;> rcases hf with hf | hf <;>
      have hx := congrArg Prod.fst h1 <;> have hy := congrArg Prod.snd h1 <;>
      have hx' := congrArg Prod.fst h2 <;> have hy' := congrArg Prod.snd h2 <;>
      omega

theorem adjacency_neighbor (G : LatticeGraph) {x y : G.vertices}
    (h : (fullGraph (edge G)).Adj x y) :
    PositiveNeighbor x.val y.val ∨ PositiveNeighbor y.val x.val := by
  obtain ⟨_,e,_,he⟩ := h
  have hn := G.nearest e.val e.property
  rcases Sym2.eq_iff.mp he with ⟨hl,hr⟩ | ⟨hl,hr⟩
  · left
    change e.val.1 = _ at hl
    change e.val.2 = _ at hr
    simpa only [hl, hr] using hn
  · right
    change e.val.1 = _ at hl
    change e.val.2 = _ at hr
    simpa only [hl, hr] using hn

def fourNeighbors (x : Site) : Finset Site :=
  {(x.1+1,x.2), (x.1-1,x.2), (x.1,x.2+1), (x.1,x.2-1)}

theorem mem_fourNeighbors {x y : Site}
    (h : PositiveNeighbor x y ∨ PositiveNeighbor y x) : y ∈ fourNeighbors x := by
  simp only [fourNeighbors, mem_insert, mem_singleton]
  rcases h with h | h <;> rcases h with ⟨h1,h2⟩ | ⟨h1,h2⟩
  · exact Or.inl (Prod.ext h1 h2)
  · exact Or.inr (Or.inr (Or.inl (Prod.ext h1 h2)))
  · exact Or.inr (Or.inl (Prod.ext (by omega) (by omega)))
  · exact Or.inr (Or.inr (Or.inr (Prod.ext (by omega) (by omega))))

theorem card_fourNeighbors_le (x : Site) : (fourNeighbors x).card ≤ 4 := by
  unfold fourNeighbors
  exact (card_insert_le _ _).trans (Nat.succ_le_succ ((card_insert_le _ _).trans
    (Nat.succ_le_succ ((card_insert_le _ _).trans (by simp)))))

theorem degree_le_four (G : LatticeGraph) (x : G.vertices) :
    Fintype.card ((fullGraph (edge G)).neighborSet x) ≤ 4 := by
  let f : (fullGraph (edge G)).neighborSet x → fourNeighbors x.val := fun y =>
    ⟨y.val.val, mem_fourNeighbors (adjacency_neighbor G y.property)⟩
  have hi : Function.Injective f := by
    intro a b h
    apply Subtype.ext
    apply Subtype.ext
    have hv := congrArg (fun z : fourNeighbors x.val => z.val) h
    exact hv
  have hc := Fintype.card_le_of_injective f hi
  exact hc.trans (by simpa only [Fintype.card_coe] using card_fourNeighbors_le x.val)

theorem radius_le_walk_length (G : LatticeGraph) {x y : G.vertices}
    (p : (fullGraph (edge G)).Walk x y) : siteRadius x.val y.val ≤ p.length := by
  induction p with
  | nil => simp
  | @cons u v w h p ih =>
    have ht := siteRadius_triangle u.val v.val w.val
    have hn : siteRadius u.val v.val = 1 := by
      rcases adjacency_neighbor G h with h | h
      · exact siteRadius_neighbor h
      · rw [siteRadius_symm]; exact siteRadius_neighbor h
    simp only [SimpleGraph.Walk.length_cons, Nat.cast_add, Nat.cast_one]
    omega

/-- Signed finite-volume bound, uniform over all retained square-lattice graphs. -/
theorem abs_correlation_le_four_opening_pow (G : LatticeGraph) (b : G.edges → ℝ)
    (β : ℝ) (hβ : 0 ≤ β) (hb : ∀ e, |b e| ≤ β) (x y : G.vertices) :
    |correlation (edge G) b x y| ≤ (3 : ℝ) / 4 *
      (4 * (1 - Real.exp (-β))) ^ (siteRadius x.val y.val).toNat := by
  apply abs_correlation_le_degree_pow (edge G) (edgeSym_injective G) 4
    (degree_le_four G) b β hβ hb (siteRadius x.val y.val).toNat x y
  intro p
  exact Int.toNat_le.mpr (radius_le_walk_length G p)

end Lattice

/-- A harmless floor keeps the displayed mass finite also at zero coupling. -/
def elementaryDecayBase (β : ℝ) : ℝ := max (1 / 2) (3 * (1 - Real.exp (-β)))

def elementaryMass (β : ℝ) : ℝ := -Real.log (elementaryDecayBase β)

theorem elementaryDecayBase_pos (β : ℝ) : 0 < elementaryDecayBase β :=
  lt_of_lt_of_le (by norm_num) (le_max_left _ _)

theorem three_opening_lt_one (β : ℝ) (hβ : β < Real.log ((3 : ℝ) / 2)) :
    3 * (1 - Real.exp (-β)) < 1 := by
  have hexp : Real.exp β < (3 : ℝ) / 2 := by
    have h := Real.exp_lt_exp.mpr hβ
    simpa only [Real.exp_log (by norm_num : (0 : ℝ) < 3 / 2)] using h
  have hprod : Real.exp β * Real.exp (-β) = 1 := by rw [← Real.exp_add]; simp
  have hp := Real.exp_pos (-β)
  nlinarith

theorem elementaryDecayBase_lt_one (β : ℝ) (hβ : β < Real.log ((3 : ℝ) / 2)) :
    elementaryDecayBase β < 1 := by
  exact max_lt (by norm_num) (three_opening_lt_one β hβ)

theorem elementaryMass_pos (β : ℝ) (hβ : β < Real.log ((3 : ℝ) / 2)) :
    0 < elementaryMass β := by
  exact neg_pos.mpr (Real.log_neg (elementaryDecayBase_pos β)
    (elementaryDecayBase_lt_one β hβ))

theorem elementaryDecayBase_pow (β : ℝ) (n : ℕ) :
    elementaryDecayBase β ^ n = Real.exp (-elementaryMass β * n) := by
  simp only [elementaryMass, neg_neg]
  rw [mul_comm, Real.exp_nat_mul, Real.exp_log (elementaryDecayBase_pos β)]

end
end RP3.HighTemperature
end StandalonePart79

/- ===== RP3/NonbacktrackingPaths.lean ===== -/
section StandalonePart80

/-! Sharper path counting: after the first step a simple path has at most
three choices on a graph of maximum degree four. -/
namespace RP3.HighTemperature
noncomputable section
open Finset
open scoped BigOperators Classical
variable {V E : Type*} [Fintype V] [Fintype E] [DecidableEq V] [DecidableEq E]

/-- Simple paths of a fixed length avoiding one specified vertex. -/
def avoidingPaths (H : SimpleGraph V) (prev : V) (n : ℕ) (x y : V) :
    Finset (H.Walk x y) :=
  (H.finsetWalkLength n x y).filter (fun p => p.IsPath ∧ prev ∉ p.support)

theorem avoidingPaths_step_subset (H : SimpleGraph V) (prev : V) (n : ℕ) (x y : V) :
    avoidingPaths H prev (n+1) x y ⊆
      (univ.filter (fun z : H.neighborSet x => z.val ≠ prev)).biUnion
        (fun z => (avoidingPaths H x n z y).map
          ⟨fun p => SimpleGraph.Walk.cons z.property p, fun _ _ => by intro h; cases h; rfl⟩) := by
  intro p hp
  obtain ⟨hlen, hpath, hprev⟩ := mem_filter.mp hp
  rw [SimpleGraph.mem_finsetWalkLength_iff] at hlen
  cases p with
  | nil => simp at hlen
  | cons h p =>
    rename_i z
    have hp' := (SimpleGraph.Walk.cons_isPath_iff h p).mp hpath
    have hz : z ≠ prev := by
      intro hz
      apply hprev
      simp only [SimpleGraph.Walk.support_cons, List.mem_cons]
      exact Or.inr (hz ▸ p.start_mem_support)
    apply mem_biUnion.mpr
    refine ⟨⟨z, h⟩, by simpa using hz, ?_⟩
    apply mem_map.mpr
    refine ⟨p, ?_, rfl⟩
    apply mem_filter.mpr
    refine ⟨?_, hp'⟩
    rw [SimpleGraph.mem_finsetWalkLength_iff]
    simpa using hlen

theorem simplePaths_step_subset (H : SimpleGraph V) (n : ℕ) (x y : V) :
    ((H.finsetWalkLength (n+1) x y).filter SimpleGraph.Walk.IsPath) ⊆
      univ.biUnion (fun z : H.neighborSet x =>
        (avoidingPaths H x n z y).map
          ⟨fun p => SimpleGraph.Walk.cons z.property p, fun _ _ => by intro h; cases h; rfl⟩) := by
  intro p hp
  obtain ⟨hlen, hpath⟩ := mem_filter.mp hp
  rw [SimpleGraph.mem_finsetWalkLength_iff] at hlen
  cases p with
  | nil => simp at hlen
  | cons h p =>
    rename_i z
    apply mem_biUnion.mpr
    refine ⟨⟨z,h⟩, mem_univ _, ?_⟩
    apply mem_map.mpr
    refine ⟨p, ?_, rfl⟩
    apply mem_filter.mpr
    refine ⟨?_, (SimpleGraph.Walk.cons_isPath_iff h p).mp hpath⟩
    rw [SimpleGraph.mem_finsetWalkLength_iff]
    simpa using hlen

/-- One neighbor is unavailable after arriving from `prev`. -/
theorem next_neighbors_card_le (H : SimpleGraph V)
    (hd : ∀ v, Fintype.card (H.neighborSet v) ≤ 4) (x prev : V)
    (hprev : H.Adj x prev) :
    (univ.filter (fun z : H.neighborSet x => z.val ≠ prev)).card ≤ 3 := by
  have heq : univ.filter (fun z : H.neighborSet x => z.val ≠ prev) =
      (univ : Finset (H.neighborSet x)).erase ⟨prev,hprev⟩ := by
    ext z
    simp only [mem_filter, mem_univ, true_and, mem_erase, and_true]
    exact not_congr (show (z.val = prev) ↔ z = ⟨prev,hprev⟩ from
      ⟨fun h => Subtype.ext h, fun h => congrArg Subtype.val h⟩)
  rw [heq, card_erase_of_mem (mem_univ _), card_univ]
  have := hd x
  omega

/-- Number of continuations after an incoming edge, summed over all endpoints. -/
theorem avoidingPaths_count_le (H : SimpleGraph V)
    (hd : ∀ v, Fintype.card (H.neighborSet v) ≤ 4) (n : ℕ) (x prev : V)
    (hprev : H.Adj x prev) :
    ∑ y : V, (avoidingPaths H prev n x y).card ≤ 3^n := by
  induction n generalizing x prev with
  | zero =>
    calc
      _ ≤ ∑ y : V, (H.finsetWalkLength 0 x y).card := by
        exact sum_le_sum (fun y _ => card_filter_le _ _)
      _ ≤ 3^0 := by simpa using total_walk_count_le H 4 hd 0 x
  | succ n ih =>
    let Z := univ.filter (fun z : H.neighborSet x => z.val ≠ prev)
    calc
      _ ≤ ∑ y : V, ∑ z ∈ Z, (avoidingPaths H x n z y).card := by
        apply sum_le_sum
        intro y _
        apply (card_le_card (avoidingPaths_step_subset H prev n x y)).trans
        exact card_biUnion_le |>.trans_eq (by simp only [card_map, Z])
      _ = ∑ z ∈ Z, ∑ y : V, (avoidingPaths H x n z y).card := sum_comm
      _ ≤ ∑ z ∈ Z, 3^n := by
        apply sum_le_sum
        intro z hz
        exact ih z x z.property.symm
      _ ≤ 3^(n+1) := by
        simp only [sum_const, smul_eq_mul, pow_succ]
        have hc : Z.card ≤ 3 := next_neighbors_card_le H hd x prev hprev
        exact (Nat.mul_le_mul_right _ hc).trans_eq (Nat.mul_comm _ _)

/-- At most four first steps and three choices at each later step. -/
theorem simplePaths_count_le (H : SimpleGraph V)
    (hd : ∀ v, Fintype.card (H.neighborSet v) ≤ 4) (n : ℕ) (x : V) :
    ∑ y : V, ((H.finsetWalkLength (n+1) x y).filter SimpleGraph.Walk.IsPath).card ≤
      4*3^n := by
  calc
    _ ≤ ∑ y : V, ∑ z : H.neighborSet x, (avoidingPaths H x n z y).card := by
      apply sum_le_sum
      intro y _
      apply (card_le_card (simplePaths_step_subset H n x y)).trans
      exact card_biUnion_le |>.trans_eq (by simp only [card_map])
    _ = ∑ z : H.neighborSet x, ∑ y : V, (avoidingPaths H x n z y).card := sum_comm
    _ ≤ ∑ z : H.neighborSet x, 3^n := by
      exact sum_le_sum (fun z _ => avoidingPaths_count_le H hd n z x z.property.symm)
    _ ≤ 4*3^n := by
      simp only [sum_const, card_univ, smul_eq_mul]
      exact Nat.mul_le_mul_right _ (hd x)

/-- Refined finite witness count on graphs of maximum degree four. -/
theorem pathWitnesses_card_le_nonbacktracking (edge : E → V × V)
    (hd : ∀ v, Fintype.card ((fullGraph edge).neighborSet v) ≤ 4)
    (n : ℕ) (x : V) :
    (pathWitnesses edge (n+1) x).card ≤ 4*3^n := by
  apply (card_biUnion_le).trans
  apply le_trans (sum_le_sum (fun y _ => card_image_le))
  exact simplePaths_count_le (fullGraph edge) hd n x

/-- Version indexed by a positive path length. -/
theorem pathWitnesses_card_le_nonbacktracking_pos (edge : E → V × V)
    (hd : ∀ v, Fintype.card ((fullGraph edge).neighborSet v) ≤ 4)
    (n : ℕ) (hn : 0 < n) (x : V) :
    (pathWitnesses edge n x).card ≤ 4*3^(n-1) := by
  obtain ⟨m,rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : n ≠ 0)
  simpa using pathWitnesses_card_le_nonbacktracking edge hd m x

end
end RP3.HighTemperature
end StandalonePart80

/- ===== RP3/HighTemperatureExponential.lean ===== -/
section StandalonePart81

/-! Genuine, unconditional exponential decay for bounded signed couplings
at `β < log (3/2)`, with the same finite-volume constants in free local limits.
The proof is the positive active-edge expansion and simple-path prefix counting.
No two-dimensional percolation theorem or stochastic-domination axiom is used. -/

namespace RP3.HighTemperature
noncomputable section
open Finset
open scoped BigOperators Classical

variable {V E : Type*} [Fintype V] [Fintype E] [DecidableEq V] [DecidableEq E]

/-- Prefix counting avoids a geometric-series loss in the prefactor. -/
theorem abs_correlation_le_nonbacktracking_pow (edge : E → V × V)
    (hi : Function.Injective (fun e => s((edge e).1, (edge e).2)))
    (hd : ∀ v, Fintype.card ((fullGraph edge).neighborSet v) ≤ 4)
    (b : E → ℝ) (β : ℝ) (hβ : 0 ≤ β) (hb : ∀ e, |b e| ≤ β)
    (n : ℕ) (x y : V)
    (hlen : ∀ p : (fullGraph edge).Walk x y, n ≤ p.length) :
    |correlation edge b x y| ≤ (1 : ℝ) * (3 * (1 - Real.exp (-β))) ^ n := by
  cases n with
  | zero =>
    simpa only [pow_zero, mul_one] using
      (abs_correlation_le edge b x y).trans (by norm_num : (3 : ℝ) / 4 ≤ 1)
  | succ n =>
    let p := 1 - Real.exp (-β)
    have hp : 0 ≤ p := sub_nonneg.mpr (Real.exp_le_one_iff.mpr (by linarith))
    have hsum : (∑ S ∈ pathWitnesses edge (n+1) x, p ^ S.card) =
        (pathWitnesses edge (n+1) x).card * p ^ (n+1) := by
      rw [sum_congr rfl (fun S hS => by rw [card_mem_pathWitnesses edge hi (n+1) x S hS])]
      simp
    have hcard : ((pathWitnesses edge (n+1) x).card : ℝ) ≤ 4 * (3 : ℝ) ^ n := by
      exact_mod_cast pathWitnesses_card_le_nonbacktracking edge hd n x
    have hc := abs_correlation_le_witness_sum edge b β hβ hb x y
      (pathWitnesses edge (n+1) x) (connected_has_pathWitness edge hi (n+1) x y hlen)
    change |correlation edge b x y| ≤ (3 : ℝ) / 4 *
      (∑ S ∈ pathWitnesses edge (n+1) x, p ^ S.card) at hc
    rw [hsum] at hc
    apply hc.trans
    change (3 : ℝ) / 4 * ((pathWitnesses edge (n+1) x).card * p ^ (n+1)) ≤
      (1 : ℝ) * (3 * p) ^ (n+1)
    calc
      _ ≤ (3 : ℝ) / 4 * ((4 * (3 : ℝ) ^ n) * p ^ (n+1)) := by
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right hcard (pow_nonneg hp _)) (by norm_num)
      _ = _ := by rw [mul_pow, pow_succ (3 : ℝ)]; ring

end
end RP3.HighTemperature

namespace RP3
noncomputable section
open MeasureTheory Finset
open scoped BigOperators Classical

/-- The elementary nonbacktracking estimate holds even outside its decay regime. -/
theorem nonbacktracking_quadrupolar_bound_signed (β : ℝ) (hβ : 0 ≤ β)
    (G : Fourier.LatticeGraph) (b : G.edges → ℝ) (hb : ∀ e, |b e| ≤ β)
    (x y : G.vertices) :
    |correlation (fun e : G.edges => e.val) b x y| ≤ (1 : ℝ) *
      (3 * (1 - Real.exp (-β))) ^ (Fourier.siteRadius x.val y.val).toNat := by
  apply HighTemperature.abs_correlation_le_nonbacktracking_pow
    (HighTemperature.Lattice.edge G) (HighTemperature.Lattice.edgeSym_injective G)
    (HighTemperature.Lattice.degree_le_four G) b β hβ hb
    (Fourier.siteRadius x.val y.val).toNat x y
  intro p
  exact Int.toNat_le.mpr (HighTemperature.Lattice.radius_le_walk_length G p)

/-- A positive, explicit mass and a uniform exponential bound for the actual
signed RP³ model. The harmless floor in the mass includes β=0. -/
theorem elementary_exponential_quadrupolar_decay_signed (β : ℝ) (hβ : 0 ≤ β)
    (hhigh : β < Real.log ((3 : ℝ) / 2)) :
    0 < HighTemperature.elementaryMass β ∧
      ∀ (G : Fourier.LatticeGraph) (b : G.edges → ℝ),
      (∀ e, |b e| ≤ β) → ∀ (x y : G.vertices),
      |correlation (fun e : G.edges => e.val) b x y| ≤
        (1 : ℝ) * Real.exp (-HighTemperature.elementaryMass β *
          (Fourier.siteRadius x.val y.val : ℝ)) := by
  refine ⟨HighTemperature.elementaryMass_pos β hhigh, ?_⟩
  intro G b hb x y
  have hp : 0 ≤ 3 * (1 - Real.exp (-β)) := by
    have h := Real.exp_le_one_iff.mpr (show -β ≤ 0 by linarith)
    positivity
  have hr : ((Fourier.siteRadius x.val y.val).toNat : ℝ) =
      (Fourier.siteRadius x.val y.val : ℝ) := by
    exact_mod_cast Int.toNat_of_nonneg (Fourier.siteRadius_nonneg x.val y.val)
  apply (nonbacktracking_quadrupolar_bound_signed β hβ G b hb x y).trans
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  calc
    _ ≤ HighTemperature.elementaryDecayBase β ^ (Fourier.siteRadius x.val y.val).toNat :=
      pow_le_pow_left₀ hp (le_max_right _ _) _
    _ = _ := by rw [HighTemperature.elementaryDecayBase_pow, hr]

/-- Ferromagnetic specialization of the elementary exponential theorem. -/
theorem elementary_exponential_quadrupolar_decay (β : ℝ) (hβ : 0 ≤ β)
    (hhigh : β < Real.log ((3 : ℝ) / 2)) :
    0 < HighTemperature.elementaryMass β ∧
      ∀ (G : Fourier.LatticeGraph) (b : G.edges → ℝ),
      (∀ e, 0 ≤ b e ∧ b e ≤ β) → ∀ (x y : G.vertices),
      |correlation (fun e : G.edges => e.val) b x y| ≤
        (1 : ℝ) * Real.exp (-HighTemperature.elementaryMass β *
          (Fourier.siteRadius x.val y.val : ℝ)) := by
  obtain ⟨hm, hbound⟩ := elementary_exponential_quadrupolar_decay_signed β hβ hhigh
  refine ⟨hm, fun G b hb => hbound G b ?_⟩
  intro e
  rw [abs_of_nonneg (hb e).1]
  exact (hb e).2

/-- The direct prefix bound passes to every stated signed free-boundary local limit. -/
theorem nonbacktracking_quadrupolar_bound_local_limit_signed (β : ℝ) (hβ : 0 ≤ β)
    (μ : ProbabilityMeasure InfiniteConfiguration) (hμ : IsSignedFreeBoundaryLocalLimit β μ)
    (x y : Fourier.Site) :
    |infiniteCorrelation μ x y| ≤ (1 : ℝ) *
      (3 * (1 - Real.exp (-β))) ^ (Fourier.siteRadius x y).toNat := by
  obtain ⟨G,b,hb,hlocal⟩ := hμ
  exact hlocal.correlation_bound (fun _ _ => True)
    (fun x y => (1 : ℝ) * (3 * (1 - Real.exp (-β))) ^ (Fourier.siteRadius x y).toNat)
    (fun n u v _ => nonbacktracking_quadrupolar_bound_signed β hβ (G n) (b n) (hb n) u v)
    x y trivial

/-- The exponential mass is unchanged in every signed free-boundary local limit. -/
theorem elementary_exponential_quadrupolar_decay_local_limit_signed
    (β : ℝ) (hβ : 0 ≤ β) (hhigh : β < Real.log ((3 : ℝ) / 2)) :
    0 < HighTemperature.elementaryMass β ∧
      ∀ μ : ProbabilityMeasure InfiniteConfiguration,
      IsSignedFreeBoundaryLocalLimit β μ → ∀ x y : Fourier.Site,
      |infiniteCorrelation μ x y| ≤ (1 : ℝ) *
        Real.exp (-HighTemperature.elementaryMass β * (Fourier.siteRadius x y : ℝ)) := by
  obtain ⟨hm,hbound⟩ := elementary_exponential_quadrupolar_decay_signed β hβ hhigh
  refine ⟨hm, ?_⟩
  intro μ hμ x y
  obtain ⟨G,b,hb,hlocal⟩ := hμ
  exact hlocal.correlation_bound (fun _ _ => True)
    (fun x y => (1 : ℝ) * Real.exp (-HighTemperature.elementaryMass β *
      (Fourier.siteRadius x y : ℝ)))
    (fun n u v _ => hbound (G n) (b n) (hb n) u v) x y trivial

/-- Ferromagnetic local limits obey the same elementary exponential bound. -/
theorem elementary_exponential_quadrupolar_decay_local_limit
    (β : ℝ) (hβ : 0 ≤ β) (hhigh : β < Real.log ((3 : ℝ) / 2)) :
    0 < HighTemperature.elementaryMass β ∧
      ∀ μ : ProbabilityMeasure InfiniteConfiguration,
      IsFreeBoundaryLocalLimit β μ → ∀ x y : Fourier.Site,
      |infiniteCorrelation μ x y| ≤ (1 : ℝ) *
        Real.exp (-HighTemperature.elementaryMass β * (Fourier.siteRadius x y : ℝ)) := by
  obtain ⟨hm,hbound⟩ := elementary_exponential_quadrupolar_decay_local_limit_signed β hβ hhigh
  exact ⟨hm, fun μ hμ => hbound μ hμ.signed⟩

end
end RP3
end StandalonePart81
