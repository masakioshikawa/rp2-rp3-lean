/-! Module: RP3.Fourier.KernelDefs -/

namespace RP3.Fourier
noncomputable section
universe uI uE
open scoped BigOperators ComplexConjugate
variable {I : Type uI} {E : Type uE} [Fintype I] [Fintype E]

def familyKernel (u : I → E → ℂ) (e l : E) : ℂ := ∑ i, u i e * conj (u i l)

def rowSquare (u : I → E → ℂ) (e : E) : ℝ := ∑ l, ‖familyKernel u e l‖^2

def familyHSSquare (u : I → E → ℂ) : ℝ := ∑ e, rowSquare u e

omit [Fintype E] in
@[simp] theorem familyKernel_conj (u : I → E → ℂ) (e l : E) :
    familyKernel (fun i e => conj (u i e)) e l = conj (familyKernel u e l) := by
  simp [familyKernel]

theorem rowSquare_nonneg (u : I → E → ℂ) (e : E) : 0 ≤ rowSquare u e :=
  Finset.sum_nonneg fun _ _ => sq_nonneg _

theorem familyHSSquare_nonneg (u : I → E → ℂ) : 0 ≤ familyHSSquare u :=
  Finset.sum_nonneg fun e _ => rowSquare_nonneg u e

theorem kernel_diag_sq_le_row (u : I → E → ℂ) (e : E) :
    ‖familyKernel u e e‖^2 ≤ rowSquare u e :=
  Finset.single_le_sum (fun l _ => sq_nonneg ‖familyKernel u e l‖) (Finset.mem_univ e)

theorem kernel_diag_norm_le_sqrt (u : I → E → ℂ) (e : E) :
    ‖familyKernel u e e‖ ≤ Real.sqrt (rowSquare u e) :=
  Real.le_sqrt_of_sq_le (kernel_diag_sq_le_row u e)


end
end RP3.Fourier

/-! Module: RP3.Fourier.Geometry -/

namespace RP3.Fourier

abbrev Site := ℤ × ℤ

def PositiveNeighbor (x y : Site) : Prop :=
  (y.1 = x.1 + 1 ∧ y.2 = x.2) ∨ (y.1 = x.1 ∧ y.2 = x.2 + 1)

structure LatticeGraph where
  vertices : Finset Site
  edges : Finset (vertices × vertices)
  nearest : ∀ e ∈ edges, PositiveNeighbor e.1.val e.2.val

noncomputable def siteDistance (x y : Site) : ℝ :=
  Real.sqrt (((x.1 : ℝ) - (y.1 : ℝ)) ^ 2 + ((x.2 : ℝ) - (y.2 : ℝ)) ^ 2)


end RP3.Fourier

/-! Module: RP3.Fourier.TorusFourier -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

universe uP

noncomputable section
open scoped BigOperators ComplexConjugate

namespace Fourier

abbrev DiscreteTorus (L : ℕ) := ZMod L × ZMod L

def torusWave {L : ℕ} [NeZero L] (p x : DiscreteTorus L) : ℂ :=
  ZMod.stdAddChar (p.1*x.1+p.2*x.2)

variable {L : ℕ} [NeZero L]

@[simp] theorem torusWave_norm (p x : DiscreteTorus L) : ‖torusWave p x‖ = 1 :=
  AddChar.norm_apply _ _

@[simp] theorem torusWave_add (p x y : DiscreteTorus L) :
    torusWave p (x+y) = torusWave p x * torusWave p y := by
  unfold torusWave
  rw [← AddChar.map_add_eq_mul]
  congr 1
  simp only [Prod.fst_add, Prod.snd_add]
  ring

@[simp] theorem torusWave_zero (p : DiscreteTorus L) : torusWave p 0 = 1 := by
  simp [torusWave]

@[simp] theorem torusWave_conj (p x : DiscreteTorus L) :
    conj (torusWave p x) = torusWave (-p) x := by
  unfold torusWave
  rw [← AddChar.map_neg_eq_conj]
  congr 1
  simp only [Prod.fst_neg, Prod.snd_neg]
  ring

theorem torusWave_mul_conj (p q x : DiscreteTorus L) :
    torusWave p x*conj (torusWave q x) = torusWave (p-q) x := by
  rw [torusWave_conj]
  unfold torusWave
  rw [← AddChar.map_add_eq_mul]
  congr 1
  simp only [Prod.fst_sub, Prod.snd_sub, Prod.fst_neg, Prod.snd_neg]
  ring

theorem sum_stdAddChar_mul (t : ZMod L) :
    (∑ i : ZMod L, ZMod.stdAddChar (t*i)) = if t=0 then (L:ℂ) else 0 := by
  classical
  split_ifs with h
  · simp [h]
  · exact AddChar.sum_eq_zero_of_ne_one (ZMod.isPrimitive_stdAddChar L h)

theorem sum_torusWave (p : DiscreteTorus L) :
    (∑ x : DiscreteTorus L, torusWave p x) = if p=0 then (L:ℂ)^2 else 0 := by
  classical
  simp only [torusWave, Fintype.sum_prod_type, AddChar.map_add_eq_mul]
  rw [← Finset.sum_mul_sum, sum_stdAddChar_mul, sum_stdAddChar_mul]
  by_cases h1 : p.1=0 <;> by_cases h2 : p.2=0 <;>
    simp [h1, h2, Prod.ext_iff, pow_two]

theorem torusWave_orthogonal (p q : DiscreteTorus L) :
    (∑ x : DiscreteTorus L, torusWave p x*conj (torusWave q x)) =
      if p=q then ((L:ℝ)^2 : ℂ) else 0 := by
  simp only [torusWave_mul_conj, sum_torusWave, sub_eq_zero,
    Complex.ofReal_natCast]

theorem torusWave_orthogonal_subfamily {P : Type uP} [DecidableEq P]
    (p : P → DiscreteTorus L) (hp : Function.Injective p) (i j : P) :
    (∑ x : DiscreteTorus L, torusWave (p i) x*conj (torusWave (p j) x)) =
      if i=j then ((L:ℝ)^2 : ℂ) else 0 := by
  simp only [torusWave_orthogonal, hp.eq_iff]

theorem torusWave_intCast (p x : ℤ × ℤ) :
    torusWave (L := L) ((p.1:ZMod L),(p.2:ZMod L)) ((x.1:ZMod L),(x.2:ZMod L)) =
      Complex.exp (Complex.I * ((2*Real.pi*((p.1:ℝ)*(x.1:ℝ)+(p.2:ℝ)*(x.2:ℝ))/(L:ℝ)):ℂ)) := by
  unfold torusWave
  simp only [← Int.cast_mul, ← Int.cast_add]
  rw [ZMod.stdAddChar_coe]
  congr 1
  push_cast
  ring

theorem norm_stdAddChar_intCast_sub_one (p : ℤ) :
    ‖ZMod.stdAddChar (p : ZMod L)-1‖ ≤ (2*Real.pi/(L:ℝ))*|(p:ℝ)| := by
  rw [ZMod.stdAddChar_coe]
  have he : (2*Real.pi*Complex.I*(p:ℂ)/(L:ℂ)) =
      Complex.I*((2*Real.pi/(L:ℝ)*(p:ℝ):ℝ):ℂ) := by push_cast; ring
  rw [he]
  refine (Real.norm_exp_I_mul_ofReal_sub_one_le (x := 2*Real.pi/(L:ℝ)*(p:ℝ))).trans ?_
  rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg]
  positivity

theorem torus_mode_difference (φ : DiscreteTorus L → ℂ) (p x h : DiscreteTorus L) :
    φ (x+h)*torusWave p (x+h)-φ x*torusWave p x =
      (φ (x+h)-φ x)*torusWave p x +
        φ (x+h)*torusWave p x*(torusWave p h-1) := by
  rw [torusWave_add]
  ring

end Fourier

end

end RP3

/-! Module: RP3.Fourier.DyadicFourier -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open scoped BigOperators ComplexConjugate
namespace Fourier

abbrev DyadicFreq (k : ℕ) := Σ j : Fin k, Fin (2^j.val) × Fin (2*2^j.val+1)

def dyadicRadius {k : ℕ} (p : DyadicFreq k) : ℕ := 2^p.1.val

def dyadicPoint {k : ℕ} (p : DyadicFreq k) : ℤ × ℤ :=
  ((dyadicRadius p : ℤ)+p.2.1.val, (p.2.2.val:ℤ)-dyadicRadius p)

theorem dyadicRadius_pos {k : ℕ} (p : DyadicFreq k) : 0 < dyadicRadius p := by
  unfold dyadicRadius
  positivity

theorem dyadicRadius_le {k : ℕ} (p : DyadicFreq k) : dyadicRadius p ≤ 2^k := by
  exact Nat.pow_le_pow_right (by decide) p.1.isLt.le

theorem dyadicPoint_bounds {k : ℕ} (p : DyadicFreq k) :
    (dyadicRadius p:ℤ) ≤ (dyadicPoint p).1 ∧ (dyadicPoint p).1 < 2*dyadicRadius p ∧
      -(dyadicRadius p:ℤ) ≤ (dyadicPoint p).2 ∧ (dyadicPoint p).2 ≤ dyadicRadius p := by
  have h1 := p.2.1.isLt
  have h2 := p.2.2.isLt
  simp only [dyadicPoint, dyadicRadius]
  omega

theorem dyadicPoint_injective {k : ℕ} : Function.Injective (dyadicPoint (k := k)) := by
  intro p q he
  have hf := congrArg Prod.fst he
  have hs := congrArg Prod.snd he
  have hp := dyadicPoint_bounds p
  have hq := dyadicPoint_bounds q
  have hj : p.1 = q.1 := by
    apply Fin.ext
    by_contra h
    rcases lt_or_gt_of_ne h with hlt | hgt
    · have hr : 2*dyadicRadius p ≤ dyadicRadius q := by
        have hh := Nat.pow_le_pow_right (n := 2) (by decide : 1 ≤ 2) (Nat.succ_le_of_lt hlt)
        simpa only [dyadicRadius, pow_succ, Nat.mul_comm] using hh
      have hr' : (2*dyadicRadius p:ℤ) ≤ dyadicRadius q := by exact_mod_cast hr
      omega
    · have hr : 2*dyadicRadius q ≤ dyadicRadius p := by
        have hh := Nat.pow_le_pow_right (n := 2) (by decide : 1 ≤ 2) (Nat.succ_le_of_lt hgt)
        simpa only [dyadicRadius, pow_succ, Nat.mul_comm] using hh
      have hr' : (2*dyadicRadius q:ℤ) ≤ dyadicRadius p := by exact_mod_cast hr
      omega
  rcases p with ⟨j,a,b⟩
  rcases q with ⟨j',a',b'⟩
  dsimp only at hj
  subst j'
  have ha : a = a' := by apply Fin.ext; simp only [dyadicPoint, dyadicRadius] at hf; omega
  have hb : b = b' := by apply Fin.ext; simp only [dyadicPoint, dyadicRadius] at hs; omega
  subst a'; subst b'; rfl

theorem zmod_cast_inj_interval (L : ℕ) (c a b : ℤ)
    (ha : c ≤ a ∧ a < c+L) (hb : c ≤ b ∧ b < c+L)
    (he : (a:ZMod L) = (b:ZMod L)) : a=b := by
  have hh : ((a-c:ℤ):ZMod L) = ((b-c:ℤ):ZMod L) := by simpa only [Int.cast_sub] using congrArg (fun z : ZMod L => z-(c:ZMod L)) he
  have ha' : a-c ∈ Set.Ico (0:ℤ) L := by constructor <;> omega
  have hb' : b-c ∈ Set.Ico (0:ℤ) L := by constructor <;> omega
  have hz := CharP.intCast_injOn_Ico (R := ZMod L) L ha' hb' hh
  omega

def dyadicTorusPoint {k : ℕ} (p : DyadicFreq k) : DiscreteTorus (16*2^k) :=
  (((dyadicPoint p).1:ZMod (16*2^k)), ((dyadicPoint p).2:ZMod (16*2^k)))

theorem dyadicTorusPoint_injective {k : ℕ} : Function.Injective (dyadicTorusPoint (k := k)) := by
  intro p q he
  apply dyadicPoint_injective
  apply Prod.ext
  · apply zmod_cast_inj_interval (16*2^k) 0 _ _
    · have hp := dyadicPoint_bounds p; have hr := dyadicRadius_le p; have hn : 0 < 2^k := by positivity
      constructor <;> omega
    · have hq := dyadicPoint_bounds q; have hr := dyadicRadius_le q; have hn : 0 < 2^k := by positivity
      constructor <;> omega
    · exact congrArg Prod.fst he
  · apply zmod_cast_inj_interval (16*2^k) (-(2^k:ℕ):ℤ) _ _
    · have hp := dyadicPoint_bounds p; have hr := dyadicRadius_le p; have hn : 0 < 2^k := by positivity
      constructor <;> omega
    · have hq := dyadicPoint_bounds q; have hr := dyadicRadius_le q; have hn : 0 < 2^k := by positivity
      constructor <;> omega
    · exact congrArg Prod.snd he

theorem dyadic_shell_card_bounds (j : ℕ) :
    2*(2^j)^2 ≤ Fintype.card (Fin (2^j) × Fin (2*2^j+1)) ∧
      Fintype.card (Fin (2^j) × Fin (2*2^j+1)) ≤ 3*(2^j)^2 := by
  simp only [Fintype.card_prod, Fintype.card_fin]
  have h : 1 ≤ 2^j := Nat.one_le_iff_ne_zero.mpr (pow_ne_zero _ (by decide))
  constructor <;> nlinarith

end Fourier

end

end RP3

/-! Module: RP3.Fourier.SmoothProfiles -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open Set Function
open scoped Topology ContDiff

namespace Fourier

def thetaBump : ContDiffBump (0 : ℝ) := ⟨4/3, 5/3, by norm_num, by norm_num⟩
def outerBump : ContDiffBump (0 : ℝ) := ⟨7/4, 15/8, by norm_num, by norm_num⟩
def innerBump : ContDiffBump (0 : ℝ) := ⟨9/8, 5/4, by norm_num, by norm_num⟩

def squareTheta (z : ℝ × ℝ) : ℝ := thetaBump z.1 * thetaBump z.2

def squareCutoff (z : ℝ × ℝ) : ℝ :=
  outerBump z.1 * outerBump z.2 * (1-innerBump z.1*innerBump z.2)

def squareGradient (m : Bool) (z : ℝ × ℝ) : ℝ :=
  if m then thetaBump z.1 * deriv thetaBump z.2 else deriv thetaBump z.1 * thetaBump z.2

def squareProfile (m sign : Bool) (z : ℝ × ℝ) : ℝ :=
  if sign then (squareCutoff z-squareGradient m z)/2 else
    (squareCutoff z+squareGradient m z)/2

theorem thetaBump_one {x : ℝ} (hx : |x| ≤ 4/3) : thetaBump x = 1 := by
  apply thetaBump.one_of_mem_closedBall
  simpa [Metric.mem_closedBall, Real.dist_eq, thetaBump] using hx

theorem thetaBump_zero {x : ℝ} (hx : 5/3 ≤ |x|) : thetaBump x = 0 := by
  apply thetaBump.zero_of_le_dist
  simpa [Real.dist_eq, thetaBump] using hx

theorem thetaBump_deriv_zero_inner {x : ℝ} (hx : |x| ≤ 4/3) : deriv thetaBump x = 0 := by
  apply IsLocalMax.deriv_eq_zero
  apply Filter.Eventually.of_forall
  intro y
  rw [thetaBump_one hx]
  exact thetaBump.le_one

theorem thetaBump_deriv_zero_outer {x : ℝ} (hx : 5/3 ≤ |x|) : deriv thetaBump x = 0 := by
  apply IsLocalMin.deriv_eq_zero
  apply Filter.Eventually.of_forall
  intro y
  rw [thetaBump_zero hx]
  exact thetaBump.nonneg

theorem outerBump_one {x : ℝ} (hx : |x| ≤ 7/4) : outerBump x = 1 := by
  apply outerBump.one_of_mem_closedBall
  simpa [Metric.mem_closedBall, Real.dist_eq, outerBump] using hx

theorem outerBump_zero {x : ℝ} (hx : 15/8 ≤ |x|) : outerBump x = 0 := by
  apply outerBump.zero_of_le_dist
  simpa [Real.dist_eq, outerBump] using hx

theorem innerBump_one {x : ℝ} (hx : |x| ≤ 9/8) : innerBump x = 1 := by
  apply innerBump.one_of_mem_closedBall
  simpa [Metric.mem_closedBall, Real.dist_eq, innerBump] using hx

theorem innerBump_zero {x : ℝ} (hx : 5/4 ≤ |x|) : innerBump x = 0 := by
  apply innerBump.zero_of_le_dist
  simpa [Real.dist_eq, innerBump] using hx

theorem squareTheta_one (z : ℝ × ℝ) (hx : |z.1| ≤ 1) (hy : |z.2| ≤ 1) :
    squareTheta z = 1 := by
  rw [squareTheta, thetaBump_one (by linarith), thetaBump_one (by linarith), mul_one]

theorem squareTheta_zero (z : ℝ × ℝ) (h : 2 ≤ |z.1| ∨ 2 ≤ |z.2|) :
    squareTheta z = 0 := by
  rcases h with hx | hy
  · simp [squareTheta, thetaBump_zero (by linarith : 5/3 ≤ |z.1|)]
  · simp [squareTheta, thetaBump_zero (by linarith : 5/3 ≤ |z.2|)]

theorem squareCutoff_gradient (m : Bool) (z : ℝ × ℝ) :
    squareCutoff z * squareGradient m z = squareGradient m z := by
  cases m
  · simp only [squareGradient, Bool.false_eq_true, ↓reduceIte]
    by_cases hg : deriv thetaBump z.1 = 0
    · simp [hg]
    by_cases ht : thetaBump z.2 = 0
    · simp [ht]
    have hx : 4/3 < |z.1| ∧ |z.1| < 5/3 := by
      constructor
      · exact lt_of_not_ge (fun h => hg (thetaBump_deriv_zero_inner h))
      · exact lt_of_not_ge (fun h => hg (thetaBump_deriv_zero_outer h))
    have hy : |z.2| < 5/3 := lt_of_not_ge (fun h => ht (thetaBump_zero h))
    simp [squareCutoff, outerBump_one (by linarith : |z.1| ≤ 7/4),
      outerBump_one (by linarith : |z.2| ≤ 7/4), innerBump_zero (by linarith : 5/4 ≤ |z.1|)]
  · simp only [squareGradient, ↓reduceIte]
    by_cases hg : deriv thetaBump z.2 = 0
    · simp [hg]
    by_cases ht : thetaBump z.1 = 0
    · simp [ht]
    have hy : 4/3 < |z.2| ∧ |z.2| < 5/3 := by
      constructor
      · exact lt_of_not_ge (fun h => hg (thetaBump_deriv_zero_inner h))
      · exact lt_of_not_ge (fun h => hg (thetaBump_deriv_zero_outer h))
    have hx : |z.1| < 5/3 := lt_of_not_ge (fun h => ht (thetaBump_zero h))
    simp [squareCutoff, outerBump_one (by linarith : |z.1| ≤ 7/4),
      outerBump_one (by linarith : |z.2| ≤ 7/4), innerBump_zero (by linarith : 5/4 ≤ |z.2|)]

theorem squareProfile_squares (m : Bool) (z : ℝ × ℝ) :
    squareProfile m false z ^ 2 - squareProfile m true z ^ 2 = squareGradient m z := by
  simp only [squareProfile, Bool.false_eq_true, ↓reduceIte]
  have h := squareCutoff_gradient m z
  nlinarith

theorem squareProfile_zero_inner (m s : Bool) (z : ℝ × ℝ)
    (hx : |z.1| ≤ 1) (hy : |z.2| ≤ 1) : squareProfile m s z = 0 := by
  have hc : squareCutoff z = 0 := by
    simp [squareCutoff, innerBump_one (by linarith : |z.1| ≤ 9/8),
      innerBump_one (by linarith : |z.2| ≤ 9/8)]
  have hg : squareGradient m z = 0 := by
    cases m <;> simp [squareGradient,
      thetaBump_deriv_zero_inner (by linarith : |z.1| ≤ 4/3),
      thetaBump_deriv_zero_inner (by linarith : |z.2| ≤ 4/3)]
  cases s <;> simp [squareProfile, hc, hg]

theorem squareProfile_zero_outer (m s : Bool) (z : ℝ × ℝ)
    (h : 2 ≤ |z.1| ∨ 2 ≤ |z.2|) : squareProfile m s z = 0 := by
  have hc : squareCutoff z = 0 := by
    rcases h with hx | hy
    · simp [squareCutoff, outerBump_zero (by linarith : 15/8 ≤ |z.1|)]
    · simp [squareCutoff, outerBump_zero (by linarith : 15/8 ≤ |z.2|)]
  have hg : squareGradient m z = 0 := by
    rcases h with hx | hy
    · cases m <;> simp [squareGradient,
        thetaBump_zero (by linarith : 5/3 ≤ |z.1|),
        thetaBump_deriv_zero_outer (by linarith : 5/3 ≤ |z.1|)]
    · cases m <;> simp [squareGradient,
        thetaBump_zero (by linarith : 5/3 ≤ |z.2|),
        thetaBump_deriv_zero_outer (by linarith : 5/3 ≤ |z.2|)]
  cases s <;> simp [squareProfile, hc, hg]

theorem squareTheta_contDiff : ContDiff ℝ ∞ squareTheta := by
  exact (thetaBump.contDiff.comp contDiff_fst).mul (thetaBump.contDiff.comp contDiff_snd)

theorem squareCutoff_contDiff : ContDiff ℝ ∞ squareCutoff := by
  apply ((outerBump.contDiff.comp contDiff_fst).mul (outerBump.contDiff.comp contDiff_snd)).mul
  exact contDiff_const.sub ((innerBump.contDiff.comp contDiff_fst).mul (innerBump.contDiff.comp contDiff_snd))

theorem squareGradient_contDiff (m : Bool) : ContDiff ℝ ∞ (squareGradient m) := by
  have hd : ContDiff ℝ ∞ (deriv thetaBump) := (contDiff_infty_iff_deriv.mp (thetaBump.contDiff : ContDiff ℝ ∞ thetaBump)).2
  cases m
  · exact (hd.comp contDiff_fst).mul (thetaBump.contDiff.comp contDiff_snd)
  · exact (thetaBump.contDiff.comp contDiff_fst).mul (hd.comp contDiff_snd)

theorem squareProfile_contDiff (m s : Bool) : ContDiff ℝ ∞ (squareProfile m s) := by
  cases s
  · exact (squareCutoff_contDiff.add (squareGradient_contDiff m)).div_const 2
  · exact (squareCutoff_contDiff.sub (squareGradient_contDiff m)).div_const 2

theorem squareProfile_compact (m s : Bool) : HasCompactSupport (squareProfile m s) := by
  apply HasCompactSupport.intro (isCompact_Icc.prod isCompact_Icc :
    IsCompact (Icc (-2:ℝ) 2 ×ˢ Icc (-2:ℝ) 2))
  intro z hz
  apply squareProfile_zero_outer
  by_contra h
  push Not at h
  apply hz
  constructor <;> constructor <;> nlinarith [abs_le.mp h.1.le, abs_le.mp h.2.le]

end Fourier

end

end RP3

/-! Module: RP3.Fourier.SmoothBounds -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

universe uE uF

noncomputable section
open Set Function
open scoped ContDiff
namespace Fourier

variable {E : Type uE} {F : Type uF} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

omit [NormedSpace ℝ E] [NormedSpace ℝ F] in
theorem compact_continuous_norm_bound {f : E → F} (hc : HasCompactSupport f) (hf : Continuous f) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x, ‖f x‖ ≤ C := by
  obtain ⟨C,hC⟩ := (hc.isCompact_range hf).isBounded.exists_norm_le
  exact ⟨max C 0, le_max_right _ _, fun x => (hC _ ⟨x,rfl⟩).trans (le_max_left _ _)⟩

theorem smooth_compact_lipschitz_bound {f : E → F}
    (hc : HasCompactSupport f) (hf : ContDiff ℝ ∞ f) :
    ∃ C : ℝ, 0 ≤ C ∧ (∀ x, ‖f x‖ ≤ C) ∧
      (∀ x y, ‖f y-f x‖ ≤ C*‖y-x‖) := by
  obtain ⟨A,hA,hfA⟩ := compact_continuous_norm_bound hc hf.continuous
  obtain ⟨B,hB,hfB⟩ := compact_continuous_norm_bound (hc.fderiv ℝ)
    (hf.fderiv_right (m := ∞) (by simp)).continuous
  refine ⟨A+B, add_nonneg hA hB, fun x => (hfA x).trans (le_add_of_nonneg_right hB), ?_⟩
  intro x y
  calc ‖f y-f x‖ ≤ B*‖y-x‖ :=
        Convex.norm_image_sub_le_of_norm_fderiv_le (fun z _ => hf.differentiable (by simp) z)
          (fun z _ => hfB z) convex_univ (mem_univ x) (mem_univ y)
       _ ≤ (A+B)*‖y-x‖ := by gcongr; exact le_add_of_nonneg_left hA

theorem scalar_lipschitz_of_deriv_bound (f f' : ℝ → ℝ) (C : ℝ)
    (hf : ∀ x, HasDerivAt f (f' x) x) (hC : ∀ x, |f' x| ≤ C) (x y : ℝ) :
    |f y-f x| ≤ C*|y-x| := by
  exact Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
    (fun z _ => (hf z).hasDerivWithinAt) (fun z _ => hC z) convex_univ
      (mem_univ x) (mem_univ y)

theorem abs_sub_left_le_of_uIcc {x y z : ℝ} (hz : z ∈ uIcc x y) :
    |z-x| ≤ |y-x| := by
  rcases le_total x y with h | h
  · rw [uIcc_of_le h] at hz
    rw [abs_of_nonneg (sub_nonneg.mpr hz.1), abs_of_nonneg (sub_nonneg.mpr h)]
    linarith [hz.2]
  · rw [uIcc_of_ge h] at hz
    rw [abs_of_nonpos (sub_nonpos.mpr hz.2), abs_of_nonpos (sub_nonpos.mpr h)]
    linarith [hz.1]

theorem first_remainder_bound (f f' : ℝ → ℝ) (C : ℝ) (hC : 0 ≤ C)
    (hf : ∀ x, HasDerivAt f (f' x) x)
    (hL : ∀ x y, |f' y-f' x| ≤ C*|y-x|) (x y : ℝ) :
    |f y-f x-f' x*(y-x)| ≤ C*|y-x|^2 := by
  let g := fun z => f z-f' x*z
  have hg (z : ℝ) : HasDerivAt g (f' z-f' x) z := by
    convert (hf z).sub ((hasDerivAt_id z).const_mul (f' x)) using 1 <;> first | rfl | ring
  have hb (z : ℝ) (hz : z ∈ uIcc x y) : |f' z-f' x| ≤ C*|y-x| :=
    (hL x z).trans (mul_le_mul_of_nonneg_left (abs_sub_left_le_of_uIcc hz) hC)
  have H := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
    (fun z (_ : z ∈ uIcc x y) => (hg z).hasDerivWithinAt)
    (fun z hz => hb z hz) (convex_uIcc x y) (left_mem_uIcc) (right_mem_uIcc)
  change |g y-g x| ≤ _ at H
  convert H using 1
  · congr 1; ring
  · rw [Real.norm_eq_abs]; ring

theorem second_remainder_bound (f f' f'' : ℝ → ℝ) (C : ℝ) (hC : 0 ≤ C)
    (hf : ∀ x, HasDerivAt f (f' x) x) (hf' : ∀ x, HasDerivAt f' (f'' x) x)
    (hL : ∀ x y, |f'' y-f'' x| ≤ C*|y-x|) (x y : ℝ) :
    |f y-f x-f' x*(y-x)-f'' x/2*(y-x)^2| ≤ C*|y-x|^3 := by
  let g := fun z => f z-f' x*(z-x)-f'' x/2*(z-x)^2
  have hg (z : ℝ) : HasDerivAt g (f' z-f' x-f'' x*(z-x)) z := by
    have ht : HasDerivAt (fun t : ℝ => t-x) 1 z := (hasDerivAt_id z).sub_const x
    have hq := ((hf z).sub (ht.const_mul (f' x))).sub ((ht.pow 2).const_mul (f'' x/2))
    convert hq using 1; first | rfl | ring
  have hb (z : ℝ) (hz : z ∈ uIcc x y) : |f' z-f' x-f'' x*(z-x)| ≤ C*|y-x|^2 := by
    exact (first_remainder_bound f' f'' C hC hf' hL x z).trans
      (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (abs_nonneg _) (abs_sub_left_le_of_uIcc hz) 2) hC)
  have H := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
    (fun z (_ : z ∈ uIcc x y) => (hg z).hasDerivWithinAt)
    (fun z hz => hb z hz) (convex_uIcc x y) (left_mem_uIcc) (right_mem_uIcc)
  change |g y-g x| ≤ _ at H
  convert H using 1
  · congr 1; ring
  · rw [Real.norm_eq_abs]; ring

theorem trapezoid_error_bound (f f' f'' : ℝ → ℝ) (C : ℝ) (hC : 0 ≤ C)
    (hf : ∀ x, HasDerivAt f (f' x) x) (hf' : ∀ x, HasDerivAt f' (f'' x) x)
    (hL : ∀ x y, |f'' y-f'' x| ≤ C*|y-x|) (x y : ℝ) :
    |f y-f x-(y-x)/2*(f' x+f' y)| ≤ 2*C*|y-x|^3 := by
  have h1 := second_remainder_bound f f' f'' C hC hf hf' hL x y
  have h2 := first_remainder_bound f' f'' C hC hf' hL x y
  have he : f y-f x-(y-x)/2*(f' x+f' y) =
      (f y-f x-f' x*(y-x)-f'' x/2*(y-x)^2) -
        (y-x)/2*(f' y-f' x-f'' x*(y-x)) := by ring
  rw [he]
  calc _ ≤ |f y-f x-f' x*(y-x)-f'' x/2*(y-x)^2| +
        |(y-x)/2*(f' y-f' x-f'' x*(y-x))| := abs_sub _ _
       _ ≤ C*|y-x|^3+|y-x|/2*(C*|y-x|^2) := by
          rw [abs_mul, abs_div, abs_of_pos (by norm_num : (0:ℝ)<2)]
          gcongr
       _ ≤ _ := by nlinarith [mul_nonneg hC (pow_nonneg (abs_nonneg (y-x)) 3)]

end Fourier

end

end RP3

/-! Module: RP3.Fourier.ProfileEstimates -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open Set Function
open scoped ContDiff BigOperators
namespace Fourier

def squareStep (m : Bool) (ε : ℝ) (z : ℝ × ℝ) : ℝ × ℝ :=
  if m then (z.1,z.2+ε) else (z.1+ε,z.2)

@[simp] theorem squareStep_distance (m : Bool) (ε : ℝ) (z : ℝ × ℝ) :
    ‖squareStep m ε z-z‖ = |ε| := by
  cases m <;> simp [squareStep, Prod.norm_def, Real.norm_eq_abs, abs_nonneg]

theorem profiles_uniform_bound : ∃ C : ℝ, 1 ≤ C ∧
    (∀ m s z, |squareProfile m s z| ≤ C) ∧
    (∀ m s z w, |squareProfile m s w-squareProfile m s z| ≤ C*‖w-z‖) := by
  have he (m s : Bool) := smooth_compact_lipschitz_bound
    (squareProfile_compact m s) (squareProfile_contDiff m s)
  choose C hC hval hLip using he
  let M : ℝ := 1+∑ m, ∑ s, C m s
  have hsum : 0 ≤ ∑ m : Bool, ∑ s : Bool, C m s :=
    Finset.sum_nonneg fun m _ => Finset.sum_nonneg fun s _ => hC m s
  have hCM (m s : Bool) : C m s ≤ M := by
    have hs := Finset.single_le_sum (fun t _ => hC m t) (Finset.mem_univ s)
    have hm : (∑ t : Bool, C m t) ≤ ∑ u : Bool, ∑ t : Bool, C u t := Finset.single_le_sum (fun t _ => Finset.sum_nonneg fun t' _ => hC t t') (Finset.mem_univ m)
    dsimp only [M]
    linarith
  refine ⟨M, by dsimp only [M]; linarith, fun m s z => (hval m s z).trans (hCM m s), ?_⟩
  intro m s z w
  exact (hLip m s z w).trans (mul_le_mul_of_nonneg_right (hCM m s) (norm_nonneg _))

theorem theta_trapezoid_bound : ∃ C : ℝ, 0 ≤ C ∧ ∀ x y : ℝ,
    |thetaBump y-thetaBump x-(y-x)/2*(deriv thetaBump x+deriv thetaBump y)| ≤
      C*|y-x|^3 := by
  have hd : ContDiff ℝ ∞ (deriv thetaBump) :=
    (contDiff_infty_iff_deriv.mp (thetaBump.contDiff : ContDiff ℝ ∞ thetaBump)).2
  have hdd : ContDiff ℝ ∞ (deriv (deriv thetaBump)) := (contDiff_infty_iff_deriv.mp hd).2
  obtain ⟨C,hC,_hval,hL⟩ := smooth_compact_lipschitz_bound
    (thetaBump.hasCompactSupport.deriv.deriv) hdd
  refine ⟨2*C, by positivity, fun x y => ?_⟩
  exact trapezoid_error_bound thetaBump (deriv thetaBump) (deriv (deriv thetaBump)) C hC
    (fun t => ((thetaBump.contDiff : ContDiff ℝ ∞ thetaBump).differentiable (by simp) t).hasDerivAt)
    (fun t => (hd.differentiable (by simp) t).hasDerivAt) hL x y

theorem squareCutoff_near_gradient (m : Bool) (z w : ℝ × ℝ)
    (h1 : |w.1-z.1| ≤ 1/16) (h2 : |w.2-z.2| ≤ 1/16)
    (hg : squareGradient m z ≠ 0) : squareCutoff w = 1 := by
  have ha1 : |w.1| ≤ |w.1-z.1|+|z.1| := by simpa only [sub_add_cancel] using (abs_add_le (w.1-z.1) z.1)
  have ha2 : |w.2| ≤ |w.2-z.2|+|z.2| := by simpa only [sub_add_cancel] using (abs_add_le (w.2-z.2) z.2)
  have hb1 : |z.1| ≤ |w.1-z.1|+|w.1| := by
    simpa only [sub_add_cancel, abs_sub_comm] using (abs_add_le (z.1-w.1) w.1)
  have hb2 : |z.2| ≤ |w.2-z.2|+|w.2| := by
    simpa only [sub_add_cancel, abs_sub_comm] using (abs_add_le (z.2-w.2) w.2)
  cases m
  · have hd : deriv thetaBump z.1 ≠ 0 := by intro h; apply hg; simp [squareGradient, h]
    have ht : thetaBump z.2 ≠ 0 := by intro h; apply hg; simp [squareGradient, h]
    have hx : 4/3 < |z.1| ∧ |z.1| < 5/3 := ⟨
      lt_of_not_ge (fun h => hd (thetaBump_deriv_zero_inner h)),
      lt_of_not_ge (fun h => hd (thetaBump_deriv_zero_outer h))⟩
    have hy : |z.2| < 5/3 := lt_of_not_ge (fun h => ht (thetaBump_zero h))
    simp [squareCutoff, outerBump_one (by linarith : |w.1| ≤ 7/4),
      outerBump_one (by linarith : |w.2| ≤ 7/4), innerBump_zero (by linarith : 5/4 ≤ |w.1|)]
  · have hd : deriv thetaBump z.2 ≠ 0 := by intro h; apply hg; simp [squareGradient, h]
    have ht : thetaBump z.1 ≠ 0 := by intro h; apply hg; simp [squareGradient, h]
    have hy : 4/3 < |z.2| ∧ |z.2| < 5/3 := ⟨
      lt_of_not_ge (fun h => hd (thetaBump_deriv_zero_inner h)),
      lt_of_not_ge (fun h => hd (thetaBump_deriv_zero_outer h))⟩
    have hx : |z.1| < 5/3 := lt_of_not_ge (fun h => ht (thetaBump_zero h))
    simp [squareCutoff, outerBump_one (by linarith : |w.1| ≤ 7/4),
      outerBump_one (by linarith : |w.2| ≤ 7/4), innerBump_zero (by linarith : 5/4 ≤ |w.2|)]

theorem squareProfile_product_difference (m : Bool) (z w : ℝ × ℝ)
    (h1 : |w.1-z.1| ≤ 1/16) (h2 : |w.2-z.2| ≤ 1/16) :
    squareProfile m false z*squareProfile m false w-
      squareProfile m true z*squareProfile m true w =
      (squareGradient m z+squareGradient m w)/2 := by
  have hzw : squareGradient m z*squareCutoff w = squareGradient m z := by
    by_cases hg : squareGradient m z=0
    · simp [hg]
    · rw [squareCutoff_near_gradient m z w h1 h2 hg, mul_one]
  have hwz : squareCutoff z*squareGradient m w = squareGradient m w := by
    by_cases hg : squareGradient m w=0
    · simp [hg]
    · rw [squareCutoff_near_gradient m w z (by simpa only [abs_sub_comm] using h1)
        (by simpa only [abs_sub_comm] using h2) hg, one_mul]
  simp only [squareProfile, Bool.false_eq_true, ↓reduceIte]
  nlinarith

theorem squareTheta_step_error : ∃ C : ℝ, 0 ≤ C ∧ ∀ (m : Bool) (z : ℝ × ℝ) (ε : ℝ),
    |ε| ≤ 1/16 →
    |squareTheta (squareStep m ε z)-squareTheta z-
      ε*(squareProfile m false z*squareProfile m false (squareStep m ε z)-
           squareProfile m true z*squareProfile m true (squareStep m ε z))| ≤ C*|ε|^3 := by
  obtain ⟨C,hC,hT⟩ := theta_trapezoid_bound
  refine ⟨C,hC,?_⟩
  intro m z ε hε
  have hp := squareProfile_product_difference m z (squareStep m ε z)
    (by cases m
        · simpa only [squareStep, Bool.false_eq_true, ↓reduceIte, add_sub_cancel_left] using hε
        · simp [squareStep])
    (by cases m
        · simp [squareStep]
        · simpa only [squareStep, ↓reduceIte, add_sub_cancel_left] using hε)
  rw [hp]
  have hb (x : ℝ) : |thetaBump x| ≤ 1 := by rw [abs_of_nonneg thetaBump.nonneg]; exact thetaBump.le_one
  cases m
  · have h := hT z.1 (z.1+ε)
    simp only [add_sub_cancel_left] at h
    have he : squareTheta (squareStep false ε z)-squareTheta z-
        ε*((squareGradient false z+squareGradient false (squareStep false ε z))/2) =
        thetaBump z.2*(thetaBump (z.1+ε)-thetaBump z.1-ε/2*(deriv thetaBump z.1+deriv thetaBump (z.1+ε))) := by
      simp only [squareTheta, squareStep, squareGradient, Bool.false_eq_true, ↓reduceIte]
      ring
    rw [he, abs_mul]
    calc _ ≤ 1*(C*|ε|^3) := mul_le_mul (hb z.2) h (abs_nonneg _) (by norm_num)
         _ = _ := one_mul _
  · have h := hT z.2 (z.2+ε)
    simp only [add_sub_cancel_left] at h
    have he : squareTheta (squareStep true ε z)-squareTheta z-
        ε*((squareGradient true z+squareGradient true (squareStep true ε z))/2) =
        thetaBump z.1*(thetaBump (z.2+ε)-thetaBump z.2-ε/2*(deriv thetaBump z.2+deriv thetaBump (z.2+ε))) := by
      simp only [squareTheta, squareStep, squareGradient, ↓reduceIte]
      ring
    rw [he, abs_mul]
    calc _ ≤ 1*(C*|ε|^3) := mul_le_mul (hb z.1) h (abs_nonneg _) (by norm_num)
         _ = _ := one_mul _

end Fourier

end

end RP3

/-! Module: RP3.Fourier.DyadicSine -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open scoped BigOperators
namespace Fourier

def dyadicAngle (k : ℕ) (t : ℝ) : ℝ := 2*Real.pi*t/(16*(2:ℝ)^k)

def dyadicLambda (k : ℕ) : ℝ :=
  (2:ℝ)^k * ∑ p : DyadicFreq k,
    (1/(dyadicRadius p:ℝ))^3 * Real.sin (dyadicAngle k (dyadicPoint p).1)

@[simp] theorem dyadicAngle_neg (k : ℕ) (t : ℝ) : dyadicAngle k (-t) = -dyadicAngle k t := by
  unfold dyadicAngle; ring

theorem dyadic_sin_lower (k : ℕ) (t : ℝ) (ht : 0 ≤ t) (hN : t ≤ (2:ℝ)^k) :
    t/(4*(2:ℝ)^k) ≤ Real.sin (dyadicAngle k t) := by
  have hpow : (0:ℝ) < 2^k := by positivity
  have ha : 0 ≤ dyadicAngle k t := by unfold dyadicAngle; positivity
  have hb : dyadicAngle k t ≤ Real.pi/2 := by
    unfold dyadicAngle
    rw [div_le_iff₀ (by positivity : (0:ℝ)<16*2^k)]
    nlinarith [Real.pi_pos, mul_le_mul_of_nonneg_left hN Real.pi_pos.le]
  have h := Real.mul_le_sin ha hb
  convert h using 1
  unfold dyadicAngle
  field_simp
  ring

theorem dyadicPoint_fst_le_N {k : ℕ} (p : DyadicFreq k) :
    ((dyadicPoint p).1:ℝ) ≤ (2:ℝ)^k := by
  have hr : 2*dyadicRadius p ≤ 2^k := by
    have hh := Nat.pow_le_pow_right (n := 2) (by decide : 1 ≤ 2) p.1.isLt
    simpa only [dyadicRadius, pow_succ, Nat.mul_comm] using hh
  have hp := (dyadicPoint_bounds p).2.1
  have hz : (dyadicPoint p).1 ≤ (2^k:ℕ) := by omega
  exact_mod_cast hz

theorem dyadicLambda_lower (k : ℕ) : (k:ℝ)/2 ≤ dyadicLambda k := by
  have hN : (0:ℝ)<2^k := by positivity
  have hp (p : DyadicFreq k) :
      (1/(dyadicRadius p:ℝ))^2/4 ≤
        (2:ℝ)^k*((1/(dyadicRadius p:ℝ))^3*Real.sin (dyadicAngle k (dyadicPoint p).1)) := by
    have hr : (0:ℝ)<dyadicRadius p := by exact_mod_cast dyadicRadius_pos p
    have hpr : (dyadicRadius p:ℝ) ≤ ((dyadicPoint p).1:ℝ) := by exact_mod_cast (dyadicPoint_bounds p).1
    have hs := dyadic_sin_lower k ((dyadicPoint p).1:ℝ) (by linarith) (dyadicPoint_fst_le_N p)
    calc _ = (2:ℝ)^k*((1/(dyadicRadius p:ℝ))^3*((dyadicRadius p:ℝ)/(4*(2:ℝ)^k))) := by field_simp
         _ ≤ _ := by gcongr; exact (div_le_div_of_nonneg_right hpr (by positivity)).trans hs
  unfold dyadicLambda
  rw [Finset.mul_sum]
  calc _ ≤ ∑ p : DyadicFreq k, (1/(dyadicRadius p:ℝ))^2/4 := by
          rw [Fintype.sum_sigma]
          calc _ = ∑ _j : Fin k, (1/2:ℝ) := by simp; ring
               _ ≤ _ := by
                 apply Finset.sum_le_sum
                 intro j _
                 simp only [dyadicRadius, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
                 have hr : (0:ℝ)<(2^j.val:ℕ) := by positivity
                 have hc : 2*((2^j.val:ℕ):ℝ)^2 ≤ (Fintype.card (Fin (2^j.val) × Fin (2*2^j.val+1)):ℝ) := by
                   exact_mod_cast (dyadic_shell_card_bounds j.val).1
                 calc (1/2:ℝ) = (2*((2^j.val:ℕ):ℝ)^2)*((1/((2^j.val:ℕ):ℝ))^2/4) := by field_simp; norm_num
                      _ ≤ _ := mul_le_mul_of_nonneg_right hc (by positivity)
       _ ≤ _ := Finset.sum_le_sum fun p _ => hp p

def dyadicReflect {k : ℕ} (p : DyadicFreq k) : DyadicFreq k :=
  ⟨p.1, p.2.1, p.2.2.rev⟩

@[simp] theorem dyadicReflect_radius {k : ℕ} (p : DyadicFreq k) :
    dyadicRadius (dyadicReflect p) = dyadicRadius p := rfl

@[simp] theorem dyadicReflect_point {k : ℕ} (p : DyadicFreq k) :
    (dyadicPoint (dyadicReflect p)).2 = -(dyadicPoint p).2 := by
  simp only [dyadicPoint, dyadicReflect, dyadicRadius, Fin.val_rev]
  have h := p.2.2.isLt
  omega

@[simp] theorem dyadicReflect_involution {k : ℕ} (p : DyadicFreq k) :
    dyadicReflect (dyadicReflect p) = p := by
  simp [dyadicReflect]

theorem dyadic_sin_cancel (k : ℕ) :
    (∑ p : DyadicFreq k, (1/(dyadicRadius p:ℝ))^3 *
      Real.sin (dyadicAngle k (dyadicPoint p).2)) = 0 := by
  let e : DyadicFreq k ≃ DyadicFreq k := ⟨dyadicReflect, dyadicReflect, dyadicReflect_involution, dyadicReflect_involution⟩
  have he := Equiv.sum_comp e
    (fun p : DyadicFreq k => (1/(dyadicRadius p:ℝ))^3 * Real.sin (dyadicAngle k (dyadicPoint p).2))
  change (∑ p : DyadicFreq k, (1/(dyadicRadius (dyadicReflect p):ℝ))^3 * Real.sin (dyadicAngle k (dyadicPoint (dyadicReflect p)).2)) = _ at he
  simp only [dyadicReflect_radius, dyadicReflect_point,
    Int.cast_neg, dyadicAngle_neg, Real.sin_neg, mul_neg, Finset.sum_neg_distrib] at he
  linarith

end Fourier

end

end RP3

/-! Module: RP3.Fourier.LatticeGeometry -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open scoped BigOperators
namespace Fourier

def latticeAxis (m : Bool) : Site := if m then (0,1) else (1,0)

def latticeTorus (L : ℕ) (x : Site) : DiscreteTorus L := ((x.1:ZMod L),(x.2:ZMod L))

@[simp] theorem latticeTorus_add (L : ℕ) (x y : Site) :
    latticeTorus L (x+y) = latticeTorus L x+latticeTorus L y := by
  ext <;> simp [latticeTorus]

def scaledSite (k : ℕ) (x : Site) : ℝ × ℝ :=
  ((x.1:ℝ)/(2:ℝ)^k, (x.2:ℝ)/(2:ℝ)^k)

@[simp] theorem scaledSite_add_axis (k : ℕ) (x : Site) (m : Bool) :
    scaledSite k (x+latticeAxis m) = squareStep m (1/(2:ℝ)^k) (scaledSite k x) := by
  cases m <;> ext <;> simp [scaledSite, latticeAxis, squareStep, add_div]

namespace LatticeGraph

def edgeDirection (G : LatticeGraph) (e : G.edges) : Bool :=
  decide (e.val.2.val.1 = e.val.1.val.1)

theorem edge_step (G : LatticeGraph) (e : G.edges) :
    e.val.2.val = e.val.1.val+latticeAxis (G.edgeDirection e) := by
  rcases G.nearest e.val e.property with h | h
  · have hn : e.val.2.val.1 ≠ e.val.1.val.1 := by omega
    simp only [edgeDirection, decide_eq_false hn, latticeAxis, Bool.false_eq_true, ↓reduceIte]
    exact Prod.ext h.1 (by simpa using h.2)
  · simp only [edgeDirection, h.1, decide_true, latticeAxis, ↓reduceIte]
    exact Prod.ext (by simpa using h.1) h.2

abbrev DirectionalEdges (G : LatticeGraph) (m : Bool) := {e : G.edges // G.edgeDirection e=m}

theorem directional_origin_injective (G : LatticeGraph) (m : Bool) :
    Function.Injective (fun e : G.DirectionalEdges m => e.val.val.1) := by
  intro e f h
  change e.val.val.1 = f.val.val.1 at h
  have he := G.edge_step e.val
  have hf := G.edge_step f.val
  rw [e.property] at he
  rw [f.property] at hf
  have hy : e.val.val.2 = f.val.val.2 := by
    apply Subtype.ext
    rw [he, hf, h]
  apply Subtype.ext
  apply Subtype.ext
  exact Prod.ext h hy

def WithinDyadicBox (G : LatticeGraph) (k : ℕ) : Prop :=
  ∀ x : G.vertices, |x.val.1| ≤ 2*(2^k:ℕ) ∧ |x.val.2| ≤ 2*(2^k:ℕ)

theorem torus_site_injective (G : LatticeGraph) (k : ℕ) (hG : G.WithinDyadicBox k) :
    Function.Injective (fun x : G.vertices => latticeTorus (16*2^k) x.val) := by
  intro x y h
  apply Subtype.ext
  apply Prod.ext
  · apply zmod_cast_inj_interval (16*2^k) (-(2*(2^k:ℕ)):ℤ) _ _
    · have hx := abs_le.mp (hG x).1; have hN : 0<2^k := by positivity
      constructor <;> omega
    · have hy := abs_le.mp (hG y).1; have hN : 0<2^k := by positivity
      constructor <;> omega
    · exact congrArg Prod.fst h
  · apply zmod_cast_inj_interval (16*2^k) (-(2*(2^k:ℕ)):ℤ) _ _
    · have hx := abs_le.mp (hG x).2; have hN : 0<2^k := by positivity
      constructor <;> omega
    · have hy := abs_le.mp (hG y).2; have hN : 0<2^k := by positivity
      constructor <;> omega
    · exact congrArg Prod.snd h

theorem directional_torus_injective (G : LatticeGraph) (k : ℕ) (hG : G.WithinDyadicBox k) (m : Bool) :
    Function.Injective (fun e : G.DirectionalEdges m => latticeTorus (16*2^k) e.val.val.1.val) :=
  (G.torus_site_injective k hG).comp (G.directional_origin_injective m)

theorem edge_card_bound (G : LatticeGraph) (k : ℕ) (hG : G.WithinDyadicBox k) :
    (Fintype.card G.edges:ℝ) ≤ 512*((2:ℝ)^k)^2 := by
  let i := fun e : G.edges => (G.edgeDirection e, latticeTorus (16*2^k) e.val.1.val)
  have hi : Function.Injective i := by
    intro e f h
    have hm : G.edgeDirection e = G.edgeDirection f := congrArg Prod.fst h
    have hx := (G.torus_site_injective k hG) (congrArg Prod.snd h)
    have he := G.edge_step e
    have hf := G.edge_step f
    have hy : e.val.2 = f.val.2 := by
      apply Subtype.ext
      rw [he,hf,hm,hx]
    apply Subtype.ext
    exact Prod.ext hx hy
  have hc := Fintype.card_le_of_injective i hi
  simp only [Fintype.card_prod, Fintype.card_bool, ZMod.card] at hc
  have hh : (Fintype.card G.edges:ℝ) ≤ 2*((16*(2:ℝ)^k)*(16*(2:ℝ)^k)) := by exact_mod_cast hc
  nlinarith

theorem scaled_edge_distance (G : LatticeGraph) (k : ℕ) (e : G.edges) :
    ‖scaledSite k e.val.2.val-scaledSite k e.val.1.val‖ = 1/(2:ℝ)^k := by
  rw [G.edge_step e, scaledSite_add_axis, squareStep_distance, abs_of_pos (by positivity)]

end LatticeGraph
end Fourier

end

end RP3

/-! Module: RP3.Fourier.DyadicModes -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open scoped BigOperators ComplexConjugate
namespace Fourier

variable {k : ℕ}

def groupedPoint (m s : Bool) (p : DyadicFreq k) : ℤ × ℤ :=
  let q := if m then (dyadicPoint p).swap else dyadicPoint p
  if s then -q else q

def groupedTorusPoint (m s : Bool) (p : DyadicFreq k) : DiscreteTorus (16*2^k) :=
  (((groupedPoint m s p).1:ZMod (16*2^k)), ((groupedPoint m s p).2:ZMod (16*2^k)))

instance dyadicModulus_neZero (k : ℕ) : NeZero (16*2^k) := ⟨by positivity⟩

theorem groupedTorusPoint_injective (m s : Bool) :
    Function.Injective (groupedTorusPoint (k := k) m s) := by
  have hs := dyadicTorusPoint_injective (k := k)
  cases m <;> cases s <;> intro p q h <;> apply hs
  · exact h
  · simpa [groupedTorusPoint, groupedPoint, dyadicTorusPoint, Prod.ext_iff] using h
  · exact Prod.ext (congrArg Prod.snd h) (congrArg Prod.fst h)
  · have h' : (dyadicTorusPoint p).swap = (dyadicTorusPoint q).swap := by
      simpa [groupedTorusPoint, groupedPoint, dyadicTorusPoint, Prod.ext_iff] using h
    exact Prod.swap_injective h'

def dyadicWeight (p : DyadicFreq k) : ℝ :=
  1/((dyadicRadius p:ℝ)*Real.sqrt (dyadicRadius p:ℝ))

theorem dyadicWeight_pos (p : DyadicFreq k) : 0 < dyadicWeight p := by
  have h : (0:ℝ)<dyadicRadius p := by exact_mod_cast dyadicRadius_pos p
  unfold dyadicWeight
  positivity

@[simp] theorem dyadicWeight_sq (p : DyadicFreq k) :
    dyadicWeight p^2 = (1/(dyadicRadius p:ℝ))^3 := by
  have hr : (0:ℝ)<dyadicRadius p := by exact_mod_cast dyadicRadius_pos p
  unfold dyadicWeight
  rw [div_pow, mul_pow, Real.sq_sqrt hr.le]
  field_simp

@[simp] theorem dyadicWeight_mul_sqrt (p : DyadicFreq k) :
    dyadicWeight p*Real.sqrt (dyadicRadius p:ℝ) = 1/(dyadicRadius p:ℝ) := by
  have hr : (0:ℝ)<dyadicRadius p := by exact_mod_cast dyadicRadius_pos p
  have hs : Real.sqrt (dyadicRadius p:ℝ) ≠ 0 := (Real.sqrt_pos.mpr hr).ne'
  unfold dyadicWeight
  field_simp

theorem wave_commutator (a b c θ : ℝ) (w : ℂ) (hw : ‖w‖=1) :
    ((a*b:ℝ):ℂ)*w * conj (((a*c:ℝ):ℂ)*w*Complex.exp (Complex.I*(θ:ℂ))) / 2 -
      conj (((a*b:ℝ):ℂ)*w) * (((a*c:ℝ):ℂ)*w*Complex.exp (Complex.I*(θ:ℂ))) / 2 =
        -Complex.I * ((a^2*b*c*Real.sin θ:ℝ):ℂ) := by
  have hww : w*conj w=1 := by rw [Complex.mul_conj, Complex.normSq_eq_norm_sq, hw]; norm_num
  rw [mul_comm Complex.I (θ:ℂ), Complex.exp_ofReal_mul_I]
  simp only [map_mul, map_add, Complex.conj_ofReal, Complex.conj_I]
  push_cast
  linear_combination -Complex.I*(a:ℂ)^2*(b:ℂ)*(c:ℂ)*(Complex.sin (θ:ℂ)) * hww

end Fourier

end

end RP3

/-! Module: RP3.Fourier.MatrixSquare -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

universe uP uX

noncomputable section
open scoped BigOperators ComplexConjugate

namespace Fourier

def SquareBound {X : Type uX} {P : Type uP} [Fintype X] [Fintype P]
    (U : X → P → ℂ) (a : ℝ) : Prop :=
  ∀ v : P → ℂ, (∑ x, ‖∑ p, U x p*v p‖^2) ≤ a^2*∑ p, ‖v p‖^2

variable {X : Type uX} {P : Type uP} [Fintype X] [Fintype P]

theorem SquareBound.column {U : X → P → ℂ} {a : ℝ} (h : SquareBound U a) (p : P) :
    ∑ x, ‖U x p‖^2 ≤ a^2 := by
  classical
  have hs : (∑ q : P, ‖((Pi.single p (1:ℂ)) : P → ℂ) q‖^2) = 1 := by
    simp only [Pi.single_apply, apply_ite, norm_one, norm_zero, ite_pow, one_pow,
      zero_pow (by decide : 2 ≠ 0), Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  have he := h (Pi.single p 1)
  rw [hs, mul_one] at he
  simpa only [Pi.single_apply, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
    Finset.mem_univ, ite_true] using he

theorem SquareBound.gram_weighted {U : X → P → ℂ} {a : ℝ}
    (h : SquareBound U a) (d : P → ℂ) :
    (∑ x, ∑ y, ‖∑ p, U x p*d p*conj (U y p)‖^2) ≤ a^4*∑ p, ‖d p‖^2 := by
  calc _ = ∑ y, ∑ x, ‖∑ p, U x p*(d p*conj (U y p))‖^2 := by
          simp only [mul_assoc]
          exact Finset.sum_comm
       _ ≤ ∑ y, a^2*∑ p, ‖d p*conj (U y p)‖^2 :=
          Finset.sum_le_sum fun y _ => h (fun p => d p*conj (U y p))
       _ = a^2*∑ p, ‖d p‖^2*(∑ y, ‖U y p‖^2) := by
          simp only [norm_mul, Complex.norm_conj, mul_pow, Finset.mul_sum]
          rw [Finset.sum_comm]
       _ ≤ a^2*∑ p, ‖d p‖^2*a^2 := by
          apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
          exact Finset.sum_le_sum fun p _ => mul_le_mul_of_nonneg_left (h.column p) (sq_nonneg _)
       _ = _ := by rw [← Finset.sum_mul]; ring

theorem sum_norm_add_sq_le (f g : X → ℂ) :
    (∑ x, ‖f x+g x‖^2) ≤ 2*(∑ x, ‖f x‖^2)+2*(∑ x, ‖g x‖^2) := by
  rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro x _
  have hv := norm_add_le (f x) (g x)
  have hsq := sq_le_sq₀ (norm_nonneg _) (add_nonneg (norm_nonneg _) (norm_nonneg _)) |>.mpr hv
  nlinarith [sq_nonneg (‖f x‖-‖g x‖)]

theorem parseval_of_orthogonal [DecidableEq P] (W : X → P → ℂ) (M : ℝ)
    (ho : ∀ p q, (∑ x, W x p*conj (W x q)) = if p=q then (M:ℂ) else 0)
    (v : P → ℂ) :
    (∑ x, ‖∑ p, W x p*v p‖^2) = M*∑ p, ‖v p‖^2 := by
  classical
  have he : (∑ x, (∑ p, W x p*v p)*conj (∑ q, W x q*v q)) =
      (M:ℂ)*∑ p, v p*conj (v p) := by
    simp only [map_sum, map_mul, Finset.sum_mul, Finset.mul_sum]
    calc
      (∑ x, ∑ q, ∑ p, W x p*v p*(conj (W x q)*conj (v q))) =
          ∑ q, ∑ p, ∑ x, W x p*v p*(conj (W x q)*conj (v q)) := by
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl (fun q _ => Finset.sum_comm)
      _ = ∑ p, ∑ q, (∑ x, W x p*conj (W x q))*(v p*conj (v q)) := by
        rw [Finset.sum_comm]
        apply Finset.sum_congr rfl
        intro p _
        apply Finset.sum_congr rfl
        intro q _
        rw [Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro x _
        ring
      _ = _ := by simp [ho]
  have hr := congrArg Complex.re he
  simp only [Complex.mul_conj, Complex.normSq_eq_norm_sq,
    Complex.ofReal_re, ← Complex.ofReal_sum, ← Complex.ofReal_mul] at hr
  exact hr

theorem parseval_diagonal_bound [DecidableEq P] (W : X → P → ℂ) (M c : ℝ) (hM : 0 ≤ M)
    (ho : ∀ p q, (∑ x, W x p*conj (W x q)) = if p=q then (M:ℂ) else 0)
    (d v : P → ℂ) (hd : ∀ p, ‖d p‖ ≤ c) :
    (∑ x, ‖∑ p, W x p*(d p*v p)‖^2) ≤ (M*c^2)*∑ p, ‖v p‖^2 := by
  rw [parseval_of_orthogonal W M ho, mul_assoc]
  apply mul_le_mul_of_nonneg_left _ hM
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro p _
  rw [norm_mul, mul_pow]
  exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) (hd p) 2) (sq_nonneg _)

end Fourier

end

end RP3

/-! Module: RP3.Fourier.FourierOperator -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

universe uP uX uY

noncomputable section
open scoped BigOperators ComplexConjugate
namespace Fourier

variable {X : Type uX} {P : Type uP} {Y : Type uY} [Fintype X] [Fintype P] [Fintype Y]

theorem sum_norm_pointwise_mul_sq_le (d v : X → ℂ) (c : ℝ) (hd : ∀ x, ‖d x‖ ≤ c) :
    (∑ x, ‖d x*v x‖^2) ≤ c^2*∑ x, ‖v x‖^2 := by
  rw [Finset.mul_sum]
  exact Finset.sum_le_sum fun x _ => by
    rw [norm_mul, mul_pow]
    exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) (hd x) 2) (sq_nonneg _)

theorem sum_norm_sq_restrict (i : Y → X) (hi : Function.Injective i) (v : X → ℂ) :
    (∑ y, ‖v (i y)‖^2) ≤ ∑ x, ‖v x‖^2 := by
  classical
  calc _ = ∑ x ∈ Finset.univ.image i, ‖v x‖^2 := (Finset.sum_image (fun a _ b _ h => hi h)).symm
       _ ≤ _ := Finset.sum_le_univ_sum_of_nonneg fun x => sq_nonneg _

theorem modulated_fourier_bound [DecidableEq P] (W : X → P → ℂ) (M C A : ℝ)
    (hM : 0 ≤ M)
    (hW : ∀ p q, (∑ x, W x p*conj (W x q)) = if p=q then (M:ℂ) else 0)
    (d : X → ℂ) (a v : P → ℂ) (hd : ∀ x, ‖d x‖ ≤ C) (ha : ∀ p, ‖a p‖ ≤ A) :
    (∑ x, ‖d x*(∑ p, W x p*(a p*v p))‖^2) ≤ (C^2*M*A^2)*∑ p, ‖v p‖^2 := by
  calc _ ≤ C^2*∑ x, ‖∑ p, W x p*(a p*v p)‖^2 := sum_norm_pointwise_mul_sq_le _ _ C hd
       _ ≤ C^2*((M*A^2)*∑ p, ‖v p‖^2) := mul_le_mul_of_nonneg_left
          (parseval_diagonal_bound W M A hM hW a v ha) (sq_nonneg _)
       _ = _ := by ring

theorem cutoff_fourier_difference_bound {L : ℕ} [NeZero L] [DecidableEq P]
    (p : P → DiscreteTorus L) (hp : Function.Injective p)
    (φ : DiscreteTorus L → ℂ) (h : DiscreteTorus L) (a v : P → ℂ)
    (D C A B : ℝ) (hD : ∀ x, ‖φ (x+h)-φ x‖ ≤ D)
    (hC : ∀ x, ‖φ (x+h)‖ ≤ C) (hA : ∀ q, ‖a q‖ ≤ A)
    (hB : ∀ q, ‖a q*(torusWave (p q) h-1)‖ ≤ B) :
    (∑ x, ‖∑ q, (a q*(φ (x+h)*torusWave (p q) (x+h)-φ x*torusWave (p q) x))*v q‖^2) ≤
      (2*(L:ℝ)^2*(D^2*A^2+C^2*B^2))*∑ q, ‖v q‖^2 := by
  let f := fun x => (φ (x+h)-φ x)*(∑ q, torusWave (p q) x*(a q*v q))
  let g := fun x => φ (x+h)*(∑ q, torusWave (p q) x*((a q*(torusWave (p q) h-1))*v q))
  have he (x : DiscreteTorus L) :
      (∑ q, a q*(φ (x+h)*torusWave (p q) (x+h)-φ x*torusWave (p q) x)*v q) = f x+g x := by
    simp only [f, g, Finset.mul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro q _
    rw [torus_mode_difference]
    ring
  simp_rw [he]
  have hf := modulated_fourier_bound (fun x q => torusWave (p q) x) ((L:ℝ)^2) D A
    (sq_nonneg _) (fun i j => by simpa only [Complex.ofReal_pow] using torusWave_orthogonal_subfamily p hp i j) (fun x => φ (x+h)-φ x) a v hD hA
  have hg := modulated_fourier_bound (fun x q => torusWave (p q) x) ((L:ℝ)^2) C B
    (sq_nonneg _) (fun i j => by simpa only [Complex.ofReal_pow] using torusWave_orthogonal_subfamily p hp i j) (fun x => φ (x+h))
    (fun q => a q*(torusWave (p q) h-1)) v hC hB
  have ht := sum_norm_add_sq_le f g
  dsimp only [f, g] at ht ⊢
  linarith

theorem restricted_cutoff_squareBound {L : ℕ} [NeZero L] [DecidableEq P]
    (p : P → DiscreteTorus L) (hp : Function.Injective p)
    (φ : DiscreteTorus L → ℂ) (h : DiscreteTorus L) (a : P → ℂ)
    (i : Y → DiscreteTorus L) (hi : Function.Injective i)
    (D C A B : ℝ) (hD : ∀ x, ‖φ (x+h)-φ x‖ ≤ D)
    (hC : ∀ x, ‖φ (x+h)‖ ≤ C) (hA : ∀ q, ‖a q‖ ≤ A)
    (hB : ∀ q, ‖a q*(torusWave (p q) h-1)‖ ≤ B) :
    SquareBound (fun y q => a q*(φ (i y+h)*torusWave (p q) (i y+h)-φ (i y)*torusWave (p q) (i y)))
      (Real.sqrt (2*(L:ℝ)^2*(D^2*A^2+C^2*B^2))) := by
  intro v
  rw [Real.sq_sqrt (by positivity)]
  exact (sum_norm_sq_restrict i hi _).trans
    (cutoff_fourier_difference_bound p hp φ h a v D C A B hD hC hA hB)

end Fourier

end

end RP3

/-! Module: RP3.Fourier.EdgeOperators -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

universe uP uX uY

noncomputable section
open scoped BigOperators ComplexConjugate
namespace Fourier

theorem restricted_modulated_fourier_bound {X : Type uX} {P : Type uP} {Y : Type uY}
    [Fintype X] [Fintype P] [Fintype Y] [DecidableEq P]
    (W : X → P → ℂ) (M C A : ℝ) (hM : 0 ≤ M)
    (hW : ∀ p q, (∑ x, W x p*conj (W x q)) = if p=q then (M:ℂ) else 0)
    (i : Y → X) (hi : Function.Injective i) (d : Y → ℂ) (a v : P → ℂ)
    (hd : ∀ y, ‖d y‖ ≤ C) (ha : ∀ p, ‖a p‖ ≤ A) :
    (∑ y, ‖d y*(∑ p, W (i y) p*(a p*v p))‖^2) ≤ (C^2*M*A^2)*∑ p, ‖v p‖^2 := by
  calc _ ≤ C^2*∑ y, ‖∑ p, W (i y) p*(a p*v p)‖^2 := sum_norm_pointwise_mul_sq_le _ _ C hd
       _ ≤ C^2*∑ x, ‖∑ p, W x p*(a p*v p)‖^2 :=
          mul_le_mul_of_nonneg_left (sum_norm_sq_restrict i hi (fun x => ∑ p, W x p*(a p*v p))) (sq_nonneg _)
       _ ≤ C^2*((M*A^2)*∑ p, ‖v p‖^2) := mul_le_mul_of_nonneg_left
          (parseval_diagonal_bound W M A hM hW a v ha) (sq_nonneg _)
       _ = _ := by ring

theorem edge_cutoff_squareBound {P : Type uP} {Y : Type uY} [Fintype P] [Fintype Y] [DecidableEq P]
    {L : ℕ} [NeZero L] (p : P → DiscreteTorus L) (hp : Function.Injective p)
    (i : Y → DiscreteTorus L) (hi : Function.Injective i) (h : DiscreteTorus L)
    (φ₀ φ₁ : Y → ℂ) (a : P → ℂ)
    (D C A B : ℝ) (hD : ∀ y, ‖φ₁ y-φ₀ y‖ ≤ D) (hC : ∀ y, ‖φ₁ y‖ ≤ C)
    (hA : ∀ q, ‖a q‖ ≤ A) (hB : ∀ q, ‖a q*(torusWave (p q) h-1)‖ ≤ B) :
    SquareBound (fun y q => a q*(φ₁ y*torusWave (p q) (i y+h)-φ₀ y*torusWave (p q) (i y)))
      (Real.sqrt (2*(L:ℝ)^2*(D^2*A^2+C^2*B^2))) := by
  intro v
  rw [Real.sq_sqrt (by positivity)]
  let f := fun y => (φ₁ y-φ₀ y)*(∑ q, torusWave (p q) (i y)*(a q*v q))
  let g := fun y => φ₁ y*(∑ q, torusWave (p q) (i y)*((a q*(torusWave (p q) h-1))*v q))
  have he (y : Y) :
      (∑ q, a q*(φ₁ y*torusWave (p q) (i y+h)-φ₀ y*torusWave (p q) (i y))*v q) = f y+g y := by
    simp only [f, g, Finset.mul_sum, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro q _
    rw [torusWave_add]
    ring
  simp_rw [he]
  have hf := restricted_modulated_fourier_bound (fun x q => torusWave (p q) x) ((L:ℝ)^2) D A
    (sq_nonneg _) (fun q r => by simpa only [Complex.ofReal_pow] using torusWave_orthogonal_subfamily p hp q r)
    i hi (fun y => φ₁ y-φ₀ y) a v hD hA
  have hg := restricted_modulated_fourier_bound (fun x q => torusWave (p q) x) ((L:ℝ)^2) C B
    (sq_nonneg _) (fun q r => by simpa only [Complex.ofReal_pow] using torusWave_orthogonal_subfamily p hp q r)
    i hi φ₁ (fun q => a q*(torusWave (p q) h-1)) v hC hB
  have ht := sum_norm_add_sq_le f g
  dsimp only [f, g] at ht ⊢
  linarith

end Fourier

end

end RP3

/-! Module: RP3.Fourier.SquareEstimates -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

universe uI uP uX

noncomputable section
open scoped BigOperators ComplexConjugate
namespace Fourier

variable {X : Type uX} {P : Type uP} {I : Type uI} [Fintype X] [Fintype P] [Fintype I]

theorem norm_sum_sq_le_card (f : I → ℂ) :
    ‖∑ i, f i‖^2 ≤ (Fintype.card I:ℝ)*∑ i, ‖f i‖^2 := by
  calc _ ≤ (∑ i, ‖f i‖)^2 := pow_le_pow_left₀ (norm_nonneg _) (norm_sum_le _ _) 2
       _ ≤ _ := by
          have h := Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul (R := ℝ)
            (s := Finset.univ) (r := fun i => ‖f i‖) (f := fun _ => 1)
            (g := fun i => ‖f i‖^2) (fun _ _ => by norm_num) (fun i _ => sq_nonneg _)
            (fun i _ => le_of_eq (one_mul _).symm)
          simpa using h

theorem SquareBound.mono {U : X → P → ℂ} {a b : ℝ}
    (ha : SquareBound U a) (hab : a^2 ≤ b^2) : SquareBound U b := by
  intro v
  exact (ha v).trans (mul_le_mul_of_nonneg_right hab (Finset.sum_nonneg fun _ _ => sq_nonneg _))

theorem sum_by_fibers [DecidableEq I] (d : X → I) (f : X → ℝ) :
    (∑ x, f x) = ∑ i, ∑ x : {x // d x=i}, f x := by
  classical
  simpa only [Fintype.sum_sigma, Equiv.sigmaFiberEquiv_apply] using
    (Equiv.sum_comp (Equiv.sigmaFiberEquiv d) f).symm

theorem SquareBound.combine_directions (U : X → P → ℂ) (d : X → Bool) (a : ℝ)
    (h : ∀ m : Bool, SquareBound (fun (x : {x // d x=m}) p => U x p) a) :
    SquareBound U (2*a) := by
  intro v
  rw [sum_by_fibers d]
  calc _ ≤ ∑ _m : Bool, a^2*∑ p, ‖v p‖^2 :=
          Finset.sum_le_sum fun m _ => h m v
       _ ≤ (2*a)^2*∑ p, ‖v p‖^2 := by
          simp only [Finset.sum_const, Finset.card_univ, Fintype.card_bool, nsmul_eq_mul, Nat.cast_ofNat]
          have hs : 0 ≤ ∑ p : P, ‖v p‖^2 := Finset.sum_nonneg fun p _ => sq_nonneg ‖v p‖
          nlinarith [mul_nonneg (sq_nonneg a) hs]

theorem gram_groups_bound (T : I → X → X → ℂ) (C : ℝ)
    (h : ∀ i, (∑ x, ∑ y, ‖T i x y‖^2) ≤ C) :
    (∑ x, ∑ y, ‖∑ i, T i x y‖^2) ≤ (Fintype.card I:ℝ)^2*C := by
  calc _ ≤ ∑ x, ∑ y, (Fintype.card I:ℝ)*∑ i, ‖T i x y‖^2 :=
          Finset.sum_le_sum fun x _ => Finset.sum_le_sum fun y _ => norm_sum_sq_le_card _
       _ = (Fintype.card I:ℝ)*∑ i, ∑ x, ∑ y, ‖T i x y‖^2 := by
          simp only [← Finset.mul_sum]
          congr 1
          calc (∑ x, ∑ y, ∑ i, ‖T i x y‖^2) = ∑ x, ∑ i, ∑ y, ‖T i x y‖^2 :=
                Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
               _ = _ := Finset.sum_comm
       _ ≤ (Fintype.card I:ℝ)*∑ _i : I, C := by gcongr with i; exact h i
       _ = _ := by simp; ring

end Fourier

end

end RP3

/-! Module: RP3.Fourier.LatticeModes -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open scoped BigOperators ComplexConjugate
namespace Fourier

variable {k : ℕ}

def latticeMode (m s : Bool) (p : DyadicFreq k) (x : Site) : ℂ :=
  (dyadicWeight p:ℂ) * (squareProfile m s (scaledSite k x):ℂ) *
    torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) x)

theorem groupedPoint_abs_bound (m s : Bool) (p : DyadicFreq k) :
    |(groupedPoint m s p).1| ≤ 2*(dyadicRadius p:ℤ) ∧
    |(groupedPoint m s p).2| ≤ 2*(dyadicRadius p:ℤ) := by
  have hp := dyadicPoint_bounds p
  have hr : (0:ℤ)<dyadicRadius p := by exact_mod_cast dyadicRadius_pos p
  have h1 : |(dyadicPoint p).1| ≤ 2*(dyadicRadius p:ℤ) := abs_le.mpr (by constructor <;> omega)
  have h2 : |(dyadicPoint p).2| ≤ 2*(dyadicRadius p:ℤ) := abs_le.mpr (by constructor <;> omega)
  cases m <;> cases s
  · simpa [groupedPoint] using And.intro h1 h2
  · simpa [groupedPoint] using And.intro h1 h2
  · simpa [groupedPoint] using And.intro h2 h1
  · simpa [groupedPoint] using And.intro h2 h1

theorem groupedWave_axis (m s j : Bool) (p : DyadicFreq k) :
    torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) (latticeAxis j)) =
      ZMod.stdAddChar ((if j then (groupedPoint m s p).2 else (groupedPoint m s p).1):ZMod (16*2^k)) := by
  cases j <;> simp [torusWave, groupedTorusPoint, latticeTorus, latticeAxis]

theorem groupedWave_axis_sine (m s j : Bool) (p : DyadicFreq k) :
    torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) (latticeAxis j)) =
      Complex.exp (Complex.I*((dyadicAngle k ((if j then (groupedPoint m s p).2 else (groupedPoint m s p).1):ℤ):ℝ):ℂ)) := by
  rw [groupedWave_axis]
  cases j <;> simp only [Bool.false_eq_true, ↓reduceIte]
  all_goals
    rw [ZMod.stdAddChar_coe]
    congr 1
    unfold dyadicAngle
    push_cast
    ring

theorem groupedWave_multiplier_bound (m s j : Bool) (p : DyadicFreq k) :
    ‖((1/(dyadicRadius p:ℝ)):ℂ) *
      (torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) (latticeAxis j))-1)‖ ≤
        Real.pi/(4*(2:ℝ)^k) := by
  have hr : (0:ℝ)<dyadicRadius p := by exact_mod_cast dyadicRadius_pos p
  have hp : |((if j then (groupedPoint m s p).2 else (groupedPoint m s p).1):ℤ)| ≤
      2*(dyadicRadius p:ℤ) := by
    cases j
    · exact (groupedPoint_abs_bound m s p).1
    · exact (groupedPoint_abs_bound m s p).2
  have hp' : |(((if j then (groupedPoint m s p).2 else (groupedPoint m s p).1):ℤ):ℝ)| ≤ 2*(dyadicRadius p:ℝ) := by exact_mod_cast hp
  simp only [norm_mul, norm_div, norm_one, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr]
  rw [groupedWave_axis]
  have hchar : ‖ZMod.stdAddChar (if j then ((groupedPoint m s p).2:ZMod (16*2^k)) else ((groupedPoint m s p).1:ZMod (16*2^k)))-1‖ ≤
      (2*Real.pi/(16*2^k:ℕ))*|(((if j then (groupedPoint m s p).2 else (groupedPoint m s p).1):ℤ):ℝ)| := by
    cases j <;> exact norm_stdAddChar_intCast_sub_one (L := 16*2^k) _
  calc _ ≤ (1/(dyadicRadius p:ℝ))*((2*Real.pi/(16*2^k:ℕ))*|(((if j then (groupedPoint m s p).2 else (groupedPoint m s p).1):ℤ):ℝ)|) :=
          mul_le_mul_of_nonneg_left hchar (by positivity)
       _ ≤ (1/(dyadicRadius p:ℝ))*((2*Real.pi/(16*2^k:ℕ))*(2*(dyadicRadius p:ℝ))) := by gcongr
       _ = Real.pi/(4*(2:ℝ)^k) := by push_cast; field_simp [ne_of_gt hr]; ring

theorem latticeMode_norm_bound (m s : Bool) (p : DyadicFreq k) (x : Site) (C : ℝ)
    (hC : |squareProfile m s (scaledSite k x)| ≤ C) : ‖latticeMode m s p x‖ ≤ dyadicWeight p*C := by
  simp only [latticeMode, norm_mul, torusWave_norm, mul_one, Complex.norm_real, Real.norm_eq_abs]
  rw [abs_of_pos (dyadicWeight_pos p)]
  exact mul_le_mul_of_nonneg_left hC (dyadicWeight_pos p).le

namespace LatticeGraph

def modeGradient (G : LatticeGraph) (m s : Bool) (p : DyadicFreq k) (e : G.edges) : ℂ :=
  latticeMode m s p e.val.2.val-latticeMode m s p e.val.1.val

def scaledModeGradient (G : LatticeGraph) (m s : Bool) (p : DyadicFreq k) (e : G.edges) : ℂ :=
  (Real.sqrt (dyadicRadius p:ℝ):ℂ)*G.modeGradient m s p e

theorem scaledModeGradient_formula (G : LatticeGraph) (m s : Bool) (p : DyadicFreq k) (e : G.edges) :
    G.scaledModeGradient m s p e =
      ((1/(dyadicRadius p:ℝ)):ℂ) *
      ((squareProfile m s (scaledSite k e.val.2.val):ℂ)*torusWave (groupedTorusPoint m s p)
        (latticeTorus (16*2^k) e.val.1.val+latticeTorus (16*2^k) (latticeAxis (G.edgeDirection e))) -
       (squareProfile m s (scaledSite k e.val.1.val):ℂ)*torusWave (groupedTorusPoint m s p)
        (latticeTorus (16*2^k) e.val.1.val)) := by
  have h := congrArg Complex.ofReal (dyadicWeight_mul_sqrt p)
  push_cast at h
  simp only [scaledModeGradient, modeGradient, latticeMode]
  rw [G.edge_step e, latticeTorus_add]
  linear_combination ( ((squareProfile m s (scaledSite k (e.val.1.val+latticeAxis (G.edgeDirection e))):ℂ)*
    torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) e.val.1.val+latticeTorus (16*2^k) (latticeAxis (G.edgeDirection e)))) -
    ((squareProfile m s (scaledSite k e.val.1.val):ℂ)*torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) e.val.1.val)) ) * h

end LatticeGraph
end Fourier

end

end RP3

/-! Module: RP3.Fourier.DyadicSums -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open scoped BigOperators
namespace Fourier

theorem dyadic_inverse_square_sum (k : ℕ) :
    (∑ p : DyadicFreq k, (1/(dyadicRadius p:ℝ))^2) ≤ 3*(k:ℝ) := by
  rw [Fintype.sum_sigma]
  calc _ ≤ ∑ j : Fin k, (3:ℝ) := by
          apply Finset.sum_le_sum
          intro j _
          simp only [dyadicRadius, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
          have hr : (0:ℝ) < (2^j.val:ℕ) := by positivity
          have hc : (Fintype.card (Fin (2^j.val) × Fin (2*2^j.val+1)):ℝ) ≤ 3*((2^j.val:ℕ):ℝ)^2 := by
            exact_mod_cast (dyadic_shell_card_bounds j.val).2
          calc _ ≤ (3*((2^j.val:ℕ):ℝ)^2)*(1/((2^j.val:ℕ):ℝ))^2 :=
                mul_le_mul_of_nonneg_right hc (sq_nonneg _)
               _ = 3 := by field_simp
       _ = _ := by simp; ring

theorem sum_dyadic_ratio_lower (k i : ℕ) :
    (∑ j ∈ Finset.range k, if j ≤ i then (2:ℝ)^j/2^i else 0) ≤ 2 := by
  classical
  rw [← Finset.sum_filter]
  have hs : (Finset.range k).filter (fun j => j ≤ i) ⊆ Finset.range (i+1) := by
    intro j hj
    simp only [Finset.mem_filter, Finset.mem_range] at hj ⊢
    omega
  calc _ ≤ ∑ j ∈ Finset.range (i+1), (2:ℝ)^j/2^i :=
          Finset.sum_le_sum_of_subset_of_nonneg hs (fun _ _ _ => by positivity)
       _ ≤ 2 := by
          rw [← Finset.sum_div]
          have hh := geom_sum_mul (2:ℝ) (i+1)
          have hp : (0:ℝ) < 2^i := by positivity
          rw [div_le_iff₀ hp]
          simp only [show (2:ℝ)-1=1 by norm_num, mul_one,
            pow_succ] at hh
          linarith

theorem dyadic_min_ratio_sum (k : ℕ) :
    (∑ i : Fin k, ∑ j : Fin k, min ((2:ℝ)^i.val/2^j.val) (2^j.val/2^i.val)) ≤ 4*(k:ℝ) := by
  classical
  have point (i j : Fin k) : min ((2:ℝ)^i.val/2^j.val) (2^j.val/2^i.val) ≤
      (if j.val ≤ i.val then (2:ℝ)^j.val/2^i.val else 0)+
      (if i.val ≤ j.val then (2:ℝ)^i.val/2^j.val else 0) := by
    by_cases h : j.val ≤ i.val
    · rw [ite_eq_left h]
      exact (min_le_right _ _).trans (le_add_of_nonneg_right (by split_ifs <;> positivity))
    · have hh : i.val ≤ j.val := by omega
      rw [ite_eq_right h, ite_eq_left hh, zero_add]
      exact min_le_left _ _
  have hs : (∑ i : Fin k, ∑ j : Fin k, if j.val ≤ i.val then (2:ℝ)^j.val/2^i.val else 0) ≤ 2*(k:ℝ) := by
    calc _ ≤ ∑ _i : Fin k, (2:ℝ) := by
            apply Finset.sum_le_sum
            intro i _
            rw [← Finset.sum_range (fun j => if j ≤ i.val then (2:ℝ)^j/2^i.val else 0)]
            exact sum_dyadic_ratio_lower k i.val
         _ = _ := by simp; ring
  calc _ ≤ ∑ i : Fin k, ∑ j : Fin k,
          ((if j.val ≤ i.val then (2:ℝ)^j.val/2^i.val else 0)+
           (if i.val ≤ j.val then (2:ℝ)^i.val/2^j.val else 0)) :=
            Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => point i j
       _ = 2*∑ i : Fin k, ∑ j : Fin k, if j.val ≤ i.val then (2:ℝ)^j.val/2^i.val else 0 := by
          simp only [Finset.sum_add_distrib]
          rw [Finset.sum_comm (f := fun i j : Fin k => if i.val ≤ j.val then (2:ℝ)^i.val/2^j.val else 0)]
          ring
       _ ≤ _ := by linarith

theorem weighted_dyadic_min_pair (a b : ℝ) (ha : 0<a) (hb : 0<b) :
    a^2*b^2*min ((1/a)^3*(1/b)) ((1/b)^3*(1/a)) = min (b/a) (a/b) := by
  rw [mul_min_of_nonneg _ _ (by positivity : (0:ℝ) ≤ a^2*b^2)]
  congr 1 <;> field_simp

theorem dyadic_min_cost_sum (k : ℕ) :
    (∑ p : DyadicFreq k, ∑ q : DyadicFreq k,
      min ((1/(dyadicRadius p:ℝ))^3*(1/(dyadicRadius q:ℝ)))
          ((1/(dyadicRadius q:ℝ))^3*(1/(dyadicRadius p:ℝ)))) ≤ 36*(k:ℝ) := by
  simp only [Fintype.sum_sigma]
  have he : (∑ i : Fin k, ∑ a : Fin (2^i.val) × Fin (2*2^i.val+1),
      ∑ j : Fin k, ∑ b : Fin (2^j.val) × Fin (2*2^j.val+1),
      min ((1/(dyadicRadius ⟨i,a⟩:ℝ))^3*(1/(dyadicRadius ⟨j,b⟩:ℝ)))
          ((1/(dyadicRadius ⟨j,b⟩:ℝ))^3*(1/(dyadicRadius ⟨i,a⟩:ℝ)))) =
      ∑ i : Fin k, ∑ j : Fin k,
      (Fintype.card (Fin (2^i.val) × Fin (2*2^i.val+1)):ℝ)*
      (Fintype.card (Fin (2^j.val) × Fin (2*2^j.val+1)):ℝ)*
      min ((1/(2:ℝ)^i.val)^3*(1/(2:ℝ)^j.val))
          ((1/(2:ℝ)^j.val)^3*(1/(2:ℝ)^i.val)) := by
    apply Finset.sum_congr rfl
    intro i _
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    simp only [dyadicRadius, Nat.cast_pow, Nat.cast_ofNat, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    ring
  rw [he]
  calc _ ≤ ∑ i : Fin k, ∑ j : Fin k, 9*min ((2:ℝ)^i.val/2^j.val) (2^j.val/2^i.val) := by
          apply Finset.sum_le_sum; intro i _
          apply Finset.sum_le_sum; intro j _
          have hi : (Fintype.card (Fin (2^i.val) × Fin (2*2^i.val+1)):ℝ) ≤ 3*((2:ℝ)^i.val)^2 := by
            exact_mod_cast (dyadic_shell_card_bounds i.val).2
          have hj : (Fintype.card (Fin (2^j.val) × Fin (2*2^j.val+1)):ℝ) ≤ 3*((2:ℝ)^j.val)^2 := by
            exact_mod_cast (dyadic_shell_card_bounds j.val).2
          calc _ ≤ (3*((2:ℝ)^i.val)^2)*(3*((2:ℝ)^j.val)^2)*
                min ((1/(2:ℝ)^i.val)^3*(1/(2:ℝ)^j.val)) ((1/(2:ℝ)^j.val)^3*(1/(2:ℝ)^i.val)) := by
                  gcongr
               _ = _ := by
                  rw [show (3*((2:ℝ)^i.val)^2)*(3*((2:ℝ)^j.val)^2) = 9*(((2:ℝ)^i.val)^2*((2:ℝ)^j.val)^2) by ring,
                    mul_assoc, weighted_dyadic_min_pair _ _ (by positivity) (by positivity), min_comm]
       _ ≤ _ := by
          simp only [← Finset.mul_sum]
          have hs := dyadic_min_ratio_sum k
          linarith

end Fourier

end

end RP3

/-! Module: RP3.Fourier.ModeBounds -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open scoped BigOperators ComplexConjugate
namespace Fourier
namespace LatticeGraph
variable {k : ℕ}

def modeBlockConstant (C : ℝ) : ℝ := Real.sqrt (512*(C^2+C^2*(Real.pi/4)^2))

theorem scaledModes_direction_bound (G : LatticeGraph) (hG : G.WithinDyadicBox k)
    (C : ℝ)
    (hval : ∀ m s z, |squareProfile m s z| ≤ C)
    (hLip : ∀ m s z w, |squareProfile m s w-squareProfile m s z| ≤ C*‖w-z‖)
    (m s j : Bool) :
    SquareBound (fun (e : G.DirectionalEdges j) (p : DyadicFreq k) => G.scaledModeGradient m s p e.val)
      (modeBlockConstant C) := by
  classical
  have hN : (2:ℝ)^k ≠ 0 := by positivity
  have hd (e : G.DirectionalEdges j) :
      ‖(squareProfile m s (scaledSite k e.val.val.2.val):ℂ)-
        (squareProfile m s (scaledSite k e.val.val.1.val):ℂ)‖ ≤ C/(2:ℝ)^k := by
    rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
    simpa only [G.scaled_edge_distance, div_eq_mul_inv, one_mul] using
      hLip m s (scaledSite k e.val.val.1.val) (scaledSite k e.val.val.2.val)
  have hv (e : G.DirectionalEdges j) :
      ‖(squareProfile m s (scaledSite k e.val.val.2.val):ℂ)‖ ≤ C := by
    simpa only [Complex.norm_real, Real.norm_eq_abs] using hval m s (scaledSite k e.val.val.2.val)
  have ha (p : DyadicFreq k) : ‖((1/(dyadicRadius p:ℝ)):ℂ)‖ ≤ 1 := by
    have hp : (1:ℝ) ≤ dyadicRadius p := by exact_mod_cast dyadicRadius_pos p
    simp only [norm_div, norm_one, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by linarith : (0:ℝ) ≤ dyadicRadius p)]
    exact (div_le_one (by positivity)).mpr hp
  have hh := edge_cutoff_squareBound (groupedTorusPoint m s) (groupedTorusPoint_injective m s)
    (fun e : G.DirectionalEdges j => latticeTorus (16*2^k) e.val.val.1.val)
    (G.directional_torus_injective k hG j) (latticeTorus (16*2^k) (latticeAxis j))
    (fun e => (squareProfile m s (scaledSite k e.val.val.1.val):ℂ))
    (fun e => (squareProfile m s (scaledSite k e.val.val.2.val):ℂ))
    (fun p => ((1/(dyadicRadius p:ℝ)):ℂ)) (C/(2:ℝ)^k) C 1 (Real.pi/(4*(2:ℝ)^k))
    hd hv ha (groupedWave_multiplier_bound m s j)
  have hc : Real.sqrt (2*((16*2^k:ℕ):ℝ)^2*((C/(2:ℝ)^k)^2*1^2+C^2*(Real.pi/(4*(2:ℝ)^k))^2)) = modeBlockConstant C := by
    congr 1
    push_cast
    field_simp [hN]
    ring
  rw [hc] at hh
  have hdir (e : G.DirectionalEdges j) : G.edgeDirection e.val=j := e.property
  exact fun v => by simpa only [G.scaledModeGradient_formula, hdir] using hh v

theorem scaledModes_squareBound (G : LatticeGraph) (hG : G.WithinDyadicBox k)
    (C : ℝ)
    (hval : ∀ m s z, |squareProfile m s z| ≤ C)
    (hLip : ∀ m s z w, |squareProfile m s w-squareProfile m s z| ≤ C*‖w-z‖)
    (m s : Bool) :
    SquareBound (fun e (p : DyadicFreq k) => G.scaledModeGradient m s p e) (2*modeBlockConstant C) := by
  apply SquareBound.combine_directions _ G.edgeDirection
  exact fun j => G.scaledModes_direction_bound hG C hval hLip m s j

end LatticeGraph
end Fourier

end

end RP3

/-! Module: RP3.Fourier.ModeCosts -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open scoped BigOperators ComplexConjugate
namespace Fourier
namespace LatticeGraph
variable {k : ℕ}

theorem mode_gradient_square_sum_le (G : LatticeGraph) (m s : Bool) (a : ℝ)
    (h : SquareBound (fun e (p : DyadicFreq k) => G.scaledModeGradient m s p e) a) (p : DyadicFreq k) :
    (∑ e, ‖G.modeGradient m s p e‖^2) ≤ a^2/(dyadicRadius p:ℝ) := by
  have hr : (0:ℝ)<dyadicRadius p := by exact_mod_cast dyadicRadius_pos p
  have hh := h.column p
  simp only [scaledModeGradient, norm_mul, mul_pow, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _), Real.sq_sqrt hr.le] at hh
  rw [← Finset.mul_sum] at hh
  exact (le_div_iff₀ hr).mpr (by simpa only [mul_comm] using hh)

theorem mode_sup_square_le (G : LatticeGraph) (m s : Bool) (p : DyadicFreq k)
    (C : ℝ) (hC : 0 ≤ C) (hv : ∀ z, |squareProfile m s z| ≤ C) :
    ‖(fun x : G.vertices => latticeMode m s p x.val)‖^2 ≤ C^2*(1/(dyadicRadius p:ℝ))^3 := by
  have hnorm : ‖(fun x : G.vertices => latticeMode m s p x.val)‖ ≤ dyadicWeight p*C := by
    apply (pi_norm_le_iff_of_nonneg (mul_nonneg (dyadicWeight_pos p).le hC)).mpr
    exact fun x => latticeMode_norm_bound m s p x.val C (hv _)
  calc _ ≤ (dyadicWeight p*C)^2 := pow_le_pow_left₀ (norm_nonneg _) hnorm 2
       _ = _ := by rw [mul_pow, dyadicWeight_sq]; ring

theorem mode_gram_reweight (G : LatticeGraph) (m s : Bool) (e l : G.edges) :
    (∑ p : DyadicFreq k, G.scaledModeGradient m s p e*((1/(dyadicRadius p:ℝ)):ℂ)*
      conj (G.scaledModeGradient m s p l)) = ∑ p : DyadicFreq k,
        G.modeGradient m s p e*conj (G.modeGradient m s p l) := by
  apply Finset.sum_congr rfl
  intro p _
  have hr : (0:ℝ)<dyadicRadius p := by exact_mod_cast dyadicRadius_pos p
  have hs : ((Real.sqrt (dyadicRadius p:ℝ):ℂ)*((1/(dyadicRadius p:ℝ)):ℂ)*
      (Real.sqrt (dyadicRadius p:ℝ):ℂ)) = 1 := by
    have hsreal : Real.sqrt (dyadicRadius p:ℝ)*(1/(dyadicRadius p:ℝ))*Real.sqrt (dyadicRadius p:ℝ) = 1 := by
      rw [show Real.sqrt (dyadicRadius p:ℝ)*(1/(dyadicRadius p:ℝ))*Real.sqrt (dyadicRadius p:ℝ) =
      (Real.sqrt (dyadicRadius p:ℝ))^2/(dyadicRadius p:ℝ) by ring, Real.sq_sqrt hr.le, div_self hr.ne']
    exact_mod_cast hsreal
  simp only [scaledModeGradient, map_mul, Complex.conj_ofReal]
  linear_combination G.modeGradient m s p e*conj (G.modeGradient m s p l)*hs

theorem mode_group_gram_bound (G : LatticeGraph) (m s : Bool) (a : ℝ)
    (h : SquareBound (fun e (p : DyadicFreq k) => G.scaledModeGradient m s p e) a) :
    (∑ e, ∑ l, ‖∑ p : DyadicFreq k, G.modeGradient m s p e*conj (G.modeGradient m s p l)‖^2)
      ≤ 3*a^4*(k:ℝ) := by
  have hh := h.gram_weighted (fun p => ((1/(dyadicRadius p:ℝ)):ℂ))
  simp_rw [G.mode_gram_reweight] at hh
  have he (p : DyadicFreq k) : ‖((1/(dyadicRadius p:ℝ)):ℂ)‖^2 = (1/(dyadicRadius p:ℝ))^2 := by
    have hr : (0:ℝ) ≤ dyadicRadius p := by positivity
    simp only [norm_div, norm_one, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr]
  simp_rw [he] at hh
  exact hh.trans (by nlinarith [mul_le_mul_of_nonneg_left (dyadic_inverse_square_sum k) (by positivity : 0≤a^4)])

abbrev ModeIndex (k : ℕ) := (Bool × Bool) × DyadicFreq k

def modes (G : LatticeGraph) (i : ModeIndex k) (x : G.vertices) : ℂ :=
  latticeMode i.1.1 i.1.2 i.2 x.val

def modeDifferences (G : LatticeGraph) (i : ModeIndex k) (e : G.edges) : ℂ :=
  G.modeGradient i.1.1 i.1.2 i.2 e

theorem modes_HS_bound (G : LatticeGraph) (a : ℝ)
    (h : ∀ m s, SquareBound (fun e (p : DyadicFreq k) => G.scaledModeGradient m s p e) a) :
    familyHSSquare (G.modeDifferences (k := k)) ≤ 48*a^4*(k:ℝ) := by
  unfold familyHSSquare rowSquare familyKernel modeDifferences
  simp only [Fintype.sum_prod_type]
  have hh := gram_groups_bound
    (fun (i : Bool × Bool) e l => ∑ p : DyadicFreq k,
      G.modeGradient i.1 i.2 p e*conj (G.modeGradient i.1 i.2 p l))
    (3*a^4*(k:ℝ)) (fun i => G.mode_group_gram_bound i.1 i.2 a (h i.1 i.2))
  simpa only [Fintype.sum_prod_type, Fintype.card_prod, Fintype.card_bool, Nat.cast_mul, Nat.cast_ofNat,
    show ((2:ℝ)*2)^2*(3*a^4*(k:ℝ)) = 48*a^4*(k:ℝ) by ring] using hh

theorem modes_min_bound (G : LatticeGraph) (a C : ℝ) (hC : 0 ≤ C)
    (hv : ∀ m s z, |squareProfile m s z| ≤ C)
    (h : ∀ m s, SquareBound (fun e (p : DyadicFreq k) => G.scaledModeGradient m s p e) a) :
    (∑ i : ModeIndex k, ∑ j : ModeIndex k,
      min (‖G.modes i‖^2*∑ e, ‖G.modeDifferences j e‖^2)
          (‖G.modes j‖^2*∑ e, ‖G.modeDifferences i e‖^2)) ≤ 576*C^2*a^2*(k:ℝ) := by
  have hv' (i : ModeIndex k) : ‖G.modes i‖^2 ≤ C^2*(1/(dyadicRadius i.2:ℝ))^3 :=
    G.mode_sup_square_le i.1.1 i.1.2 i.2 C hC (hv i.1.1 i.1.2)
  have hd' (i : ModeIndex k) : (∑ e, ‖G.modeDifferences i e‖^2) ≤ a^2/(dyadicRadius i.2:ℝ) :=
    G.mode_gradient_square_sum_le i.1.1 i.1.2 a (h i.1.1 i.1.2) i.2
  have hm (i j : ModeIndex k) :
      min (‖G.modes i‖^2*∑ e, ‖G.modeDifferences j e‖^2)
          (‖G.modes j‖^2*∑ e, ‖G.modeDifferences i e‖^2) ≤
      C^2*a^2*min ((1/(dyadicRadius i.2:ℝ))^3*(1/(dyadicRadius j.2:ℝ)))
                 ((1/(dyadicRadius j.2:ℝ))^3*(1/(dyadicRadius i.2:ℝ))) := by
    rw [mul_min_of_nonneg _ _ (mul_nonneg (sq_nonneg _) (sq_nonneg _))]
    apply min_le_min
    · calc _ ≤ (C^2*(1/(dyadicRadius i.2:ℝ))^3)*(a^2/(dyadicRadius j.2:ℝ)) :=
            mul_le_mul (hv' i) (hd' j) (Finset.sum_nonneg fun _ _ => sq_nonneg _) (by positivity)
           _ = _ := by ring
    · calc _ ≤ (C^2*(1/(dyadicRadius j.2:ℝ))^3)*(a^2/(dyadicRadius i.2:ℝ)) :=
            mul_le_mul (hv' j) (hd' i) (Finset.sum_nonneg fun _ _ => sq_nonneg _) (by positivity)
           _ = _ := by ring
  calc _ ≤ ∑ i : ModeIndex k, ∑ j : ModeIndex k,
        C^2*a^2*min ((1/(dyadicRadius i.2:ℝ))^3*(1/(dyadicRadius j.2:ℝ)))
                   ((1/(dyadicRadius j.2:ℝ))^3*(1/(dyadicRadius i.2:ℝ))) :=
           Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => hm i j
       _ = 16*C^2*a^2*∑ p : DyadicFreq k, ∑ q : DyadicFreq k,
           min ((1/(dyadicRadius p:ℝ))^3*(1/(dyadicRadius q:ℝ)))
               ((1/(dyadicRadius q:ℝ))^3*(1/(dyadicRadius p:ℝ))) := by
          simp only [ModeIndex, Fintype.sum_prod_type, Finset.sum_const, Finset.card_univ,
            Fintype.card_prod, Fintype.card_bool, Nat.cast_mul, nsmul_eq_mul, Nat.cast_ofNat, ← Finset.mul_sum]
          ring
       _ ≤ _ := by
          have hd := mul_le_mul_of_nonneg_left (dyadic_min_cost_sum k)
            (by positivity : 0 ≤ 16*C^2*a^2)
          nlinarith

end LatticeGraph
end Fourier

end

end RP3

/-! Module: RP3.Fourier.ModeCommutator -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open scoped BigOperators ComplexConjugate
namespace Fourier
variable {k : ℕ}

theorem dyadic_sine_main_sum (k : ℕ) :
    (∑ p : DyadicFreq k, (dyadicWeight p)^2*Real.sin (dyadicAngle k (dyadicPoint p).1)) =
      dyadicLambda k/(2:ℝ)^k := by
  simp only [dyadicWeight_sq, dyadicLambda]
  rw [mul_div_cancel_left₀ _ (by positivity : (2:ℝ)^k ≠ 0)]

theorem grouped_sine_sum (m s j : Bool) :
    (∑ p : DyadicFreq k, (dyadicWeight p)^2*
      Real.sin (dyadicAngle k (if j then (groupedPoint m s p).2 else (groupedPoint m s p).1))) =
      if m=j then (if s then -(dyadicLambda k/(2:ℝ)^k) else dyadicLambda k/(2:ℝ)^k) else 0 := by
  have h1 := dyadic_sine_main_sum k
  have h2 := dyadic_sin_cancel k
  cases m <;> cases s <;> cases j <;>
    simp_all [groupedPoint]

namespace LatticeGraph

def modeCommutator (G : LatticeGraph) (m s : Bool) (p : DyadicFreq k) (e : G.edges) : ℂ :=
  (latticeMode m s p e.val.1.val*conj (latticeMode m s p e.val.2.val)-
    conj (latticeMode m s p e.val.1.val)*latticeMode m s p e.val.2.val)/2

def profileEdge (G : LatticeGraph) (k : ℕ) (e : G.edges) : ℝ :=
  (1/(2:ℝ)^k)*(squareProfile (G.edgeDirection e) false (scaledSite k e.val.1.val)*
    squareProfile (G.edgeDirection e) false (scaledSite k e.val.2.val)-
    squareProfile (G.edgeDirection e) true (scaledSite k e.val.1.val)*
    squareProfile (G.edgeDirection e) true (scaledSite k e.val.2.val))

def thetaEdge (G : LatticeGraph) (k : ℕ) (e : G.edges) : ℝ :=
  squareTheta (scaledSite k e.val.2.val)-squareTheta (scaledSite k e.val.1.val)

theorem modeCommutator_formula (G : LatticeGraph) (m s : Bool) (p : DyadicFreq k) (e : G.edges) :
    G.modeCommutator m s p e = -Complex.I *
      ((squareProfile m s (scaledSite k e.val.1.val)*squareProfile m s (scaledSite k e.val.2.val)*
        ((dyadicWeight p)^2*Real.sin (dyadicAngle k
          (if G.edgeDirection e then (groupedPoint m s p).2 else (groupedPoint m s p).1))):ℝ):ℂ) := by
  have hy : latticeMode m s p e.val.2.val =
      (((dyadicWeight p*squareProfile m s (scaledSite k e.val.2.val)):ℝ):ℂ)*
        torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) e.val.1.val)*
        Complex.exp (Complex.I*((dyadicAngle k
          (if G.edgeDirection e then (groupedPoint m s p).2 else (groupedPoint m s p).1):ℝ):ℂ)) := by
    unfold latticeMode
    rw [show latticeTorus (16*2^k) e.val.2.val = latticeTorus (16*2^k) e.val.1.val+
      latticeTorus (16*2^k) (latticeAxis (G.edgeDirection e)) by rw [G.edge_step e,latticeTorus_add],
      torusWave_add, groupedWave_axis_sine]
    push_cast
    ring
  have hh := wave_commutator (dyadicWeight p)
    (squareProfile m s (scaledSite k e.val.1.val)) (squareProfile m s (scaledSite k e.val.2.val))
    (dyadicAngle k (if G.edgeDirection e then (groupedPoint m s p).2 else (groupedPoint m s p).1))
    (torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) e.val.1.val))
    (torusWave_norm _ _)
  unfold modeCommutator
  rw [hy]
  simp only [latticeMode, Complex.ofReal_mul] at hh ⊢
  linear_combination hh

theorem mode_group_commutator (G : LatticeGraph) (m s : Bool) (e : G.edges) :
    (∑ p : DyadicFreq k, G.modeCommutator m s p e) = -Complex.I*
      ((squareProfile m s (scaledSite k e.val.1.val)*squareProfile m s (scaledSite k e.val.2.val)*
        (if m=G.edgeDirection e then (if s then -(dyadicLambda k/(2:ℝ)^k) else dyadicLambda k/(2:ℝ)^k) else 0):ℝ):ℂ) := by
  simp only [G.modeCommutator_formula, ← Finset.mul_sum, ← Complex.ofReal_sum]
  rw [grouped_sine_sum]

theorem modes_commutator (G : LatticeGraph) (e : G.edges) :
    (∑ i : ModeIndex k, G.modeCommutator i.1.1 i.1.2 i.2 e) =
      -Complex.I*((dyadicLambda k*G.profileEdge k e:ℝ):ℂ) := by
  simp only [Fintype.sum_prod_type, G.mode_group_commutator, Fintype.sum_bool]
  cases h : G.edgeDirection e <;>
    simp [profileEdge, h]
  all_goals ring

end LatticeGraph
end Fourier

end

end RP3

/-! Module: RP3.Fourier.ThetaEstimates -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open Set
open scoped BigOperators ComplexConjugate
namespace Fourier

theorem squareTheta_compact : HasCompactSupport squareTheta := by
  apply HasCompactSupport.intro (isCompact_Icc.prod isCompact_Icc :
    IsCompact (Icc (-2:ℝ) 2 ×ˢ Icc (-2:ℝ) 2))
  intro z hz
  apply squareTheta_zero
  by_contra h
  push Not at h
  apply hz
  constructor <;> constructor <;> nlinarith [abs_le.mp h.1.le, abs_le.mp h.2.le]

theorem theta_lipschitz_bound : ∃ C : ℝ, 0 ≤ C ∧ ∀ z w,
    |squareTheta w-squareTheta z| ≤ C*‖w-z‖ := by
  obtain ⟨C,hC,_,hL⟩ := smooth_compact_lipschitz_bound squareTheta_compact squareTheta_contDiff
  exact ⟨C,hC,by simpa only [Real.norm_eq_abs] using hL⟩

namespace LatticeGraph

theorem theta_edge_bounds : ∃ L D : ℝ, 0 ≤ L ∧ 0 ≤ D ∧
    ∀ (G : LatticeGraph) (k : ℕ), 4 ≤ k → ∀ e : G.edges,
      |G.thetaEdge k e| ≤ L/(2:ℝ)^k ∧
      |G.thetaEdge k e-G.profileEdge k e| ≤ D/((2:ℝ)^k)^3 := by
  obtain ⟨L,hL,hLip⟩ := theta_lipschitz_bound
  obtain ⟨D,hD,hR⟩ := squareTheta_step_error
  refine ⟨L,D,hL,hD,?_⟩
  intro G k hk e
  constructor
  · have h := hLip (scaledSite k e.val.1.val) (scaledSite k e.val.2.val)
    rw [G.scaled_edge_distance] at h
    exact h.trans_eq (by ring)
  · have hN : (16:ℝ) ≤ (2:ℝ)^k := by
      calc (16:ℝ) = (2:ℝ)^4 := by norm_num
           _ ≤ _ := pow_le_pow_right₀ (by norm_num) hk
    have hmesh : |1/(2:ℝ)^k| ≤ 1/16 := by
      rw [abs_of_pos (by positivity)]
      exact one_div_le_one_div_of_le (by norm_num) hN
    have h := hR (G.edgeDirection e) (scaledSite k e.val.1.val) (1/(2:ℝ)^k) hmesh
    rw [← scaledSite_add_axis, ← G.edge_step e,abs_of_pos (by positivity : 0 < 1/(2:ℝ)^k)] at h
    simpa only [thetaEdge,profileEdge,div_pow,one_pow,mul_one_div] using h

theorem theta_sum_bounds (G : LatticeGraph) (k : ℕ) (hG : G.WithinDyadicBox k)
    (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (he : ∀ e : G.edges, |G.thetaEdge k e| ≤ L/(2:ℝ)^k ∧
      |G.thetaEdge k e-G.profileEdge k e| ≤ D/((2:ℝ)^k)^3) :
    (∑ e, |G.thetaEdge k e-G.profileEdge k e|) ≤ 512*D/(2:ℝ)^k ∧
    (∑ e, |G.thetaEdge k e|^2) ≤ 512*L^2 ∧
    (∑ e, |G.thetaEdge k e-G.profileEdge k e| *
      (|G.thetaEdge k e| + |G.profileEdge k e|)) ≤ 512*D*(2*L+D)/((2:ℝ)^k)^2 := by
  let N : ℝ := (2:ℝ)^k
  have hN : 0 < N := by dsimp [N]; positivity
  have hN1 : 1 ≤ N := one_le_pow₀ (by norm_num)
  have hcount := G.edge_card_bound k hG
  change (Fintype.card G.edges:ℝ) ≤ 512*N^2 at hcount
  have hv (e : G.edges) : |G.profileEdge k e| ≤ (L+D)/N := by
    have htri : |G.profileEdge k e| ≤ |G.thetaEdge k e| + |G.thetaEdge k e-G.profileEdge k e| := by
      simpa only [add_sub_cancel, abs_sub_comm] using abs_add_le (G.thetaEdge k e) (G.profileEdge k e-G.thetaEdge k e)
    have hpow : N ≤ N^3 := by nlinarith [sq_nonneg (N-1)]
    calc _ ≤ L/N+D/N^3 := htri.trans (add_le_add (he e).1 (he e).2)
         _ ≤ L/N+D/N := add_le_add_right (div_le_div_of_nonneg_left hD hN hpow) _
         _ = _ := by ring
  have hs1 : (∑ e, |G.thetaEdge k e-G.profileEdge k e|) ≤ (Fintype.card G.edges:ℝ)*(D/N^3) := by
    simpa only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul] using Finset.sum_le_sum (s := Finset.univ) (fun e _ => (he e).2)
  have hs2 : (∑ e, |G.thetaEdge k e|^2) ≤ (Fintype.card G.edges:ℝ)*(L/N)^2 := by
    simpa only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul] using Finset.sum_le_sum (s := Finset.univ)
      (fun e _ => pow_le_pow_left₀ (abs_nonneg _) (he e).1 2)
  have hs3 : (∑ e, |G.thetaEdge k e-G.profileEdge k e| *(|G.thetaEdge k e| + |G.profileEdge k e|)) ≤
      (Fintype.card G.edges:ℝ)*(D/N^3*((2*L+D)/N)) := by
    simpa only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul] using Finset.sum_le_sum (s := Finset.univ)
      (fun e _ => mul_le_mul (he e).2 (show |G.thetaEdge k e| + |G.profileEdge k e| ≤ (2*L+D)/N from
        (add_le_add (he e).1 (hv e)).trans_eq (by ring)) (by positivity) (by positivity))
  refine ⟨hs1.trans ?_,hs2.trans ?_,hs3.trans ?_⟩
  all_goals
    calc _ ≤ 512*N^2*_ := mul_le_mul_of_nonneg_right hcount (by positivity)
         _ = _ := by dsimp only [N]; field_simp

end LatticeGraph
end Fourier

end

end RP3

/-! Module: RP3.Fourier.LatticeRestriction -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open Set
open scoped Classical
namespace Fourier.LatticeGraph

def restrictVertices (G : LatticeGraph) (P : Site → Prop) : Finset Site := G.vertices.filter P

def restrictVertex (G : LatticeGraph) (P : Site → Prop) (v : G.restrictVertices P) : G.vertices :=
  ⟨v.val,(Finset.mem_filter.mp v.property).1⟩

def restrict (G : LatticeGraph) (P : Site → Prop) : LatticeGraph where
  vertices := G.restrictVertices P
  edges := Finset.univ.filter (fun e : G.restrictVertices P × G.restrictVertices P =>
    (G.restrictVertex P e.1,G.restrictVertex P e.2)∈G.edges)
  nearest _e he := G.nearest _ (Finset.mem_filter.mp he).2

def restrictEdge (G : LatticeGraph) (P : Site → Prop) (e : (G.restrict P).edges) : G.edges :=
  ⟨(G.restrictVertex P e.val.1,G.restrictVertex P e.val.2),(Finset.mem_filter.mp e.property).2⟩

def restrictVertexEquiv (G : LatticeGraph) (P : Site → Prop) :
    {v : G.vertices // P v.val} ≃ (G.restrict P).vertices where
  toFun v := ⟨v.val.val,Finset.mem_filter.mpr ⟨v.val.property,v.property⟩⟩
  invFun v := ⟨G.restrictVertex P v,(Finset.mem_filter.mp v.property).2⟩
  left_inv _ := rfl
  right_inv _ := rfl

def restrictEdgeEquiv (G : LatticeGraph) (P : Site → Prop) :
    {e : G.edges // P e.val.1.val ∧ P e.val.2.val} ≃ (G.restrict P).edges where
  toFun e := ⟨(⟨e.val.val.1.val,Finset.mem_filter.mpr ⟨e.val.val.1.property,e.property.1⟩⟩,
    ⟨e.val.val.2.val,Finset.mem_filter.mpr ⟨e.val.val.2.property,e.property.2⟩⟩),
    Finset.mem_filter.mpr ⟨Finset.mem_univ _,e.val.property⟩⟩
  invFun e := ⟨G.restrictEdge P e,(Finset.mem_filter.mp e.val.1.property).2,
    (Finset.mem_filter.mp e.val.2.property).2⟩
  left_inv _ := rfl
  right_inv _ := rfl

@[simp] theorem restrictVertexEquiv_val (G : LatticeGraph) (P : Site → Prop)
    (v : {v : G.vertices // P v.val}) : (G.restrictVertexEquiv P v).val=v.val.val := rfl

@[simp] theorem restrictEdgeEquiv_left (G : LatticeGraph) (P : Site → Prop)
    (e : {e : G.edges // P e.val.1.val ∧ P e.val.2.val}) :
    (G.restrictEdgeEquiv P e).val.1=G.restrictVertexEquiv P ⟨e.val.val.1,e.property.1⟩ := rfl

@[simp] theorem restrictEdgeEquiv_right (G : LatticeGraph) (P : Site → Prop)
    (e : {e : G.edges // P e.val.1.val ∧ P e.val.2.val}) :
    (G.restrictEdgeEquiv P e).val.2=G.restrictVertexEquiv P ⟨e.val.val.2,e.property.2⟩ := rfl

def translateVertexEquiv (G : LatticeGraph) (z : Site) :
    G.vertices ≃ G.vertices.map (Equiv.addRight (-z)).toEmbedding :=
  Finset.equivMap (Equiv.addRight (-z)).toEmbedding G.vertices

def translate (G : LatticeGraph) (z : Site) : LatticeGraph where
  vertices := G.vertices.map (Equiv.addRight (-z)).toEmbedding
  edges := G.edges.map ((Equiv.prodCongr (G.translateVertexEquiv z) (G.translateVertexEquiv z)).toEmbedding)
  nearest e he := by
    obtain ⟨e',he',rfl⟩ := Finset.mem_map.mp he
    have h := G.nearest e' he'
    change PositiveNeighbor (e'.1.val+-z) (e'.2.val+-z)
    rcases h with h | h
    · left
      constructor <;> simp only [Prod.fst_add,Prod.snd_add,Prod.fst_neg,Prod.snd_neg]
      · omega
      · omega
    · right
      constructor <;> simp only [Prod.fst_add,Prod.snd_add,Prod.fst_neg,Prod.snd_neg]
      · omega
      · omega

def translateEdgeEquiv (G : LatticeGraph) (z : Site) : G.edges ≃ (G.translate z).edges :=
  Finset.equivMap ((Equiv.prodCongr (G.translateVertexEquiv z) (G.translateVertexEquiv z)).toEmbedding) G.edges

@[simp] theorem translateVertexEquiv_val (G : LatticeGraph) (z : Site) (v : G.vertices) :
    (G.translateVertexEquiv z v).val=v.val-z := rfl

@[simp] theorem translateEdgeEquiv_left (G : LatticeGraph) (z : Site) (e : G.edges) :
    (G.translateEdgeEquiv z e).val.1=G.translateVertexEquiv z e.val.1 := rfl

@[simp] theorem translateEdgeEquiv_right (G : LatticeGraph) (z : Site) (e : G.edges) :
    (G.translateEdgeEquiv z e).val.2=G.translateVertexEquiv z e.val.2 := rfl

end Fourier.LatticeGraph

end

end RP3

/-! Module: RP3.Fourier.LatticeRadius -/

/-! Interaction-independent Fourier and lattice analysis, adapted from the
OpenAI ClassicalON formalization (commit adc7f1241b42e322a6451854ab7e4b4c146bf78a). -/

namespace RP3

noncomputable section
open Set
open scoped Classical
namespace Fourier

def siteRadius (z v : Site) : ℤ := max |v.1-z.1| |v.2-z.2|

@[simp] theorem siteRadius_self (z : Site) : siteRadius z z=0 := by simp [siteRadius]

theorem siteRadius_nonneg (z v : Site) : 0≤ siteRadius z v := le_trans (abs_nonneg _) (le_max_left _ _)

theorem siteRadius_symm (z v : Site) : siteRadius z v=siteRadius v z := by
  simp only [siteRadius,abs_sub_comm]

theorem siteRadius_le_iff (z v : Site) (N : ℤ) :
    siteRadius z v≤N ↔ |v.1-z.1|≤N ∧ |v.2-z.2|≤N := max_le_iff

theorem siteRadius_triangle (x y z : Site) : siteRadius x z≤ siteRadius x y+siteRadius y z := by
  apply max_le
  · have h := abs_add_le (y.1-x.1) (z.1-y.1)
    have h1 : |y.1-x.1|≤ siteRadius x y := le_max_left _ _
    have h2 : |z.1-y.1|≤ siteRadius y z := le_max_left _ _
    have he : (y.1-x.1)+(z.1-y.1)=z.1-x.1 := by ring
    rw [he] at h
    omega
  · have h := abs_add_le (y.2-x.2) (z.2-y.2)
    have h1 : |y.2-x.2|≤ siteRadius x y := le_max_right _ _
    have h2 : |z.2-y.2|≤ siteRadius y z := le_max_right _ _
    have he : (y.2-x.2)+(z.2-y.2)=z.2-x.2 := by ring
    rw [he] at h
    omega

theorem siteRadius_neighbor {x y : Site} (h : PositiveNeighbor x y) : siteRadius x y=1 := by
  rcases h with ⟨h1,h2⟩ | ⟨h1,h2⟩ <;> simp [siteRadius,h1,h2]

theorem siteRadius_neighbor_step (z : Site) {x y : Site} (h : PositiveNeighbor x y ∨ PositiveNeighbor y x) :
    siteRadius z y≤ siteRadius z x+1 ∧ siteRadius z x≤ siteRadius z y+1 := by
  have hh : siteRadius x y=1 := by
    rcases h with h | h
    · exact siteRadius_neighbor h
    · rw [siteRadius_symm]; exact siteRadius_neighbor h
  constructor
  · simpa only [hh] using siteRadius_triangle z x y
  · have := siteRadius_triangle z y x
    rwa [siteRadius_symm y x,hh] at this

def annulusSites (N : ℤ) (z : Site) : Set Site := {v | N≤ siteRadius z v ∧ siteRadius z v≤2*N}

def annulusBoundary (N : ℤ) (z : Site) : Set Site := {v | siteRadius z v=N ∨ siteRadius z v=2*N}

def annulusInterior (N : ℤ) (z : Site) : Set Site := {v | N<siteRadius z v ∧ siteRadius z v<2*N}

theorem annulusSites_not_boundary (N : ℤ) (z v : Site) :
    v∈annulusSites N z ∧ v∉annulusBoundary N z ↔ v∈annulusInterior N z := by
  simp only [annulusSites,annulusBoundary,annulusInterior,mem_ofPred_eq]
  omega

theorem neighbor_in_annulus {N : ℤ} {z x y : Site} (hx : x∈annulusInterior N z)
    (hxy : PositiveNeighbor x y ∨ PositiveNeighbor y x) : y∈annulusSites N z := by
  have hh := siteRadius_neighbor_step z hxy
  change N<siteRadius z x ∧ siteRadius z x<2*N at hx
  change N≤ siteRadius z y ∧ siteRadius z y≤2*N
  omega

theorem annuli_disjoint {N : ℤ} {x y : Site} (hxy : 4*N<siteRadius x y) :
    Disjoint (annulusSites N x) (annulusSites N y) := by
  apply Set.disjoint_left.mpr
  intro z hx hy
  have ht := siteRadius_triangle x z y
  rw [siteRadius_symm z y] at ht
  change N≤ siteRadius x z ∧ siteRadius x z≤2*N at hx
  change N≤ siteRadius y z ∧ siteRadius y z≤2*N at hy
  omega

namespace LatticeGraph

def annulusGraph (G : LatticeGraph) (N : ℤ) (z : Site) := G.restrict (·∈annulusSites N z)

def annulusInner (G : LatticeGraph) (N : ℤ) (z : Site) : Set (G.annulusGraph N z).vertices :=
  {v | siteRadius z v.val=N}

def annulusOuter (G : LatticeGraph) (N : ℤ) (z : Site) : Set (G.annulusGraph N z).vertices :=
  {v | siteRadius z v.val=2*N}

def annulusPins (G : LatticeGraph) (N : ℤ) (z : Site) : Set (G.annulusGraph N z).vertices :=
  G.annulusInner N z∪G.annulusOuter N z

def annulusCoupling (G : LatticeGraph) (b : G.edges → ℝ) (N : ℤ) (z : Site) :
    (G.annulusGraph N z).edges → ℝ := fun e => b (G.restrictEdge _ e)

end LatticeGraph
end Fourier

end

end RP3
/-! Module: RP3.Fourier.ResponseEstimates -/

/-!
# Quantitative numerical consequences of the Fourier family construction

These intermediate lemmas keep the response argument explicit; the actual
RP³ response is substituted in the model-specific analytic assembly.
-/
namespace RP3.Fourier
noncomputable section
open scoped BigOperators
namespace LatticeGraph

def rotationCostConstant (M C : ℝ) : ℝ :=
  4*((6*M^2+4*M*Real.sqrt M+M)*(48*(2*modeBlockConstant C)^4)+
        M*(576*C^2*(2*modeBlockConstant C)^2))

def transferCostConstant (M L D : ℝ) : ℝ :=
  M*(512*D*(2*L+D)) + (M*512*D)*(M*(512*L^2)+1) + (M*512*D)^2

theorem rotationCostConstant_nonneg (M C : ℝ) (hM : 0 ≤ M) :
    0 ≤ rotationCostConstant M C := by unfold rotationCostConstant; positivity

theorem transferCostConstant_nonneg (M L D : ℝ)
    (hM : 0 ≤ M) (hL : 0 ≤ L) (hD : 0 ≤ D) :
    0 ≤ transferCostConstant M L D := by unfold transferCostConstant; positivity

/-- The Fourier normalization converts a family bound of order k into a
single profile response bound of order 1/k. -/
theorem profile_response_bound_of_family (G : LatticeGraph) (k : ℕ) (hk : 0 < k)
    (hG : G.WithinDyadicBox k) (M : ℝ) (hM : 0 ≤ M)
    (C : ℝ) (hC : 0 ≤ C) (hv : ∀ m s z, |squareProfile m s z| ≤ C)
    (hLip : ∀ m s z w, |squareProfile m s w-squareProfile m s z| ≤ C*‖w-z‖)
    (R : ℝ)
    (hfamily : -(dyadicLambda k)^2 * R ≤
      (6*M^2+4*M*Real.sqrt M+M)*familyHSSquare (G.modeDifferences (k := k)) +
        M * (∑ i : ModeIndex k, ∑ j : ModeIndex k,
          min (‖G.modes i‖^2*∑ e, ‖G.modeDifferences j e‖^2)
            (‖G.modes j‖^2*∑ e, ‖G.modeDifferences i e‖^2))) :
    -R ≤ rotationCostConstant M C/(k:ℝ) := by
  let a := 2*modeBlockConstant C
  let T := (6*M^2+4*M*Real.sqrt M+M)*(48*a^4)+M*(576*C^2*a^2)
  have ha (m s : Bool) := G.scaledModes_squareBound hG C hv hLip m s
  have hT : 0 ≤ T := by dsimp only [T]; positivity
  have hLam : (k:ℝ)/2 ≤ dyadicLambda k := dyadicLambda_lower k
  have hkR : (0:ℝ) < k := by exact_mod_cast hk
  have hLp : 0 < dyadicLambda k := by linarith
  have hHS := G.modes_HS_bound a ha
  have hmin := G.modes_min_bound a C hC hv ha
  have hK : 0 ≤ 6*M^2+4*M*Real.sqrt M+M := by positivity
  have hcost : (6*M^2+4*M*Real.sqrt M+M)*familyHSSquare (G.modeDifferences (k := k))+
      M*(∑ i : ModeIndex k, ∑ j : ModeIndex k,
      min (‖G.modes i‖^2*∑ e, ‖G.modeDifferences j e‖^2)
          (‖G.modes j‖^2*∑ e, ‖G.modeDifferences i e‖^2)) ≤ T*(k:ℝ) := by
    calc _ ≤ (6*M^2+4*M*Real.sqrt M+M)*(48*a^4*(k:ℝ))+M*(576*C^2*a^2*(k:ℝ)) :=
      add_le_add (mul_le_mul_of_nonneg_left hHS hK) (mul_le_mul_of_nonneg_left hmin hM)
      _ = _ := by dsimp only [T]; ring
  change -R ≤ 4*T/(k:ℝ)
  by_cases hr : R ≤ 0
  · apply (le_div_iff₀ hkR).mpr
    have hsq : (k:ℝ)^2/4 ≤ (dyadicLambda k)^2 := by nlinarith
    have hh := mul_le_mul_of_nonneg_right hsq (neg_nonneg.mpr hr)
    have ht := hfamily.trans hcost
    nlinarith
  · have hh : 0 ≤ 4*T/(k:ℝ) := by positivity
    linarith

/-- Real-response transfer with a common derivative bound M. -/
theorem theta_response_bound_of_transfer (G : LatticeGraph) (k : ℕ)
    (hG : G.WithinDyadicBox k) (M L D a R : ℝ)
    (hM : 0 ≤ M) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (he : ∀ e : G.edges, |G.thetaEdge k e| ≤ L/(2:ℝ)^k ∧
      |G.thetaEdge k e-G.profileEdge k e| ≤ D/((2:ℝ)^k)^3)
    (htransfer : -R ≤ a +
      M*(∑ e, |G.thetaEdge k e-G.profileEdge k e| *
        (|G.thetaEdge k e|+|G.profileEdge k e|)) +
      (M*∑ e, |G.thetaEdge k e-G.profileEdge k e|) *
        (M*(∑ e, (G.thetaEdge k e)^2)+1) +
      (M*∑ e, |G.thetaEdge k e-G.profileEdge k e|)^2) :
    -R ≤ a+transferCostConstant M L D/(2:ℝ)^k := by
  let N : ℝ := (2:ℝ)^k
  have hN : 0 < N := by dsimp [N]; positivity
  have hN1 : 1 ≤ N := one_le_pow₀ (by norm_num)
  obtain ⟨hs1,hs2,hs3⟩ := G.theta_sum_bounds k hG L D hL hD he
  simp only [sq_abs] at hs2
  have h1n : 0 ≤ M*∑ e, |G.thetaEdge k e-G.profileEdge k e| := by positivity
  have hh : -R ≤ a + M*(512*D*(2*L+D)/N^2) +
      (M*(512*D/N))*(M*(512*L^2)+1)+(M*(512*D/N))^2 := by
    apply htransfer.trans
    apply add_le_add
    · apply add_le_add
      · exact add_le_add le_rfl (mul_le_mul_of_nonneg_left hs3 hM)
      · exact mul_le_mul (mul_le_mul_of_nonneg_left hs1 hM)
          (add_le_add (mul_le_mul_of_nonneg_left hs2 hM) le_rfl) (by positivity) (by positivity)
    · exact pow_le_pow_left₀ h1n (mul_le_mul_of_nonneg_left hs1 hM) 2
  apply hh.trans
  rw [add_assoc a, add_assoc a]
  apply add_le_add le_rfl
  have hN2 : N ≤ N^2 := by nlinarith
  have hQ : 0 ≤ M*(512*D*(2*L+D))+(M*512*D)^2 := by positivity
  calc _ = (M*(512*D*(2*L+D))+(M*512*D)^2)/N^2+
        ((M*512*D)*(M*(512*L^2)+1))/N := by ring
    _ ≤ (M*(512*D*(2*L+D))+(M*512*D)^2)/N+
        ((M*512*D)*(M*(512*L^2)+1))/N :=
      add_le_add (div_le_div_of_nonneg_left hQ hN hN2) le_rfl
    _ = _ := by unfold transferCostConstant; dsimp only [N]; ring

/-- A scale-uniform 1/k form is convenient for nesting annuli. -/
theorem dyadic_error_le_inverse_scale (k : ℕ) (hk : 0 < k) (A B : ℝ) (hB : 0 ≤ B) :
    A/(k:ℝ)+B/(2:ℝ)^k ≤ (A+B)/(k:ℝ) := by
  have hkR : (0:ℝ) < k := by exact_mod_cast hk
  have hpow : (k:ℝ) ≤ (2:ℝ)^k := by exact_mod_cast k.lt_two_pow_self.le
  calc _ ≤ A/(k:ℝ)+B/(k:ℝ) :=
      add_le_add le_rfl (div_le_div_of_nonneg_left hB hkR hpow)
    _ = _ := by ring

end LatticeGraph
end
end RP3.Fourier
end StandalonePart1

/- ===== RP3/ThinProfiles.lean ===== -/
section StandalonePart2

/-! Balanced smooth profiles in arbitrarily thin square annuli.

The construction reuses the already verified fixed smooth profiles.  A signed
soft-threshold stretches their constant central plateau; this map is affine
where the profiles have nonzero derivatives.  Thus its apparent corners do not
introduce corners in the resulting cutoff functions.
-/

namespace RP3.Fourier
noncomputable section
open Set
open scoped ContDiff

/-- Signed soft threshold, with threshold `c ≥ 0`. -/
def plateauMap (c x : ℝ) : ℝ :=
  if x ≤ -c then x+c else if c ≤ x then x-c else 0

theorem plateauMap_left (c x : ℝ) (h : x ≤ -c) : plateauMap c x = x+c := by
  simp [plateauMap, h]

theorem plateauMap_right (c x : ℝ) (hc : 0 ≤ c) (h : c ≤ x) :
    plateauMap c x = x-c := by
  by_cases hx : x ≤ -c
  · have : c = 0 := by linarith
    have : x = 0 := by linarith
    simp_all [plateauMap]
  · simp [plateauMap, hx, h]

theorem plateauMap_middle (c x : ℝ) (h1 : -c ≤ x) (h2 : x ≤ c) :
    plateauMap c x = 0 := by
  unfold plateauMap
  split_ifs <;> linarith

theorem plateauMap_lipschitz (c : ℝ) (hc : 0 ≤ c) (x y : ℝ) :
    |plateauMap c y-plateauMap c x| ≤ |y-x| := by
  have hab := abs_le.mp (le_refl |y-x|)
  unfold plateauMap
  split_ifs <;> rw [abs_le] <;> constructor <;> linarith [abs_nonneg (y-x)]

theorem plateauMap_abs_le (c : ℝ) (hc : 0 ≤ c) (x : ℝ) :
    |plateauMap c x| ≤ |x| := by
  have h := plateauMap_lipschitz c hc 0 x
  simpa [plateauMap_middle c 0 (by linarith) hc] using h

theorem plateauMap_inner (c d x : ℝ) (hc : 0 ≤ c) (hd : 0 ≤ d)
    (hx : |x| ≤ c+d) : |plateauMap c x| ≤ d := by
  have hx' := abs_le.mp hx
  unfold plateauMap
  split_ifs <;> rw [abs_le] <;> constructor <;> linarith

theorem plateauMap_outer (c d x : ℝ) (hc : 0 ≤ c) (hd : 0 ≤ d)
    (hx : c+d ≤ |x|) : d ≤ |plateauMap c x| := by
  by_cases hxp : 0 ≤ x
  · rw [abs_of_nonneg hxp] at hx
    rw [plateauMap_right c x hc (by linarith), abs_of_nonneg (by linarith)]
    linarith
  · rw [abs_of_nonpos (by linarith)] at hx
    rw [plateauMap_left c x (by linarith), abs_of_nonpos (by linarith)]
    linarith

/-- A short interval either sees the same affine branch or remains entirely in
    the region where every fixed cutoff is constant in this coordinate. -/
theorem plateauMap_step_alternative (c d x y : ℝ) (hc : 0 ≤ c) (hd : 0 ≤ d)
    (hxy : |y-x| ≤ d) :
    plateauMap c y-plateauMap c x = y-x ∨
      (|plateauMap c x| ≤ d ∧ |plateauMap c y| ≤ d) := by
  have hxy' := abs_le.mp hxy
  unfold plateauMap
  split_ifs <;> first
    | (left; ring1)
    | right; constructor <;> rw [abs_le] <;> constructor <;> linarith

/-- Rescaled plateau map. -/
def thinCoord (a δ x : ℝ) : ℝ := plateauMap (a-δ) x / δ

def thinMap (a δ : ℝ) (z : ℝ × ℝ) : ℝ × ℝ :=
  (thinCoord a δ z.1, thinCoord a δ z.2)

def thinProfile (a δ : ℝ) (m s : Bool) (z : ℝ × ℝ) : ℝ :=
  squareProfile m s (thinMap a δ z) / Real.sqrt δ

def thinTheta (a δ : ℝ) (z : ℝ × ℝ) : ℝ :=
  squareTheta (thinMap a δ z)

theorem thinCoord_lipschitz (a δ : ℝ) (hδ : 0 < δ) (ha : δ ≤ a) (x y : ℝ) :
    |thinCoord a δ y-thinCoord a δ x| ≤ |y-x|/δ := by
  simp only [thinCoord, ← sub_div, abs_div, abs_of_pos hδ]
  exact div_le_div_of_nonneg_right (plateauMap_lipschitz (a-δ) (sub_nonneg.mpr ha) x y) hδ.le

theorem thinMap_lipschitz (a δ : ℝ) (hδ : 0 < δ) (ha : δ ≤ a) (z w : ℝ × ℝ) :
    ‖thinMap a δ w-thinMap a δ z‖ ≤ ‖w-z‖/δ := by
  simp only [thinMap, Prod.mk_sub_mk, Prod.norm_def, Real.norm_eq_abs]
  apply max_le
  · exact (thinCoord_lipschitz a δ hδ ha z.1 w.1).trans
      (div_le_div_of_nonneg_right (le_max_left _ _) hδ.le)
  · exact (thinCoord_lipschitz a δ hδ ha z.2 w.2).trans
      (div_le_div_of_nonneg_right (le_max_right _ _) hδ.le)

theorem thinCoord_inner (a δ x : ℝ) (hδ : 0 < δ) (ha : δ ≤ a)
    (hx : |x| ≤ a) : |thinCoord a δ x| ≤ 1 := by
  rw [thinCoord, abs_div, abs_of_pos hδ, div_le_one hδ]
  apply plateauMap_inner (a-δ) δ x (sub_nonneg.mpr ha) hδ.le
  linarith

theorem thinCoord_outer (a δ x : ℝ) (hδ : 0 < δ) (ha : δ ≤ a)
    (hx : a+δ ≤ |x|) : 2 ≤ |thinCoord a δ x| := by
  rw [thinCoord, abs_div, abs_of_pos hδ, le_div_iff₀ hδ]
  apply plateauMap_outer (a-δ) (2*δ) x (sub_nonneg.mpr ha) (by positivity)
  linarith

theorem thinProfile_zero_inner (a δ : ℝ) (hδ : 0 < δ) (ha : δ ≤ a)
    (m s : Bool) (z : ℝ × ℝ) (hx : |z.1| ≤ a) (hy : |z.2| ≤ a) :
    thinProfile a δ m s z = 0 := by
  unfold thinProfile
  rw [squareProfile_zero_inner m s (thinMap a δ z)
    (thinCoord_inner a δ z.1 hδ ha hx) (thinCoord_inner a δ z.2 hδ ha hy), zero_div]

theorem thinProfile_zero_outer (a δ : ℝ) (hδ : 0 < δ) (ha : δ ≤ a)
    (m s : Bool) (z : ℝ × ℝ) (hz : a+δ ≤ |z.1| ∨ a+δ ≤ |z.2|) :
    thinProfile a δ m s z = 0 := by
  unfold thinProfile
  rw [squareProfile_zero_outer m s (thinMap a δ z) ?_, zero_div]
  rcases hz with h | h
  · exact Or.inl (thinCoord_outer a δ z.1 hδ ha h)
  · exact Or.inr (thinCoord_outer a δ z.2 hδ ha h)

theorem thinTheta_one (a δ : ℝ) (hδ : 0 < δ) (ha : δ ≤ a)
    (z : ℝ × ℝ) (hx : |z.1| ≤ a) (hy : |z.2| ≤ a) :
    thinTheta a δ z = 1 := by
  exact squareTheta_one (thinMap a δ z)
    (thinCoord_inner a δ z.1 hδ ha hx) (thinCoord_inner a δ z.2 hδ ha hy)

theorem thinTheta_zero (a δ : ℝ) (hδ : 0 < δ) (ha : δ ≤ a)
    (z : ℝ × ℝ) (hz : a+δ ≤ |z.1| ∨ a+δ ≤ |z.2|) :
    thinTheta a δ z = 0 := by
  apply squareTheta_zero
  rcases hz with h | h
  · exact Or.inl (thinCoord_outer a δ z.1 hδ ha h)
  · exact Or.inr (thinCoord_outer a δ z.2 hδ ha h)

theorem thinProfile_uniform_bounds : ∃ P : ℝ, 1 ≤ P ∧
    ∀ (a δ : ℝ), 0 < δ → δ ≤ a →
      (∀ m s z, |thinProfile a δ m s z| ≤ P/Real.sqrt δ) ∧
      (∀ m s z w, |thinProfile a δ m s w-thinProfile a δ m s z| ≤
        (P/(δ*Real.sqrt δ))*‖w-z‖) := by
  obtain ⟨P,hP,hv,hL⟩ := profiles_uniform_bound
  refine ⟨P,hP,?_⟩
  intro a δ hδ ha
  have hs : 0 < Real.sqrt δ := Real.sqrt_pos.mpr hδ
  constructor
  · intro m s z
    rw [thinProfile, abs_div, abs_of_pos hs]
    exact div_le_div_of_nonneg_right (hv m s (thinMap a δ z)) hs.le
  · intro m s z w
    simp only [thinProfile, ← sub_div, abs_div, abs_of_pos hs]
    calc
      _ ≤ (P*‖thinMap a δ w-thinMap a δ z‖)/Real.sqrt δ :=
        div_le_div_of_nonneg_right (hL m s (thinMap a δ z) (thinMap a δ w)) hs.le
      _ ≤ (P*(‖w-z‖/δ))/Real.sqrt δ := by
        gcongr
        exact thinMap_lipschitz a δ hδ ha z w
      _ = _ := by ring

theorem thinTheta_lipschitz_bound : ∃ L : ℝ, 0 ≤ L ∧
    ∀ (a δ : ℝ), 0 < δ → δ ≤ a → ∀ z w,
      |thinTheta a δ w-thinTheta a δ z| ≤ (L/δ)*‖w-z‖ := by
  obtain ⟨L,hL,h⟩ := theta_lipschitz_bound
  refine ⟨L,hL,?_⟩
  intro a δ hδ ha z w
  calc
    _ ≤ L*‖thinMap a δ w-thinMap a δ z‖ := h _ _
    _ ≤ L*(‖w-z‖/δ) := mul_le_mul_of_nonneg_left (thinMap_lipschitz a δ hδ ha z w) hL
    _ = _ := by ring

/-- The coordinate changed by a square-lattice step. -/
def stepCoordinate (m : Bool) (z : ℝ × ℝ) : ℝ := if m then z.2 else z.1

def thinIncrement (a δ : ℝ) (m : Bool) (ε : ℝ) (z : ℝ × ℝ) : ℝ :=
  thinCoord a δ (stepCoordinate m z+ε)-thinCoord a δ (stepCoordinate m z)

theorem thinMap_squareStep (a δ : ℝ) (m : Bool) (ε : ℝ) (z : ℝ × ℝ) :
    thinMap a δ (squareStep m ε z) =
      squareStep m (thinIncrement a δ m ε z) (thinMap a δ z) := by
  cases m <;> simp [thinMap, squareStep, thinIncrement, stepCoordinate]

theorem thinIncrement_bound (a δ : ℝ) (hδ : 0 < δ) (ha : δ ≤ a)
    (m : Bool) (ε : ℝ) (z : ℝ × ℝ) :
    |thinIncrement a δ m ε z| ≤ |ε|/δ := by
  simpa only [thinIncrement, add_sub_cancel_left] using
    thinCoord_lipschitz a δ hδ ha (stepCoordinate m z) (stepCoordinate m z+ε)

theorem thinIncrement_alternative (a δ : ℝ) (hδ : 0 < δ) (ha : δ ≤ a)
    (m : Bool) (ε : ℝ) (z : ℝ × ℝ) (hε : |ε| ≤ δ/16) :
    thinIncrement a δ m ε z = ε/δ ∨
      (|thinCoord a δ (stepCoordinate m z)| ≤ 1/16 ∧
        |thinCoord a δ (stepCoordinate m z+ε)| ≤ 1/16) := by
  have hh := plateauMap_step_alternative (a-δ) (δ/16)
    (stepCoordinate m z) (stepCoordinate m z+ε) (sub_nonneg.mpr ha)
    (by positivity) (by simpa only [add_sub_cancel_left] using hε)
  rcases hh with hh | ⟨hx,hy⟩
  · left
    simp only [thinIncrement, thinCoord, ←sub_div, hh, add_sub_cancel_left]
  · right
    constructor
    · rw [thinCoord, abs_div, abs_of_pos hδ, div_le_iff₀ hδ]
      linarith
    · rw [thinCoord, abs_div, abs_of_pos hδ, div_le_iff₀ hδ]
      linarith

theorem thinProfile_product_scale (a δ : ℝ) (hδ : 0 < δ)
    (m : Bool) (z w : ℝ × ℝ) :
    thinProfile a δ m false z*thinProfile a δ m false w-
      thinProfile a δ m true z*thinProfile a δ m true w =
    (squareProfile m false (thinMap a δ z)*squareProfile m false (thinMap a δ w)-
      squareProfile m true (thinMap a δ z)*squareProfile m true (thinMap a δ w))/δ := by
  simp only [thinProfile, div_mul_div_comm, ←sub_div, ←pow_two, Real.sq_sqrt hδ.le]

theorem squareGradient_zero_of_stepCoordinate (m : Bool) (z : ℝ × ℝ)
    (h : |stepCoordinate m z| ≤ 4/3) : squareGradient m z = 0 := by
  cases m
  · have hh : |z.1| ≤ 4/3 := h
    simp [squareGradient, thetaBump_deriv_zero_inner hh]
  · have hh : |z.2| ≤ 4/3 := h
    simp [squareGradient, thetaBump_deriv_zero_inner hh]

theorem thinTheta_step_error : ∃ D : ℝ, 0 ≤ D ∧
    ∀ (a δ : ℝ), 0 < δ → δ ≤ a → ∀ (m : Bool) (z : ℝ × ℝ) (ε : ℝ),
    |ε| ≤ δ/16 →
    |thinTheta a δ (squareStep m ε z)-thinTheta a δ z-
      ε*(thinProfile a δ m false z*thinProfile a δ m false (squareStep m ε z)-
         thinProfile a δ m true z*thinProfile a δ m true (squareStep m ε z))| ≤
      (D/δ^3)*|ε|^3 := by
  obtain ⟨D,hD,hR⟩ := squareTheta_step_error
  refine ⟨D,hD,?_⟩
  intro a δ hδ ha m z ε hε
  let η := thinIncrement a δ m ε z
  let v := thinMap a δ z
  let w := thinMap a δ (squareStep m ε z)
  have hη : |η| ≤ |ε|/δ := thinIncrement_bound a δ hδ ha m ε z
  have hsmall : |η| ≤ 1/16 := hη.trans ((div_le_iff₀ hδ).mpr (by linarith))
  have hw : w = squareStep m η v := thinMap_squareStep a δ m ε z
  have hprod := squareProfile_product_difference m v w
    (by rw [hw]; cases m <;> simpa [squareStep] using hsmall)
    (by rw [hw]; cases m <;> simpa [squareStep] using hsmall)
  let F := squareProfile m false v*squareProfile m false w-
    squareProfile m true v*squareProfile m true w
  have hcoef : η*F = (ε/δ)*F := by
    rcases thinIncrement_alternative a δ hδ ha m ε z hε with heq | ⟨hx,hy⟩
    · rw [show η = ε/δ from heq]
    · have hv0 : squareGradient m v = 0 := by
        apply squareGradient_zero_of_stepCoordinate
        have heq : stepCoordinate m v = thinCoord a δ (stepCoordinate m z) := by
          cases m <;> rfl
        rw [heq]
        linarith
      have hw0 : squareGradient m w = 0 := by
        apply squareGradient_zero_of_stepCoordinate
        have heq : stepCoordinate m w = thinCoord a δ (stepCoordinate m z+ε) := by
          cases m <;> rfl
        rw [heq]
        linarith
      have hF : F = 0 := by dsimp only [F]; rw [hprod,hv0,hw0]; ring
      rw [hF]; ring
  have h := hR m v η hsmall
  rw [←hw] at h
  change |squareTheta w-squareTheta v-η*F| ≤ D*|η|^3 at h
  rw [hcoef] at h
  rw [thinProfile_product_scale a δ hδ m z (squareStep m ε z)]
  change |squareTheta w-squareTheta v-ε*(F/δ)| ≤ _
  calc
    _ = |squareTheta w-squareTheta v-(ε/δ)*F| := by congr 1; ring
    _ ≤ D*|η|^3 := h
    _ ≤ D*(|ε|/δ)^3 := by gcongr
    _ = _ := by ring

end
end RP3.Fourier
end StandalonePart2

/- ===== RP3/Averaging.lean ===== -/
section StandalonePart3

/-!
# Exact annular averaging

Continuous functions are used so a positive linear functional can be actual
integration against a finite measure on a compact configuration space.
The abstract interface lists the structural averaging properties explicitly.
It contains no decay assumption and no correlation estimate.
-/

namespace RP3

open Finset

variable {Ω ι : Type*} [TopologicalSpace Ω]

/-- Unnormalised integration, retaining positivity and linearity. -/
structure PositiveIntegral (Ω : Type*) [TopologicalSpace Ω] where
  linear : C(Ω, ℝ) →ₗ[ℝ] ℝ
  nonneg : ∀ f, (∀ x, 0 ≤ f x) → 0 ≤ linear f

namespace PositiveIntegral

variable (I : PositiveIntegral Ω)

theorem mono {f g : C(Ω, ℝ)} (h : ∀ x, f x ≤ g x) : I.linear f ≤ I.linear g := by
  have hn := I.nonneg (g - f) (fun x => sub_nonneg.mpr (h x))
  simpa only [map_sub, sub_nonneg] using hn

/-- The elementary bounded-observable estimate for a nonnegative weight. -/
theorem abs_weighted_le (O W : C(Ω, ℝ)) {M : ℝ}
    (hO : ∀ x, |O x| ≤ M) (hW : ∀ x, 0 ≤ W x) :
    |I.linear (O * W)| ≤ M * I.linear W := by
  apply abs_le.mpr
  constructor
  · have h := I.mono (f := (-M) • W) (g := O * W) (fun x => by
      change -M * W x ≤ O x * W x
      exact mul_le_mul_of_nonneg_right (abs_le.mp (hO x)).1 (hW x))
    simpa using h
  · have h := I.mono (f := O * W) (g := M • W) (fun x => by
      change O x * W x ≤ M * W x
      exact mul_le_mul_of_nonneg_right (abs_le.mp (hO x)).2 (hW x))
    simpa using h

end PositiveIntegral

/-- A commuting family of averaging projections for nested cuts.

`pull` is the usual rule for taking an invariant factor out of an average.
`preserve` is invariance of the reference integral.  Commutation expresses
normalisation of inner rotations by outer rotations; it does NOT assert
independence of annuli.
-/
structure AveragingSystem (I : PositiveIntegral Ω) (ι : Type*) where
  avg : ι → C(Ω, ℝ) →ₗ[ℝ] C(Ω, ℝ)
  one : ∀ i, avg i 1 = 1
  idem : ∀ i f, avg i (avg i f) = avg i f
  commute : ∀ i j f, avg i (avg j f) = avg j (avg i f)
  pull : ∀ i f g, avg i f = f → avg i (f * g) = f * avg i g
  preserve : ∀ i f, I.linear (avg i f) = I.linear f

namespace AveragingSystem

variable {I : PositiveIntegral Ω} (S : AveragingSystem I ι)

/-- The positive remainder of one annular kernel. -/
noncomputable def remainder (i : ι) (ε : ℝ) (K : C(Ω, ℝ)) : C(Ω, ℝ) :=
  ε⁻¹ • (K - (1 - ε) • S.avg i K)

theorem split (i : ι) {ε : ℝ} (hε : ε ≠ 0) (K : C(Ω, ℝ)) :
    K = (1 - ε) • S.avg i K + ε • S.remainder i ε K := by
  ext x
  simp only [remainder, ContinuousMap.add_apply, ContinuousMap.smul_apply,
    ContinuousMap.sub_apply, smul_eq_mul]
  field_simp
  ring

theorem remainder_nonneg (i : ι) {ε : ℝ} (hε : 0 < ε) (K : C(Ω, ℝ))
    (hlower : ∀ x, (1 - ε) * S.avg i K x ≤ K x) :
    ∀ x, 0 ≤ S.remainder i ε K x := by
  intro x
  exact mul_nonneg (inv_nonneg.mpr hε.le) (sub_nonneg.mpr (hlower x))

theorem avg_remainder (i : ι) {ε : ℝ} (hε : ε ≠ 0) (K : C(Ω, ℝ)) :
    S.avg i (S.remainder i ε K) = S.avg i K := by
  simp only [remainder, map_smul, map_sub, S.idem]
  ext x
  simp only [ContinuousMap.smul_apply, ContinuousMap.sub_apply, smul_eq_mul]
  field_simp
  ring

theorem fixed_mul (i : ι) {f g : C(Ω, ℝ)}
    (hf : S.avg i f = f) (hg : S.avg i g = g) : S.avg i (f * g) = f * g := by
  rw [S.pull i f g hf, hg]

theorem fixed_prod (i : ι) (s : Finset ι) (K : ι → C(Ω, ℝ))
    (hK : ∀ j ∈ s, S.avg i (K j) = K j) :
    S.avg i (∏ j ∈ s, K j) = ∏ j ∈ s, K j := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using S.one i
  | @insert j s hj ih =>
    simp only [prod_insert hj]
    apply S.fixed_mul
    · exact hK j (mem_insert_self _ _)
    · apply ih
      exact fun j hj => hK j (mem_insert_of_mem hj)

theorem remainder_fixed (i j : ι) {ε : ℝ} (K : C(Ω, ℝ))
    (hK : S.avg j K = K) : S.avg j (S.remainder i ε K) = S.remainder i ε K := by
  simp only [remainder, map_smul, map_sub, hK, S.commute j i K]

/-- Replacing one annulus by its remainder preserves the unnormalised partition function. -/
theorem partition_replace (i : ι) {ε : ℝ} (hε : ε ≠ 0)
    (W K : C(Ω, ℝ)) (hW : S.avg i W = W) :
    I.linear (W * S.remainder i ε K) = I.linear (W * K) := by
  calc
    _ = I.linear (S.avg i (W * S.remainder i ε K)) := (S.preserve _ _).symm
    _ = I.linear (W * S.avg i K) := by rw [S.pull _ _ _ hW, S.avg_remainder i hε K]
    _ = I.linear (S.avg i (W * K)) := by rw [S.pull _ _ _ hW]
    _ = _ := S.preserve _ _

/-- An averaged annulus kills an observable whose rotational average vanishes. -/
theorem numerator_average_zero (i : ι) (O W K : C(Ω, ℝ))
    (hO : S.avg i O = 0) (hW : S.avg i W = W) :
    I.linear (O * W * S.avg i K) = 0 := by
  have hF := S.fixed_mul i hW (S.idem i K)
  calc
    _ = I.linear ((W * S.avg i K) * O) := by congr 1; ring
    _ = I.linear (S.avg i ((W * S.avg i K) * O)) := (S.preserve _ _).symm
    _ = 0 := by rw [S.pull _ _ _ hF, hO, mul_zero, map_zero]

/-- Exactly one error factor is extracted; the remaining weight stays nonnegative. -/
theorem numerator_replace (i : ι) {ε : ℝ} (hε : ε ≠ 0)
    (O W K : C(Ω, ℝ)) (hO : S.avg i O = 0) (hW : S.avg i W = W) :
    I.linear (O * W * K) = ε * I.linear (O * W * S.remainder i ε K) := by
  have heq : O * W * K = (1 - ε) • (O * W * S.avg i K) +
      ε • (O * W * S.remainder i ε K) := by
    conv_lhs => rw [S.split i hε K]
    ext x
    simp only [ContinuousMap.mul_apply, ContinuousMap.add_apply,
      ContinuousMap.smul_apply, smul_eq_mul]
    ring
  rw [heq, map_add, map_smul, map_smul, S.numerator_average_zero i O W K hO hW]
  simp

/-- The nested-annulus product estimate, proved by successive replacements.
All analytic information is in the pointwise lower bounds `hlower`.
The other hypotheses express locality, symmetry, and positivity. -/
theorem product_bound (s : Finset ι) (ε : ι → ℝ) (K : ι → C(Ω, ℝ))
    (O W : C(Ω, ℝ)) {M : ℝ}
    (hε : ∀ i ∈ s, 0 < ε i)
    (hK : ∀ i ∈ s, ∀ x, 0 ≤ K i x)
    (hlower : ∀ i ∈ s, ∀ x, (1 - ε i) * S.avg i (K i) x ≤ K i x)
    (hcross : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → S.avg i (K j) = K j)
    (hO : ∀ i ∈ s, S.avg i O = 0)
    (hObound : ∀ x, |O x| ≤ M)
    (hW : ∀ x, 0 ≤ W x) (hWfixed : ∀ i ∈ s, S.avg i W = W) :
    |I.linear (O * W * ∏ i ∈ s, K i)| ≤
      M * (∏ i ∈ s, ε i) * I.linear (W * ∏ i ∈ s, K i) := by
  classical
  induction s using Finset.induction_on generalizing W with
  | empty =>
    simpa using I.abs_weighted_le O W hObound hW
  | @insert i s hi ih =>
    have hi' : i ∈ insert i s := mem_insert_self i s
    have hin (j : ι) (hj : j ∈ s) : j ∈ insert i s := mem_insert_of_mem hj
    let L := S.remainder i (ε i) (K i)
    let P := ∏ j ∈ s, K j
    have hL : ∀ x, 0 ≤ L x := S.remainder_nonneg i (hε i hi') _ (hlower i hi')
    have hPfixed : S.avg i P = P := S.fixed_prod i s K (by
      intro j hj
      exact hcross i hi' j (hin j hj) (by intro he; subst j; exact hi hj))
    have hWP : S.avg i (W * P) = W * P := S.fixed_mul i (hWfixed i hi') hPfixed
    have hpart : I.linear ((W * L) * P) = I.linear (W * (K i * P)) := by
      calc
        _ = I.linear ((W * P) * L) := by congr 1; ring
        _ = I.linear ((W * P) * K i) :=
          S.partition_replace i (ne_of_gt (hε i hi')) (W * P) (K i) hWP
        _ = _ := by congr 1; ring
    have hnum : I.linear (O * W * (K i * P)) =
        ε i * I.linear (O * (W * L) * P) := by
      calc
        _ = I.linear (O * (W * P) * K i) := by congr 1; ring
        _ = ε i * I.linear (O * (W * P) * L) :=
          S.numerator_replace i (ne_of_gt (hε i hi')) O (W * P) (K i) (hO i hi') hWP
        _ = _ := by congr 2; ring
    have hb := ih (W * L)
      (fun j hj => hε j (hin j hj))
      (fun j hj => hK j (hin j hj))
      (fun j hj => hlower j (hin j hj))
      (fun j hj l hl => hcross j (hin j hj) l (hin l hl))
      (fun j hj => hO j (hin j hj))
      (fun x => mul_nonneg (hW x) (hL x)) (by
        intro j hj
        apply S.fixed_mul j (hWfixed j (hin j hj))
        exact S.remainder_fixed i j (K i)
          (hcross j (hin j hj) i hi' (by intro he; subst j; exact hi hj)))
    rw [prod_insert hi, prod_insert hi]
    change |I.linear (O * W * (K i * P))| ≤ _
    rw [hnum, abs_mul, abs_of_pos (hε i hi')]
    calc
      ε i * |I.linear (O * (W * L) * P)| ≤
          ε i * (M * (∏ j ∈ s, ε j) * I.linear ((W * L) * P)) :=
        mul_le_mul_of_nonneg_left hb (hε i hi').le
      _ = M * (ε i * ∏ j ∈ s, ε j) * I.linear (W * (K i * P)) := by
        rw [hpart]
        ring

/-- Division by a positive partition function gives the correlation bound. -/
theorem correlation_bound (s : Finset ι) (ε : ι → ℝ) (K : ι → C(Ω, ℝ))
    (O W : C(Ω, ℝ)) {M : ℝ}
    (hε : ∀ i ∈ s, 0 < ε i)
    (hK : ∀ i ∈ s, ∀ x, 0 ≤ K i x)
    (hlower : ∀ i ∈ s, ∀ x, (1 - ε i) * S.avg i (K i) x ≤ K i x)
    (hcross : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → S.avg i (K j) = K j)
    (hO : ∀ i ∈ s, S.avg i O = 0) (hObound : ∀ x, |O x| ≤ M)
    (hW : ∀ x, 0 ≤ W x) (hWfixed : ∀ i ∈ s, S.avg i W = W)
    (hZ : 0 < I.linear (W * ∏ i ∈ s, K i)) :
    |I.linear (O * W * ∏ i ∈ s, K i) / I.linear (W * ∏ i ∈ s, K i)| ≤
      M * ∏ i ∈ s, ε i := by
  rw [abs_div, abs_of_pos hZ]
  exact (div_le_iff₀ hZ).mpr
    (S.product_bound s ε K O W hε hK hlower hcross hO hObound hW hWfixed)

end AveragingSystem
end RP3
end StandalonePart3

/- ===== RP3/FiniteAveraging.lean ===== -/
section StandalonePart4

/-! Concrete finite-group averages and integration against finite measures. -/

namespace RP3

open Finset MeasureTheory

variable {Ω G : Type*} [TopologicalSpace Ω]

/-- A continuous finite-group action, written without a global typeclass so
several different cuts can act on the same configuration space. -/
structure FiniteAction (G Ω : Type*) [Group G] [TopologicalSpace Ω] where
  move : G → C(Ω, Ω)
  one_apply : ∀ x, move 1 x = x
  mul_apply : ∀ g h x, move (g * h) x = move g (move h x)

namespace FiniteAction

variable [Group G] [Fintype G] (A : FiniteAction G Ω)

noncomputable def pullback (g : G) : C(Ω, ℝ) →ₗ[ℝ] C(Ω, ℝ) where
  toFun f := f.comp (A.move g)
  map_add' f h := by ext x; rfl
  map_smul' c f := by ext x; rfl

noncomputable def average : C(Ω, ℝ) →ₗ[ℝ] C(Ω, ℝ) :=
  (Fintype.card G : ℝ)⁻¹ • ∑ g : G, A.pullback g

@[simp] theorem average_apply (f : C(Ω, ℝ)) (x : Ω) :
    A.average f x = (Fintype.card G : ℝ)⁻¹ * ∑ g : G, f (A.move g x) := by
  simp [average, pullback]

theorem card_ne_zero : (Fintype.card G : ℝ) ≠ 0 := by
  exact_mod_cast Fintype.card_ne_zero

theorem invariant (f : C(Ω, ℝ)) (g : G) (x : Ω) :
    A.average f (A.move g x) = A.average f x := by
  simp only [average_apply, ← A.mul_apply]
  congr 1
  exact Equiv.sum_comp (Equiv.mulRight g) (fun h => f (A.move h x))

theorem average_of_invariant (f : C(Ω, ℝ))
    (hf : ∀ g x, f (A.move g x) = f x) : A.average f = f := by
  ext x
  simp only [average_apply, hf, sum_const, card_univ, nsmul_eq_mul]
  exact inv_mul_cancel_left₀ (card_ne_zero (G := G)) _

theorem average_one : A.average 1 = 1 :=
  A.average_of_invariant 1 (fun _ _ => rfl)

theorem average_idem (f : C(Ω, ℝ)) : A.average (A.average f) = A.average f :=
  A.average_of_invariant _ (A.invariant f)

theorem average_pull (f h : C(Ω, ℝ)) (hf : A.average f = f) :
    A.average (f * h) = f * A.average h := by
  have hfinv (g : G) (x : Ω) : f (A.move g x) = f x := by
    rw [← hf]
    exact A.invariant f g x
  ext x
  simp only [average_apply, ContinuousMap.mul_apply, hfinv, ← mul_sum]
  ring

theorem average_nonneg (f : C(Ω, ℝ)) (hf : ∀ x, 0 ≤ f x) :
    ∀ x, 0 ≤ A.average f x := by
  intro x
  rw [average_apply]
  exact mul_nonneg (by positivity) (sum_nonneg (fun g _ => hf _))

/-- Pairwise rotational comparison implies the lower bound used to split a kernel. -/
theorem comparison_lower (K : C(Ω, ℝ)) (ε : ℝ)
    (hcomp : ∀ g x, (1 - ε) * K (A.move g x) ≤ K x) :
    ∀ x, (1 - ε) * A.average K x ≤ K x := by
  intro x
  have hs := sum_le_sum (s := (univ : Finset G)) (fun g _ => hcomp g x)
  simp only [sum_const, card_univ, nsmul_eq_mul, ← mul_sum] at hs
  have hc : (0 : ℝ) < Fintype.card G := by exact_mod_cast Fintype.card_pos
  rw [average_apply]
  calc
    (1 - ε) * ((Fintype.card G : ℝ)⁻¹ * ∑ g, K (A.move g x)) =
        ((1 - ε) * ∑ g, K (A.move g x)) / Fintype.card G := by ring
    _ ≤ K x := (div_le_iff₀ hc).mpr (by simpa [mul_comm] using hs)

theorem preserve_integral (I : PositiveIntegral Ω)
    (hI : ∀ g f, I.linear (A.pullback g f) = I.linear f) (f : C(Ω, ℝ)) :
    I.linear (A.average f) = I.linear f := by
  simp only [average, LinearMap.smul_apply, LinearMap.sum_apply, map_smul,
    map_sum, hI, sum_const, card_univ, nsmul_eq_mul, smul_eq_mul]
  exact inv_mul_cancel_left₀ (card_ne_zero (G := G)) _

/-- Normalisation of one rotation subgroup by another makes their averages commute.
The reindexing `e h` is conjugation for nested cuts. -/
theorem averages_commute_of_normalizes (B : FiniteAction G Ω)
    (e : G → G ≃ G)
    (hn : ∀ g h x, B.move h (A.move g x) = A.move (e h g) (B.move h x))
    (f : C(Ω, ℝ)) : A.average (B.average f) = B.average (A.average f) := by
  ext x
  simp only [average_apply, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro h _
  simp only [hn]
  exact Equiv.sum_comp (e h) (fun g => (Fintype.card G : ℝ)⁻¹ *
    ((Fintype.card G : ℝ)⁻¹ * f (A.move g (B.move h x))))

end FiniteAction

/-- The positive integral interface is realised by ordinary integration;
compactness ensures every continuous function here is integrable. -/
noncomputable def integralOnCompact [CompactSpace Ω] [MeasurableSpace Ω]
    [OpensMeasurableSpace Ω] (μ : Measure Ω) [IsFiniteMeasure μ] : PositiveIntegral Ω where
  linear := {
    toFun := fun f => ∫ x, f x ∂μ
    map_add' := fun f g => integral_add
      (f.continuous.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
      (g.continuous.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
    map_smul' := fun c f => integral_smul c f }
  nonneg := fun _ hf => integral_nonneg hf

/-- Assemble the structural interface from actual finite actions and invariant integration. -/
noncomputable def systemOfFiniteActions {ι : Type*} [Group G] [Fintype G]
    (I : PositiveIntegral Ω) (A : ι → FiniteAction G Ω)
    (hI : ∀ i g f, I.linear ((A i).pullback g f) = I.linear f)
    (hc : ∀ i j f, (A i).average ((A j).average f) =
      (A j).average ((A i).average f)) : AveragingSystem I ι where
  avg i := (A i).average
  one i := (A i).average_one
  idem i := (A i).average_idem
  commute := hc
  pull i := (A i).average_pull
  preserve i := (A i).preserve_integral I (hI i)

end RP3
end StandalonePart4

/- ===== RP3/Model.lean ===== -/
section StandalonePart5

/-!
# The finite-volume RP³ model and its quadrupolar observable

Spins are unit vectors, and the interaction and observable are invariant under
independent changes of sign.  Thus they descend to director spins without
choosing a global lift.  No decay theorem is assumed in this module.
-/

namespace RP3

open MeasureTheory
open scoped BigOperators InnerProductSpace

abbrev E4 := EuclideanSpace ℝ (Fin 4)
abbrev Spin := Metric.sphere (0 : E4) 1

@[simp] theorem spin_norm (s : Spin) : ‖s.val‖ = 1 :=
  mem_sphere_zero_iff_norm.mp s.property

noncomputable def antipode (s : Spin) : Spin :=
  ⟨-s.val, mem_sphere_zero_iff_norm.mpr (by simp)⟩

noncomputable def qPair (s t : Spin) : ℝ :=
  ⟪s.val, t.val⟫_ℝ ^ 2 - 1/4

/-- The quadrupolar observable is a function of directors. -/
@[simp] theorem qPair_antipode_left (s t : Spin) : qPair (antipode s) t = qPair s t := by
  simp [qPair, antipode]

@[simp] theorem qPair_antipode_right (s t : Spin) : qPair s (antipode t) = qPair s t := by
  simp [qPair, antipode]

/-- This normalisation is `Tr (Q(s) Q(t))`, not the Legendre `P₂` normalisation. -/
theorem abs_qPair_le (s t : Spin) : |qPair s t| ≤ (3 : ℝ) / 4 := by
  have h := abs_real_inner_le_norm s.val t.val
  simp only [spin_norm, one_mul] at h
  have hs : ⟪s.val, t.val⟫_ℝ ^ 2 ≤ 1 := (sq_le_one_iff_abs_le_one _).mpr h
  rw [qPair, abs_le]
  constructor <;> nlinarith [sq_nonneg ⟪s.val, t.val⟫_ℝ]

noncomputable def Q (s : Spin) : Matrix (Fin 4) (Fin 4) ℝ :=
  fun i j => s.val i * s.val j - if i = j then 1/4 else 0

theorem spin_squares (s : Spin) : ∑ i : Fin 4, s.val i ^ 2 = 1 := by
  rw [← EuclideanSpace.real_norm_sq_eq, spin_norm]
  norm_num

/-- The tensor and scalar definitions of the observable coincide. -/
theorem trace_Q_mul (s t : Spin) : Matrix.trace (Q s * Q t) = qPair s t := by
  have hs := spin_squares s
  have ht := spin_squares t
  simp [Fin.sum_univ_succ] at hs ht
  simp only [Matrix.trace, Matrix.diag, Matrix.mul_apply, Q, qPair, PiLp.inner_apply,
    RCLike.inner_apply, conj_trivial, Fin.sum_univ_succ, Fin.sum_univ_zero]
  norm_num
  nlinarith [hs, ht]

/-- Normalised surface area on the sphere. -/
noncomputable def sphereProbability : Measure Spin :=
  ((volume : Measure E4).toSphere Set.univ)⁻¹ • (volume : Measure E4).toSphere

instance sphereProbability_isProbability : IsProbabilityMeasure sphereProbability := by
  have hs : (volume : Measure E4).toSphere ≠ 0 := Measure.toSphere_ne_zero _
  constructor
  dsimp [sphereProbability]
  exact ENNReal.inv_mul_cancel (Measure.measure_univ_eq_zero.not.mpr hs)
    (measure_ne_top _ _)

section FiniteVolume

variable {V E : Type*} [Fintype V] [Fintype E]

abbrev Configuration (V : Type*) := V → Spin

noncomputable def referenceLaw : Measure (Configuration V) :=
  Measure.pi (fun _ => sphereProbability)

instance referenceLaw_isProbability : IsProbabilityMeasure (referenceLaw (V := V)) := by
  unfold referenceLaw
  infer_instance

/-- General finite graph with oriented representatives of its unoriented edges.
The square-lattice geometry is needed later, when annuli are constructed. -/
noncomputable def interaction (edge : E → V × V) (b : E → ℝ)
    (σ : Configuration V) : ℝ :=
  ∑ e, b e * ⟪(σ (edge e).1).val, (σ (edge e).2).val⟫_ℝ ^ 2

noncomputable def weight (edge : E → V × V) (b : E → ℝ) : C(Configuration V, ℝ) :=
  ⟨fun σ => Real.exp (interaction edge b σ), by unfold interaction; fun_prop⟩

noncomputable def observable (x y : V) : C(Configuration V, ℝ) :=
  ⟨fun σ => qPair (σ x) (σ y), by unfold qPair; fun_prop⟩

noncomputable def partition (edge : E → V × V) (b : E → ℝ) : ℝ :=
  (integralOnCompact (referenceLaw (V := V))).linear (weight edge b)

noncomputable def correlation (edge : E → V × V) (b : E → ℝ) (x y : V) : ℝ :=
  (integralOnCompact (referenceLaw (V := V))).linear
    (observable x y * weight edge b) / partition edge b

theorem partition_pos (edge : E → V × V) (b : E → ℝ) : 0 < partition edge b := by
  change 0 < ∫ σ, Real.exp (interaction edge b σ) ∂referenceLaw
  apply (integral_pos_iff_support_of_nonneg (fun _ => (Real.exp_pos _).le)
    ((weight edge b).continuous.integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _))).mpr
  have hs : Function.support (fun σ : Configuration V => Real.exp (interaction edge b σ)) =
      Set.univ := by ext σ; simp [Function.mem_support, Real.exp_ne_zero]
  rw [hs, measure_univ]
  exact zero_lt_one

theorem abs_correlation_le (edge : E → V × V) (b : E → ℝ) (x y : V) :
    |correlation edge b x y| ≤ (3 : ℝ) / 4 := by
  have hb := (integralOnCompact (referenceLaw (V := V))).abs_weighted_le
    (observable x y) (weight edge b)
    (fun σ => abs_qPair_le (σ x) (σ y)) (fun σ => (Real.exp_pos _).le)
  unfold correlation
  rw [abs_div, abs_of_pos (partition_pos edge b)]
  exact (div_le_iff₀ (partition_pos edge b)).mpr hb

noncomputable def signChange (η : V → Bool) (σ : Configuration V) : Configuration V :=
  fun x => if η x then antipode (σ x) else σ x

omit [Fintype V] in
/-- Local sign changes leave the energy exactly unchanged. -/
theorem interaction_signChange (edge : E → V × V) (b : E → ℝ)
    (η : V → Bool) (σ : Configuration V) :
    interaction edge b (signChange η σ) = interaction edge b σ := by
  unfold interaction
  apply Finset.sum_congr rfl
  intro e _
  simp only [signChange]
  split_ifs <;> simp [antipode]

omit [Fintype V] in
theorem observable_signChange (x y : V) (η : V → Bool) (σ : Configuration V) :
    observable x y (signChange η σ) = observable x y σ := by
  change qPair _ _ = qPair _ _
  simp only [signChange]
  split_ifs <;> simp

end FiniteVolume


/-- Left multiplication by 1,i,j,k,-1,-i,-j,-k on real quaternion coordinates. -/
noncomputable def quaternionRotate (g : Fin 8) (u : Fin 4 → ℝ) : Fin 4 → ℝ :=
  ![![u 0, u 1, u 2, u 3],
    ![-u 1, u 0, -u 3, u 2],
    ![-u 2, u 3, u 0, -u 1],
    ![-u 3, -u 2, u 1, u 0],
    ![-u 0, -u 1, -u 2, -u 3],
    ![u 1, -u 0, u 3, -u 2],
    ![u 2, -u 3, -u 0, u 1],
    ![u 3, u 2, -u 1, -u 0]] g

theorem quaternionRotate_squares (g : Fin 8) (u : Fin 4 → ℝ) :
    ∑ i : Fin 4, quaternionRotate g u i ^ 2 = ∑ i : Fin 4, u i ^ 2 := by
  fin_cases g <;> simp [quaternionRotate, Fin.sum_univ_succ] <;> ring

theorem quaternion_cancellation (u v : Fin 4 → ℝ)
    (hu : ∑ i, u i ^ 2 = 1) (hv : ∑ i, v i ^ 2 = 1) :
    (∑ g : Fin 8, ((∑ i : Fin 4, quaternionRotate g u i * v i)^2 - (1 : ℝ)/4)) = 0 := by
  have hp : (∑ g : Fin 8, ((∑ i : Fin 4, quaternionRotate g u i * v i)^2 - (1 : ℝ)/4)) =
      2 * (∑ i : Fin 4, u i^2) * (∑ i : Fin 4, v i^2) - 2 := by
    simp [quaternionRotate, Fin.sum_univ_succ]
    ring
  rw [hp, hu, hv]
  norm_num

end RP3
end StandalonePart5

/- ===== RP3/RotationGeometryBase.lean ===== -/
section StandalonePart6

/-!
Adapted from OpenAI's ClassicalON/FiniteVolume.lean at commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a, licensed under Apache-2.0.
Copyright OpenAI. The namespace and imports have been changed and the
interaction-independent lemmas separated from the O(n) Gibbs model.
-/

namespace RP3.Rotation

universe uR uS uΩ uF
noncomputable section
open MeasureTheory
open scoped BigOperators InnerProductSpace

abbrev Spin (n : ℕ) := Metric.sphere (0 : EuclideanSpace ℝ (Fin n)) 1

def spinRotation {n : ℕ}
    (R : EuclideanSpace ℝ (Fin n) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin n)) :
    Spin n ≃ₜ Spin n :=
  R.toHomeomorph.subtype fun x => by
    simp only [mem_sphere_zero_iff_norm]
    change ‖x‖ = 1 ↔ ‖R x‖ = 1
    rw [R.norm_map]

@[simp] theorem spinRotation_val {n : ℕ}
    (R : EuclideanSpace ℝ (Fin n) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin n)) (s : Spin n) :
    (spinRotation R s).val = R s.val := rfl

theorem spinRotation_preserves_surface {n : ℕ}
    (R : EuclideanSpace ℝ (Fin n) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin n)) :
    MeasurePreserving (spinRotation R)
      (volume : Measure (EuclideanSpace ℝ (Fin n))).toSphere
      (volume : Measure (EuclideanSpace ℝ (Fin n))).toSphere := by
  open scoped Pointwise in
  refine ⟨(spinRotation R).measurable, Measure.ext fun s hs => ?_⟩
  rw [Measure.map_apply (spinRotation R).measurable hs,
    Measure.toSphere_apply' _ ((spinRotation R).measurable hs),
    Measure.toSphere_apply' _ hs]
  congr 1
  have hcone : Set.Ioo (0 : ℝ) 1 • (Subtype.val '' ((spinRotation R) ⁻¹' s)) =
      R ⁻¹' (Set.Ioo (0 : ℝ) 1 • (Subtype.val '' s)) := by
    ext v
    constructor
    · rintro ⟨r, hr, w, ⟨t, ht, rfl⟩, rfl⟩
      exact ⟨r, hr, R t.val, ⟨spinRotation R t, ht, rfl⟩, (R.map_smul r t.val).symm⟩
    · rintro ⟨r, hr, w, ⟨t, ht, rfl⟩, hv⟩
      refine ⟨r, hr, R.symm t.val, ⟨(spinRotation R).symm t, ?_, rfl⟩, ?_⟩
      · simpa only [Set.mem_preimage, Homeomorph.apply_symm_apply] using ht
      · apply R.injective
        simpa only [map_smul, LinearIsometryEquiv.apply_symm_apply] using hv
  rw [hcone]
  have hm := R.toHomeomorph.measurableEmbedding.map_apply
    (volume : Measure (EuclideanSpace ℝ (Fin n)))
    (Set.Ioo (0 : ℝ) 1 • (Subtype.val '' s))
  change (Measure.map R volume) _ = volume (R ⁻¹' _) at hm
  rw [R.measurePreserving.map_eq] at hm
  exact hm.symm

theorem spinRotation_preserves_probability
    (R : E4 ≃ₗᵢ[ℝ] E4) :
    MeasurePreserving (spinRotation R) sphereProbability sphereProbability :=
  (spinRotation_preserves_surface R).smul_measure _

abbrev SpinOperator (n : ℕ) :=
  EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n)

instance spinOperator_completeSpace (dimension : ℕ) : CompleteSpace (SpinOperator dimension) :=
  ContinuousLinearMap.instCompleteSpace

instance spinOperator_ratNormedAlgebra (n : ℕ) : NormedAlgebra ℚ (SpinOperator n) :=
  NormedAlgebra.restrictScalars ℚ ℝ _

def rotationExp {n : ℕ} (A : SpinOperator n) (hA : A ∈ skewAdjoint (SpinOperator n)) :
    EuclideanSpace ℝ (Fin n) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin n) :=
  Unitary.linearIsometryEquiv
    ⟨NormedSpace.exp A, NormedSpace.exp_mem_unitary_of_mem_skewAdjoint hA⟩

@[simp] theorem rotationExp_apply {n : ℕ} (A : SpinOperator n)
    (hA : A ∈ skewAdjoint (SpinOperator n)) (v : EuclideanSpace ℝ (Fin n)) :
    rotationExp A hA v = NormedSpace.exp A v := rfl

@[simp] theorem rotationExp_symm_apply {n : ℕ} (A : SpinOperator n)
    (hA : A ∈ skewAdjoint (SpinOperator n)) (v : EuclideanSpace ℝ (Fin n)) :
    (rotationExp A hA).symm v = NormedSpace.exp (-A) v := by
  change (star (NormedSpace.exp A)) v = _
  rw [NormedSpace.star_exp, skewAdjoint.mem_iff.mp hA]

def expPower {n : ℕ} (X : SpinOperator n) (a : ℕ) (t : ℝ) : SpinOperator n :=
  NormedSpace.exp (t • X) * X^a

theorem hasDerivAt_expPower {n : ℕ} (X : SpinOperator n) (a : ℕ) (t : ℝ) :
    HasDerivAt (expPower X a) (expPower X (a+1) t) t := by
  exact ((hasDerivAt_exp_smul_const X t).mul_const (X^a)).congr_deriv
    (by simp only [expPower, pow_succ', mul_assoc])

theorem continuous_expPower {n : ℕ} (X : SpinOperator n) (a : ℕ) :
    Continuous (expPower X a) := by
  unfold expPower
  fun_prop

def tripleJet {n : ℕ} (X Y Z : SpinOperator n) : ℕ → ℕ → ℕ → ℕ → ℝ → SpinOperator n
  | 0, a, b, c, t => expPower X a t * expPower Y b t * expPower Z c t
  | k+1, a, b, c, t => tripleJet X Y Z k (a+1) b c t +
      tripleJet X Y Z k a (b+1) c t + tripleJet X Y Z k a b (c+1) t

theorem continuous_tripleJet {n : ℕ} (X Y Z : SpinOperator n)
    (k a b c : ℕ) : Continuous (tripleJet X Y Z k a b c) := by
  induction k generalizing a b c with
  | zero => exact ((continuous_expPower X a).mul (continuous_expPower Y b)).mul (continuous_expPower Z c)
  | succ k ih => exact ((ih (a+1) b c).add (ih a (b+1) c)).add (ih a b (c+1))

theorem hasDerivAt_tripleJet {n : ℕ} (X Y Z : SpinOperator n)
    (k a b c : ℕ) (t : ℝ) :
    HasDerivAt (tripleJet X Y Z k a b c) (tripleJet X Y Z (k+1) a b c t) t := by
  induction k generalizing a b c with
  | zero =>
    exact (((hasDerivAt_expPower X a t).mul (hasDerivAt_expPower Y b t)).mul
      (hasDerivAt_expPower Z c t)).congr_deriv (by dsimp [tripleJet]; rw [add_mul, add_assoc])
  | succ k ih => exact ((ih (a+1) b c).add (ih a (b+1) c)).add (ih a b (c+1))

@[simp] theorem expPower_zero {n : ℕ} (X : SpinOperator n) (a : ℕ) :
    expPower X a 0 = X^a := by
  rw [expPower, zero_smul ℝ X, NormedSpace.exp_zero, one_mul]

theorem gaugeJets_zero_one {n : ℕ} (X Y : SpinOperator n) :
    tripleJet X (Y-X) (-Y) 0 0 0 0 0 = 1 ∧
    tripleJet X (Y-X) (-Y) 1 0 0 0 0 = 0 := by
  simp [tripleJet]

theorem gaugeJet_two {n : ℕ} (X Y : SpinOperator n) :
    tripleJet X (Y-X) (-Y) 2 0 0 0 0 = X*Y-Y*X := by
  apply ContinuousLinearMap.ext
  intro v
  simp only [tripleJet, expPower_zero, Nat.reduceAdd, pow_zero, pow_one, one_mul, mul_one, pow_two,
    add_apply, sub_apply, neg_apply, mul_apply_eq_comp, map_sub, map_neg]
  abel

open scoped Matrix

def matrixOperator {n : ℕ} : Matrix (Fin n) (Fin n) ℝ ≃ₐ[ℝ] SpinOperator n :=
  (Matrix.toLinAlgEquiv (PiLp.basisFun 2 ℝ (Fin n))).trans
    (Module.End.toContinuousLinearMap (EuclideanSpace ℝ (Fin n)))
theorem matrixOperator_apply {n : ℕ} (M : Matrix (Fin n) (Fin n) ℝ)
    (v : EuclideanSpace ℝ (Fin n)) :
    matrixOperator M v = WithLp.toLp 2 (M *ᵥ v.ofLp) := by
  change (Matrix.toLin (PiLp.basisFun 2 ℝ (Fin n)) (PiLp.basisFun 2 ℝ (Fin n)) M) v = _
  rw [← Matrix.toLpLin_eq_toLin, Matrix.toLpLin_apply]

def axisMatrixA : Matrix (Fin 4) (Fin 4) ℝ := !![0,-1/2,0,0; 1/2,0,0,0; 0,0,0,-1/2; 0,0,1/2,0]
def axisMatrixB : Matrix (Fin 4) (Fin 4) ℝ := !![0,0,-1/2,0; 0,0,0,1/2; 1/2,0,0,0; 0,-1/2,0,0]
def axisMatrixC : Matrix (Fin 4) (Fin 4) ℝ := !![0,0,0,-1/2; 0,0,-1/2,0; 0,1/2,0,0; 1/2,0,0,0]
def axisA : SpinOperator 4 := matrixOperator axisMatrixA
def axisB : SpinOperator 4 := matrixOperator axisMatrixB
def axisC : SpinOperator 4 := matrixOperator axisMatrixC

theorem axisA_apply (v : EuclideanSpace ℝ (Fin 4)) :
    axisA v = WithLp.toLp 2 ![-v 1/2, v 0/2, -v 3/2, v 2/2] := by
  rw [axisA, matrixOperator_apply]
  congr 1
  ext i
  fin_cases i <;> simp [axisMatrixA, Matrix.mulVec, dotProduct, Fin.sum_univ_succ] <;> ring


theorem matrixOperator_star {n : ℕ} (M : Matrix (Fin n) (Fin n) ℝ) :
    star (matrixOperator M) = matrixOperator M.transpose := by
  apply ContinuousLinearMap.ext
  intro x
  apply ext_inner_left ℝ
  intro y
  rw [ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.adjoint_inner_right,
    matrixOperator_apply, matrixOperator_apply]
  simp only [EuclideanSpace.inner_eq_star_dotProduct, star_trivial]
  rw [Matrix.dotProduct_mulVec, Matrix.mulVec_transpose]

theorem axisA_skew : axisA ∈ skewAdjoint (SpinOperator 4) := by
  rw [skewAdjoint.mem_iff, axisA, matrixOperator_star, ← map_neg]
  congr 1
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [axisMatrixA]

theorem axisA_norm_le : ‖axisA‖ ≤ 1 := by
  apply axisA.opNorm_le_bound zero_le_one
  intro v
  rw [one_mul]
  have hs : ‖axisA v‖^2 = ‖v‖^2/4 := by
    rw [EuclideanSpace.real_norm_sq_eq, EuclideanSpace.real_norm_sq_eq, axisA_apply]
    simp [Fin.sum_univ_succ]
    ring
  nlinarith [norm_nonneg (axisA v), norm_nonneg v, sq_nonneg ‖v‖]


theorem axisB_skew : axisB ∈ skewAdjoint (SpinOperator 4) := by
  rw [skewAdjoint.mem_iff, axisB, matrixOperator_star, ← map_neg]
  congr 1
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [axisMatrixB]

theorem axisC_skew : axisC ∈ skewAdjoint (SpinOperator 4) := by
  rw [skewAdjoint.mem_iff, axisC, matrixOperator_star, ← map_neg]
  congr 1
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [axisMatrixC]

theorem axisB_apply (v : EuclideanSpace ℝ (Fin 4)) :
    axisB v = WithLp.toLp 2 ![-v 2/2, v 3/2, v 0/2, -v 1/2] := by
  rw [axisB, matrixOperator_apply]
  congr 1
  ext i
  fin_cases i <;> simp [axisMatrixB, Matrix.mulVec, dotProduct, Fin.sum_univ_succ] <;> ring


theorem axisC_apply (v : EuclideanSpace ℝ (Fin 4)) :
    axisC v = WithLp.toLp 2 ![-v 3/2, -v 2/2, v 1/2, v 0/2] := by
  rw [axisC, matrixOperator_apply]
  congr 1
  ext i
  fin_cases i <;> simp [axisMatrixC, Matrix.mulVec, dotProduct, Fin.sum_univ_succ] <;> ring


theorem axisB_norm_le : ‖axisB‖ ≤ 1 := by
  apply axisB.opNorm_le_bound zero_le_one
  intro v
  rw [one_mul]
  have hs : ‖axisB v‖^2 = ‖v‖^2/4 := by
    rw [EuclideanSpace.real_norm_sq_eq, EuclideanSpace.real_norm_sq_eq, axisB_apply]
    simp [Fin.sum_univ_succ]
    ring
  nlinarith [norm_nonneg (axisB v), norm_nonneg v, sq_nonneg ‖v‖]


theorem axisC_norm_le : ‖axisC‖ ≤ 1 := by
  apply axisC.opNorm_le_bound zero_le_one
  intro v
  rw [one_mul]
  have hs : ‖axisC v‖^2 = ‖v‖^2/4 := by
    rw [EuclideanSpace.real_norm_sq_eq, EuclideanSpace.real_norm_sq_eq, axisC_apply]
    simp [Fin.sum_univ_succ]
    ring
  nlinarith [norm_nonneg (axisC v), norm_nonneg v, sq_nonneg ‖v‖]


def tripleMoment {R : Type uR} [Ring R] (X Y Z : R) : ℕ → ℕ → ℕ → ℕ → R
  | 0, a, b, c => X^a * Y^b * Z^c
  | k+1, a, b, c => tripleMoment X Y Z k (a+1) b c +
      tripleMoment X Y Z k a (b+1) c + tripleMoment X Y Z k a b (c+1)

theorem tripleMoment_four {R : Type uR} [Ring R] (X Y Z : R) :
    tripleMoment X Y Z 4 0 0 0 = X^4+Y^4+Z^4 +
      4 • (X^3*Y+X^3*Z+X*Y^3+Y^3*Z+X*Z^3+Y*Z^3) +
      6 • (X^2*Y^2+X^2*Z^2+Y^2*Z^2) +
      12 • (X^2*Y*Z+X*Y^2*Z+X*Y*Z^2) := by
  simp only [tripleMoment, Nat.reduceAdd, pow_zero, pow_one, one_mul, mul_one]
  noncomm_ring

def plane (f g : ℝ) : Matrix (Fin 4) (Fin 4) ℝ := !![0,-f/2,-g/2,0; f/2,0,0,g/2; g/2,0,0,-f/2; 0,-g/2,f/2,0]
def third : Matrix (Fin 4) (Fin 4) ℝ := axisMatrixC

lemma plane_sub (f g h k : ℝ) : plane f g - plane h k = plane (f-h) (g-k) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [plane] <;> ring
lemma plane_neg (f g : ℝ) : -plane f g = plane (-f) (-g) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [plane] <;> ring

def moment4Plane (f g h k : ℝ) : Matrix (Fin 4) (Fin 4) ℝ :=
  tripleMoment (plane f g) (plane h k - plane f g) (-plane h k) 4 0 0 0


end
end RP3.Rotation
end StandalonePart6

/- ===== RP3/QuaternionAlgebra.lean ===== -/
section StandalonePart7

/-! Closed multiplication of left-quaternion matrices keeps the fourth-order
calculation small. Every identity below is checked by scalar ring arithmetic. -/
namespace RP3.Rotation
noncomputable section

def qMatrix (r a b c : ℝ) : Matrix (Fin 4) (Fin 4) ℝ :=
  !![r,-a,-b,-c; a,r,-c,b; b,c,r,-a; c,-b,a,r]

theorem qMatrix_mul (r a b c s d e f : ℝ) :
    qMatrix r a b c * qMatrix s d e f =
      qMatrix (r*s-a*d-b*e-c*f) (r*d+a*s+b*f-c*e)
        (r*e-a*f+b*s+c*d) (r*f+a*e-b*d+c*s) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [qMatrix, Matrix.mul_apply, Fin.sum_univ_succ] <;> ring

theorem qMatrix_add (r a b c s d e f : ℝ) :
    qMatrix r a b c + qMatrix s d e f = qMatrix (r+s) (a+d) (b+e) (c+f) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [qMatrix] <;> ring

theorem qMatrix_smul (t r a b c : ℝ) :
    t • qMatrix r a b c = qMatrix (t*r) (t*a) (t*b) (t*c) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [qMatrix] <;> ring

theorem qMatrix_nsmul (n : ℕ) (r a b c : ℝ) :
    n • qMatrix r a b c = qMatrix (n*r) (n*a) (n*b) (n*c) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [qMatrix, nsmul_eq_mul] <;> ring

theorem plane_eq_qMatrix (f g : ℝ) : plane f g = qMatrix 0 (f/2) (g/2) 0 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [plane, qMatrix] <;> ring
theorem axisMatrixA_eq_qMatrix : axisMatrixA = qMatrix 0 (1/2) 0 0 := by
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [axisMatrixA, qMatrix]
theorem axisMatrixB_eq_qMatrix : axisMatrixB = qMatrix 0 0 (1/2) 0 := by
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [axisMatrixB, qMatrix]
theorem axisMatrixC_eq_qMatrix : axisMatrixC = qMatrix 0 0 0 (1/2) := by
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [axisMatrixC, qMatrix]

end
end RP3.Rotation
end StandalonePart7

/- ===== RP3/RotationGeometry.lean ===== -/
section StandalonePart8

namespace RP3.Rotation
universe uR uS
noncomputable section
open scoped BigOperators InnerProductSpace

set_option maxHeartbeats 400000 in
lemma moment4_plane_even (f g h k : ℝ) :
    moment4Plane f g h k + moment4Plane f (-g) h (-k) =
      (6 * (f*k-g*h)^2) • third^2 := by
  unfold moment4Plane
  rw [plane_sub, plane_neg, plane_sub, plane_neg]
  simp only [tripleMoment_four]
  simp only [plane_eq_qMatrix, third, axisMatrixC_eq_qMatrix,
    pow_succ, pow_zero, one_mul, mul_one]
  simp only [qMatrix_mul, qMatrix_add, qMatrix_nsmul, qMatrix_smul]
  congr 1 <;> ring


theorem tripleJet_at_zero {n : ℕ} (X Y Z : SpinOperator n) (k a b c : ℕ) :
    tripleJet X Y Z k a b c 0 = tripleMoment X Y Z k a b c := by
  induction k generalizing a b c with
  | zero =>
      simp only [tripleJet, expPower, tripleMoment,
        zero_smul ℝ X, zero_smul ℝ Y, zero_smul ℝ Z, NormedSpace.exp_zero, one_mul]
  | succ k ih => simp only [tripleJet, tripleMoment, ih]

theorem map_tripleMoment {R : Type uR} {S : Type uS} [Ring R] [Ring S]
    (φ : R →+* S) (X Y Z : R) (k a b c : ℕ) :
    φ (tripleMoment X Y Z k a b c) =
      tripleMoment (φ X) (φ Y) (φ Z) k a b c := by
  induction k generalizing a b c with
  | zero => simp [tripleMoment]
  | succ k ih => simp [tripleMoment, ih]

def planeOperator (f g : ℝ) : SpinOperator 4 := matrixOperator (plane f g)

theorem planeOperator_eq (f g : ℝ) : planeOperator f g = f • axisA + g • axisB := by
  rw [planeOperator, axisA, axisB, ← map_smul, ← map_smul, ← map_add]
  congr 1
  ext i j
  fin_cases i <;> fin_cases j <;> simp [plane, axisMatrixA, axisMatrixB] <;> ring

theorem plane_commutator (f g h k : ℝ) :
    plane f g * plane h k - plane h k * plane f g = (f*k-g*h) • third := by
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [plane, third, Matrix.cons_val_two, axisMatrixA, axisMatrixB, axisMatrixC] <;> ring

theorem planeOperator_commutator (f g h k : ℝ) :
    planeOperator f g * planeOperator h k - planeOperator h k * planeOperator f g =
      (f*k-g*h) • axisC := by
  rw [planeOperator, planeOperator, ← map_mul, ← map_mul, ← map_sub, plane_commutator,
    map_smul]
  rfl

theorem gaugeJet_plane_four_even (f g h k : ℝ) :
    tripleJet (planeOperator f g) (planeOperator h k-planeOperator f g)
      (-planeOperator h k) 4 0 0 0 0 +
    tripleJet (planeOperator f (-g)) (planeOperator h (-k)-planeOperator f (-g))
      (-planeOperator h (-k)) 4 0 0 0 0 = (6*(f*k-g*h)^2) • axisC^2 := by
  simp only [tripleJet_at_zero, planeOperator]
  have hm (f g h k : ℝ) := map_tripleMoment matrixOperator.toRingHom
    (plane f g) (plane h k-plane f g) (-plane h k) 4 0 0 0
  change ∀ f g h k, matrixOperator (tripleMoment (plane f g)
    (plane h k-plane f g) (-plane h k) 4 0 0 0) =
      tripleMoment (matrixOperator (plane f g)) (matrixOperator (plane h k-plane f g))
        (matrixOperator (-plane h k)) 4 0 0 0 at hm
  simp only [map_sub, map_neg] at hm
  rw [← hm, ← hm, ← map_add]
  change matrixOperator (moment4Plane f g h k + moment4Plane f (-g) h (-k)) = _
  rw [moment4_plane_even, map_smul, map_pow]
  rfl

def mixedMatrixAB : Matrix (Fin 4) (Fin 4) ℝ := 0
def mixedMatrixAAB : Matrix (Fin 4) (Fin 4) ℝ := (-1/12 : ℝ) • axisMatrixB
def mixedMatrixABB : Matrix (Fin 4) (Fin 4) ℝ := (-1/12 : ℝ) • axisMatrixA
def mixedMatrixAABB : Matrix (Fin 4) (Fin 4) ℝ := (-1/24 : ℝ) • (axisMatrixA^2+axisMatrixB^2)

theorem plane_matrix_square (f g : ℝ) :
    plane f g ^ 2 = f^2 • axisMatrixA^2 + (2*f*g) • mixedMatrixAB + g^2 • axisMatrixB^2 := by
  simp only [plane_eq_qMatrix, mixedMatrixAB, mixedMatrixAAB, mixedMatrixABB,
    mixedMatrixAABB, axisMatrixA_eq_qMatrix, axisMatrixB_eq_qMatrix,
    pow_succ, pow_zero, one_mul, mul_one, smul_zero, add_zero]
  simp only [qMatrix_mul, qMatrix_add, qMatrix_smul]
  congr 1 <;> ring


theorem plane_matrix_cube (f g : ℝ) :
    plane f g ^ 3 = f^3 • axisMatrixA^3 + (3*f^2*g) • mixedMatrixAAB + (3*f*g^2) • mixedMatrixABB + g^3 • axisMatrixB^3 := by
  simp only [plane_eq_qMatrix, mixedMatrixAB, mixedMatrixAAB, mixedMatrixABB,
    mixedMatrixAABB, axisMatrixA_eq_qMatrix, axisMatrixB_eq_qMatrix,
    pow_succ, pow_zero, one_mul, mul_one, smul_zero, add_zero]
  simp only [qMatrix_mul, qMatrix_add, qMatrix_smul]
  congr 1 <;> ring


theorem plane_matrix_four_even (f g : ℝ) :
    plane f g ^ 4 + plane f (-g) ^ 4 = (2*f^4) • axisMatrixA^4 +
      (12*f^2*g^2) • mixedMatrixAABB + (2*g^4) • axisMatrixB^4 := by
  simp only [plane_eq_qMatrix, mixedMatrixAB, mixedMatrixAAB, mixedMatrixABB,
    mixedMatrixAABB, axisMatrixA_eq_qMatrix, axisMatrixB_eq_qMatrix,
    pow_succ, pow_zero, one_mul, mul_one, smul_zero, add_zero]
  simp only [qMatrix_mul, qMatrix_add, qMatrix_smul]
  congr 1 <;> ring


theorem mixedMatrixAB_sym : mixedMatrixAB = (1/2 : ℝ) • (axisMatrixA*axisMatrixB+axisMatrixB*axisMatrixA) := by
  simp only [plane_eq_qMatrix, mixedMatrixAB, mixedMatrixAAB, mixedMatrixABB,
    mixedMatrixAABB, axisMatrixA_eq_qMatrix, axisMatrixB_eq_qMatrix,
    pow_succ, pow_zero, one_mul, mul_one, smul_zero, add_zero]
  simp only [qMatrix_mul, qMatrix_add, qMatrix_smul]
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [qMatrix]


def mixedAB : SpinOperator 4 := matrixOperator mixedMatrixAB
def mixedAAB : SpinOperator 4 := matrixOperator mixedMatrixAAB
def mixedABB : SpinOperator 4 := matrixOperator mixedMatrixABB
def mixedAABB : SpinOperator 4 := matrixOperator mixedMatrixAABB

theorem planeOperator_square (f g : ℝ) :
    planeOperator f g ^ 2 = f^2 • axisA^2 + (2*f*g) • mixedAB + g^2 • axisB^2 := by
  have h := congrArg matrixOperator (plane_matrix_square f g)
  simpa only [map_add, map_smul, map_pow, planeOperator, axisA, axisB, mixedAB, mixedAAB, mixedABB, mixedAABB] using h

theorem planeOperator_cube (f g : ℝ) :
    planeOperator f g ^ 3 = f^3 • axisA^3 + (3*f^2*g) • mixedAAB +
      (3*f*g^2) • mixedABB + g^3 • axisB^3 := by
  have h := congrArg matrixOperator (plane_matrix_cube f g)
  simpa only [map_add, map_smul, map_pow, planeOperator, axisA, axisB, mixedAB, mixedAAB, mixedABB, mixedAABB] using h

theorem planeOperator_four_even (f g : ℝ) :
    planeOperator f g ^ 4 + planeOperator f (-g) ^ 4 = (2*f^4) • axisA^4 +
      (12*f^2*g^2) • mixedAABB + (2*g^4) • axisB^4 := by
  have h := congrArg matrixOperator (plane_matrix_four_even f g)
  simpa only [map_add, map_smul, map_pow, planeOperator, axisA, axisB, mixedAB, mixedAAB, mixedABB, mixedAABB] using h

end
end RP3.Rotation
end StandalonePart8

/- ===== RP3/PeriodicODE.lean ===== -/
section StandalonePart9
/-
Adapted from OpenAI, math repository, under the Apache License 2.0.
Source: lean/OAI/Probability/ClassicalON/PeriodicODE.lean
Commit: adc7f1241b42e322a6451854ab7e4b4c146bf78a
Changes: standalone Mathlib import; namespace RP3; added kernel_lower lemma.
See LICENSE and NOTICE.
-/

namespace RP3

noncomputable section
open Set


theorem lower_second_derivative_tangent (f f' f'' : ℝ → ℝ) (a c x : ℝ)
    (h1 : ∀ t, HasDerivAt f (f' t) t) (h2 : ∀ t, HasDerivAt f' (f'' t) t)
    (hsec : ∀ t, -c ≤ f'' t) (ha : f' a = 0) :
    f a - c/2*(x-a)^2 ≤ f x := by
  let g := fun t => f t + c/2*(t-a)^2
  let g' := fun t => f' t + c*(t-a)
  let g'' := fun t => f'' t + c
  have hg (t : ℝ) : HasDerivAt g (g' t) t := by
    convert (h1 t).add ((((hasDerivAt_id t).sub_const a).pow 2).const_mul (c/2)) using 1 <;>
      first | rfl | (change f' t + c * (t-a) = f' t + c/2*(2*(t-a)^(2-1)*1); ring)
  have hg' (t : ℝ) : HasDerivAt g' (g'' t) t := by
    convert (h2 t).add (((hasDerivAt_id t).sub_const a).const_mul c) using 1 <;>
      first | rfl | (change f'' t + c = f'' t + c*1; ring)
  have hcv : ConvexOn ℝ univ g := by
    apply convexOn_of_hasDerivWithinAt2_nonneg convex_univ
      (fun t _ => (hg t).continuousAt.continuousWithinAt)
      (fun t _ => (hg t).hasDerivWithinAt)
      (fun t _ => (hg' t).hasDerivWithinAt)
    intro t _
    dsimp only [g'']
    linarith [hsec t]
  have hd : derivWithin g (Ioi a) a = 0 := by
    rw [(hg a).hasDerivWithinAt.derivWithin (uniqueDiffWithinAt_Ioi a)]
    simp [g', ha]
  have hm := hcv.isMinOn_of_rightDeriv_eq_zero (by simp) hd (mem_univ x)
  change f a + c/2*(a-a)^2 ≤ f x + c/2*(x-a)^2 at hm
  nlinarith

theorem periodic_ode_ratio (f f' f'' : ℝ → ℝ) (P δ : ℝ) (hP : 0 < P) (hδ : 0 ≤ δ)
    (hper : Function.Periodic f P) (hfpos : ∀ t, 0 < f t)
    (h1 : ∀ t, HasDerivAt f (f' t) t) (h2 : ∀ t, HasDerivAt f' (f'' t) t)
    (hode : ∀ t, -(δ*f t) ≤ f'' t) (x y : ℝ) :
    1 - δ*P^2/2 ≤ f x / f y := by
  have hf : Continuous f := continuous_iff_continuousAt.mpr fun t => (h1 t).continuousAt
  obtain ⟨a, ha, ham⟩ := isCompact_Icc.exists_isMaxOn
    (show (Icc (0:ℝ) P).Nonempty from ⟨0, le_rfl, hP.le⟩) hf.continuousOn
  have hmax (t : ℝ) : f t ≤ f a := by
    obtain ⟨s, hs, he⟩ := hper.exists_mem_Ioc hP t 0
    rw [he]
    exact ham ⟨hs.1.le, by simpa only [zero_add] using hs.2⟩
  have halocal : IsLocalMax f a := Filter.Eventually.of_forall hmax
  have hstationary : f' a = 0 := by rw [← (h1 a).deriv, halocal.deriv_eq_zero]
  have hsec (t : ℝ) : -(δ*f a) ≤ f'' t :=
    (neg_le_neg (mul_le_mul_of_nonneg_left (hmax t) hδ)).trans (hode t)
  obtain ⟨s, hs, he⟩ := hper.exists_mem_Ioc hP x a
  have ht := lower_second_derivative_tangent f f' f'' a (δ*f a) s h1 h2 hsec hstationary
  have hdist : (s-a)^2 ≤ P^2 := by
    apply pow_le_pow_left₀ (sub_nonneg.mpr hs.1.le)
    linarith [hs.2]
  have hnear : f a*(1-δ*P^2/2) ≤ f x := by
    rw [he]
    have hm := mul_le_mul_of_nonneg_left hdist (div_nonneg (mul_nonneg hδ (hfpos a).le) (by norm_num : (0:ℝ) ≤ 2))
    nlinarith
  apply (le_div_iff₀ (hfpos y)).mpr
  by_cases hc : 0 ≤ 1-δ*P^2/2
  · exact (mul_le_mul_of_nonneg_left (hmax y) hc).trans (by simpa only [mul_comm] using hnear)
  · exact (mul_nonpos_of_nonpos_of_nonneg (le_of_not_ge hc) (hfpos y).le).trans (hfpos x).le


/-- The periodic curvature inequality in the form needed for kernel splitting. -/
theorem periodic_kernel_lower (f f' f'' : ℝ → ℝ) (P δ : ℝ)
    (hP : 0 < P) (hδ : 0 ≤ δ) (hper : Function.Periodic f P)
    (hfpos : ∀ t, 0 < f t) (h1 : ∀ t, HasDerivAt f (f' t) t)
    (h2 : ∀ t, HasDerivAt f' (f'' t) t)
    (hode : ∀ t, -(δ * f t) ≤ f'' t) (x y : ℝ) :
    (1 - δ * P ^ 2 / 2) * f y ≤ f x :=
  (le_div_iff₀ (hfpos y)).mp
    (periodic_ode_ratio f f' f'' P δ hP hδ hper hfpos h1 h2 hode x y)

end

end RP3
end StandalonePart9

/- ===== RP3/PinnedKernel.lean ===== -/
section StandalonePart10

/-!
# Pinned partition functions and the curvature-to-comparison interface

We define the pinned RP³ partition function itself and show that a periodic
second-derivative bound implies the rotational kernel comparison. This is a
reusable conditional interface. The actual squared-interaction estimate is
proved in `AnnularEstimate.lean` and connected to these pinned integrals in
`KernelEstimate.lean`; the final decay theorems have no analytic hypothesis.
-/

namespace RP3

open MeasureTheory

variable {V E : Type*} [Fintype V] [Fintype E] [DecidableEq V]

/-- Overwrite pinned sites with the prescribed boundary configuration. -/
noncomputable def fillPins (pins : Finset V) (τ : Configuration V) :
    C(Configuration V, Configuration V) :=
  ⟨fun σ v => if v ∈ pins then τ v else σ v, by
    apply continuous_pi
    intro v
    by_cases hv : v ∈ pins
    · simpa only [hv, ite_true] using (continuous_const : Continuous (fun _ : Configuration V => τ v))
    · simpa only [hv, ite_false] using (continuous_apply v : Continuous (fun σ : Configuration V => σ v))⟩

/-- Pinned spins are dummy integration variables with probability mass one. -/
noncomputable def pinnedWeight (edge : E → V × V) (b : E → ℝ)
    (pins : Finset V) (τ : Configuration V) : C(Configuration V, ℝ) :=
  (weight edge b).comp (fillPins pins τ)

noncomputable def pinnedPartition (edge : E → V × V) (b : E → ℝ)
    (pins : Finset V) (τ : Configuration V) : ℝ :=
  (integralOnCompact (referenceLaw (V := V))).linear (pinnedWeight edge b pins τ)

theorem pinnedPartition_pos (edge : E → V × V) (b : E → ℝ)
    (pins : Finset V) (τ : Configuration V) : 0 < pinnedPartition edge b pins τ := by
  change 0 < ∫ σ, Real.exp (interaction edge b (fillPins pins τ σ)) ∂referenceLaw
  apply (integral_pos_iff_support_of_nonneg (fun _ => (Real.exp_pos _).le)
    ((pinnedWeight edge b pins τ).continuous.integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _))).mpr
  have hs : Function.support (fun σ : Configuration V =>
      Real.exp (interaction edge b (fillPins pins τ σ))) = Set.univ := by
    ext σ
    simp [Function.mem_support, Real.exp_ne_zero]
  rw [hs, measure_univ]
  exact zero_lt_one

/-- Rotate all directors in the inner boundary by the same motion. -/
noncomputable def twistBoundary (inner : Finset V) (ρ : ℝ → C(Spin, Spin))
    (τ : Configuration V) (t : ℝ) : Configuration V :=
  fun v => if v ∈ inner then ρ t (τ v) else τ v

noncomputable def twistedPartition (edge : E → V × V) (b : E → ℝ)
    (pins inner : Finset V) (ρ : ℝ → C(Spin, Spin)) (τ : Configuration V) : ℝ → ℝ :=
  fun t => pinnedPartition edge b pins (twistBoundary inner ρ τ t)

theorem twistedPartition_periodic (edge : E → V × V) (b : E → ℝ)
    (pins inner : Finset V) (ρ : ℝ → C(Spin, Spin)) (τ : Configuration V)
    (P : ℝ) (hρ : Function.Periodic ρ P) :
    Function.Periodic (twistedPartition edge b pins inner ρ τ) P := by
  intro t
  change pinnedPartition edge b pins (twistBoundary inner ρ τ (t + P)) =
    pinnedPartition edge b pins (twistBoundary inner ρ τ t)
  apply congrArg (pinnedPartition edge b pins)
  funext v
  change (if v ∈ inner then ρ (t + P) (τ v) else τ v) =
    (if v ∈ inner then ρ t (τ v) else τ v)
  rw [hρ t]

/-- The analytic obligation. The desired annular input has
`δ = constant(β) / log N`, uniformly in all boundary directors. -/
def CurvatureBound (Z : ℝ → ℝ) (δ : ℝ) : Prop :=
  ∃ Z' Z'' : ℝ → ℝ,
    (∀ t, HasDerivAt Z (Z' t) t) ∧
    (∀ t, HasDerivAt Z' (Z'' t) t) ∧
    (∀ t, -(δ * Z t) ≤ Z'' t)

/-- Applied to the actual pinned RP³ partition function, a uniform curvature
bound gives the comparison needed by `FiniteAction.comparison_lower`.
The constant `P²/2` is sufficient; no claim of an optimal ODE constant is made. -/
theorem pinned_kernel_comparison (edge : E → V × V) (b : E → ℝ)
    (pins inner : Finset V) (ρ : ℝ → C(Spin, Spin)) (τ : Configuration V)
    (P δ : ℝ) (hP : 0 < P) (hδ : 0 ≤ δ) (hρ : Function.Periodic ρ P)
    (hcurv : CurvatureBound (twistedPartition edge b pins inner ρ τ) δ)
    (x y : ℝ) :
    (1 - δ * P ^ 2 / 2) * twistedPartition edge b pins inner ρ τ y ≤
      twistedPartition edge b pins inner ρ τ x := by
  obtain ⟨Z', Z'', h1, h2, hode⟩ := hcurv
  exact periodic_kernel_lower _ Z' Z'' P δ hP hδ
    (twistedPartition_periodic edge b pins inner ρ τ P hρ)
    (fun t => pinnedPartition_pos edge b pins _) h1 h2 hode x y

end RP3
end StandalonePart10

/- ===== RP3/NestedCuts.lean ===== -/
section StandalonePart11

/-! Rotations on nested sets of spins. The averages commute even though
individual rotations about different axes need not commute. -/

namespace RP3.FiniteAction

open Finset MeasureTheory

variable {X V G : Type*} [TopologicalSpace X] [Group G]
  [DecidableEq V]

/-- Apply one rotation to all sites of a cut, fixing every other spin. -/
noncomputable def onCut (A : FiniteAction G X) (s : Finset V) : FiniteAction G (V → X) where
  move g := ⟨fun σ v => if v ∈ s then A.move g (σ v) else σ v, by
    apply continuous_pi
    intro v
    by_cases hv : v ∈ s
    · simpa [hv, Function.comp_def] using (A.move g).continuous.comp (continuous_apply v)
    · simpa [hv] using (continuous_apply v : Continuous (fun σ : V → X => σ v))⟩
  one_apply σ := by ext v; simp [A.one_apply]
  mul_apply g h σ := by ext v; by_cases hv : v ∈ s <;> simp [hv, A.mul_apply]

@[simp] theorem onCut_apply (A : FiniteAction G X) (s : Finset V)
    (g : G) (σ : V → X) (v : V) :
    (A.onCut s).move g σ v = if v ∈ s then A.move g (σ v) else σ v := rfl

/-- Outer rotations conjugate the subgroup of inner rotations. -/
theorem nested_conjugation (A : FiniteAction G X) {s t : Finset V} (hst : s ⊆ t)
    (g h : G) (σ : V → X) :
    (A.onCut t).move h ((A.onCut s).move g σ) =
      (A.onCut s).move (h * g * h⁻¹) ((A.onCut t).move h σ) := by
  ext v
  by_cases hs : v ∈ s
  · have ht := hst hs
    simp only [onCut_apply, hs, ht, ite_true, ← A.mul_apply]
    congr 1
    group
  · by_cases ht : v ∈ t <;> simp [hs, ht]

theorem nested_averages_commute [Fintype G] (A : FiniteAction G X) {s t : Finset V}
    (hst : s ⊆ t) (f : C(V → X, ℝ)) :
    (A.onCut s).average ((A.onCut t).average f) =
      (A.onCut t).average ((A.onCut s).average f) := by
  apply (A.onCut s).averages_commute_of_normalizes (A.onCut t)
    (fun h => (MulAut.conj h).toEquiv)
  intro g h σ
  exact A.nested_conjugation hst g h σ

/-- A finite action is a homeomorphism for each group element. -/
noncomputable def toHomeomorph (A : FiniteAction G X) (g : G) : X ≃ₜ X where
  toFun := A.move g
  invFun := A.move g⁻¹
  left_inv x := by rw [← A.mul_apply, inv_mul_cancel, A.one_apply]
  right_inv x := by rw [← A.mul_apply, mul_inv_cancel, A.one_apply]
  continuous_toFun := (A.move g).continuous
  continuous_invFun := (A.move g⁻¹).continuous

/-- Product reference measures are invariant under cut rotations as soon as
single-site reference measures are invariant. -/
theorem onCut_measurePreserving [Fintype V] [MeasurableSpace X] [BorelSpace X]
    (A : FiniteAction G X) (μ : Measure X) [IsFiniteMeasure μ]
    (hμ : ∀ g, MeasurePreserving (A.move g) μ μ) (s : Finset V) (g : G) :
    MeasurePreserving ((A.onCut s).move g) (Measure.pi fun _ : V => μ)
      (Measure.pi fun _ : V => μ) := by
  have hcoord (v : V) : MeasurePreserving
      (fun x : X => if v ∈ s then A.move g x else x) μ μ := by
    by_cases hv : v ∈ s
    · simpa only [hv, ite_true] using hμ g
    · have heq : (fun x : X => if v ∈ s then A.move g x else x) = id := by
        funext x
        simp [hv]
      rw [heq]
      exact MeasurePreserving.id μ
  exact measurePreserving_pi _ _ hcoord

/-- The complete averaging system on a chain of cuts with a product reference law. -/
noncomputable def nestedSystem {ι : Type*} [Fintype G] [Fintype V] [CompactSpace X]
    [MeasurableSpace X] [BorelSpace X] [SecondCountableTopology X]
    (A : FiniteAction G X) (μ : Measure X) [IsFiniteMeasure μ]
    (hμ : ∀ g, MeasurePreserving (A.move g) μ μ)
    (cuts : ι → Finset V) (hchain : ∀ i j, cuts i ⊆ cuts j ∨ cuts j ⊆ cuts i) :
    AveragingSystem (integralOnCompact (Measure.pi fun _ : V => μ)) ι := by
  apply systemOfFiniteActions _ (fun i => A.onCut (cuts i))
  · intro i g f
    exact (A.onCut_measurePreserving μ hμ (cuts i) g).integral_comp
      ((A.onCut (cuts i)).toHomeomorph g).measurableEmbedding f
  · intro i j f
    rcases hchain i j with hij | hji
    · exact A.nested_averages_commute hij f
    · exact (A.nested_averages_commute hji f).symm

end RP3.FiniteAction
end StandalonePart11

/- ===== RP3/ModelAssembly.lean ===== -/
section StandalonePart12

/-!
# Concrete continuity and symmetry of pinned RP³ kernels

The lemmas here discharge the continuity, boundary locality, and simultaneous
rotation obligations for the actual pinned partition function. They do not
assert the annular analytic estimate or a lattice factorisation.
-/
namespace RP3
noncomputable section
open MeasureTheory
open scoped InnerProductSpace

variable {V E G : Type*} [Fintype V] [Fintype E] [DecidableEq V]

/-- The pinned partition function depends continuously on every boundary spin. -/
theorem continuous_pinnedPartition (edge : E → V × V) (b : E → ℝ)
    (pins : Finset V) : Continuous (pinnedPartition edge b pins) := by
  have hfill : Continuous (fun z : Configuration V × Configuration V =>
      fillPins pins z.1 z.2) := by
    apply continuous_pi
    intro v
    by_cases hv : v ∈ pins <;> simp only [fillPins, ContinuousMap.coe_mk, hv,
      ite_true, ite_false] <;> fun_prop
  have hf : Continuous (Function.uncurry (fun τ σ : Configuration V =>
      Real.exp (interaction edge b (fillPins pins τ σ)))) :=
    (weight edge b).continuous.comp hfill
  have hc := continuous_parametric_integral_of_continuous
    (μ := referenceLaw (V := V)) hf isCompact_univ
  change Continuous (fun τ => ∫ σ, Real.exp
    (interaction edge b (fillPins pins τ σ)) ∂referenceLaw)
  simpa only [Measure.restrict_univ] using hc

/-- The actual pinned partition function as a continuous boundary kernel. -/
def pinnedKernel (edge : E → V × V) (b : E → ℝ) (pins : Finset V) :
    C(Configuration V, ℝ) :=
  ⟨pinnedPartition edge b pins, continuous_pinnedPartition edge b pins⟩

@[simp] theorem pinnedKernel_apply (edge : E → V × V) (b : E → ℝ)
    (pins : Finset V) (τ : Configuration V) :
    pinnedKernel edge b pins τ = pinnedPartition edge b pins τ := rfl

/-- Values at unpinned sites are dummy boundary variables. -/
theorem pinnedPartition_congr (edge : E → V × V) (b : E → ℝ)
    (pins : Finset V) {τ υ : Configuration V}
    (h : ∀ v ∈ pins, τ v = υ v) :
    pinnedPartition edge b pins τ = pinnedPartition edge b pins υ := by
  have hfill : fillPins pins τ = fillPins pins υ := by
    ext σ v
    by_cases hv : v ∈ pins
    · simp [fillPins, hv, h v hv]
    · simp [fillPins, hv]
  simp only [pinnedPartition, pinnedWeight, hfill]

/-- A common orthogonal rotation preserves every squared edge interaction. -/
theorem interaction_globalRotation (edge : E → V × V) (b : E → ℝ)
    (R : E4 ≃ₗᵢ[ℝ] E4) (σ : Configuration V) :
    interaction edge b (fun v => Rotation.spinRotation R (σ v)) =
      interaction edge b σ := by
  unfold interaction
  apply Finset.sum_congr rfl
  intro e _
  simp only [Rotation.spinRotation_val, R.inner_map_map]

/-- Arbitrary pinned arrays can be rotated together without changing the kernel. -/
theorem pinnedPartition_globalRotation (edge : E → V × V) (b : E → ℝ)
    (pins : Finset V) (R : E4 ≃ₗᵢ[ℝ] E4) (τ : Configuration V) :
    pinnedPartition edge b pins (fun v => Rotation.spinRotation R (τ v)) =
      pinnedPartition edge b pins τ := by
  let U := Homeomorph.piCongrRight (fun _ : V => Rotation.spinRotation R)
  have hm : MeasurePreserving U (referenceLaw (V := V)) (referenceLaw (V := V)) := by
    exact measurePreserving_pi _ _ (fun _ => Rotation.spinRotation_preserves_probability R)
  have hfill (σ : Configuration V) :
      fillPins pins (fun v => Rotation.spinRotation R (τ v)) (U σ) =
        fun v => Rotation.spinRotation R (fillPins pins τ σ v) := by
    funext v
    by_cases hv : v ∈ pins <;> simp [fillPins, U, hv]
  change (∫ σ, Real.exp (interaction edge b
    (fillPins pins (fun v => Rotation.spinRotation R (τ v)) σ)) ∂referenceLaw) =
      ∫ σ, Real.exp (interaction edge b (fillPins pins τ σ)) ∂referenceLaw
  rw [← hm.integral_comp U.measurableEmbedding]
  apply integral_congr_ae
  filter_upwards with σ
  rw [hfill, interaction_globalRotation]

/-- Filling some coordinates from each of two independent configurations
preserves the product reference probability. -/
theorem fillPins_product_measurePreserving (pins : Finset V) :
    MeasurePreserving
      (fun z : Configuration V × Configuration V => fillPins pins z.1 z.2)
      ((referenceLaw (V := V)).prod referenceLaw) referenceLaw := by
  let e := MeasurableEquiv.arrowProdEquivProdArrow Spin Spin V
  have he := measurePreserving_arrowProdEquivProdArrow Spin Spin V
    (fun _ => sphereProbability) (fun _ => sphereProbability)
  have hc : ∀ v : V, MeasurePreserving
      (fun z : Spin × Spin => if v ∈ pins then z.1 else z.2)
      (sphereProbability.prod sphereProbability) sphereProbability := by
    intro v
    by_cases hv : v ∈ pins
    · simpa only [hv, ite_true] using
        (measurePreserving_fst : MeasurePreserving Prod.fst
          (sphereProbability.prod sphereProbability) sphereProbability)
    · simpa only [hv, ite_false] using
        (measurePreserving_snd : MeasurePreserving Prod.snd
          (sphereProbability.prod sphereProbability) sphereProbability)
  exact (measurePreserving_pi _ _ hc).comp (MeasurePreserving.symm e he)

/-- Exact elimination of dummy boundary integration variables. -/
theorem integral_fillPins (pins : Finset V) (f : C(Configuration V, ℝ)) :
    (∫ τ, ∫ σ, f (fillPins pins τ σ) ∂referenceLaw ∂referenceLaw) =
      ∫ σ, f σ ∂referenceLaw := by
  have hc : Continuous (fun z : Configuration V × Configuration V =>
      f (fillPins pins z.1 z.2)) := by
    apply f.continuous.comp
    apply continuous_pi
    intro v
    by_cases hv : v ∈ pins <;> simp only [fillPins, ContinuousMap.coe_mk, hv,
      ite_true, ite_false] <;> fun_prop
  rw [← integral_prod _ (hc.integrable_of_hasCompactSupport
    (HasCompactSupport.of_compactSpace _))]
  have hm := fillPins_product_measurePreserving pins
  have hi := integral_map_of_stronglyMeasurable
    (μ := (referenceLaw (V := V)).prod referenceLaw) hm.measurable
    f.continuous.stronglyMeasurable
  rw [hm.map_eq] at hi
  exact hi.symm

/-- Fubini factorisation for one actual annular kernel. The other factor may
contain the observable as well as arbitrary exterior interactions. -/
theorem pinnedKernel_weighted_factorization (edge : E → V × V) (b : E → ℝ)
    (pins : Finset V) (outside : C(Configuration V, ℝ))
    (hout : ∀ τ σ, outside (fillPins pins τ σ) = outside τ) :
    (∫ τ, outside τ * pinnedKernel edge b pins τ ∂referenceLaw) =
      ∫ σ, outside σ * weight edge b σ ∂referenceLaw := by
  calc
    _ = ∫ τ, ∫ σ, (outside * weight edge b) (fillPins pins τ σ)
          ∂referenceLaw ∂referenceLaw := by
      apply integral_congr_ae
      filter_upwards with τ
      simp only [pinnedKernel_apply, pinnedPartition, pinnedWeight,
        integralOnCompact, ContinuousMap.mul_apply, ContinuousMap.comp_apply, hout]
      exact (integral_const_mul _ _).symm
    _ = _ := integral_fillPins pins (outside * weight edge b)

/-- A continuous function depends only on the specified coordinates. -/
def DependsOnPins (pins : Finset V) (f : C(Configuration V, ℝ)) : Prop :=
  ∀ τ σ, f (fillPins pins τ σ) = f τ

/-- Edge weights are local, including when a common edge type is used with
zero couplings to remove the edges outside a chosen region. -/
theorem weight_dependsOnPins (edge : E → V × V) (b : E → ℝ)
    (pins : Finset V)
    (hedge : ∀ e, b e = 0 ∨ ((edge e).1 ∈ pins ∧ (edge e).2 ∈ pins)) :
    DependsOnPins pins (weight edge b) := by
  intro τ σ
  apply congrArg Real.exp
  apply Finset.sum_congr rfl
  intro e _
  rcases hedge e with he | ⟨hl, hr⟩
  · simp only [he, zero_mul]
  · simp only [fillPins, ContinuousMap.coe_mk, hl, hr, ite_true]

theorem observable_dependsOnPins (pins : Finset V) (x y : V)
    (hx : x ∈ pins) (hy : y ∈ pins) :
    DependsOnPins pins (observable x y) := by
  intro τ σ
  simp only [observable, ContinuousMap.coe_mk, fillPins, hx, hy, ite_true]

/-- Integration over the complement of a pin set, with the remaining
coordinates retained as continuous parameters. -/
def boundaryAverage (pins : Finset V) (f : C(Configuration V, ℝ)) :
    C(Configuration V, ℝ) where
  toFun τ := ∫ σ, f (fillPins pins τ σ) ∂referenceLaw
  continuous_toFun := by
    have hf : Continuous (Function.uncurry (fun τ σ : Configuration V =>
        f (fillPins pins τ σ))) := by
      apply f.continuous.comp
      apply continuous_pi
      intro v
      by_cases hv : v ∈ pins <;> simp only [fillPins, ContinuousMap.coe_mk, hv,
        ite_true, ite_false] <;> fun_prop
    simpa only [Measure.restrict_univ] using
      (continuous_parametric_integral_of_continuous
        (μ := referenceLaw (V := V)) hf isCompact_univ)

@[simp] theorem boundaryAverage_apply (pins : Finset V)
    (f : C(Configuration V, ℝ)) (τ : Configuration V) :
    boundaryAverage pins f τ = ∫ σ, f (fillPins pins τ σ) ∂referenceLaw := rfl

theorem pinnedKernel_eq_boundaryAverage (edge : E → V × V) (b : E → ℝ)
    (pins : Finset V) : pinnedKernel edge b pins = boundaryAverage pins (weight edge b) := rfl

theorem boundaryAverage_dependsOnPins (pins : Finset V)
    (f : C(Configuration V, ℝ)) : DependsOnPins pins (boundaryAverage pins f) := by
  intro τ σ
  apply integral_congr_ae
  filter_upwards with υ
  congr 1
  funext v
  by_cases hv : v ∈ pins <;> simp [fillPins, hv]

theorem pinnedKernel_dependsOnPins (edge : E → V × V) (b : E → ℝ)
    (pins : Finset V) : DependsOnPins pins (pinnedKernel edge b pins) :=
  boundaryAverage_dependsOnPins pins (weight edge b)

theorem DependsOnPins.mul {pins : Finset V} {f g : C(Configuration V, ℝ)}
    (hf : DependsOnPins pins f) (hg : DependsOnPins pins g) :
    DependsOnPins pins (f * g) := by
  intro τ σ
  simp only [ContinuousMap.mul_apply, hf τ σ, hg τ σ]

theorem dependsOnPins_one (pins : Finset V) :
    DependsOnPins pins (1 : C(Configuration V, ℝ)) := fun _ _ => rfl

theorem dependsOnPins_prod {ι : Type*} (s : Finset ι) (pins : Finset V)
    (f : ι → C(Configuration V, ℝ)) (hf : ∀ i ∈ s, DependsOnPins pins (f i)) :
    DependsOnPins pins (∏ i ∈ s, f i) := by
  intro τ σ
  simp only [ContinuousMap.prod_apply]
  exact Finset.prod_congr rfl (fun i hi => hf i hi τ σ)

/-- Averaging other coordinates cannot create a dependence on coordinates
that the original function did not use. -/
theorem DependsOnPins.boundaryAverage {pins : Finset V} {f : C(Configuration V, ℝ)}
    (hf : DependsOnPins pins f) (other : Finset V) :
    DependsOnPins pins (boundaryAverage other f) := by
  intro τ σ
  apply integral_congr_ae
  filter_upwards with υ
  have he : fillPins other (fillPins pins τ σ) υ =
      fillPins pins (fillPins other τ υ) (fillPins other σ υ) := by
    funext v
    by_cases hp : v ∈ pins <;> by_cases ho : v ∈ other <;>
      simp [fillPins, hp, ho]
  rw [he, hf]

/-- Exact conditional integration, with any factor depending only on pins
pulled outside the inner integral. -/
theorem integral_mul_boundaryAverage (pins : Finset V)
    (outside f : C(Configuration V, ℝ)) (hout : DependsOnPins pins outside) :
    (∫ τ, outside τ * boundaryAverage pins f τ ∂referenceLaw) =
      ∫ σ, outside σ * f σ ∂referenceLaw := by
  calc
    _ = ∫ τ, ∫ σ, (outside * f) (fillPins pins τ σ)
          ∂referenceLaw ∂referenceLaw := by
      apply integral_congr_ae
      filter_upwards with τ
      simp only [boundaryAverage_apply, ContinuousMap.mul_apply, hout τ]
      exact (integral_const_mul _ _).symm
    _ = _ := integral_fillPins pins (outside * f)

/-- Exact simultaneous integration of any finite family of noninteracting
interiors. The original factors may share arbitrary boundary coordinates;
statistical independence of the Gibbs measure is not assumed. -/
theorem integral_product_boundaryAverage {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (pins : ι → Finset V) (f : ι → C(Configuration V, ℝ))
    (outside : C(Configuration V, ℝ))
    (hout : ∀ i ∈ s, DependsOnPins (pins i) outside)
    (hcross : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → DependsOnPins (pins i) (f j)) :
    (∫ τ, (outside * ∏ i ∈ s, boundaryAverage (pins i) (f i)) τ ∂referenceLaw) =
      ∫ τ, (outside * ∏ i ∈ s, f i) τ ∂referenceLaw := by
  induction s using Finset.induction_on generalizing outside with
  | empty => simp
  | @insert i s hi ih =>
    have houti := hout i (Finset.mem_insert_self i s)
    have houts : ∀ j ∈ s, DependsOnPins (pins j)
        (outside * boundaryAverage (pins i) (f i)) := by
      intro j hj
      exact (hout j (Finset.mem_insert_of_mem hj)).mul
        ((hcross j (Finset.mem_insert_of_mem hj) i (Finset.mem_insert_self i s)
          (by intro he; subst j; exact hi hj)).boundaryAverage (pins i))
    have hcrosss : ∀ a ∈ s, ∀ b ∈ s, a ≠ b → DependsOnPins (pins a) (f b) :=
      fun a ha b hb hab => hcross a (Finset.mem_insert_of_mem ha)
        b (Finset.mem_insert_of_mem hb) hab
    have hfi : DependsOnPins (pins i) (outside * ∏ j ∈ s, f j) :=
      houti.mul (dependsOnPins_prod s (pins i) f (fun j hj =>
        hcross i (Finset.mem_insert_self i s) j (Finset.mem_insert_of_mem hj)
          (by intro he; subst j; exact hi hj)))
    simp only [Finset.prod_insert hi]
    calc
      _ = ∫ τ, ((outside * boundaryAverage (pins i) (f i)) *
            ∏ j ∈ s, boundaryAverage (pins j) (f j)) τ ∂referenceLaw := by
        congr 1
        ext τ
        simp only [ContinuousMap.mul_apply]
        ring
      _ = ∫ τ, ((outside * boundaryAverage (pins i) (f i)) *
            ∏ j ∈ s, f j) τ ∂referenceLaw := ih _ houts hcrosss
      _ = ∫ τ, (outside * ∏ j ∈ s, f j) τ *
            boundaryAverage (pins i) (f i) τ ∂referenceLaw := by
        congr 1
        ext τ
        simp only [ContinuousMap.mul_apply]
        ring
      _ = ∫ τ, (outside * ∏ j ∈ s, f j) τ * f i τ ∂referenceLaw :=
        integral_mul_boundaryAverage (pins i) _ _ hfi
      _ = _ := by
        congr 1
        ext τ
        simp only [ContinuousMap.mul_apply]
        ring

/-- Pinning additional sites that are not edge endpoints does not alter the
annular kernel. This identifies a reduced boundary kernel with one that uses
the complement of its strict interior as the pin set. -/
theorem pinnedPartition_congr_pins (edge : E → V × V) (b : E → ℝ)
    (pins pins' : Finset V)
    (hleft : ∀ e, (edge e).1 ∈ pins ↔ (edge e).1 ∈ pins')
    (hright : ∀ e, (edge e).2 ∈ pins ↔ (edge e).2 ∈ pins')
    (τ : Configuration V) :
    pinnedPartition edge b pins τ = pinnedPartition edge b pins' τ := by
  change (∫ σ, Real.exp (interaction edge b (fillPins pins τ σ)) ∂referenceLaw) =
    ∫ σ, Real.exp (interaction edge b (fillPins pins' τ σ)) ∂referenceLaw
  apply integral_congr_ae
  filter_upwards with σ
  apply congrArg Real.exp
  apply Finset.sum_congr rfl
  intro e _
  simp only [fillPins, ContinuousMap.coe_mk, hleft e, hright e]

section CutSymmetry
variable [Group G] [Fintype G]
variable (A : FiniteAction G Spin) (ρ : G → E4 ≃ₗᵢ[ℝ] E4)
  (hρ : ∀ g s, A.move g s = Rotation.spinRotation (ρ g) s)
include ρ hρ

/-- A cut rotation leaves a pinned kernel fixed if it contains all pinned sites,
or none of them. This is the concrete locality used for distinct annuli. -/
theorem pinnedKernel_cut_invariant (edge : E → V × V) (b : E → ℝ)
    (pins cut : Finset V) (hsep : pins ⊆ cut ∨ Disjoint pins cut)
    (g : G) (τ : Configuration V) :
    pinnedKernel edge b pins ((A.onCut cut).move g τ) =
      pinnedKernel edge b pins τ := by
  rcases hsep with hin | hout
  · calc
      pinnedKernel edge b pins ((A.onCut cut).move g τ) =
          pinnedPartition edge b pins (fun v => Rotation.spinRotation (ρ g) (τ v)) := by
        apply pinnedPartition_congr
        intro v hv
        simp only [FiniteAction.onCut_apply, hin hv, ite_true, hρ]
      _ = _ := pinnedPartition_globalRotation edge b pins (ρ g) τ
  · apply pinnedPartition_congr
    intro v hv
    have hn : v ∉ cut := fun hc => Finset.disjoint_left.mp hout hv hc
    simp [FiniteAction.onCut_apply, hn]

/-- The corresponding average fixes the actual pinned kernel. -/
theorem pinnedKernel_cut_average (edge : E → V × V) (b : E → ℝ)
    (pins cut : Finset V) (hsep : pins ⊆ cut ∨ Disjoint pins cut) :
    (A.onCut cut).average (pinnedKernel edge b pins) = pinnedKernel edge b pins :=
  (A.onCut cut).average_of_invariant _
    (pinnedKernel_cut_invariant A ρ hρ edge b pins cut hsep)

/-- An ordinary remaining-region weight is invariant under a cut if no
interaction edge crosses that cut. -/
theorem weight_cut_invariant (edge : E → V × V) (b : E → ℝ)
    (cut : Finset V)
    (hcut : ∀ e, b e = 0 ∨ ((edge e).1 ∈ cut ↔ (edge e).2 ∈ cut))
    (g : G) (σ : Configuration V) :
    weight edge b ((A.onCut cut).move g σ) = weight edge b σ := by
  apply congrArg Real.exp
  apply Finset.sum_congr rfl
  intro e _
  rcases hcut e with hb | he
  · simp only [hb, zero_mul]
  by_cases hl : (edge e).1 ∈ cut
  · have hr := he.mp hl
    simp only [FiniteAction.onCut_apply, hl, hr, ite_true, hρ,
      Rotation.spinRotation_val, (ρ g).inner_map_map]
  · have hr : (edge e).2 ∉ cut := fun hh => hl (he.mpr hh)
    simp only [FiniteAction.onCut_apply, hl, hr, ite_false]

/-- No-crossing edge geometry discharges the base-weight averaging obligation. -/
theorem weight_cut_average (edge : E → V × V) (b : E → ℝ)
    (cut : Finset V)
    (hcut : ∀ e, b e = 0 ∨ ((edge e).1 ∈ cut ↔ (edge e).2 ∈ cut)) :
    (A.onCut cut).average (weight edge b) = weight edge b :=
  (A.onCut cut).average_of_invariant _
    (weight_cut_invariant A ρ hρ edge b cut hcut)

/-- No active edge crossing a cut implies invariance of the pinned kernel,
for an arbitrary pin set. The unpinned spins undergo the same change of
variables, so the boundary need not be rotated uniformly across the graph. -/
theorem pinnedKernel_cut_invariant_of_edges (edge : E → V × V) (b : E → ℝ)
    (pins cut : Finset V)
    (hcut : ∀ e, b e = 0 ∨ ((edge e).1 ∈ cut ↔ (edge e).2 ∈ cut))
    (g : G) (τ : Configuration V) :
    pinnedKernel edge b pins ((A.onCut cut).move g τ) =
      pinnedKernel edge b pins τ := by
  have hμ : ∀ g, MeasurePreserving (A.move g) sphereProbability sphereProbability := by
    intro h
    have he : (A.move h : Spin → Spin) = Rotation.spinRotation (ρ h) :=
      funext (hρ h)
    rw [he]
    exact Rotation.spinRotation_preserves_probability (ρ h)
  have hm : MeasurePreserving ((A.onCut cut).move g)
      (referenceLaw (V := V)) referenceLaw :=
    A.onCut_measurePreserving sphereProbability hμ cut g
  have hfill (σ : Configuration V) :
      fillPins pins ((A.onCut cut).move g τ) ((A.onCut cut).move g σ) =
        (A.onCut cut).move g (fillPins pins τ σ) := by
    funext v
    by_cases hp : v ∈ pins <;> by_cases hc : v ∈ cut <;>
      simp [fillPins, FiniteAction.onCut_apply, hp, hc]
  change (∫ σ, weight edge b (fillPins pins ((A.onCut cut).move g τ) σ)
      ∂referenceLaw) = ∫ σ, weight edge b (fillPins pins τ σ) ∂referenceLaw
  rw [← hm.integral_comp ((A.onCut cut).toHomeomorph g).measurableEmbedding]
  apply integral_congr_ae
  filter_upwards with σ
  rw [hfill, weight_cut_invariant A ρ hρ edge b cut hcut]

theorem pinnedKernel_cut_average_of_edges (edge : E → V × V) (b : E → ℝ)
    (pins cut : Finset V)
    (hcut : ∀ e, b e = 0 ∨ ((edge e).1 ∈ cut ↔ (edge e).2 ∈ cut)) :
    (A.onCut cut).average (pinnedKernel edge b pins) = pinnedKernel edge b pins :=
  (A.onCut cut).average_of_invariant _
    (pinnedKernel_cut_invariant_of_edges A ρ hρ edge b pins cut hcut)

omit ρ hρ in
/-- Single-spin quadrupole cancellation implies cancellation of the observable
under every cut separating its two sites. -/
theorem observable_cut_average_zero
    (hcancel : ∀ s t : Spin, ∑ g : G, qPair (A.move g s) t = 0)
    (cut : Finset V) (x y : V) (hx : x ∈ cut) (hy : y ∉ cut) :
    (A.onCut cut).average (observable x y) = 0 := by
  ext σ
  simp only [FiniteAction.average_apply, observable, ContinuousMap.coe_mk,
    FiniteAction.onCut_apply, hx, hy, ite_true, ite_false,
    hcancel, mul_zero, ContinuousMap.zero_apply]

end CutSymmetry
end
end RP3
end StandalonePart12

/- ===== RP3/QuaternionAction.lean ===== -/
section StandalonePart13

/-! The eight quaternion units acting on the unit sphere in real four-space. -/
namespace RP3
open MeasureTheory
open scoped BigOperators InnerProductSpace Pointwise

@[ext] structure Quaternion where
  index : Fin 8
  deriving DecidableEq, Fintype

private def quaternionMul (g h : Quaternion) : Quaternion :=
  ⟨![![0, 1, 2, 3, 4, 5, 6, 7],
    ![1, 4, 3, 6, 5, 0, 7, 2],
    ![2, 7, 4, 1, 6, 3, 0, 5],
    ![3, 2, 5, 4, 7, 6, 1, 0],
    ![4, 5, 6, 7, 0, 1, 2, 3],
    ![5, 0, 7, 2, 1, 4, 3, 6],
    ![6, 3, 0, 5, 2, 7, 4, 1],
    ![7, 6, 1, 0, 3, 2, 5, 4]] g.index h.index⟩
private def quaternionInv (g : Quaternion) : Quaternion :=
  ⟨![0,5,6,7,4,1,2,3] g.index⟩

set_option maxHeartbeats 3000000 in
instance : Group Quaternion where
  mul := quaternionMul
  one := ⟨0⟩
  inv := quaternionInv
  mul_assoc := by decide
  one_mul := by decide
  mul_one := by decide
  inv_mul_cancel := by decide

def quaternionIndex : Quaternion ≃ Fin 8 where
  toFun g := g.index
  invFun i := ⟨i⟩
  left_inv _ := rfl
  right_inv _ := rfl

@[simp] theorem quaternion_card : Fintype.card Quaternion = 8 := by
  rw [Fintype.card_congr quaternionIndex]
  decide

@[simp] theorem quaternionRotate_one (u : Fin 4 → ℝ) :
    quaternionRotate (1 : Quaternion).index u = u := by
  change quaternionRotate 0 u = u
  ext i
  fin_cases i <;> rfl

set_option maxHeartbeats 2000000 in
theorem quaternionRotate_mul (g h : Quaternion) (u : Fin 4 → ℝ) :
    quaternionRotate (g*h).index u = quaternionRotate g.index (quaternionRotate h.index u) := by
  rcases g with ⟨g⟩
  rcases h with ⟨h⟩
  change quaternionRotate (quaternionMul ⟨g⟩ ⟨h⟩).index u = _
  fin_cases g <;> fin_cases h <;> ext i <;> fin_cases i <;>
    simp [quaternionMul, quaternionRotate]

noncomputable def quaternionLinear (g : Quaternion) : E4 →ₗ[ℝ] E4 where
  toFun u := WithLp.toLp 2 (quaternionRotate g.index u)
  map_add' u v := by
    rcases g with ⟨g⟩
    ext i
    fin_cases g <;> fin_cases i <;> simp [quaternionRotate, PiLp.add_apply, add_comm]
  map_smul' r u := by
    rcases g with ⟨g⟩
    ext i
    fin_cases g <;> fin_cases i <;> simp [quaternionRotate, PiLp.smul_apply]

@[simp] theorem quaternionLinear_apply (g : Quaternion) (u : E4) (i : Fin 4) :
    quaternionLinear g u i = quaternionRotate g.index u i := rfl

@[simp] theorem quaternionLinear_one (u : E4) : quaternionLinear 1 u = u := by
  ext i
  exact congrFun (quaternionRotate_one u) i

theorem quaternionLinear_mul (g h : Quaternion) (u : E4) :
    quaternionLinear (g*h) u = quaternionLinear g (quaternionLinear h u) := by
  ext i
  exact congrFun (quaternionRotate_mul g h u) i

theorem quaternionLinear_norm (g : Quaternion) (u : E4) :
    ‖quaternionLinear g u‖ = ‖u‖ := by
  have hs : ‖quaternionLinear g u‖^2 = ‖u‖^2 := by
    rw [EuclideanSpace.real_norm_sq_eq, EuclideanSpace.real_norm_sq_eq]
    exact quaternionRotate_squares g.index u
  nlinarith [norm_nonneg (quaternionLinear g u), norm_nonneg u]

noncomputable def quaternionLinearIsometry (g : Quaternion) : E4 ≃ₗᵢ[ℝ] E4 where
  toLinearEquiv := {
    quaternionLinear g with
    invFun := quaternionLinear g⁻¹
    left_inv := fun u => by
      change quaternionLinear g⁻¹ (quaternionLinear g u) = u
      rw [← quaternionLinear_mul, inv_mul_cancel, quaternionLinear_one]
    right_inv := fun u => by
      change quaternionLinear g (quaternionLinear g⁻¹ u) = u
      rw [← quaternionLinear_mul, mul_inv_cancel, quaternionLinear_one] }
  norm_map' := quaternionLinear_norm g

noncomputable def quaternionAction : FiniteAction Quaternion Spin where
  move g := ⟨Rotation.spinRotation (quaternionLinearIsometry g),
    (Rotation.spinRotation (quaternionLinearIsometry g)).continuous⟩
  one_apply s := Subtype.ext (quaternionLinear_one s.val)
  mul_apply g h s := Subtype.ext (quaternionLinear_mul g h s.val)

@[simp] theorem quaternionAction_val (g : Quaternion) (s : Spin) :
    (quaternionAction.move g s).val = quaternionLinear g s.val := rfl

theorem quaternionAction_sum_qPair_zero (s t : Spin) :
    ∑ g : Quaternion, qPair (quaternionAction.move g s) t = 0 := by
  have h := quaternion_cancellation s.val t.val (spin_squares s) (spin_squares t)
  rw [← Equiv.sum_comp quaternionIndex] at h
  change (∑ g : Quaternion,
    ((∑ i : Fin 4, quaternionRotate g.index s.val i * t.val i)^2 - (1:ℝ)/4)) = 0 at h
  simpa only [qPair, quaternionAction_val, PiLp.inner_apply, Real.inner_apply,
    quaternionLinear_apply] using h


theorem quaternionAction_measurePreserving (g : Quaternion) :
    MeasurePreserving (quaternionAction.move g) sphereProbability sphereProbability :=
  Rotation.spinRotation_preserves_probability (quaternionLinearIsometry g)

@[simp] theorem quaternionAction_eq_spinRotation (g : Quaternion) (s : Spin) :
    quaternionAction.move g s = Rotation.spinRotation (quaternionLinearIsometry g) s := rfl

/-- On a separating cut the quadrupolar observable has exactly zero average. -/
theorem quaternionAction_cut_average_zero {V : Type*} [Fintype V] [DecidableEq V]
    (cut : Finset V) (x y : V) (hx : x ∈ cut) (hy : y ∉ cut) :
    (quaternionAction.onCut cut).average (observable x y) = 0 := by
  ext σ
  simp only [FiniteAction.average_apply, observable, ContinuousMap.coe_mk,
    FiniteAction.onCut_apply, hx, hy, ite_true, ite_false, ContinuousMap.zero_apply]
  rw [quaternionAction_sum_qPair_zero, mul_zero]

/-- Concrete averaging system for any nested chain of spatial cuts. -/
noncomputable def quaternionNestedSystem {V ι : Type*} [Fintype V] [DecidableEq V]
    (cuts : ι → Finset V) (hchain : ∀ i j, cuts i ⊆ cuts j ∨ cuts j ⊆ cuts i) :
    AveragingSystem (integralOnCompact (referenceLaw (V := V))) ι :=
  quaternionAction.nestedSystem sphereProbability quaternionAction_measurePreserving cuts hchain

end RP3
end StandalonePart13

/- ===== RP3/LatticeAnnuli.lean ===== -/
section StandalonePart14

/-!
# Edge allocation for nested square annuli

Annular edges are exactly those having at least one endpoint in the strict
interior.  Boundary-only edges stay in the ordinary weight.  These definitions
allow missing vertices, missing edges, and empty annuli.
-/

namespace RP3
noncomputable section
open Finset
open RP3.Fourier
open scoped Classical

namespace Fourier.LatticeGraph

def strictLayer (G : LatticeGraph) (N : ℤ) (z : Site) : Finset G.vertices :=
  univ.filter (fun v => N < siteRadius z v.val ∧ siteRadius z v.val < 2*N)

def innerCut (G : LatticeGraph) (N : ℤ) (z : Site) : Finset G.vertices :=
  univ.filter (fun v => siteRadius z v.val ≤ N)

def kernelEdges (G : LatticeGraph) (N : ℤ) (z : Site) : Finset G.edges :=
  univ.filter (fun e => e.val.1 ∈ G.strictLayer N z ∨ e.val.2 ∈ G.strictLayer N z)

@[simp] theorem mem_strictLayer (G : LatticeGraph) (N : ℤ) (z : Site) (v : G.vertices) :
    v ∈ G.strictLayer N z ↔ N < siteRadius z v.val ∧ siteRadius z v.val < 2*N := by
  simp [strictLayer]

@[simp] theorem mem_innerCut (G : LatticeGraph) (N : ℤ) (z : Site) (v : G.vertices) :
    v ∈ G.innerCut N z ↔ siteRadius z v.val ≤ N := by
  simp [innerCut]

@[simp] theorem mem_kernelEdges (G : LatticeGraph) (N : ℤ) (z : Site) (e : G.edges) :
    e ∈ G.kernelEdges N z ↔
      e.val.1 ∈ G.strictLayer N z ∨ e.val.2 ∈ G.strictLayer N z := by
  simp [kernelEdges]

theorem kernelEdges_endpoints (G : LatticeGraph) (N : ℤ) (z : Site) (e : G.edges)
    (he : e ∈ G.kernelEdges N z) :
    (N ≤ siteRadius z e.val.1.val ∧ siteRadius z e.val.1.val ≤ 2*N) ∧
    (N ≤ siteRadius z e.val.2.val ∧ siteRadius z e.val.2.val ≤ 2*N) := by
  have hn := siteRadius_neighbor_step z (Or.inl (G.nearest e.val e.property))
  simp only [mem_kernelEdges, mem_strictLayer] at he
  omega

theorem innerCut_mono (G : LatticeGraph) {N M : ℤ} (z : Site) (h : N ≤ M) :
    G.innerCut N z ⊆ G.innerCut M z := by
  intro v hv
  exact (mem_innerCut G M z v).mpr (((mem_innerCut G N z v).mp hv).trans h)

theorem separated_kernelEdges (G : LatticeGraph) {N M : ℤ} (z : Site)
    (hNM : 2*N < M) : Disjoint (G.kernelEdges N z) (G.kernelEdges M z) := by
  apply Finset.disjoint_left.mpr
  intro e he hf
  have hn := G.kernelEdges_endpoints N z e he
  have hm := G.kernelEdges_endpoints M z e hf
  omega

theorem kernelEdges_avoid_smaller_interior (G : LatticeGraph) {N M : ℤ} (z : Site)
    (hNM : 2*N < M) (e : G.edges) (he : e ∈ G.kernelEdges M z) :
    e.val.1 ∉ G.strictLayer N z ∧ e.val.2 ∉ G.strictLayer N z := by
  have hm := G.kernelEdges_endpoints M z e he
  simp only [mem_strictLayer]
  omega

theorem kernelEdges_avoid_larger_interior (G : LatticeGraph) {N M : ℤ} (z : Site)
    (hNM : 2*N < M) (e : G.edges) (he : e ∈ G.kernelEdges N z) :
    e.val.1 ∉ G.strictLayer M z ∧ e.val.2 ∉ G.strictLayer M z := by
  have hn := G.kernelEdges_endpoints N z e he
  simp only [mem_strictLayer]
  omega

theorem kernelEdges_inside_larger_cut (G : LatticeGraph) {N M : ℤ} (z : Site)
    (hNM : 2*N < M) (e : G.edges) (he : e ∈ G.kernelEdges N z) :
    e.val.1 ∈ G.innerCut M z ∧ e.val.2 ∈ G.innerCut M z := by
  have hn := G.kernelEdges_endpoints N z e he
  simp only [mem_innerCut]
  omega

theorem kernelEdges_outside_smaller_cut (G : LatticeGraph) {N M : ℤ} (hN : 0 ≤ N)
    (z : Site) (hNM : 2*N < M) (e : G.edges) (he : e ∈ G.kernelEdges M z) :
    e.val.1 ∉ G.innerCut N z ∧ e.val.2 ∉ G.innerCut N z := by
  have hm := G.kernelEdges_endpoints M z e he
  simp only [mem_innerCut]
  omega

/-- Adjacent dyadic annuli may share their boundary: nearest-neighbor edges
cannot meet both strict interiors across that boundary. -/
theorem separated_kernelEdges_le (G : LatticeGraph) {N M : ℤ} (z : Site)
    (hNM : 2*N ≤ M) : Disjoint (G.kernelEdges N z) (G.kernelEdges M z) := by
  apply Finset.disjoint_left.mpr
  intro e he hf
  have hn := siteRadius_neighbor_step z (Or.inl (G.nearest e.val e.property))
  simp only [mem_kernelEdges, mem_strictLayer] at he hf
  omega

theorem kernelEdges_avoid_smaller_interior_le (G : LatticeGraph) {N M : ℤ} (z : Site)
    (hNM : 2*N ≤ M) (e : G.edges) (he : e ∈ G.kernelEdges M z) :
    e.val.1 ∉ G.strictLayer N z ∧ e.val.2 ∉ G.strictLayer N z := by
  have hm := G.kernelEdges_endpoints M z e he
  simp only [mem_strictLayer]
  omega

theorem kernelEdges_avoid_larger_interior_le (G : LatticeGraph) {N M : ℤ} (z : Site)
    (hNM : 2*N ≤ M) (e : G.edges) (he : e ∈ G.kernelEdges N z) :
    e.val.1 ∉ G.strictLayer M z ∧ e.val.2 ∉ G.strictLayer M z := by
  have hn := G.kernelEdges_endpoints N z e he
  simp only [mem_strictLayer]
  omega

theorem kernelEdges_inside_larger_cut_le (G : LatticeGraph) {N M : ℤ} (z : Site)
    (hNM : 2*N ≤ M) (e : G.edges) (he : e ∈ G.kernelEdges N z) :
    e.val.1 ∈ G.innerCut M z ∧ e.val.2 ∈ G.innerCut M z := by
  have hn := G.kernelEdges_endpoints N z e he
  simp only [mem_innerCut]
  omega

theorem kernelEdges_outside_smaller_cut_le (G : LatticeGraph) {N M : ℤ} (hN : 0 < N)
    (z : Site) (hNM : 2*N ≤ M) (e : G.edges) (he : e ∈ G.kernelEdges M z) :
    e.val.1 ∉ G.innerCut N z ∧ e.val.2 ∉ G.innerCut N z := by
  have hm := G.kernelEdges_endpoints M z e he
  simp only [mem_innerCut]
  omega

/-- An edge that crosses the inner cut belongs to that annular kernel. -/
theorem crossing_mem_kernelEdges (G : LatticeGraph) (N : ℤ) (hN : 2 ≤ N)
    (z : Site) (e : G.edges)
    (he : ¬(e.val.1 ∈ G.innerCut N z ↔ e.val.2 ∈ G.innerCut N z)) :
    e ∈ G.kernelEdges N z := by
  have hn := siteRadius_neighbor_step z (Or.inl (G.nearest e.val e.property))
  simp only [mem_kernelEdges, mem_strictLayer]
  simp only [mem_innerCut] at he
  omega

/-- A boundary-only edge omitted from an annulus cannot cross its inner cut. -/
theorem nonkernel_same_side (G : LatticeGraph) (N : ℤ) (hN : 2 ≤ N)
    (z : Site) (e : G.edges) (he : e ∉ G.kernelEdges N z) :
    e.val.1 ∈ G.innerCut N z ↔ e.val.2 ∈ G.innerCut N z := by
  by_contra h
  exact he (G.crossing_mem_kernelEdges N hN z e h)

end Fourier.LatticeGraph

section MaskedInteractions
variable {V E J : Type*} [Fintype V] [Fintype E] [Fintype J]

def maskedCoupling (s : Finset E) (b : E → ℝ) : E → ℝ :=
  fun e => if e ∈ s then b e else 0

def remainingCoupling (sets : J → Finset E) (b : E → ℝ) : E → ℝ :=
  fun e => if ∃ j, e ∈ sets j then 0 else b e

theorem coupling_partition (sets : J → Finset E)
    (hd : Pairwise (fun i j => Disjoint (sets i) (sets j))) (b : E → ℝ) (e : E) :
    b e = remainingCoupling sets b e + ∑ j, maskedCoupling (sets j) b e := by
  classical
  by_cases he : ∃ j, e ∈ sets j
  · obtain ⟨i, hi⟩ := he
    have hz (j : J) (hji : j ≠ i) : maskedCoupling (sets j) b e = 0 := by
      have hn : e ∉ sets j := by
        intro hj
        exact Finset.disjoint_left.mp (hd hji) hj hi
      simp [maskedCoupling, hn]
    rw [Finset.sum_eq_single i (fun j _ hji => hz j hji) (by simp)]
    simp [remainingCoupling, maskedCoupling, hi, show ∃ j, e ∈ sets j from ⟨i, hi⟩]
  · have hn (j : J) : e ∉ sets j := fun h => he ⟨j,h⟩
    simp [remainingCoupling, maskedCoupling, he, hn]

/-- Exact allocation of the squared interaction, with no lost boundary edges. -/
theorem interaction_partition (edge : E → V × V) (sets : J → Finset E)
    (hd : Pairwise (fun i j => Disjoint (sets i) (sets j)))
    (b : E → ℝ) (σ : Configuration V) :
    interaction edge b σ = interaction edge (remainingCoupling sets b) σ +
      ∑ j, interaction edge (maskedCoupling (sets j) b) σ := by
  classical
  unfold interaction
  rw [Finset.sum_comm, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e _
  rw [← Finset.sum_mul, ← add_mul, ← coupling_partition sets hd b e]

/-- The raw Gibbs weight is a product before the interiors are integrated. -/
theorem weight_partition (edge : E → V × V) (sets : J → Finset E)
    (hd : Pairwise (fun i j => Disjoint (sets i) (sets j))) (b : E → ℝ) :
    weight edge b = weight edge (remainingCoupling sets b) *
      ∏ j, weight edge (maskedCoupling (sets j) b) := by
  classical
  ext σ
  change Real.exp (interaction edge b σ) = _
  rw [interaction_partition edge sets hd b σ, Real.exp_add, Real.exp_sum]
  simp [weight]

end MaskedInteractions
end
end RP3
end StandalonePart14

/- ===== RP3/Rates.lean ===== -/
section StandalonePart15

/-!
# From annular products to decay faster than every power

This module is independent of the spin model. All bounds are explicit.
-/

namespace RP3

open Finset

/-- The elementary factorial bound for logarithmically improving annular factors. -/
theorem annular_product_le_factorial (ε : ℕ → ℝ) (B : ℝ) (_hB : 0 ≤ B)
    (hε : ∀ j, 0 ≤ ε j) (hbound : ∀ j, ε j ≤ B / (j + 1)) (k : ℕ) :
    (∏ j ∈ range k, ε j) ≤ B ^ k / k.factorial := by
  calc
    (∏ j ∈ range k, ε j) ≤ ∏ j ∈ range k, B / ((j : ℝ) + 1) :=
      prod_le_prod₀ (fun j _ => hε j) (fun j _ => hbound j)
    _ = B ^ k / k.factorial := by
      rw [prod_div_distrib]
      simp only [prod_const, card_range]
      congr 1
      norm_cast
      exact prod_range_add_one_eq_factorial k

/-- A factorial in the number of scales beats any prescribed power of distance.
The hypothesis `1 + r ≤ a * q^k` records only the geometry of the chosen scales. -/
theorem factorial_weighted_bound {B a q r : ℝ} (hB : 0 ≤ B) (ha : 0 ≤ a)
    (hq : 0 ≤ q) (hr : 0 ≤ r) (k p : ℕ) (hscale : 1 + r ≤ a * q ^ k) :
    (B ^ k / k.factorial) * (1 + r) ^ p ≤
      a ^ p * Real.exp (B * q ^ p) := by
  calc
    (B ^ k / k.factorial) * (1 + r) ^ p ≤
        (B ^ k / k.factorial) * (a * q ^ k) ^ p := by gcongr
    _ = a ^ p * ((B * q ^ p) ^ k / k.factorial) := by
      rw [mul_pow, mul_pow, ← pow_mul, ← pow_mul]
      rw [Nat.mul_comm k p]
      ring
    _ ≤ a ^ p * Real.exp (B * q ^ p) := by
      gcongr
      exact Real.pow_div_factorial_le_exp (B * q ^ p) (mul_nonneg hB (pow_nonneg hq _)) k

/-- Logarithmic annular errors have the factorial bound used in the note. -/
theorem log_factor_le {D L : ℝ} (hD : 0 ≤ D) (hL : Real.log 4 ≤ L) (j : ℕ) :
    D / (L + j * Real.log 4) ≤ (D / Real.log 4) / (j + 1) := by
  have hlog : 0 < Real.log 4 := Real.log_pos (by norm_num)
  have hj : (0 : ℝ) < j + 1 := by positivity
  have hden : (j + 1) * Real.log 4 ≤ L + j * Real.log 4 := by nlinarith
  calc
    D / (L + j * Real.log 4) ≤ D / ((j + 1) * Real.log 4) :=
      div_le_div_of_nonneg_left hD (mul_pos hj hlog) hden
    _ = (D / Real.log 4) / (j + 1) := by rw [div_div, mul_comm]

/-- Number of disjoint scales `N, 4N, ...` whose outer radius is strictly below `r`.
Using a least integer avoids any convention concerning logarithmic rounding. -/
noncomputable def annulusCount (N r : ℕ) (hN : 0 < N) : ℕ :=
  Nat.find (show ∃ k : ℕ, r ≤ 2 * N * 4 ^ k from
    ⟨r, (Nat.lt_pow_self (by norm_num : 1 < (4 : ℕ))).le.trans
      (Nat.le_mul_of_pos_left _ (by omega))⟩)

theorem annulusCount_cover (N r : ℕ) (hN : 0 < N) :
    r ≤ 2 * N * 4 ^ annulusCount N r hN := by
  unfold annulusCount
  exact Nat.find_spec (p := fun k => r ≤ 2 * N * 4 ^ k) _

theorem annulusCount_inside (N r : ℕ) (hN : 0 < N) {j : ℕ}
    (hj : j < annulusCount N r hN) : 2 * N * 4 ^ j < r := by
  unfold annulusCount at hj
  exact Nat.lt_of_not_ge (Nat.find_min (p := fun k => r ≤ 2 * N * 4 ^ k) _ hj)

theorem annulusCount_distance (N r : ℕ) (hN : 0 < N) :
    1 + (r : ℝ) ≤ (2 * N + 1) * (4 : ℝ) ^ annulusCount N r hN := by
  have hc : (r : ℝ) ≤ 2 * N * (4 : ℝ) ^ annulusCount N r hN := by
    exact_mod_cast annulusCount_cover N r hN
  have hp : (1 : ℝ) ≤ 4 ^ annulusCount N r hN := one_le_pow₀ (by norm_num)
  nlinarith

/-- A natural-exponent formulation; the next theorem includes arbitrary real exponents. -/
def SuperpolynomialDecay (C : ℕ → ℝ) : Prop :=
  ∀ p : ℕ, ∃ A > 0, ∀ r : ℕ, |C r| * (1 + (r : ℝ)) ^ p ≤ A

/-- A factorial bound at geometric scales implies superpolynomial decay. -/
theorem superpolynomial_of_factorial {C : ℕ → ℝ} {M B : ℝ} (hM : 0 ≤ M)
    (hB : 0 ≤ B) (N : ℕ) (hN : 0 < N)
    (hC : ∀ r, |C r| ≤ M * B ^ annulusCount N r hN /
      (annulusCount N r hN).factorial) : SuperpolynomialDecay C := by
  intro p
  let A := M * (2 * (N : ℝ) + 1) ^ p * Real.exp (B * (4 : ℝ) ^ p)
  refine ⟨A + 1, by dsimp [A]; positivity, ?_⟩
  intro r
  have hb := factorial_weighted_bound hB
    (show 0 ≤ 2 * (N : ℝ) + 1 by positivity) (by norm_num : (0 : ℝ) ≤ 4)
    (Nat.cast_nonneg r) (annulusCount N r hN) p (annulusCount_distance N r hN)
  calc
    |C r| * (1 + (r : ℝ)) ^ p ≤
        M * ((B ^ annulusCount N r hN /
          (annulusCount N r hN).factorial) * (1 + (r : ℝ)) ^ p) := by
      calc
        _ ≤ (M * B ^ annulusCount N r hN /
            (annulusCount N r hN).factorial) * (1 + (r : ℝ)) ^ p := by
          gcongr
          exact hC r
        _ = _ := by ring
    _ ≤ A := by dsimp [A]; nlinarith [mul_le_mul_of_nonneg_left hb hM]
    _ ≤ A + 1 := by linarith

/-- The same conclusion in the conventional `A (1+r)^(-p)` form, for real `p`. -/
theorem SuperpolynomialDecay.real_bound {C : ℕ → ℝ} (h : SuperpolynomialDecay C)
    (p : ℝ) : ∃ A > 0, ∀ r : ℕ, |C r| ≤ A * (1 + (r : ℝ)) ^ (-p) := by
  obtain ⟨A, hA, hbound⟩ := h ⌈p⌉₊
  refine ⟨A, hA, ?_⟩
  intro r
  have hx : (0 : ℝ) < 1 + r := by positivity
  have hexp : (1 + (r : ℝ)) ^ p ≤ (1 + (r : ℝ)) ^ ⌈p⌉₊ := by
    rw [← Real.rpow_natCast]
    exact Real.rpow_le_rpow_of_exponent_le (by have := Nat.cast_nonneg (α := ℝ) r; linarith) (Nat.le_ceil p)
  have hw : |C r| * (1 + (r : ℝ)) ^ p ≤ A :=
    (mul_le_mul_of_nonneg_left hexp (abs_nonneg _)).trans (hbound r)
  rw [Real.rpow_neg hx.le]
  exact (le_div_iff₀ (Real.rpow_pos_of_pos hx p)).2 hw

end RP3
end StandalonePart15

/- ===== RP3/Main.lean ===== -/
section StandalonePart16

/-!
# Conditional conclusion of the annular argument

`AnnularData` is an explicit certificate for the factorised model. Its fields
are proof obligations, not axioms.  In particular, `lower` is the analytic
annular estimate, and `cross`/`base_fixed` are the locality/symmetry obligations.
This file does not claim those fields have been constructed for RP³.
-/

namespace RP3

open Finset

variable {Ω : Type*} [TopologicalSpace Ω]

/-- Data after integrating out the strict interiors of `k` annuli. -/
structure AnnularData (Ω : Type*) [TopologicalSpace Ω] (k : ℕ) (D L : ℝ) where
  integral : PositiveIntegral Ω
  system : AveragingSystem integral ℕ
  kernels : ℕ → C(Ω, ℝ)
  base : C(Ω, ℝ)
  obs : C(Ω, ℝ)
  kernel_nonneg : ∀ i ∈ range k, ∀ x, 0 ≤ kernels i x
  base_nonneg : ∀ x, 0 ≤ base x
  lower : ∀ i ∈ range k, ∀ x,
    (1 - D / (L + i * Real.log 4)) * system.avg i (kernels i) x ≤ kernels i x
  cross : ∀ i ∈ range k, ∀ j ∈ range k, i ≠ j → system.avg i (kernels j) = kernels j
  base_fixed : ∀ i ∈ range k, system.avg i base = base
  obs_zero : ∀ i ∈ range k, system.avg i obs = 0
  obs_bound : ∀ x, |obs x| ≤ (3 : ℝ) / 4
  partition_pos : 0 < integral.linear (base * ∏ i ∈ range k, kernels i)

namespace AnnularData

variable {k : ℕ} {D L : ℝ} (A : AnnularData Ω k D L)

noncomputable def correlation : ℝ :=
  A.integral.linear (A.obs * A.base * ∏ i ∈ range k, A.kernels i) /
    A.integral.linear (A.base * ∏ i ∈ range k, A.kernels i)

theorem product_bound (hD : 0 < D) (hL : Real.log 4 ≤ L) :
    |A.correlation| ≤ (3 : ℝ) / 4 * ∏ j ∈ range k, D / (L + j * Real.log 4) := by
  have hlog : 0 < Real.log 4 := Real.log_pos (by norm_num)
  apply A.system.correlation_bound
  · intro j _
    apply div_pos hD
    have hLj : 0 ≤ (j : ℝ) * Real.log 4 := mul_nonneg (Nat.cast_nonneg j) hlog.le
    linarith
  · exact A.kernel_nonneg
  · exact A.lower
  · exact A.cross
  · exact A.obs_zero
  · exact A.obs_bound
  · exact A.base_nonneg
  · exact A.base_fixed
  · exact A.partition_pos

theorem factorial_bound (hD : 0 < D) (hL : Real.log 4 ≤ L) :
    |A.correlation| ≤ (3 : ℝ) / 4 * (D / Real.log 4) ^ k / k.factorial := by
  have hlog : 0 < Real.log 4 := Real.log_pos (by norm_num)
  have hL0 : 0 ≤ L := hlog.le.trans hL
  have hp := annular_product_le_factorial (fun j => D / (L + j * Real.log 4))
    (D / Real.log 4) (div_nonneg hD.le hlog.le)
    (fun j => div_nonneg hD.le (by positivity)) (log_factor_le hD.le hL) k
  calc
    |A.correlation| ≤ (3 : ℝ) / 4 * ∏ j ∈ range k, D / (L + j * Real.log 4) :=
      A.product_bound hD hL
    _ ≤ (3 : ℝ) / 4 * ((D / Real.log 4) ^ k / k.factorial) := by gcongr
    _ = _ := by ring

/-- A uniform explicit estimate: the constant does not depend on the graph,
its volume, the sites, or the represented correlation. -/
theorem weighted_bound (hD : 0 < D) (hL : Real.log 4 ≤ L)
    {a r : ℝ} (ha : 0 ≤ a) (hr : 0 ≤ r) (hscale : 1 + r ≤ a * (4 : ℝ) ^ k)
    (p : ℕ) :
    |A.correlation| * (1 + r) ^ p ≤
      (3 : ℝ) / 4 * a ^ p * Real.exp ((D / Real.log 4) * (4 : ℝ) ^ p) := by
  have hlog : 0 < Real.log 4 := Real.log_pos (by norm_num)
  have hf := factorial_weighted_bound (div_nonneg hD.le hlog.le) ha
    (by norm_num : (0 : ℝ) ≤ 4) hr k p hscale
  calc
    |A.correlation| * (1 + r) ^ p ≤
        ((3 : ℝ) / 4 * (D / Real.log 4) ^ k / k.factorial) * (1 + r) ^ p := by
      gcongr
      exact A.factorial_bound hD hL
    _ = (3 : ℝ) / 4 * (((D / Real.log 4) ^ k / k.factorial) * (1 + r) ^ p) := by ring
    _ ≤ (3 : ℝ) / 4 * (a ^ p * Real.exp ((D / Real.log 4) * (4 : ℝ) ^ p)) := by
      gcongr
    _ = _ := by ring

end AnnularData

/-- Precise conditional statement: a correlation sequence with certified
annular factorizations has superpolynomial decay. -/
theorem superpolynomial_of_annular_data {C : ℕ → ℝ} {D L : ℝ}
    (spaces : ℕ → Type*) [∀ r, TopologicalSpace (spaces r)]
    (hD : 0 < D) (hL : Real.log 4 ≤ L) (N : ℕ) (hN : 0 < N)
    (data : ∀ r, AnnularData (spaces r) (annulusCount N r hN) D L)
    (represents : ∀ r, (data r).correlation = C r) : SuperpolynomialDecay C := by
  apply superpolynomial_of_factorial (M := (3 : ℝ) / 4)
    (B := D / Real.log 4) (by norm_num)
    (div_nonneg hD.le (Real.log_pos (by norm_num)).le) N hN
  intro r
  rw [← represents r]
  exact (data r).factorial_bound hD hL

end RP3
end StandalonePart16

/- ===== RP3/ConcreteAnnuli.lean ===== -/
section StandalonePart17

/-!
# The product estimate for the actual finite-volume RP³ Gibbs measure

All kernels in this file are ordinary pinned partition integrals of the
squared interaction.  The factorization and the normalization identity are
proved from integration; they are not representation hypotheses.
-/

namespace RP3
noncomputable section
open Finset MeasureTheory

variable {V E J : Type*} [Fintype V] [Fintype E] [Fintype J]
  [DecidableEq V] [DecidableEq J]

/-- A finite-volume product bound with a single analytic hypothesis: the
pointwise rotational comparison for the actual pinned annular kernels.
The remaining hypotheses are finite edge and cut incidences. -/
theorem concrete_kernel_product_bound (edge : E → V × V) (b : E → ℝ)
    (sets : J → Finset E) (pins cuts : J → Finset V) (x y : V) (ε : J → ℝ)
    (hdisjoint : Pairwise (fun i j => Disjoint (sets i) (sets j)))
    (hchain : ∀ i j, cuts i ⊆ cuts j ∨ cuts j ⊆ cuts i)
    (hbaseLocal : ∀ i e, remainingCoupling sets b e = 0 ∨
      ((edge e).1 ∈ pins i ∧ (edge e).2 ∈ pins i))
    (hcrossLocal : ∀ i j, i ≠ j → ∀ e, maskedCoupling (sets j) b e = 0 ∨
      ((edge e).1 ∈ pins i ∧ (edge e).2 ∈ pins i))
    (hobsLocal : ∀ i, x ∈ pins i ∧ y ∈ pins i)
    (hbaseCut : ∀ i e, remainingCoupling sets b e = 0 ∨
      ((edge e).1 ∈ cuts i ↔ (edge e).2 ∈ cuts i))
    (hcrossCut : ∀ i j, i ≠ j → ∀ e, maskedCoupling (sets j) b e = 0 ∨
      ((edge e).1 ∈ cuts i ↔ (edge e).2 ∈ cuts i))
    (hseparates : ∀ i, x ∈ cuts i ∧ y ∉ cuts i)
    (hε : ∀ i, 0 < ε i)
    (hcompare : ∀ i (g : Quaternion) τ,
      (1 - ε i) * pinnedKernel edge (maskedCoupling (sets i) b) (pins i)
        ((quaternionAction.onCut (cuts i)).move g τ) ≤
        pinnedKernel edge (maskedCoupling (sets i) b) (pins i) τ) :
    |correlation edge b x y| ≤ (3 : ℝ) / 4 * ∏ i, ε i := by
  classical
  let I := integralOnCompact (referenceLaw (V := V))
  let S := quaternionNestedSystem cuts hchain
  let f := fun i => weight edge (maskedCoupling (sets i) b)
  let K := fun i => pinnedKernel edge (maskedCoupling (sets i) b) (pins i)
  let W := weight edge (remainingCoupling sets b)
  let O := observable x y
  have hf : ∀ i j, i ≠ j → DependsOnPins (pins i) (f j) := by
    intro i j hij
    exact weight_dependsOnPins edge _ _ (hcrossLocal i j hij)
  have hW : ∀ i, DependsOnPins (pins i) W := by
    intro i
    exact weight_dependsOnPins edge _ _ (hbaseLocal i)
  have hO : ∀ i, DependsOnPins (pins i) O := by
    intro i
    exact observable_dependsOnPins _ x y (hobsLocal i).1 (hobsLocal i).2
  have hZ : I.linear (W * ∏ i, K i) = partition edge b := by
    change (∫ τ, (W * ∏ i, K i) τ ∂referenceLaw) = _
    have h := integral_product_boundaryAverage (univ : Finset J) pins f W
      (fun i _ => hW i) (fun i _ j _ hij => hf i j hij)
    change (∫ τ, (W * ∏ i, K i) τ ∂referenceLaw) =
      ∫ τ, (W * ∏ i, f i) τ ∂referenceLaw at h
    rw [h]
    have hw := weight_partition edge sets hdisjoint b
    change (∫ τ, (weight edge (remainingCoupling sets b) *
      ∏ i, weight edge (maskedCoupling (sets i) b)) τ ∂referenceLaw) = _
    rw [← hw]
    rfl
  have hnum : I.linear (O * W * ∏ i, K i) =
      I.linear (observable x y * weight edge b) := by
    change (∫ τ, (O * W * ∏ i, K i) τ ∂referenceLaw) = _
    have h := integral_product_boundaryAverage (univ : Finset J) pins f (O * W)
      (fun i _ => (hO i).mul (hW i)) (fun i _ j _ hij => hf i j hij)
    change (∫ τ, (O * W * ∏ i, K i) τ ∂referenceLaw) =
      ∫ τ, (O * W * ∏ i, f i) τ ∂referenceLaw at h
    rw [h]
    have hw : O * W * ∏ i, f i = observable x y * weight edge b := by
      rw [weight_partition edge sets hdisjoint b]
      exact mul_assoc _ _ _
    rw [hw]
    rfl
  have hb := S.correlation_bound (univ : Finset J) ε K O W
    (fun i _ => hε i)
    (fun i _ τ => (pinnedPartition_pos edge _ _ τ).le)
    (fun i _ => (quaternionAction.onCut (cuts i)).comparison_lower (K i) (ε i)
      (hcompare i))
    (fun i _ j _ hij => pinnedKernel_cut_average_of_edges
      quaternionAction quaternionLinearIsometry quaternionAction_eq_spinRotation
      edge _ (pins j) (cuts i) (hcrossCut i j hij))
    (fun i _ => quaternionAction_cut_average_zero _ x y (hseparates i).1 (hseparates i).2)
    (fun τ => abs_qPair_le (τ x) (τ y))
    (fun τ => (Real.exp_pos _).le)
    (fun i _ => weight_cut_average quaternionAction quaternionLinearIsometry
      quaternionAction_eq_spinRotation edge _ (cuts i) (hbaseCut i))
    (by rw [hZ]; exact partition_pos edge b)
  change |I.linear (O * W * ∏ i, K i) / I.linear (W * ∏ i, K i)| ≤ _ at hb
  rw [hZ, hnum] at hb
  exact hb

namespace Fourier.LatticeGraph

/-- The concrete nested-annulus product bound on every retained square-lattice
graph.  The only hypothesis beyond geometric scale separation is comparison
of explicitly defined pinned RP³ partition integrals. -/
theorem square_annuli_product_bound (G : LatticeGraph) (b : G.edges → ℝ)
    (k : ℕ) (N : Fin k → ℤ) (hN : ∀ i, 2 ≤ N i)
    (hsep : ∀ i j, i < j → 2*N i < N j)
    (x y : G.vertices) (hy : ∀ i, 2*N i < siteRadius x.val y.val)
    (ε : Fin k → ℝ) (hε : ∀ i, 0 < ε i)
    (hcompare : ∀ i (g : Quaternion) τ,
      (1 - ε i) * pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (N i) x.val) b) (G.strictLayer (N i) x.val)ᶜ
        ((quaternionAction.onCut (G.innerCut (N i) x.val)).move g τ) ≤
      pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (N i) x.val) b) (G.strictLayer (N i) x.val)ᶜ τ) :
    |correlation (fun e : G.edges => e.val) b x y| ≤ (3 : ℝ) / 4 * ∏ i, ε i := by
  classical
  let sets := fun i => G.kernelEdges (N i) x.val
  let pins := fun i => (G.strictLayer (N i) x.val)ᶜ
  let cuts := fun i => G.innerCut (N i) x.val
  have hleft (i : Fin k) : x ∈ pins i := by
    simp only [pins, mem_compl, mem_strictLayer, siteRadius_self]
    have := hN i
    omega
  have hright (i : Fin k) : y ∈ pins i := by
    simp only [pins, mem_compl, mem_strictLayer]
    have := hy i
    omega
  apply concrete_kernel_product_bound (fun e : G.edges => e.val) b sets pins cuts
    x y ε
  · intro i j hij
    rcases lt_or_gt_of_ne hij with hij | hji
    · exact G.separated_kernelEdges x.val (hsep i j hij)
    · exact (G.separated_kernelEdges x.val (hsep j i hji)).symm
  · intro i j
    rcases le_total i j with hij | hji
    · left
      apply G.innerCut_mono
      rcases eq_or_lt_of_le hij with rfl | hij
      · exact le_rfl
      · have := hsep i j hij
        have := hN i
        omega
    · right
      apply G.innerCut_mono
      rcases eq_or_lt_of_le hji with rfl | hji
      · exact le_rfl
      · have := hsep j i hji
        have := hN j
        omega
  · intro i e
    by_cases he : ∃ j, e ∈ sets j
    · left
      simp [remainingCoupling, he]
    · right
      have hn : e ∉ sets i := fun hi => he ⟨i, hi⟩
      simpa only [sets, pins, mem_kernelEdges, not_or, mem_compl] using hn
  · intro i j hij e
    by_cases he : e ∈ sets j
    · right
      simp only [pins, mem_compl]
      rcases lt_or_gt_of_ne hij with hij | hji
      · exact G.kernelEdges_avoid_smaller_interior x.val (hsep i j hij) e he
      · exact G.kernelEdges_avoid_larger_interior x.val (hsep j i hji) e he
    · left
      simp [maskedCoupling, he]
  · exact fun i => ⟨hleft i, hright i⟩
  · intro i e
    by_cases he : ∃ j, e ∈ sets j
    · left
      simp [remainingCoupling, he]
    · right
      exact G.nonkernel_same_side (N i) (hN i) x.val e (fun hi => he ⟨i,hi⟩)
  · intro i j hij e
    by_cases he : e ∈ sets j
    · right
      rcases lt_or_gt_of_ne hij with hij | hji
      · have hn := G.kernelEdges_outside_smaller_cut (by have := hN i; omega)
          x.val (hsep i j hij) e he
        exact iff_of_false hn.1 hn.2
      · have hn := G.kernelEdges_inside_larger_cut x.val (hsep j i hji) e he
        exact iff_of_true hn.1 hn.2
    · left
      simp [maskedCoupling, he]
  · intro i
    simp only [cuts, mem_innerCut, siteRadius_self]
    have := hN i
    have := hy i
    omega
  · exact hε
  · exact hcompare

end Fourier.LatticeGraph

end
end RP3
end StandalonePart17

/- ===== RP3/ThinAnnuli.lean ===== -/
section StandalonePart18

/-! Integer square annuli with independently chosen inner and outer radii.
Every kernel edge has an endpoint in the strict interior. Boundary-only
edges remain in the base weight. No fixed ratio between radii is assumed. -/
namespace RP3
noncomputable section
open Finset MeasureTheory
open RP3.Fourier
open scoped Classical

namespace Fourier

def thinAnnulusSites (R S : ℤ) (z : Site) : Set Site :=
  {v | R ≤ siteRadius z v ∧ siteRadius z v ≤ S}

namespace LatticeGraph

def thinLayer (G : LatticeGraph) (R S : ℤ) (z : Site) : Finset G.vertices :=
  univ.filter (fun v => R < siteRadius z v.val ∧ siteRadius z v.val < S)

def thinKernelEdges (G : LatticeGraph) (R S : ℤ) (z : Site) : Finset G.edges :=
  univ.filter (fun e => e.val.1 ∈ G.thinLayer R S z ∨ e.val.2 ∈ G.thinLayer R S z)

@[simp] theorem mem_thinLayer (G : LatticeGraph) (R S : ℤ) (z : Site) (v : G.vertices) :
    v ∈ G.thinLayer R S z ↔ R < siteRadius z v.val ∧ siteRadius z v.val < S := by
  simp [thinLayer]

@[simp] theorem mem_thinKernelEdges (G : LatticeGraph) (R S : ℤ) (z : Site) (e : G.edges) :
    e ∈ G.thinKernelEdges R S z ↔
      e.val.1 ∈ G.thinLayer R S z ∨ e.val.2 ∈ G.thinLayer R S z := by
  simp [thinKernelEdges]

theorem thinKernelEdges_endpoints (G : LatticeGraph) (R S : ℤ) (z : Site) (e : G.edges)
    (he : e ∈ G.thinKernelEdges R S z) :
    (R ≤ siteRadius z e.val.1.val ∧ siteRadius z e.val.1.val ≤ S) ∧
    (R ≤ siteRadius z e.val.2.val ∧ siteRadius z e.val.2.val ≤ S) := by
  have hn := siteRadius_neighbor_step z (Or.inl (G.nearest e.val e.property))
  simp only [mem_thinKernelEdges, mem_thinLayer] at he
  omega

theorem separated_thinKernelEdges (G : LatticeGraph) {R S T U : ℤ} (z : Site)
    (hsep : S ≤ T) : Disjoint (G.thinKernelEdges R S z) (G.thinKernelEdges T U z) := by
  apply Finset.disjoint_left.mpr
  intro e he hf
  have hn := siteRadius_neighbor_step z (Or.inl (G.nearest e.val e.property))
  simp only [mem_thinKernelEdges, mem_thinLayer] at he hf
  omega

theorem thinKernelEdges_avoid_smaller_interior (G : LatticeGraph) {R S T U : ℤ}
    (z : Site) (hsep : S ≤ T) (e : G.edges) (he : e ∈ G.thinKernelEdges T U z) :
    e.val.1 ∉ G.thinLayer R S z ∧ e.val.2 ∉ G.thinLayer R S z := by
  have hm := G.thinKernelEdges_endpoints T U z e he
  simp only [mem_thinLayer]
  omega

theorem thinKernelEdges_avoid_larger_interior (G : LatticeGraph) {R S T U : ℤ}
    (z : Site) (hsep : S ≤ T) (e : G.edges) (he : e ∈ G.thinKernelEdges R S z) :
    e.val.1 ∉ G.thinLayer T U z ∧ e.val.2 ∉ G.thinLayer T U z := by
  have hn := G.thinKernelEdges_endpoints R S z e he
  simp only [mem_thinLayer]
  omega

theorem thinKernelEdges_inside_larger_cut (G : LatticeGraph) {R S T : ℤ}
    (z : Site) (hsep : S ≤ T) (e : G.edges) (he : e ∈ G.thinKernelEdges R S z) :
    e.val.1 ∈ G.innerCut T z ∧ e.val.2 ∈ G.innerCut T z := by
  have hn := G.thinKernelEdges_endpoints R S z e he
  simp only [mem_innerCut]
  omega

theorem thinKernelEdges_outside_smaller_cut (G : LatticeGraph) {R S T U : ℤ}
    (z : Site) (hwidth : R < S) (hsep : S ≤ T)
    (e : G.edges) (he : e ∈ G.thinKernelEdges T U z) :
    e.val.1 ∉ G.innerCut R z ∧ e.val.2 ∉ G.innerCut R z := by
  have hm := G.thinKernelEdges_endpoints T U z e he
  simp only [mem_innerCut]
  omega

/-- Width two is enough: a nearest-neighbor edge crossing the inner cut has
an endpoint at radius `R+1`, in the strict interior. -/
theorem crossing_mem_thinKernelEdges (G : LatticeGraph) (R S : ℤ)
    (hwidth : R+2 ≤ S) (z : Site) (e : G.edges)
    (he : ¬(e.val.1 ∈ G.innerCut R z ↔ e.val.2 ∈ G.innerCut R z)) :
    e ∈ G.thinKernelEdges R S z := by
  have hn := siteRadius_neighbor_step z (Or.inl (G.nearest e.val e.property))
  simp only [mem_thinKernelEdges, mem_thinLayer]
  simp only [mem_innerCut] at he
  omega

theorem nonthinKernel_same_side (G : LatticeGraph) (R S : ℤ)
    (hwidth : R+2 ≤ S) (z : Site) (e : G.edges)
    (he : e ∉ G.thinKernelEdges R S z) :
    e.val.1 ∈ G.innerCut R z ↔ e.val.2 ∈ G.innerCut R z := by
  by_contra h
  exact he (G.crossing_mem_thinKernelEdges R S hwidth z e h)

/-- The annular product estimate remains valid when consecutive annuli share
only their pinned boundary. -/
theorem thin_square_annuli_product_bound {J : Type*} [Fintype J] [LinearOrder J]
    (G : LatticeGraph) (b : G.edges → ℝ) (R S : J → ℤ) (hR : ∀ i, 0 ≤ R i)
    (hwidth : ∀ i, R i+2 ≤ S i)
    (hsep : ∀ i j, i < j → S i ≤ R j)
    (x y : G.vertices) (hy : ∀ i, S i < siteRadius x.val y.val)
    (ε : J → ℝ) (hε : ∀ i, 0 < ε i)
    (hcompare : ∀ i (g : Quaternion) τ,
      (1 - ε i) * pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.thinKernelEdges (R i) (S i) x.val) b) (G.thinLayer (R i) (S i) x.val)ᶜ
        ((quaternionAction.onCut (G.innerCut (R i) x.val)).move g τ) ≤
      pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.thinKernelEdges (R i) (S i) x.val) b) (G.thinLayer (R i) (S i) x.val)ᶜ τ) :
    |correlation (fun e : G.edges => e.val) b x y| ≤ (3 : ℝ) / 4 * ∏ i, ε i := by
  classical
  let sets := fun i => G.thinKernelEdges (R i) (S i) x.val
  let pins := fun i => (G.thinLayer (R i) (S i) x.val)ᶜ
  let cuts := fun i => G.innerCut (R i) x.val
  have hleft (i : J) : x ∈ pins i := by
    simp only [pins, mem_compl, mem_thinLayer, siteRadius_self]
    have := hR i
    have := hwidth i
    omega
  have hright (i : J) : y ∈ pins i := by
    simp only [pins, mem_compl, mem_thinLayer]
    have := hy i
    omega
  apply concrete_kernel_product_bound (fun e : G.edges => e.val) b sets pins cuts
    x y ε
  · intro i j hij
    rcases lt_or_gt_of_ne hij with hij | hji
    · exact G.separated_thinKernelEdges x.val (hsep i j hij)
    · exact (G.separated_thinKernelEdges x.val (hsep j i hji)).symm
  · intro i j
    rcases le_total i j with hij | hji
    · left
      apply G.innerCut_mono
      rcases eq_or_lt_of_le hij with rfl | hij
      · exact le_rfl
      · have := hsep i j hij
        have := hR i
        have := hwidth i
        omega
    · right
      apply G.innerCut_mono
      rcases eq_or_lt_of_le hji with rfl | hji
      · exact le_rfl
      · have := hsep j i hji
        have := hR j
        have := hwidth j
        omega
  · intro i e
    by_cases he : ∃ j, e ∈ sets j
    · left
      simp [remainingCoupling, he]
    · right
      have hn : e ∉ sets i := fun hi => he ⟨i, hi⟩
      simpa only [sets, pins, mem_thinKernelEdges, not_or, mem_compl] using hn
  · intro i j hij e
    by_cases he : e ∈ sets j
    · right
      simp only [pins, mem_compl]
      rcases lt_or_gt_of_ne hij with hij | hji
      · exact G.thinKernelEdges_avoid_smaller_interior x.val (hsep i j hij) e he
      · exact G.thinKernelEdges_avoid_larger_interior x.val (hsep j i hji) e he
    · left
      simp [maskedCoupling, he]
  · exact fun i => ⟨hleft i, hright i⟩
  · intro i e
    by_cases he : ∃ j, e ∈ sets j
    · left
      simp [remainingCoupling, he]
    · right
      exact G.nonthinKernel_same_side (R i) (S i) (hwidth i) x.val e (fun hi => he ⟨i,hi⟩)
  · intro i j hij e
    by_cases he : e ∈ sets j
    · right
      rcases lt_or_gt_of_ne hij with hij | hji
      · have hn := G.thinKernelEdges_outside_smaller_cut (R := R i) (S := S i)
          (T := R j) (U := S j) x.val (by have := hwidth i; omega) (hsep i j hij) e he
        exact iff_of_false hn.1 hn.2
      · have hn := G.thinKernelEdges_inside_larger_cut x.val (hsep j i hji) e he
        exact iff_of_true hn.1 hn.2
    · left
      simp [maskedCoupling, he]
  · intro i
    simp only [cuts, mem_innerCut, siteRadius_self]
    have := hR i
    have := hwidth i
    have := hy i
    omega
  · exact hε
  · exact hcompare



end LatticeGraph
end Fourier
end
end RP3
end StandalonePart18

/- ===== RP3/ModelRestriction.lean ===== -/
section StandalonePart19

/-!
# Restriction and relabeling of actual pinned RP³ partitions

Vertices with no active interaction can be discarded, even if they are
pinned. Coordinate projection pushes the full product reference law to the
restricted product law; the assertions are exact equalities.
-/
namespace RP3
noncomputable section
open MeasureTheory
open scoped InnerProductSpace

section Restriction
variable {V E : Type*} [Fintype V] [Fintype E] [DecidableEq V]
variable (P : V → Prop) [DecidablePred P]

/-- Restricting an independent reference configuration to any set of sites
has the corresponding independent reference distribution. -/
theorem referenceLaw_restrict_measurePreserving :
    MeasurePreserving (fun σ : Configuration V => fun v : {v // P v} => σ v.val)
      (referenceLaw (V := V)) (referenceLaw (V := {v // P v})) := by
  have hp := measurePreserving_piEquivPiSubtypeProd
    (fun _ : V => sphereProbability) P
  exact measurePreserving_fst.comp hp

def inducedEdge (edge : E → V × V) :
    {e : E // P (edge e).1 ∧ P (edge e).2} → {v // P v} × {v // P v} :=
  fun e => (⟨(edge e.val).1, e.property.1⟩, ⟨(edge e.val).2, e.property.2⟩)

def inducedPins (pins : Finset V) : Finset {v // P v} :=
  Finset.univ.filter (fun v => v.val ∈ pins)

@[simp] theorem mem_inducedPins (pins : Finset V) (v : {v // P v}) :
    v ∈ inducedPins P pins ↔ v.val ∈ pins := by simp [inducedPins]

/-- Removing zero-strength edges and irrelevant vertices does not change
an interaction evaluated at the remaining spins. -/
theorem interaction_restrict (edge : E → V × V) (b : E → ℝ)
    (hb : ∀ e, ¬ (P (edge e).1 ∧ P (edge e).2) → b e = 0)
    (σ : Configuration V) :
    interaction edge b σ =
      interaction (inducedEdge P edge) (fun e => b e.val) (fun v => σ v.val) := by
  let q : E → Prop := fun e => P (edge e).1 ∧ P (edge e).2
  let f : E → ℝ := fun e => b e * ⟪(σ (edge e).1).val, (σ (edge e).2).val⟫_ℝ ^ 2
  have hsum := Fintype.sum_subtype_add_sum_subtype q f
  have hz : (∑ e : {e // ¬ q e}, f e.val) = 0 := by
    apply Finset.sum_eq_zero
    intro e _
    simp only [f, hb e.val e.property, zero_mul]
  rw [hz, add_zero] at hsum
  exact hsum.symm

/-- Exact identification with a smaller pinned finite-volume system. -/
theorem pinnedPartition_restrict (edge : E → V × V) (b : E → ℝ)
    (hb : ∀ e, ¬ (P (edge e).1 ∧ P (edge e).2) → b e = 0)
    (pins : Finset V) (τ : Configuration V) :
    pinnedPartition edge b pins τ =
      pinnedPartition (inducedEdge P edge) (fun e => b e.val)
        (inducedPins P pins) (fun v => τ v.val) := by
  have hfill (σ : Configuration V) :
      (fun v : {v // P v} => fillPins pins τ σ v.val) =
      fillPins (inducedPins P pins) (fun v => τ v.val) (fun v => σ v.val) := by
    funext v
    simp only [fillPins, ContinuousMap.coe_mk, mem_inducedPins]
  change (∫ σ, Real.exp (interaction edge b (fillPins pins τ σ)) ∂referenceLaw) = _
  simp_rw [interaction_restrict P edge b hb, hfill]
  have hm := referenceLaw_restrict_measurePreserving P
  have hi := integral_map_of_stronglyMeasurable
    (μ := referenceLaw (V := V)) hm.measurable
    (pinnedWeight (inducedEdge P edge) (fun e => b e.val)
      (inducedPins P pins) (fun v => τ v.val)).continuous.stronglyMeasurable
  rw [hm.map_eq] at hi
  exact hi.symm
end Restriction

section Reindex
variable {V E W F : Type*} [Fintype V] [Fintype E] [Fintype W] [Fintype F]
  [DecidableEq V] [DecidableEq W]

/-- The same finite interaction in relabeled vertex and edge coordinates. -/
theorem interaction_reindex (ev : V ≃ W) (ee : E ≃ F)
    (edge : E → V × V) (edge' : F → W × W) (b : E → ℝ)
    (hl : ∀ e, (edge' (ee e)).1 = ev (edge e).1)
    (hr : ∀ e, (edge' (ee e)).2 = ev (edge e).2)
    (σ : Configuration V) :
    interaction edge b σ = interaction edge' (fun e => b (ee.symm e))
      (fun v => σ (ev.symm v)) := by
  apply Fintype.sum_equiv ee
  intro e
  simp only [ee.symm_apply_apply, hl, hr, ev.symm_apply_apply]

/-- Relabeling vertices, edges, pins, and boundary arrays leaves the actual
pinned partition function unchanged. -/
theorem pinnedPartition_reindex (ev : V ≃ W) (ee : E ≃ F)
    (edge : E → V × V) (edge' : F → W × W) (b : E → ℝ)
    (hl : ∀ e, (edge' (ee e)).1 = ev (edge e).1)
    (hr : ∀ e, (edge' (ee e)).2 = ev (edge e).2)
    (pins : Finset V) (pins' : Finset W)
    (hp : ∀ v, ev v ∈ pins' ↔ v ∈ pins)
    (τ : Configuration V) :
    pinnedPartition edge b pins τ =
      pinnedPartition edge' (fun e => b (ee.symm e)) pins' (fun v => τ (ev.symm v)) := by
  let e := MeasurableEquiv.piCongrLeft (fun _ : W => Spin) ev
  have hm : MeasurePreserving e (referenceLaw (V := V)) (referenceLaw (V := W)) :=
    measurePreserving_piCongrLeft (fun _ : W => sphereProbability) ev
  have hfill (σ : Configuration V) :
      (fun v : W => fillPins pins τ σ (ev.symm v)) =
      fillPins pins' (fun v => τ (ev.symm v)) (e σ) := by
    funext v
    have hv : v ∈ pins' ↔ ev.symm v ∈ pins := by simpa using hp (ev.symm v)
    have heval : e σ v = σ (ev.symm v) := by
      have hh := MeasurableEquiv.piCongrLeft_apply_apply
        (β := fun _ : W => Spin) ev σ (ev.symm v)
      simpa only [Equiv.apply_symm_apply] using hh
    simp only [fillPins, ContinuousMap.coe_mk, hv, heval]
  change (∫ σ, Real.exp (interaction edge b (fillPins pins τ σ)) ∂referenceLaw) = _
  simp_rw [interaction_reindex ev ee edge edge' b hl hr, hfill]
  exact hm.integral_comp e.measurableEmbedding
    (fun σ => Real.exp (interaction edge' (fun e => b (ee.symm e))
      (fillPins pins' (fun v => τ (ev.symm v)) σ)))
end Reindex
end
end RP3
end StandalonePart19

/- ===== RP3/LatticeModelRestriction.lean ===== -/
section StandalonePart20

/-! Exact restriction of annular kernels and translation of lattice Gibbs systems. -/
namespace RP3.Fourier.LatticeGraph
noncomputable section
open scoped Classical
open RP3

/-- Pins inherited by a restricted retained graph. -/
def restrictionPins (G : LatticeGraph) (P : Site → Prop) (pins : Finset G.vertices) :
    Finset (G.restrict P).vertices :=
  Finset.univ.filter (fun v => G.restrictVertex P v ∈ pins)

/-- Discarding all vertices and zero-strength edges outside a site predicate
identifies the actual pinned partition with the retained subgraph. -/
theorem pinnedPartition_restrict_graph (G : LatticeGraph) (P : Site → Prop)
    (b : G.edges → ℝ)
    (hb : ∀ e, ¬ (P e.val.1.val ∧ P e.val.2.val) → b e = 0)
    (pins : Finset G.vertices) (τ : Configuration G.vertices) :
    pinnedPartition (fun e : G.edges => e.val) b pins τ =
      pinnedPartition (fun e : (G.restrict P).edges => e.val)
        (fun e => b (G.restrictEdge P e)) (G.restrictionPins P pins)
        (fun v => τ (G.restrictVertex P v)) := by
  let Pv : G.vertices → Prop := fun v => P v.val
  have h1 := RP3.pinnedPartition_restrict Pv (fun e : G.edges => e.val) b hb pins τ
  have h2 := RP3.pinnedPartition_reindex (G.restrictVertexEquiv P)
    (G.restrictEdgeEquiv P) (inducedEdge Pv (fun e : G.edges => e.val))
    (fun e : (G.restrict P).edges => e.val) (fun e => b e.val)
    (fun _ => rfl) (fun _ => rfl)
    (inducedPins Pv pins) (G.restrictionPins P pins)
    (by
      intro v
      simp only [restrictionPins, Finset.mem_filter, Finset.mem_univ, true_and,
        mem_inducedPins]
      try rfl)
    (fun v => τ v.val)
  exact h1.trans h2

/-- The finite pin set on the two boundary layers of the restricted annulus. -/
def annulusPinFinset (G : LatticeGraph) (N : ℤ) (z : Site) :
    Finset (G.annulusGraph N z).vertices :=
  Finset.univ.filter (fun v => v ∈ G.annulusPins N z)

set_option backward.isDefEq.respectTransparency false in
/-- Outside the strict annular interior, the remaining vertices of the
restricted annulus are exactly its two boundary layers. -/
theorem restrictionPins_strictLayer_compl (G : LatticeGraph) (N : ℤ) (z : Site) :
    G.restrictionPins (· ∈ annulusSites N z) (G.strictLayer N z)ᶜ =
      G.annulusPinFinset N z := by
  classical
  ext v
  have hv : N ≤ siteRadius z v.val ∧ siteRadius z v.val ≤ 2*N :=
    (Finset.mem_filter.mp v.property).2
  simp only [restrictionPins, annulusPinFinset, Finset.mem_filter, Finset.mem_univ,
    true_and, Finset.mem_compl, mem_strictLayer, restrictVertex,
    Set.mem_ofPred_eq, annulusPins, annulusInner, annulusOuter, Set.mem_union]
  change ¬ (N < siteRadius z v.val ∧ siteRadius z v.val < 2*N) ↔
    siteRadius z v.val = N ∨ siteRadius z v.val = 2*N
  omega

/-- The full-graph masked pinned kernel equals the actual annular partition
with its boundary-only couplings set to zero. -/
theorem pinnedKernel_annulus_restrict (G : LatticeGraph) (N : ℤ) (z : Site)
    (b : G.edges → ℝ) (τ : Configuration G.vertices) :
    pinnedKernel (fun e : G.edges => e.val)
      (maskedCoupling (G.kernelEdges N z) b) (G.strictLayer N z)ᶜ τ =
    pinnedPartition (fun e : (G.annulusGraph N z).edges => e.val)
      (fun e => maskedCoupling (G.kernelEdges N z) b
        (G.restrictEdge (· ∈ annulusSites N z) e))
      (G.annulusPinFinset N z)
      (fun v => τ (G.restrictVertex (· ∈ annulusSites N z) v)) := by
  have hb : ∀ e : G.edges,
      ¬ (e.val.1.val ∈ annulusSites N z ∧ e.val.2.val ∈ annulusSites N z) →
      maskedCoupling (G.kernelEdges N z) b e = 0 := by
    intro e he
    by_cases hm : e ∈ G.kernelEdges N z
    · exact False.elim (he (G.kernelEdges_endpoints N z e hm))
    · simp only [maskedCoupling, hm, ite_false]
  have h := G.pinnedPartition_restrict_graph (· ∈ annulusSites N z)
    (maskedCoupling (G.kernelEdges N z) b) hb (G.strictLayer N z)ᶜ τ
  rw [restrictionPins_strictLayer_compl] at h
  exact h

/-- Pins transported along a lattice translation. -/
def translatePins (G : LatticeGraph) (z : Site) (pins : Finset G.vertices) :
    Finset (G.translate z).vertices :=
  Finset.univ.filter (fun v => (G.translateVertexEquiv z).symm v ∈ pins)

set_option backward.isDefEq.respectTransparency false in
/-- Translation is only a relabeling of the pinned RP³ integral. -/
theorem pinnedPartition_translate (G : LatticeGraph) (z : Site) (b : G.edges → ℝ)
    (pins : Finset G.vertices) (τ : Configuration G.vertices) :
    pinnedPartition (fun e : G.edges => e.val) b pins τ =
      pinnedPartition (fun e : (G.translate z).edges => e.val)
        (fun e => b ((G.translateEdgeEquiv z).symm e)) (G.translatePins z pins)
        (fun v => τ ((G.translateVertexEquiv z).symm v)) := by
  classical
  apply RP3.pinnedPartition_reindex (G.translateVertexEquiv z)
    (G.translateEdgeEquiv z) (fun e : G.edges => e.val)
    (fun e : (G.translate z).edges => e.val) b
    (G.translateEdgeEquiv_left z) (G.translateEdgeEquiv_right z)
    pins (G.translatePins z pins)
  intro v
  have hm (w : (G.translate z).vertices) :
      w ∈ G.translatePins z pins ↔ (G.translateVertexEquiv z).symm w ∈ pins := by
    exact (@Finset.mem_filter (G.translate z).vertices
      (fun a => (G.translateVertexEquiv z).symm a ∈ pins)
      (fun a => Classical.propDecidable _) Finset.univ w).trans
      (and_iff_right (Finset.mem_univ w))
  exact (hm ((G.translateVertexEquiv z) v)).trans
    (by rw [Equiv.symm_apply_apply])

/-- The original vertex corresponding to a site of the centered annulus. -/
def annulusOriginalVertex (G : LatticeGraph) (N : ℤ) (z : Site)
    (v : ((G.annulusGraph N z).translate z).vertices) : G.vertices :=
  G.restrictVertex (· ∈ annulusSites N z)
    (((G.annulusGraph N z).translateVertexEquiv z).symm v)

theorem annulusOriginalVertex_radius (G : LatticeGraph) (N : ℤ) (z : Site)
    (v : ((G.annulusGraph N z).translate z).vertices) :
    siteRadius z (G.annulusOriginalVertex N z v).val = siteRadius 0 v.val := by
  have h := (G.annulusGraph N z).translateVertexEquiv_val z
    (((G.annulusGraph N z).translateVertexEquiv z).symm v)
  have hc := congrArg (fun w => w.val)
    (((G.annulusGraph N z).translateVertexEquiv z).apply_symm_apply v)
  have h' : v.val = (((G.annulusGraph N z).translateVertexEquiv z).symm v).val - z :=
    hc.symm.trans h
  calc
    _ = siteRadius 0 ((((G.annulusGraph N z).translateVertexEquiv z).symm v).val - z) := by
      simp only [annulusOriginalVertex, restrictVertex, siteRadius,
        Prod.fst_sub, Prod.snd_sub, Prod.fst_zero, Prod.snd_zero, sub_zero]
    _ = _ := congrArg (siteRadius 0) h'.symm

theorem translated_annulus_within_box (G : LatticeGraph) (k : ℕ) (z : Site) :
    ((G.annulusGraph (2^k) z).translate z).WithinDyadicBox k := by
  intro v
  let w := (((G.annulusGraph (2^k) z).translateVertexEquiv z).symm v)
  have hv : (2:ℤ)^k ≤ siteRadius z w.val ∧ siteRadius z w.val ≤ 2*(2:ℤ)^k :=
    (Finset.mem_filter.mp w.property).2
  have hr := G.annulusOriginalVertex_radius (2^k) z v
  have hbound : siteRadius 0 v.val ≤ 2*(2:ℤ)^k := by
    rw [← hr]
    exact hv.2
  simpa only [siteRadius, Prod.fst_zero, Prod.snd_zero, sub_zero,
    max_le_iff, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_pow] using hbound

theorem translated_annulus_pin_radius (G : LatticeGraph) (N : ℤ) (z : Site)
    (v : ((G.annulusGraph N z).translate z).vertices)
    (hv : v ∈ (G.annulusGraph N z).translatePins z (G.annulusPinFinset N z)) :
    siteRadius 0 v.val = N ∨ siteRadius 0 v.val = 2*N := by
  have hr := G.annulusOriginalVertex_radius N z v
  simp only [translatePins, Finset.mem_filter, Finset.mem_univ, true_and,
    annulusPinFinset] at hv
  change siteRadius z (G.annulusOriginalVertex N z v).val = N ∨
    siteRadius z (G.annulusOriginalVertex N z v).val = 2*N at hv
  rwa [hr] at hv

/-- An inner cut on the original graph becomes the radial inner cut after
restriction and translation. This identity holds for every boundary array. -/
theorem annulusOriginalVertex_cut (G : LatticeGraph) (N : ℤ) (z : Site)
    {H : Type*} [Group H] (A : FiniteAction H Spin) (g : H)
    (τ : Configuration G.vertices)
    (v : ((G.annulusGraph N z).translate z).vertices) :
    (A.onCut (G.innerCut N z)).move g τ (G.annulusOriginalVertex N z v) =
      if siteRadius 0 v.val ≤ N then A.move g (τ (G.annulusOriginalVertex N z v))
      else τ (G.annulusOriginalVertex N z v) := by
  simp only [FiniteAction.onCut_apply, mem_innerCut, annulusOriginalVertex_radius]

/-- A single exact equality from the full-graph kernel to the origin-centered
annular pinned model used by the Fourier estimates. -/
theorem pinnedKernel_centered_annulus (G : LatticeGraph) (N : ℤ) (z : Site)
    (b : G.edges → ℝ) (τ : Configuration G.vertices) :
    pinnedKernel (fun e : G.edges => e.val)
      (maskedCoupling (G.kernelEdges N z) b) (G.strictLayer N z)ᶜ τ =
    pinnedPartition (fun e : ((G.annulusGraph N z).translate z).edges => e.val)
      (fun e => maskedCoupling (G.kernelEdges N z) b
        (G.restrictEdge (· ∈ annulusSites N z)
          (((G.annulusGraph N z).translateEdgeEquiv z).symm e)))
      ((G.annulusGraph N z).translatePins z (G.annulusPinFinset N z))
      (fun v => τ (G.annulusOriginalVertex N z v)) := by
  exact (G.pinnedKernel_annulus_restrict N z b τ).trans
    ((G.annulusGraph N z).pinnedPartition_translate z _ _ _)
end
end RP3.Fourier.LatticeGraph
end StandalonePart20

/- ===== RP3/Calculus.lean ===== -/
section StandalonePart21

/-!
Adapted from OpenAI's ClassicalON/FiniteVolume.lean at commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a, licensed under Apache-2.0.
Copyright OpenAI. The namespace and imports have been changed and the
interaction-independent lemmas separated from the O(n) Gibbs model.
-/

namespace RP3
universe uΩ uF
open MeasureTheory
noncomputable section

theorem hasDerivAt_integral_compact
    {Ω : Type uΩ} {F : Type uF} [TopologicalSpace Ω] [CompactSpace Ω] [MeasurableSpace Ω]
    [OpensMeasurableSpace Ω] [NormedAddCommGroup F] [NormedSpace ℝ F]
    (μ : Measure Ω) [IsFiniteMeasure μ] (f fd : ℝ → Ω → F)
    (hf : Continuous (Function.uncurry f)) (hfd : Continuous (Function.uncurry fd))
    (hd : ∀ t ω, HasDerivAt (fun u => f u ω) (fd t ω) t) (t : ℝ) :
    HasDerivAt (fun u => ∫ ω, f u ω ∂μ) (∫ ω, fd t ω ∂μ) t := by
  have hi (u : ℝ) : Integrable (f u) μ :=
    (hf.comp (continuous_const.prodMk continuous_id)).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  have hdi (u : ℝ) : Integrable (fd u) μ :=
    (hfd.comp (continuous_const.prodMk continuous_id)).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  obtain ⟨C, hC⟩ := (((isCompact_closedBall t 1).prod
    (isCompact_univ : IsCompact (Set.univ : Set Ω))).image hfd).isBounded.exists_norm_le
  exact (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (s := Metric.closedBall t 1) (bound := fun _ => C)
    (Metric.closedBall_mem_nhds t zero_lt_one)
    (Filter.Eventually.of_forall fun u => (hi u).aestronglyMeasurable)
    (hi t) (hdi t).aestronglyMeasurable
    (Filter.Eventually.of_forall fun ω u hu => hC _ ⟨(u, ω), ⟨hu, Set.mem_univ _⟩, rfl⟩)
    (integrable_const C)
    (Filter.Eventually.of_forall fun ω u _ => hd u ω)).2

def fourthBell {Ω : Type uΩ} (F : ℕ → ℝ → Ω → ℝ) (t : ℝ) (ω : Ω) : ℝ :=
  Real.exp (F 0 t ω) * (F 4 t ω + 4 * F 1 t ω * F 3 t ω + 3 * (F 2 t ω)^2 +
    6 * (F 1 t ω)^2 * F 2 t ω + (F 1 t ω)^4)

theorem iteratedDeriv_four_integral_exp
    {Ω : Type uΩ} [TopologicalSpace Ω] [CompactSpace Ω] [MeasurableSpace Ω]
    [OpensMeasurableSpace Ω] (μ : Measure Ω) [IsFiniteMeasure μ]
    (F : ℕ → ℝ → Ω → ℝ)
    (hC : ∀ k, Continuous (Function.uncurry (F k)))
    (hD : ∀ k t ω, HasDerivAt (fun u => F k u ω) (F (k+1) t ω) t) (t : ℝ) :
    iteratedDeriv 4 (fun u => ∫ ω, Real.exp (F 0 u ω) ∂μ) t =
      ∫ ω, fourthBell F t ω ∂μ := by
  let w0 := fun u ω => Real.exp (F 0 u ω)
  let w1 := fun u ω => Real.exp (F 0 u ω) * F 1 u ω
  let w2 := fun u ω => Real.exp (F 0 u ω) * (F 2 u ω + (F 1 u ω)^2)
  let w3 := fun u ω => Real.exp (F 0 u ω) *
    (F 3 u ω + 3 * F 1 u ω * F 2 u ω + (F 1 u ω)^3)
  let w4 := fourthBell F
  have c0 : Continuous (Function.uncurry w0) := (hC 0).rexp
  have c1 : Continuous (Function.uncurry w1) := (hC 0).rexp.mul (hC 1)
  have c2 : Continuous (Function.uncurry w2) :=
    (hC 0).rexp.mul ((hC 2).add ((hC 1).pow 2))
  have c3 : Continuous (Function.uncurry w3) := (hC 0).rexp.mul
    (((hC 3).add (((hC 1).const_mul 3).mul (hC 2))).add ((hC 1).pow 3))
  have c4 : Continuous (Function.uncurry w4) := (hC 0).rexp.mul
    (((((hC 4).add (((hC 1).const_mul 4).mul (hC 3))).add
      (((hC 2).pow 2).const_mul 3)).add ((((hC 1).pow 2).const_mul 6).mul
        (hC 2))).add ((hC 1).pow 4))
  have d0 (u : ℝ) (ω : Ω) : HasDerivAt (fun v => w0 v ω) (w1 u ω) u := (hD 0 u ω).exp
  have d1 (u : ℝ) (ω : Ω) : HasDerivAt (fun v => w1 v ω) (w2 u ω) u :=
    ((d0 u ω).mul (hD 1 u ω)).congr_deriv (by dsimp [w0, w1, w2]; ring)
  have d2 (u : ℝ) (ω : Ω) : HasDerivAt (fun v => w2 v ω) (w3 u ω) u :=
    ((d0 u ω).mul ((hD 2 u ω).add ((hD 1 u ω).pow 2))).congr_deriv
      (by dsimp [w0, w1, w3]; ring)
  have d3 (u : ℝ) (ω : Ω) : HasDerivAt (fun v => w3 v ω) (w4 u ω) u :=
    ((d0 u ω).mul (((hD 3 u ω).add (((hD 1 u ω).const_mul 3).mul
      (hD 2 u ω))).add ((hD 1 u ω).pow 3))).congr_deriv
      (by dsimp [w0, w1, w4, fourthBell]; ring)
  have e0 : deriv (fun u => ∫ ω, w0 u ω ∂μ) = (fun u => ∫ ω, w1 u ω ∂μ) :=
    funext fun u => (hasDerivAt_integral_compact μ w0 w1 c0 c1 d0 u).deriv
  have e1 : deriv (fun u => ∫ ω, w1 u ω ∂μ) = (fun u => ∫ ω, w2 u ω ∂μ) :=
    funext fun u => (hasDerivAt_integral_compact μ w1 w2 c1 c2 d1 u).deriv
  have e2 : deriv (fun u => ∫ ω, w2 u ω ∂μ) = (fun u => ∫ ω, w3 u ω ∂μ) :=
    funext fun u => (hasDerivAt_integral_compact μ w2 w3 c2 c3 d2 u).deriv
  have e3 : deriv (fun u => ∫ ω, w3 u ω ∂μ) = (fun u => ∫ ω, w4 u ω ∂μ) :=
    funext fun u => (hasDerivAt_integral_compact μ w3 w4 c3 c4 d3 u).deriv
  change iteratedDeriv 4 (fun u => ∫ ω, w0 u ω ∂μ) t = ∫ ω, w4 t ω ∂μ
  simp only [iteratedDeriv_succ, iteratedDeriv_zero, e0, e1, e2, e3]

end
end RP3
end StandalonePart21

/- ===== RP3/QuadraticGibbs.lean ===== -/
section StandalonePart22

/-!
# Pinned quadratic-spin Gibbs systems

Gauge transformations and their reference-measure proofs are adapted from
OpenAI's ClassicalON/FiniteVolume.lean at commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a (Apache-2.0, copyright OpenAI).
The interaction here is the squared scalar product. Its derivative jets are
constructed by the product rule, rather than the linear-energy formulas in
that source.
-/

namespace RP3.Quadratic
universe uV uE
noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace

def siteReference (p : Option (RP3.Spin)) : Measure (RP3.Spin) :=
  match p with
  | none => sphereProbability
  | some s => Measure.dirac s

instance siteReference_isProbability (p : Option (RP3.Spin)) :
    IsProbabilityMeasure (siteReference p) := by
  cases p <;> dsimp [siteReference] <;> infer_instance

structure SpinSystem (V : Type uV) (E : Type uE) where
  left : E → V
  right : E → V
  strength : E → ℝ
  pin : V → Option (RP3.Spin)

namespace SpinSystem
variable {V : Type uV} {E : Type uE} [Fintype V] [Fintype E]

def reference (S : SpinSystem V E) : Measure (V → RP3.Spin) :=
  Measure.pi (fun x => siteReference (S.pin x))

instance reference_isProbability (S : SpinSystem V E) :
    IsProbabilityMeasure S.reference := by
  unfold reference
  infer_instance

def energy (S : SpinSystem V E) (K : E → SpinOperator 4) (σ : V → RP3.Spin) : ℝ :=
  ∑ e, S.strength e * ⟪(σ (S.left e)).val, K e (σ (S.right e)).val⟫_ℝ ^ 2

def Z (S : SpinSystem V E) (K : E → SpinOperator 4) : ℝ :=
  ∫ σ, Real.exp (S.energy K σ) ∂S.reference

omit [Fintype V] in
theorem continuous_energy (S : SpinSystem V E) (K : E → SpinOperator 4) :
    Continuous (S.energy K) := by
  unfold energy
  fun_prop

theorem integrable_weight (S : SpinSystem V E) (K : E → SpinOperator 4) :
    Integrable (fun σ => Real.exp (S.energy K σ)) S.reference :=
  (S.continuous_energy K).rexp.integrable_of_hasCompactSupport
    (HasCompactSupport.of_compactSpace _)

theorem Z_pos (S : SpinSystem V E) (K : E → SpinOperator 4) :
    0 < S.Z K := by
  unfold Z
  apply (integral_pos_iff_support_of_nonneg
    (fun σ => (Real.exp_pos _).le) (S.integrable_weight K)).mpr
  have hs : Function.support (fun σ => Real.exp (S.energy K σ)) = Set.univ := by
    ext σ
    simp [Function.mem_support, Real.exp_ne_zero]
  rw [hs, measure_univ]
  exact zero_lt_one

def rotateConfiguration
    (U : V → E4 ≃ₗᵢ[ℝ] E4) :
    (V → RP3.Spin) ≃ₜ (V → RP3.Spin) :=
  Homeomorph.piCongrRight (fun x => spinRotation (U x))

def rotatePins (S : SpinSystem V E)
    (U : V → E4 ≃ₗᵢ[ℝ] E4) :
    SpinSystem V E :=
  { S with pin := fun x => (S.pin x).map (spinRotation (U x)) }

def gauge (S : SpinSystem V E) (K : E → SpinOperator 4)
    (U : V → E4 ≃ₗᵢ[ℝ] E4) :
    E → SpinOperator 4 :=
  fun e => (U (S.left e)).symm.toContinuousLinearEquiv.toContinuousLinearMap * K e *
    (U (S.right e)).toContinuousLinearEquiv.toContinuousLinearMap

omit [Fintype E] in
theorem rotateConfiguration_preserves_reference (S : SpinSystem V E)
    (U : V → E4 ≃ₗᵢ[ℝ] E4) :
    MeasurePreserving (rotateConfiguration U) S.reference (S.rotatePins U).reference := by
  change MeasurePreserving (fun σ x => spinRotation (U x) (σ x))
    (Measure.pi (fun x => siteReference (S.pin x)))
    (Measure.pi (fun x => siteReference ((S.pin x).map (spinRotation (U x)))))
  apply measurePreserving_pi
  intro x
  cases S.pin x with
  | none => exact spinRotation_preserves_probability (U x)
  | some s =>
    exact ⟨(spinRotation (U x)).measurable, Measure.map_dirac s⟩

omit [Fintype V] in
theorem energy_gauge (S : SpinSystem V E) (K : E → SpinOperator 4)
    (U : V → E4 ≃ₗᵢ[ℝ] E4)
    (σ : V → RP3.Spin) :
    S.energy (S.gauge K U) σ = (S.rotatePins U).energy K (rotateConfiguration U σ) := by
  apply Finset.sum_congr rfl
  intro e _
  change S.strength e * _ ^ 2 = S.strength e * _ ^ 2
  apply congrArg (fun r : ℝ => S.strength e * r ^ 2)
  change ⟪(σ (S.left e)).val,
      (U (S.left e)).symm (K e (U (S.right e) (σ (S.right e)).val))⟫_ℝ =
    ⟪U (S.left e) (σ (S.left e)).val, K e (U (S.right e) (σ (S.right e)).val)⟫_ℝ
  simpa only [LinearIsometryEquiv.apply_symm_apply] using
    ((U (S.left e)).inner_map_map (σ (S.left e)).val
      ((U (S.left e)).symm (K e (U (S.right e) (σ (S.right e)).val)))).symm

theorem Z_gauge (S : SpinSystem V E) (K : E → SpinOperator 4)
    (U : V → E4 ≃ₗᵢ[ℝ] E4) :
    S.Z (S.gauge K U) = (S.rotatePins U).Z K := by
  unfold Z
  simp_rw [energy_gauge]
  exact (S.rotateConfiguration_preserves_reference U).integral_comp
    (rotateConfiguration U).measurableEmbedding
    (fun σ => Real.exp ((S.rotatePins U).energy K σ))

omit [Fintype V] [Fintype E] in

theorem rotatePins_eq_self (S : SpinSystem V E)
    (U : V → E4 ≃ₗᵢ[ℝ] E4)
    (hU : ∀ x s, S.pin x = some s → spinRotation (U x) s = s) :
    S.rotatePins U = S := by
  suffices hp : (fun x => (S.pin x).map (spinRotation (U x))) = S.pin by
    unfold rotatePins
    rw [hp]
  funext x
  cases h : S.pin x with
  | none => rfl
  | some s => simp only [Option.map_some, hU x s h]

theorem Z_gauge_of_fixes_pins (S : SpinSystem V E)
    (K : E → SpinOperator 4)
    (U : V → E4 ≃ₗᵢ[ℝ] E4)
    (hU : ∀ x s, S.pin x = some s → spinRotation (U x) s = s) :
    S.Z (S.gauge K U) = S.Z K := by
  rw [S.Z_gauge K U, S.rotatePins_eq_self U hU]

def W (S : SpinSystem V E) (A : E → SpinOperator 4) : ℝ :=
  S.Z (fun e => NormedSpace.exp (A e)) / S.Z (fun _ => 1)

@[simp] theorem W_zero (S : SpinSystem V E) : S.W 0 = 1 := by
  simp only [W, Pi.zero_apply, NormedSpace.exp_zero]
  exact div_self (S.Z_pos _).ne'

def gaugeProduct (S : SpinSystem V E) (F : V → SpinOperator 4) : E → SpinOperator 4 :=
  fun e => NormedSpace.exp (F (S.left e)) *
    NormedSpace.exp (F (S.right e) - F (S.left e)) *
    NormedSpace.exp (-F (S.right e))

theorem noncommuting_gauge (S : SpinSystem V E)
    (F : V → SpinOperator 4) (hF : ∀ x, F x ∈ skewAdjoint (SpinOperator 4))
    (hP : ∀ x s, S.pin x = some s → F x = 0) :
    S.Z (fun e => NormedSpace.exp (F (S.right e) - F (S.left e))) =
      S.Z (S.gaugeProduct F) := by
  let U := fun x => rotationExp (-F x) ((skewAdjoint _).neg_mem (hF x))
  have hfix : ∀ x s, S.pin x = some s → spinRotation (U x) s = s := by
    intro x s hs
    apply Subtype.ext
    change NormedSpace.exp (-F x) s.val = s.val
    rw [hP x s hs, neg_zero, NormedSpace.exp_zero]
    rfl
  have hg : S.gauge (fun e => NormedSpace.exp (F (S.right e) - F (S.left e))) U =
      S.gaugeProduct F := by
    funext e
    apply ContinuousLinearMap.ext
    intro v
    change (U (S.left e)).symm
      (NormedSpace.exp (F (S.right e) - F (S.left e)) (U (S.right e) v)) = _
    simp only [U, rotationExp_symm_apply, rotationExp_apply, neg_neg,
      gaugeProduct, mul_apply_eq_comp]
  rw [← hg]
  exact (S.Z_gauge_of_fixes_pins _ U hfix).symm

end SpinSystem
end
end RP3.Quadratic
end StandalonePart22

/- ===== RP3/ProductJets.lean ===== -/
section StandalonePart23

/-!
# Derivatives of a squared interaction

The recursive product jet differentiates both factors once at each step.
It supplies actual derivatives, including the extra second- and fourth-order
terms absent from a linear spin interaction.
-/
namespace RP3

open scoped BigOperators

noncomputable def productJet {Ω : Type*} (F G : ℕ → ℝ → Ω → ℝ) :
    ℕ → ℕ → ℕ → ℝ → Ω → ℝ
  | 0, a, b, t, ω => F a t ω * G b t ω
  | k+1, a, b, t, ω =>
      productJet F G k (a+1) b t ω + productJet F G k a (b+1) t ω

theorem continuous_productJet {Ω : Type*} [TopologicalSpace Ω]
    (F G : ℕ → ℝ → Ω → ℝ)
    (hF : ∀ k, Continuous (Function.uncurry (F k)))
    (hG : ∀ k, Continuous (Function.uncurry (G k))) (k a b : ℕ) :
    Continuous (Function.uncurry (productJet F G k a b)) := by
  induction k generalizing a b with
  | zero => exact (hF a).mul (hG b)
  | succ k ih => exact (ih (a+1) b).add (ih a (b+1))

theorem hasDerivAt_productJet {Ω : Type*} (F G : ℕ → ℝ → Ω → ℝ)
    (hF : ∀ k t ω, HasDerivAt (fun u => F k u ω) (F (k+1) t ω) t)
    (hG : ∀ k t ω, HasDerivAt (fun u => G k u ω) (G (k+1) t ω) t)
    (k a b : ℕ) (t : ℝ) (ω : Ω) :
    HasDerivAt (fun u => productJet F G k a b u ω)
      (productJet F G (k+1) a b t ω) t := by
  induction k generalizing a b with
  | zero => exact ((hF a t ω).mul (hG b t ω)).congr_deriv (by simp [productJet])
  | succ k ih => exact (ih (a+1) b).add (ih a (b+1))

theorem squareJet_one {Ω : Type*} (F : ℕ → ℝ → Ω → ℝ) (t : ℝ) (ω : Ω) :
    productJet F F 1 0 0 t ω = 2 * F 0 t ω * F 1 t ω := by
  simp only [productJet]; ring

theorem squareJet_two {Ω : Type*} (F : ℕ → ℝ → Ω → ℝ) (t : ℝ) (ω : Ω) :
    productJet F F 2 0 0 t ω = 2 * (F 1 t ω ^ 2 + F 0 t ω * F 2 t ω) := by
  simp only [productJet]; ring

theorem squareJet_three {Ω : Type*} (F : ℕ → ℝ → Ω → ℝ) (t : ℝ) (ω : Ω) :
    productJet F F 3 0 0 t ω =
      2 * (3 * F 1 t ω * F 2 t ω + F 0 t ω * F 3 t ω) := by
  simp only [productJet]; ring

theorem squareJet_four {Ω : Type*} (F : ℕ → ℝ → Ω → ℝ) (t : ℝ) (ω : Ω) :
    productJet F F 4 0 0 t ω =
      2 * (3 * F 2 t ω ^ 2 + 4 * F 1 t ω * F 3 t ω + F 0 t ω * F 4 t ω) := by
  simp only [productJet]; ring

/-- If each factor jet has absolute value at most one, its product jet is
bounded by `2^k`. This includes mixed initial orders `a,b`. -/
theorem abs_productJet_le {Ω : Type*} (F G : ℕ → ℝ → Ω → ℝ)
    (t : ℝ) (ω : Ω) (hF : ∀ k, |F k t ω| ≤ 1) (hG : ∀ k, |G k t ω| ≤ 1)
    (k a b : ℕ) : |productJet F G k a b t ω| ≤ (2 : ℝ)^k := by
  induction k generalizing a b with
  | zero =>
    simpa [productJet, abs_mul] using
      (mul_le_mul (hF a) (hG b) (abs_nonneg _) zero_le_one)
  | succ k ih =>
    calc
      |productJet F G (k+1) a b t ω| ≤
          |productJet F G k (a+1) b t ω| + |productJet F G k a (b+1) t ω| :=
        abs_add_le _ _
      _ ≤ 2^k + 2^k := add_le_add (ih (a+1) b) (ih a (b+1))
      _ = 2^(k+1) := by ring

end RP3
end StandalonePart23

/- ===== RP3/QuadraticDerivatives.lean ===== -/
section StandalonePart24

/-!
# Actual derivatives of the pinned RP³ partition function

The Bell-polynomial differentiation proofs are adapted from OpenAI's
ClassicalON/FiniteVolume.lean at commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a (Apache-2.0, copyright OpenAI).
The energy derivatives themselves are newly constructed from product jets
for the squared interaction.
-/
namespace RP3.Quadratic

noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace

namespace SpinSystem
variable {V E : Type*} [Fintype V] [Fintype E]

def innerJet (S : SpinSystem V E) (U : E → ℕ → ℝ → SpinOperator 4)
    (e : E) (k : ℕ) (t : ℝ) (σ : V → RP3.Spin) : ℝ :=
  ⟪(σ (S.left e)).val, U e k t (σ (S.right e)).val⟫_ℝ

def pathEnergy (S : SpinSystem V E) (U : E → ℕ → ℝ → SpinOperator 4)
    (k : ℕ) (t : ℝ) (σ : V → RP3.Spin) : ℝ :=
  ∑ e, S.strength e * productJet (S.innerJet U e) (S.innerJet U e) k 0 0 t σ

omit [Fintype V] [Fintype E] in
theorem continuous_innerJet (S : SpinSystem V E) (U : E → ℕ → ℝ → SpinOperator 4)
    (hU : ∀ e k, Continuous (U e k)) (e : E) (k : ℕ) :
    Continuous (Function.uncurry (S.innerJet U e k)) := by
  exact (((continuous_apply (S.left e)).comp continuous_snd).subtype_val.inner
    (((hU e k).comp continuous_fst).clm_apply
      (((continuous_apply (S.right e)).comp continuous_snd).subtype_val)))

omit [Fintype V] [Fintype E] in
theorem hasDerivAt_innerJet (S : SpinSystem V E) (U : E → ℕ → ℝ → SpinOperator 4)
    (hU : ∀ e k t, HasDerivAt (U e k) (U e (k+1) t) t)
    (e : E) (k : ℕ) (t : ℝ) (σ : V → RP3.Spin) :
    HasDerivAt (fun u => S.innerJet U e k u σ) (S.innerJet U e (k+1) t σ) t := by
  exact ((hasDerivAt_const t (σ (S.left e)).val).inner ℝ
    ((hU e k t).clm_apply (hasDerivAt_const t (σ (S.right e)).val))).congr_deriv
    (by simp [innerJet])

omit [Fintype V] in
theorem continuous_pathEnergy (S : SpinSystem V E) (U : E → ℕ → ℝ → SpinOperator 4)
    (hU : ∀ e k, Continuous (U e k)) (k : ℕ) :
    Continuous (Function.uncurry (S.pathEnergy U k)) := by
  apply continuous_finsetSum
  intro e _
  exact continuous_const.mul (continuous_productJet _ _
    (S.continuous_innerJet U hU e) (S.continuous_innerJet U hU e) k 0 0)

omit [Fintype V] in
theorem hasDerivAt_pathEnergy (S : SpinSystem V E) (U : E → ℕ → ℝ → SpinOperator 4)
    (hU : ∀ e k t, HasDerivAt (U e k) (U e (k+1) t) t)
    (k : ℕ) (t : ℝ) (σ : V → RP3.Spin) :
    HasDerivAt (fun u => S.pathEnergy U k u σ) (S.pathEnergy U (k+1) t σ) t := by
  apply HasDerivAt.fun_sum
  intro e _
  exact (hasDerivAt_productJet _ _ (S.hasDerivAt_innerJet U hU e)
    (S.hasDerivAt_innerJet U hU e) k 0 0 t σ).const_mul (S.strength e)

def twistEnergy (S : SpinSystem V E) (A : E → SpinOperator 4) :
    ℕ → ℝ → (V → RP3.Spin) → ℝ :=
  S.pathEnergy (fun e => expPower (A e))

omit [Fintype V] in
theorem continuous_twistEnergy (S : SpinSystem V E) (A : E → SpinOperator 4) (k : ℕ) :
    Continuous (Function.uncurry (S.twistEnergy A k)) :=
  S.continuous_pathEnergy _ (fun e => continuous_expPower (A e)) k

omit [Fintype V] in
theorem hasDerivAt_twistEnergy (S : SpinSystem V E) (A : E → SpinOperator 4)
    (k : ℕ) (t : ℝ) (σ : V → RP3.Spin) :
    HasDerivAt (fun u => S.twistEnergy A k u σ) (S.twistEnergy A (k+1) t σ) t :=
  S.hasDerivAt_pathEnergy _ (fun e => hasDerivAt_expPower (A e)) k t σ

omit [Fintype V] in
@[simp] theorem twistEnergy_zero (S : SpinSystem V E) (A : E → SpinOperator 4)
    (t : ℝ) (σ : V → RP3.Spin) :
    S.twistEnergy A 0 t σ = S.energy (fun e => NormedSpace.exp (t • A e)) σ := by
  simp [twistEnergy, pathEnergy, productJet, innerJet, expPower, energy, pow_two]

def firstEnergy (S : SpinSystem V E) (A : E → SpinOperator 4) (σ : V → RP3.Spin) : ℝ :=
  ∑ e, 2 * S.strength e * ⟪(σ (S.left e)).val, (σ (S.right e)).val⟫_ℝ *
    ⟪(σ (S.left e)).val, A e (σ (S.right e)).val⟫_ℝ

def secondEnergy (S : SpinSystem V E) (A : E → SpinOperator 4) (σ : V → RP3.Spin) : ℝ :=
  ∑ e, 2 * S.strength e *
    (⟪(σ (S.left e)).val, A e (σ (S.right e)).val⟫_ℝ ^ 2 +
      ⟪(σ (S.left e)).val, (σ (S.right e)).val⟫_ℝ *
        ⟪(σ (S.left e)).val, (A e ^ 2) (σ (S.right e)).val⟫_ℝ)

omit [Fintype V] in
theorem twistEnergy_one_at_zero (S : SpinSystem V E) (A : E → SpinOperator 4)
    (σ : V → RP3.Spin) : S.twistEnergy A 1 0 σ = S.firstEnergy A σ := by
  unfold twistEnergy pathEnergy firstEnergy
  apply Finset.sum_congr rfl
  intro e _
  simp only [squareJet_one, innerJet, expPower_zero, pow_zero, pow_one, one_apply_eq_self]
  ring

omit [Fintype V] in
theorem twistEnergy_two_at_zero (S : SpinSystem V E) (A : E → SpinOperator 4)
    (σ : V → RP3.Spin) : S.twistEnergy A 2 0 σ = S.secondEnergy A σ := by
  unfold twistEnergy pathEnergy secondEnergy
  apply Finset.sum_congr rfl
  intro e _
  simp only [squareJet_two, innerJet, expPower_zero, pow_zero, pow_one, one_apply_eq_self]
  ring

def firstWeight (S : SpinSystem V E) (A : E → SpinOperator 4)
    (t : ℝ) (σ : V → RP3.Spin) : ℝ :=
  Real.exp (S.twistEnergy A 0 t σ) * S.twistEnergy A 1 t σ

def secondWeight (S : SpinSystem V E) (A : E → SpinOperator 4)
    (t : ℝ) (σ : V → RP3.Spin) : ℝ :=
  Real.exp (S.twistEnergy A 0 t σ) *
    (S.twistEnergy A 2 t σ + (S.twistEnergy A 1 t σ)^2)

omit [Fintype V] in
theorem continuous_firstWeight (S : SpinSystem V E) (A : E → SpinOperator 4) :
    Continuous (Function.uncurry (S.firstWeight A)) := by
  exact (S.continuous_twistEnergy A 0).rexp.mul (S.continuous_twistEnergy A 1)

omit [Fintype V] in
theorem continuous_secondWeight (S : SpinSystem V E) (A : E → SpinOperator 4) :
    Continuous (Function.uncurry (S.secondWeight A)) := by
  exact (S.continuous_twistEnergy A 0).rexp.mul
    ((S.continuous_twistEnergy A 2).add ((S.continuous_twistEnergy A 1).pow 2))

omit [Fintype V] in
theorem hasDerivAt_weight (S : SpinSystem V E) (A : E → SpinOperator 4)
    (t : ℝ) (σ : V → RP3.Spin) :
    HasDerivAt (fun u => Real.exp (S.twistEnergy A 0 u σ)) (S.firstWeight A t σ) t := by
  exact (S.hasDerivAt_twistEnergy A 0 t σ).exp

omit [Fintype V] in
theorem hasDerivAt_firstWeight (S : SpinSystem V E) (A : E → SpinOperator 4)
    (t : ℝ) (σ : V → RP3.Spin) :
    HasDerivAt (fun u => S.firstWeight A u σ) (S.secondWeight A t σ) t := by
  exact ((S.hasDerivAt_weight A t σ).mul (S.hasDerivAt_twistEnergy A 1 t σ)).congr_deriv
    (by unfold firstWeight secondWeight; ring)

theorem hasDerivAt_twistZ (S : SpinSystem V E)
    (A : E → SpinOperator 4) (t : ℝ) :
    HasDerivAt (fun u => S.Z (fun e => NormedSpace.exp (u • A e)))
      (∫ σ, S.firstWeight A t σ ∂S.reference) t := by
  simpa only [twistEnergy_zero, Z] using
    hasDerivAt_integral_compact S.reference
      (fun u σ => Real.exp (S.twistEnergy A 0 u σ)) (S.firstWeight A)
      (S.continuous_twistEnergy A 0).rexp (S.continuous_firstWeight A)
      (S.hasDerivAt_weight A) t

theorem hasDerivAt_firstVariation (S : SpinSystem V E)
    (A : E → SpinOperator 4) (t : ℝ) :
    HasDerivAt (fun u => ∫ σ, S.firstWeight A u σ ∂S.reference)
      (∫ σ, S.secondWeight A t σ ∂S.reference) t :=
  hasDerivAt_integral_compact S.reference (S.firstWeight A) (S.secondWeight A)
    (S.continuous_firstWeight A) (S.continuous_secondWeight A)
    (S.hasDerivAt_firstWeight A) t

def thirdWeight (S : SpinSystem V E) (A : E → SpinOperator 4)
    (t : ℝ) (σ : V → RP3.Spin) : ℝ :=
  Real.exp (S.twistEnergy A 0 t σ) *
    (S.twistEnergy A 3 t σ + 3 * S.twistEnergy A 1 t σ * S.twistEnergy A 2 t σ +
      (S.twistEnergy A 1 t σ)^3)

def fourthWeight (S : SpinSystem V E) (A : E → SpinOperator 4)
    (t : ℝ) (σ : V → RP3.Spin) : ℝ :=
  Real.exp (S.twistEnergy A 0 t σ) *
    (S.twistEnergy A 4 t σ + 4 * S.twistEnergy A 1 t σ * S.twistEnergy A 3 t σ +
      3 * (S.twistEnergy A 2 t σ)^2 +
      6 * (S.twistEnergy A 1 t σ)^2 * S.twistEnergy A 2 t σ +
      (S.twistEnergy A 1 t σ)^4)

omit [Fintype V] in
theorem continuous_thirdWeight (S : SpinSystem V E) (A : E → SpinOperator 4) :
    Continuous (Function.uncurry (S.thirdWeight A)) := by
  exact (S.continuous_twistEnergy A 0).rexp.mul
    (((S.continuous_twistEnergy A 3).add
      (((S.continuous_twistEnergy A 1).const_mul 3).mul
        (S.continuous_twistEnergy A 2))).add ((S.continuous_twistEnergy A 1).pow 3))

omit [Fintype V] in
theorem continuous_fourthWeight (S : SpinSystem V E) (A : E → SpinOperator 4) :
    Continuous (Function.uncurry (S.fourthWeight A)) := by
  exact (S.continuous_twistEnergy A 0).rexp.mul
    (((((S.continuous_twistEnergy A 4).add
      (((S.continuous_twistEnergy A 1).const_mul 4).mul
        (S.continuous_twistEnergy A 3))).add
      (((S.continuous_twistEnergy A 2).pow 2).const_mul 3)).add
      ((((S.continuous_twistEnergy A 1).pow 2).const_mul 6).mul
        (S.continuous_twistEnergy A 2))).add ((S.continuous_twistEnergy A 1).pow 4))

omit [Fintype V] in
theorem hasDerivAt_secondWeight (S : SpinSystem V E) (A : E → SpinOperator 4)
    (t : ℝ) (σ : V → RP3.Spin) :
    HasDerivAt (fun u => S.secondWeight A u σ) (S.thirdWeight A t σ) t := by
  exact ((S.hasDerivAt_weight A t σ).mul
    ((S.hasDerivAt_twistEnergy A 2 t σ).add
      ((S.hasDerivAt_twistEnergy A 1 t σ).pow 2))).congr_deriv
    (by dsimp [firstWeight, thirdWeight]; ring)

omit [Fintype V] in
theorem hasDerivAt_thirdWeight (S : SpinSystem V E) (A : E → SpinOperator 4)
    (t : ℝ) (σ : V → RP3.Spin) :
    HasDerivAt (fun u => S.thirdWeight A u σ) (S.fourthWeight A t σ) t := by
  exact ((S.hasDerivAt_weight A t σ).mul
    (((S.hasDerivAt_twistEnergy A 3 t σ).add
      (((S.hasDerivAt_twistEnergy A 1 t σ).const_mul 3).mul
        (S.hasDerivAt_twistEnergy A 2 t σ))).add
      ((S.hasDerivAt_twistEnergy A 1 t σ).pow 3))).congr_deriv
    (by dsimp [firstWeight, fourthWeight]; ring)

theorem hasDerivAt_secondVariation (S : SpinSystem V E)
    (A : E → SpinOperator 4) (t : ℝ) :
    HasDerivAt (fun u => ∫ σ, S.secondWeight A u σ ∂S.reference)
      (∫ σ, S.thirdWeight A t σ ∂S.reference) t :=
  hasDerivAt_integral_compact S.reference (S.secondWeight A) (S.thirdWeight A)
    (S.continuous_secondWeight A) (S.continuous_thirdWeight A)
    (S.hasDerivAt_secondWeight A) t

theorem hasDerivAt_thirdVariation (S : SpinSystem V E)
    (A : E → SpinOperator 4) (t : ℝ) :
    HasDerivAt (fun u => ∫ σ, S.thirdWeight A u σ ∂S.reference)
      (∫ σ, S.fourthWeight A t σ ∂S.reference) t :=
  hasDerivAt_integral_compact S.reference (S.thirdWeight A) (S.fourthWeight A)
    (S.continuous_thirdWeight A) (S.continuous_fourthWeight A)
    (S.hasDerivAt_thirdWeight A) t

omit [Fintype V] [Fintype E] in

theorem exp_smul_add (g : SpinOperator 4) (r s : ℝ) :
    NormedSpace.exp ((r+s) • g) = NormedSpace.exp (r • g) * NormedSpace.exp (s • g) := by
  rw [add_smul r s g]
  apply NormedSpace.exp_add_of_commute
  change (r • g) * (s • g) = (s • g) * (r • g)
  rw [Algebra.smul_mul_assoc r g (s • g), Algebra.mul_smul_comm s g g,
    smul_smul r s (g*g), Algebra.smul_mul_assoc s g (r • g),
    Algebra.mul_smul_comm r g g, smul_smul s r (g*g), mul_comm r s]

theorem W_add_gradient (S : SpinSystem V E) (g : SpinOperator 4)
    (hg : g ∈ skewAdjoint (SpinOperator 4)) (h : E → ℝ) (f : V → ℝ)
    (hP : ∀ x s, S.pin x = some s → f x = 0) :
    S.W (fun e => (h e + f (S.right e) - f (S.left e)) • g) =
      S.W (fun e => h e • g) := by
  let U := fun x => rotationExp (-(f x • g)) ((skewAdjoint _).neg_mem (skewAdjoint.smul_mem _ hg))
  have hfix : ∀ x s, S.pin x = some s → spinRotation (U x) s = s := by
    intro x s hs
    apply Subtype.ext
    change NormedSpace.exp (-(f x • g)) s.val = s.val
    rw [hP x s hs, zero_smul ℝ g, neg_zero, NormedSpace.exp_zero]
    rfl
  have hK : S.gauge
      (fun e => NormedSpace.exp ((h e + f (S.right e) - f (S.left e)) • g)) U =
      (fun e => NormedSpace.exp (h e • g)) := by
    funext e
    apply ContinuousLinearMap.ext
    intro v
    change (U (S.left e)).symm
      (NormedSpace.exp ((h e + f (S.right e) - f (S.left e)) • g)
        (U (S.right e) v)) = _
    simp only [U, rotationExp_symm_apply, rotationExp_apply, neg_neg]
    rw [← mul_apply_eq_comp, ← mul_apply_eq_comp, ← neg_smul (f (S.right e)) g,
      ← exp_smul_add,
      ← exp_smul_add]
    have hc : f (S.left e) + (h e + f (S.right e) - f (S.left e)) + -f (S.right e) =
        h e := by ring
    rw [hc]
  unfold W
  congr 1
  rw [← hK]
  exact (S.Z_gauge_of_fixes_pins _ U hfix).symm

theorem W_gradient (S : SpinSystem V E) (g : SpinOperator 4)
    (hg : g ∈ skewAdjoint (SpinOperator 4)) (f : V → ℝ)
    (hP : ∀ x s, S.pin x = some s → f x = 0) :
    S.W (fun e => (f (S.right e) - f (S.left e)) • g) = 1 := by
  have h := S.W_add_gradient g hg 0 f hP
  simp only [Pi.zero_apply, zero_add, zero_smul ℝ g] at h
  exact h.trans (S.W_zero)

def average (S : SpinSystem V E) (f : (V → RP3.Spin) → ℝ) : ℝ :=
  (∫ σ, f σ * Real.exp (S.energy (fun _ => 1) σ) ∂S.reference) / S.Z (fun _ => 1)

theorem integrable_average_integrand (S : SpinSystem V E)
    {f : (V → RP3.Spin) → ℝ} (hf : Continuous f) :
    Integrable (fun σ => f σ * Real.exp (S.energy (fun _ => 1) σ)) S.reference :=
  (hf.mul (S.continuous_energy _).rexp).integrable_of_hasCompactSupport
    (HasCompactSupport.of_compactSpace _)

@[simp] theorem average_const (S : SpinSystem V E) (c : ℝ) :
    S.average (fun _ => c) = c := by
  unfold average
  rw [integral_const_mul]
  change c * S.Z (fun _ => 1) / S.Z (fun _ => 1) = c
  exact mul_div_cancel_right₀ c (S.Z_pos _).ne'

theorem average_add (S : SpinSystem V E)
    {f g : (V → RP3.Spin) → ℝ} (hf : Continuous f) (hg : Continuous g) :
    S.average (f+g) = S.average f + S.average g := by
  unfold average
  simp only [Pi.add_apply, add_mul]
  rw [integral_add (S.integrable_average_integrand hf)
    (S.integrable_average_integrand hg), add_div]

theorem average_mono (S : SpinSystem V E)
    {f g : (V → RP3.Spin) → ℝ} (hf : Continuous f) (hg : Continuous g)
    (hfg : ∀ σ, f σ ≤ g σ) : S.average f ≤ S.average g := by
  apply div_le_div_of_nonneg_right _ (S.Z_pos _).le
  apply integral_mono (S.integrable_average_integrand hf) (S.integrable_average_integrand hg)
  intro σ
  exact mul_le_mul_of_nonneg_right (hfg σ) (Real.exp_pos _).le

theorem average_nonneg (S : SpinSystem V E)
    {f : (V → RP3.Spin) → ℝ} (hf : ∀ σ, 0 ≤ f σ) : 0 ≤ S.average f :=
  div_nonneg (integral_nonneg fun σ => mul_nonneg (hf σ) (Real.exp_pos _).le) (S.Z_pos _).le

omit [Fintype V] [Fintype E] in

def axisGradient (S : SpinSystem V E) (f : V → ℝ) (g : SpinOperator 4) : E → SpinOperator 4 :=
  fun e => (f (S.right e) - f (S.left e)) • g

theorem Z_gradient_line (S : SpinSystem V E) (g : SpinOperator 4)
    (hg : g ∈ skewAdjoint (SpinOperator 4)) (f : V → ℝ)
    (hP : ∀ x s, S.pin x = some s → f x = 0) (t : ℝ) :
    S.Z (fun e => NormedSpace.exp (t • S.axisGradient f g e)) = S.Z (fun _ => 1) := by
  have hp : ∀ x s, S.pin x = some s → t * f x = 0 := by
    intro x s hs
    rw [hP x s hs, mul_zero]
  have h := S.W_gradient g hg (fun x => t * f x) hp
  unfold W at h
  have ha : (fun e => (t * f (S.right e) - t * f (S.left e)) • g) =
      (fun e => t • S.axisGradient f g e) := by
    funext e
    simp only [axisGradient, smul_smul, mul_sub]
  rw [ha] at h
  exact (div_eq_one_iff_eq (S.Z_pos _).ne').mp h


end SpinSystem
end
end RP3.Quadratic
end StandalonePart24

/- ===== RP3/QuadraticWard.lean ===== -/
section StandalonePart25

/-!
# Second and fourth Ward identities for the quadratic interaction

The change-of-variables and fourth-derivative proof pattern is adapted from
OpenAI's ClassicalON/FiniteVolume.lean at commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a (Apache-2.0, copyright OpenAI).
All energy derivatives refer to the squared interaction in QuadraticGibbs.
-/
namespace RP3.Quadratic
noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace

namespace SpinSystem
variable {V E : Type*} [Fintype V] [Fintype E]

theorem second_gradient_identity (S : SpinSystem V E) (g : SpinOperator 4)
    (hg : g ∈ skewAdjoint (SpinOperator 4)) (f : V → ℝ)
    (hP : ∀ x s, S.pin x = some s → f x = 0) :
    S.average (fun σ => S.secondEnergy (S.axisGradient f g) σ +
      (S.firstEnergy (S.axisGradient f g) σ)^2) = 0 := by
  let A := S.axisGradient f g
  have hZ : (fun t => S.Z (fun e => NormedSpace.exp (t • A e))) =
      (fun _ : ℝ => S.Z (fun _ => 1)) := funext (S.Z_gradient_line g hg f hP)
  have hfirst : (fun t => ∫ σ, S.firstWeight A t σ ∂S.reference) = (fun _ : ℝ => 0) := by
    funext t
    have h := S.hasDerivAt_twistZ A t
    rw [hZ] at h
    exact h.unique (hasDerivAt_const t _)
  have hsecond : (∫ σ, S.secondWeight A 0 σ ∂S.reference) = 0 := by
    have h := S.hasDerivAt_firstVariation A 0
    rw [hfirst] at h
    exact h.unique (hasDerivAt_const 0 0)
  unfold average
  have hfun : (fun σ => (S.secondEnergy A σ + (S.firstEnergy A σ)^2) *
      Real.exp (S.energy (fun _ => 1) σ)) = (fun σ => S.secondWeight A 0 σ) := by
    funext σ
    have hz (e : E) : (0 : ℝ) • A e = 0 := zero_smul ℝ (A e)
    simp only [secondWeight, twistEnergy_zero, twistEnergy_one_at_zero,
      twistEnergy_two_at_zero, hz, NormedSpace.exp_zero]
    exact mul_comm (S.secondEnergy A σ + S.firstEnergy A σ ^ 2) (Real.exp (S.energy (fun _ => 1) σ))
  change (∫ σ, (S.secondEnergy A σ + (S.firstEnergy A σ)^2) *
    Real.exp (S.energy (fun _ => 1) σ) ∂S.reference) / S.Z (fun _ => 1) = 0
  rw [hfun, hsecond, zero_div]

def gaugeEnergy (S : SpinSystem V E) (F : V → SpinOperator 4) :
    ℕ → ℝ → (V → RP3.Spin) → ℝ :=
  S.pathEnergy (fun e k => tripleJet (F (S.left e))
    (F (S.right e) - F (S.left e)) (-F (S.right e)) k 0 0 0)

omit [Fintype V] in
theorem continuous_gaugeEnergy (S : SpinSystem V E) (F : V → SpinOperator 4) (k : ℕ) :
    Continuous (Function.uncurry (S.gaugeEnergy F k)) :=
  S.continuous_pathEnergy _ (fun _ k => continuous_tripleJet _ _ _ k 0 0 0) k

omit [Fintype V] in
set_option maxHeartbeats 800000 in
theorem hasDerivAt_gaugeEnergy (S : SpinSystem V E) (F : V → SpinOperator 4)
    (k : ℕ) (t : ℝ) (σ : V → RP3.Spin) :
    HasDerivAt (fun u => S.gaugeEnergy F k u σ) (S.gaugeEnergy F (k+1) t σ) t :=
  S.hasDerivAt_pathEnergy _ (fun e k t => hasDerivAt_tripleJet
    (F (S.left e)) (F (S.right e) - F (S.left e)) (-F (S.right e)) k 0 0 0 t) k t σ

omit [Fintype V] in
theorem gaugeEnergy_at_zero (S : SpinSystem V E) (F : V → SpinOperator 4)
    (σ : V → RP3.Spin) :
    S.gaugeEnergy F 0 0 σ = S.energy (fun _ => 1) σ ∧
    S.gaugeEnergy F 1 0 σ = 0 ∧
    S.gaugeEnergy F 2 0 σ = S.firstEnergy
      (fun e => F (S.left e)*F (S.right e)-F (S.right e)*F (S.left e)) σ := by
  have h0 := fun e => (gaugeJets_zero_one (F (S.left e)) (F (S.right e))).1
  have h1 := fun e => (gaugeJets_zero_one (F (S.left e)) (F (S.right e))).2
  constructor
  · simp only [gaugeEnergy, pathEnergy, productJet, innerJet, h0, energy, pow_two]
  constructor
  · simp [gaugeEnergy, pathEnergy, squareJet_one, innerJet, h1]
  · unfold gaugeEnergy pathEnergy firstEnergy
    apply Finset.sum_congr rfl
    intro e _
    simp only [squareJet_two, innerJet, h0, h1, gaugeJet_two]
    simp only [zero_apply, inner_zero_right, one_apply_eq_self, zero_pow (by decide : 2 ≠ 0),
      zero_add]
    ring

theorem fourth_noncommuting_identity (S : SpinSystem V E)
    (F : V → SpinOperator 4) (hF : ∀ x, F x ∈ skewAdjoint (SpinOperator 4))
    (hP : ∀ x s, S.pin x = some s → F x = 0) :
    (∫ σ, S.fourthWeight (fun e => F (S.right e)-F (S.left e)) 0 σ ∂S.reference) =
      ∫ σ, Real.exp (S.energy (fun _ => 1) σ) *
        (S.gaugeEnergy F 4 0 σ + 3 * (S.firstEnergy
          (fun e => F (S.left e)*F (S.right e)-F (S.right e)*F (S.left e)) σ)^2)
        ∂S.reference := by
  let A : E → SpinOperator 4 := fun e => F (S.right e)-F (S.left e)
  have heq : (fun t => ∫ σ, Real.exp (S.twistEnergy A 0 t σ) ∂S.reference) =
      (fun t => ∫ σ, Real.exp (S.gaugeEnergy F 0 t σ) ∂S.reference) := by
    funext t
    have htP : ∀ x s, S.pin x = some s → t • F x = 0 := by
      intro x s hs
      rw [hP x s hs]
      exact smul_zero (M := ℝ) (A := SpinOperator 4) t
    have h := S.noncommuting_gauge (fun x => t • F x)
      (fun x => skewAdjoint.smul_mem t (hF x)) htP
    have hd (e : E) : t • F (S.right e) - t • F (S.left e) = t • A e :=
      (smul_sub t (F (S.right e)) (F (S.left e))).symm
    have hGP : S.gaugeProduct (fun x => t • F x) =
        (fun e => tripleJet (F (S.left e)) (F (S.right e)-F (S.left e))
          (-F (S.right e)) 0 0 0 0 t) := by
      funext e
      change NormedSpace.exp (t • F (S.left e)) *
        NormedSpace.exp (t • F (S.right e) - t • F (S.left e)) *
        NormedSpace.exp (-(t • F (S.right e))) = _
      rw [hd]
      simp only [tripleJet, expPower, pow_zero, mul_one]
      rw [smul_neg t (F (S.right e))]
    rw [hGP] at h
    simpa only [Z, twistEnergy_zero, gaugeEnergy, pathEnergy, productJet, innerJet, energy, pow_two, hd] using h
  have hl := iteratedDeriv_four_integral_exp S.reference (S.twistEnergy A)
    (S.continuous_twistEnergy A) (S.hasDerivAt_twistEnergy A) 0
  have hr := iteratedDeriv_four_integral_exp S.reference (S.gaugeEnergy F)
    (S.continuous_gaugeEnergy F) (S.hasDerivAt_gaugeEnergy F) 0
  rw [heq, hr] at hl
  refine hl.symm.trans (integral_congr_ae (Filter.Eventually.of_forall ?_))
  intro σ
  have hz := S.gaugeEnergy_at_zero F σ
  simp [fourthBell, hz.1, hz.2.1, hz.2.2]


end SpinSystem
end
end RP3.Quadratic
end StandalonePart25

/- ===== RP3/ModelConnection.lean ===== -/
section StandalonePart26

/-!
# Connecting the analytic Gibbs system to the existing RP³ definitions

These equalities identify the partition functions, including arbitrary pinned
spins. They do not assume an annular estimate or a decay theorem.
-/
namespace RP3.Quadratic
noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
open scoped InnerProductSpace

variable {V E : Type*} [Fintype V] [Fintype E] [DecidableEq V]

def freeSystem (edge : E → V × V) (b : E → ℝ) : SpinSystem V E where
  left e := (edge e).1
  right e := (edge e).2
  strength := b
  pin _ := none

def pinnedSystem (edge : E → V × V) (b : E → ℝ) (pins : Finset V)
    (τ : RP3.Configuration V) : SpinSystem V E :=
  { freeSystem edge b with pin := fun v => if v ∈ pins then some (τ v) else none }

omit [Fintype V] [DecidableEq V] in
theorem freeSystem_energy (edge : E → V × V) (b : E → ℝ) (σ : RP3.Configuration V) :
    (freeSystem edge b).energy (fun _ => 1) σ = RP3.interaction edge b σ := by
  simp only [SpinSystem.energy, freeSystem, one_apply_eq_self, RP3.interaction]

omit [DecidableEq V] in
theorem freeSystem_partition (edge : E → V × V) (b : E → ℝ) :
    (freeSystem edge b).Z (fun _ => 1) = RP3.partition edge b := by
  simp only [SpinSystem.Z, freeSystem_energy]
  rfl

omit [DecidableEq V] in
theorem freeSystem_correlation (edge : E → V × V) (b : E → ℝ) (x y : V) :
    (freeSystem edge b).average (RP3.observable x y) = RP3.correlation edge b x y := by
  simp only [SpinSystem.average, freeSystem_energy, freeSystem_partition]
  rfl

omit [Fintype V] in
theorem pinnedSystem_energy (edge : E → V × V) (b : E → ℝ) (pins : Finset V)
    (τ σ : RP3.Configuration V) :
    (pinnedSystem edge b pins τ).energy (fun _ => 1) σ = RP3.interaction edge b σ := by
  simp only [SpinSystem.energy, pinnedSystem, freeSystem, one_apply_eq_self, RP3.interaction]

omit [Fintype E] in
/-- Overwriting the boundary pushes the free reference probability to the
product law with the prescribed Dirac masses. -/
theorem fillPins_preserves_reference (edge : E → V × V) (b : E → ℝ)
    (pins : Finset V) (τ : RP3.Configuration V) :
    MeasurePreserving (RP3.fillPins pins τ) (RP3.referenceLaw (V := V))
      (pinnedSystem edge b pins τ).reference := by
  change MeasurePreserving (fun σ v => if v ∈ pins then τ v else σ v)
    (Measure.pi (fun _ => RP3.sphereProbability))
    (Measure.pi (fun v => siteReference (if v ∈ pins then some (τ v) else none)))
  apply measurePreserving_pi
  intro v
  by_cases hv : v ∈ pins
  · simp only [hv, ite_true, siteReference]
    have he : (ite (v ∈ pins) (τ v) : RP3.Spin → RP3.Spin) = (fun _ => τ v) := by
      funext s
      simp [hv]
    rw [he]
    refine ⟨measurable_const, ?_⟩
    simp only [Measure.map_const, measure_univ, one_smul]
  · simp only [hv, ite_false, siteReference]
    have he : (ite (v ∈ pins) (τ v) : RP3.Spin → RP3.Spin) = id := by
      funext s
      simp [hv]
    rw [he]
    exact MeasurePreserving.id _

/-- The analytic pinned partition function equals the one used in the
kernel-comparison interface, with no change of Gibbs measure. -/
theorem pinnedSystem_partition (edge : E → V × V) (b : E → ℝ) (pins : Finset V)
    (τ : RP3.Configuration V) :
    (pinnedSystem edge b pins τ).Z (fun _ => 1) = RP3.pinnedPartition edge b pins τ := by
  let S := pinnedSystem edge b pins τ
  have hm := fillPins_preserves_reference edge b pins τ
  change (∫ σ, Real.exp (S.energy (fun _ => 1) σ) ∂S.reference) =
    ∫ σ, Real.exp (RP3.interaction edge b (RP3.fillPins pins τ σ)) ∂(RP3.referenceLaw (V := V))
  simp only [S, pinnedSystem_energy]
  rw [← hm.map_eq]
  exact integral_map_of_stronglyMeasurable (RP3.fillPins pins τ).continuous.measurable
    (RP3.weight edge b).continuous.stronglyMeasurable

end
end RP3.Quadratic
end StandalonePart26

/- ===== RP3/QuadraticPlane.lean ===== -/
section StandalonePart27

/-!
# The noncommuting two-axis identity for RP³

This derives the diagonal fourth-order Ward identity from the *quadratic*
Gibbs weight. In particular, the additional square of the second derivative
in the squared edge interaction is retained.
The response/gauge proof pattern and matrix identity are adapted from
OpenAI's ClassicalON development (Apache-2.0); see NOTICE.
-/
namespace RP3.Quadratic
noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace

namespace SpinSystem
variable {V E : Type*} [Fintype V] [Fintype E]

theorem average_mul_const (S : SpinSystem V E) (r : ℝ) (f : (V → RP3.Spin) → ℝ) :
    S.average (fun σ => r * f σ) = r * S.average f := by
  simp only [average, mul_assoc, integral_const_mul, mul_div_assoc]

def fourthPolynomial (F : ℕ → ℝ) : ℝ :=
  F 4 + 4 * F 1 * F 3 + 3 * (F 2)^2 + 6 * (F 1)^2 * F 2 + (F 1)^4

def fourthResponse (S : SpinSystem V E) (A : E → SpinOperator 4) : ℝ :=
  S.average (fun σ => fourthPolynomial (fun k => S.twistEnergy A k 0 σ))

theorem fourthResponse_integral (S : SpinSystem V E) (A : E → SpinOperator 4) :
    S.fourthResponse A = (∫ σ, S.fourthWeight A 0 σ ∂S.reference) / S.Z (fun _ => 1) := by
  unfold fourthResponse average
  congr 1
  apply integral_congr_ae (Filter.Eventually.of_forall _)
  intro σ
  have hz : S.twistEnergy A 0 0 σ = S.energy (fun _ => 1) σ := by
    rw [twistEnergy_zero]
    congr 1
    funext e
    rw [zero_smul ℝ (A e), NormedSpace.exp_zero]
  simp only [fourthWeight, fourthPolynomial, hz]
  ring

theorem fourthResponse_gauge (S : SpinSystem V E)
    (F : V → SpinOperator 4) (hF : ∀ x, F x ∈ skewAdjoint (SpinOperator 4))
    (hP : ∀ x s, S.pin x = some s → F x = 0) :
    S.fourthResponse (fun e => F (S.right e)-F (S.left e)) =
      S.average (fun σ => S.gaugeEnergy F 4 0 σ + 3 * (S.firstEnergy
        (fun e => F (S.left e)*F (S.right e)-F (S.right e)*F (S.left e)) σ)^2) := by
  rw [S.fourthResponse_integral, S.fourth_noncommuting_identity F hF hP]
  unfold average
  congr 1
  apply integral_congr_ae (Filter.Eventually.of_forall _)
  intro σ
  exact mul_comm _ _

omit [Fintype V] [Fintype E] in
def crossForm (S : SpinSystem V E) (f g : V → ℝ) : E → ℝ :=
  fun e => f (S.left e)*g (S.right e)-g (S.left e)*f (S.right e)

omit [Fintype V] [Fintype E] in
def planarGradient (S : SpinSystem V E) (f g : V → ℝ) : E → SpinOperator 4 :=
  fun e => planeOperator (f (S.right e)) (g (S.right e)) -
    planeOperator (f (S.left e)) (g (S.left e))

def secondAxisEnergy (S : SpinSystem V E) (h k : E → ℝ) (σ : V → RP3.Spin) : ℝ :=
  ∑ e, 2 * S.strength e * (h e * k e) *
    (⟪(σ (S.left e)).val, axisC (σ (S.right e)).val⟫_ℝ ^ 2 +
      ⟪(σ (S.left e)).val, (σ (S.right e)).val⟫_ℝ *
        ⟪(σ (S.left e)).val, (axisC ^ 2) (σ (S.right e)).val⟫_ℝ)

def secondAxisResponse (S : SpinSystem V E) (h k : E → ℝ) : ℝ :=
  S.average (fun σ => S.secondAxisEnergy h k σ +
    S.firstEnergy (fun e => h e • axisC) σ * S.firstEnergy (fun e => k e • axisC) σ)

omit [Fintype V] in
theorem firstEnergy_neg (S : SpinSystem V E) (A : E → SpinOperator 4) (σ : V → RP3.Spin) :
    S.firstEnergy (-A) σ = -S.firstEnergy A σ := by
  simp [firstEnergy]

set_option maxRecDepth 4096 in
set_option maxHeartbeats 800000 in
omit [Fintype V] in
/-- The product-rule terms combine into six times the actual second response. -/
theorem gaugeEnergy_plane_four_even (S : SpinSystem V E) (f g : V → ℝ)
    (σ : V → RP3.Spin) :
    S.gaugeEnergy (fun x => planeOperator (f x) (g x)) 4 0 σ +
      S.gaugeEnergy (fun x => planeOperator (f x) (-g x)) 4 0 σ =
        6 * S.secondAxisEnergy (S.crossForm f g) (S.crossForm f g) σ := by
  unfold gaugeEnergy pathEnergy secondAxisEnergy
  rw [← Finset.sum_add_distrib, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro e _
  let u := (σ (S.left e)).val
  let v := (σ (S.right e)).val
  let a := f (S.left e)
  let b := g (S.left e)
  let c := f (S.right e)
  let d := g (S.right e)
  let jp := fun k => tripleJet (planeOperator a b)
    (planeOperator c d-planeOperator a b) (-planeOperator c d) k 0 0 0 0
  let jm := fun k => tripleJet (planeOperator a (-b))
    (planeOperator c (-d)-planeOperator a (-b)) (-planeOperator c (-d)) k 0 0 0 0
  have hp0 : jp 0 = 1 := (gaugeJets_zero_one _ _).1
  have hm0 : jm 0 = 1 := (gaugeJets_zero_one _ _).1
  have hp1 : jp 1 = 0 := (gaugeJets_zero_one _ _).2
  have hm1 : jm 1 = 0 := (gaugeJets_zero_one _ _).2
  have hp2 : jp 2 = (a*d-b*c) • axisC := by
    exact (gaugeJet_two _ _).trans (planeOperator_commutator a b c d)
  have hm2 : jm 2 = -(a*d-b*c) • axisC := by
    change tripleJet _ _ _ 2 0 0 0 0 = _
    rw [gaugeJet_two, planeOperator_commutator]
    congr 1
    ring
  have h4 : jp 4 + jm 4 = (6*(a*d-b*c)^2) • axisC^2 :=
    gaugeJet_plane_four_even a b c d
  have h4i := congrArg (fun M : SpinOperator 4 => ⟪u, M v⟫_ℝ) h4
  simp only [add_apply, smul_apply, inner_add_right, real_inner_smul_right] at h4i
  simp only [squareJet_four, innerJet]
  change S.strength e * (2 * (3 * ⟪u, jp 2 v⟫_ℝ ^ 2 +
        4 * ⟪u, jp 1 v⟫_ℝ * ⟪u, jp 3 v⟫_ℝ + ⟪u, jp 0 v⟫_ℝ * ⟪u, jp 4 v⟫_ℝ)) +
      S.strength e * (2 * (3 * ⟪u, jm 2 v⟫_ℝ ^ 2 +
        4 * ⟪u, jm 1 v⟫_ℝ * ⟪u, jm 3 v⟫_ℝ + ⟪u, jm 0 v⟫_ℝ * ⟪u, jm 4 v⟫_ℝ)) =
      6 * (2 * S.strength e * ((a*d-b*c) * (a*d-b*c)) *
        (⟪u, axisC v⟫_ℝ ^ 2 + ⟪u, v⟫_ℝ * ⟪u, (axisC^2) v⟫_ℝ))
  rw [hp0, hm0, hp1, hm1, hp2, hm2]
  simp only [one_apply_eq_self, zero_apply, inner_zero_right, mul_zero, zero_mul,
    add_zero, smul_apply, real_inner_smul_right]
  linear_combination 2 * S.strength e * ⟪u, v⟫_ℝ * h4i

end SpinSystem
end
end RP3.Quadratic
end StandalonePart27

/- ===== RP3/QuadraticBounds.lean ===== -/
section StandalonePart28

/-! # Bounds on the actual RP³ derivative jets -/
namespace RP3.Quadratic
noncomputable section
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace

lemma abs_inner_operator_le (s t : RP3.Spin) (M : SpinOperator 4) :
    |⟪s.val, M t.val⟫_ℝ| ≤ ‖M‖ := by
  calc
    _ ≤ ‖s.val‖ * ‖M t.val‖ := abs_real_inner_le_norm _ _
    _ ≤ ‖s.val‖ * (‖M‖ * ‖t.val‖) :=
      mul_le_mul_of_nonneg_left (M.le_opNorm _) (norm_nonneg _)
    _ = ‖M‖ := by rw [RP3.spin_norm, RP3.spin_norm]; ring

namespace SpinSystem
variable {V E : Type*} [Fintype V] [Fintype E]

omit [Fintype V] [Fintype E] in
theorem abs_innerJet_at_zero_le_one (S : SpinSystem V E)
    (A : E → SpinOperator 4) (hA : ∀ e, ‖A e‖ ≤ 1)
    (e : E) (k : ℕ) (σ : V → RP3.Spin) :
    |S.innerJet (fun e => expPower (A e)) e k 0 σ| ≤ 1 := by
  simp only [innerJet, expPower_zero]
  exact (abs_inner_operator_le _ _ _).trans
    ((norm_pow_le _ _).trans (pow_le_one₀ (norm_nonneg _) (hA e)))

omit [Fintype V] [Fintype E] in
/-- The local k-th derivative is bounded by `2^k β`. The interaction
is squared, and the derivative is the product jet proved in ProductJets. -/
theorem abs_local_twistJet_le (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β) (A : E → SpinOperator 4)
    (hA : ∀ e, ‖A e‖ ≤ 1) (e : E) (k : ℕ) (σ : V → RP3.Spin) :
    |S.strength e * productJet (S.innerJet (fun e => expPower (A e)) e)
      (S.innerJet (fun e => expPower (A e)) e) k 0 0 0 σ| ≤ 2^k * β := by
  rw [abs_mul, mul_comm ((2 : ℝ)^k) β]
  exact mul_le_mul (hb e)
    (abs_productJet_le _ _ 0 σ (fun k => S.abs_innerJet_at_zero_le_one A hA e k σ)
      (fun k => S.abs_innerJet_at_zero_le_one A hA e k σ) k 0 0)
    (abs_nonneg _) ((abs_nonneg _).trans (hb e))

omit [Fintype V] [Fintype E] in
theorem abs_local_twistJet_le_sixteen (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β) (A : E → SpinOperator 4)
    (hA : ∀ e, ‖A e‖ ≤ 1) (e : E) (k : ℕ) (hk : k ≤ 4) (σ : V → RP3.Spin) :
    |S.strength e * productJet (S.innerJet (fun e => expPower (A e)) e)
      (S.innerJet (fun e => expPower (A e)) e) k 0 0 0 σ| ≤ 16 * β := by
  apply (S.abs_local_twistJet_le β hb A hA e k σ).trans
  have hp : (2 : ℝ)^k ≤ 16 := by
    calc (2 : ℝ)^k ≤ 2^4 := pow_le_pow_right₀ (by norm_num) hk
         _ = 16 := by norm_num
  exact mul_le_mul_of_nonneg_right hp ((abs_nonneg _).trans (hb e))

omit [Fintype V] in
theorem continuous_firstEnergy (S : SpinSystem V E) (A : E → SpinOperator 4) :
    Continuous (S.firstEnergy A) := by unfold firstEnergy; fun_prop

omit [Fintype V] in
theorem continuous_secondEnergy (S : SpinSystem V E) (A : E → SpinOperator 4) :
    Continuous (S.secondEnergy A) := by unfold secondEnergy; fun_prop

omit [Fintype V] in
theorem abs_secondEnergy_le (S : SpinSystem V E) (A : E → SpinOperator 4)
    (σ : V → RP3.Spin) :
    |S.secondEnergy A σ| ≤ ∑ e, 4 * |S.strength e| * ‖A e‖^2 := by
  apply (Finset.abs_sum_le_sum_abs _ _).trans
  apply Finset.sum_le_sum
  intro e _
  have hu := abs_inner_operator_le (σ (S.left e)) (σ (S.right e)) (A e)
  have hv := abs_inner_operator_le (σ (S.left e)) (σ (S.right e)) (A e ^ 2)
  have hw := abs_real_inner_le_norm (σ (S.left e)).val (σ (S.right e)).val
  simp only [RP3.spin_norm, one_mul] at hw
  have hu2 : |⟪(σ (S.left e)).val, A e (σ (S.right e)).val⟫_ℝ ^ 2| ≤ ‖A e‖^2 := by
    rw [abs_pow]
    exact pow_le_pow_left₀ (abs_nonneg _) hu 2
  have huv : |⟪(σ (S.left e)).val, (σ (S.right e)).val⟫_ℝ *
      ⟪(σ (S.left e)).val, (A e ^ 2) (σ (S.right e)).val⟫_ℝ| ≤ ‖A e‖^2 := by
    rw [abs_mul]
    calc _ ≤ 1 * ‖A e‖^2 := mul_le_mul hw (hv.trans (norm_pow_le _ _))
           (abs_nonneg _) zero_le_one
         _ = _ := one_mul _
  have hs := (abs_add_le _ _).trans (add_le_add hu2 huv)
  calc
    _ = 2 * |S.strength e| * |⟪(σ (S.left e)).val, A e (σ (S.right e)).val⟫_ℝ ^ 2 +
        ⟪(σ (S.left e)).val, (σ (S.right e)).val⟫_ℝ *
          ⟪(σ (S.left e)).val, (A e ^ 2) (σ (S.right e)).val⟫_ℝ| := by
      rw [abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    _ ≤ 2 * |S.strength e| * (‖A e‖^2 + ‖A e‖^2) :=
      mul_le_mul_of_nonneg_left hs (by positivity)
    _ = _ := by ring


omit [Fintype V] in
theorem abs_axis_secondEnergy_le (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β) (g : SpinOperator 4) (hg : ‖g‖ ≤ 1)
    (f : V → ℝ) (σ : V → RP3.Spin) :
    |S.secondEnergy (S.axisGradient f g) σ| ≤
      4 * β * ∑ e, (f (S.right e) - f (S.left e))^2 := by
  apply (S.abs_secondEnergy_le _ σ).trans
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro e _
  have hβ := (abs_nonneg _).trans (hb e)
  have hn : ‖S.axisGradient f g e‖ ≤ |f (S.right e) - f (S.left e)| := by
    rw [axisGradient, norm_smul, Real.norm_eq_abs]
    exact mul_le_of_le_one_right (abs_nonneg _) hg
  have hn2 : ‖S.axisGradient f g e‖^2 ≤ (f (S.right e) - f (S.left e))^2 := by
    simpa only [sq_abs] using pow_le_pow_left₀ (norm_nonneg _) hn 2
  exact mul_le_mul (mul_le_mul_of_nonneg_left (hb e) (by norm_num)) hn2
    (sq_nonneg _) (by positivity)

/-- The second Ward identity gives a genuine Gibbs current estimate for
arbitrary pinned boundary spins and the squared RP³ interaction. -/
theorem gradient_current_bound (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β) (g : SpinOperator 4)
    (hg : g ∈ skewAdjoint (SpinOperator 4)) (hgn : ‖g‖ ≤ 1) (f : V → ℝ)
    (hP : ∀ x s, S.pin x = some s → f x = 0) :
    S.average (fun σ => (S.firstEnergy (S.axisGradient f g) σ)^2) ≤
      4 * β * ∑ e, (f (S.right e) - f (S.left e))^2 := by
  let A := S.axisGradient f g
  let C := 4 * β * ∑ e, (f (S.right e) - f (S.left e))^2
  have hl : -C ≤ S.average (S.secondEnergy A) := by
    rw [← S.average_const (-C)]
    apply S.average_mono continuous_const (S.continuous_secondEnergy A)
    intro σ
    exact (abs_le.mp (S.abs_axis_secondEnergy_le β hb g hgn f σ)).1
  have hw : S.average (S.secondEnergy A) +
      S.average (fun σ => (S.firstEnergy A σ)^2) = 0 := by
    rw [← S.average_add (f := S.secondEnergy A) (g := fun σ => (S.firstEnergy A σ)^2)
      (S.continuous_secondEnergy A)
      (by
        convert (S.continuous_firstEnergy A).pow 2 using 1)]
    exact S.second_gradient_identity g hg f hP
  change S.average (fun σ => (S.firstEnergy A σ)^2) ≤ C
  linarith

end SpinSystem
end
end RP3.Quadratic
end StandalonePart28

/- ===== RP3/QuadraticPlaneResponse.lean ===== -/
section StandalonePart29

/-!
# The normalized two-axis Ward identity for RP³

Adapted from OpenAI's ClassicalON/RotationWork.lean at commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a (Apache-2.0, copyright OpenAI).
The first and second responses are replaced by their proved quadratic
counterparts; the squared-interaction fourth-order identity supplies the
model-specific step.
-/
namespace RP3.Quadratic
noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace
namespace SpinSystem
variable {V E : Type*} [Fintype V] [Fintype E]

theorem fourthResponse_plane_even (S : SpinSystem V E) (f g : V → ℝ)
    (hf : ∀ x s, S.pin x = some s → f x = 0)
    (hg : ∀ x s, S.pin x = some s → g x = 0) :
    S.fourthResponse (S.planarGradient f g) +
      S.fourthResponse (S.planarGradient f (-g)) =
        6 * S.secondAxisResponse (S.crossForm f g) (S.crossForm f g) := by
  have hsk (f g : V → ℝ) (x : V) :
      planeOperator (f x) (g x) ∈ skewAdjoint (SpinOperator 4) := by
    rw [planeOperator_eq]
    exact (skewAdjoint _).add_mem (skewAdjoint.smul_mem _ axisA_skew)
      (skewAdjoint.smul_mem _ axisB_skew)
  have hp : ∀ x s, S.pin x = some s → planeOperator (f x) (g x) = 0 := by
    intro x s hs
    rw [hf x s hs, hg x s hs, planeOperator_eq]
    simp only [zero_smul ℝ axisA, zero_smul ℝ axisB, add_zero]
  have hm : ∀ x s, S.pin x = some s → planeOperator (f x) ((-g) x) = 0 := by
    intro x s hs
    rw [Pi.neg_apply, hg x s hs, neg_zero, hf x s hs, planeOperator_eq]
    simp only [zero_smul ℝ axisA, zero_smul ℝ axisB, add_zero]
  change S.fourthResponse (fun e => planeOperator (f (S.right e)) (g (S.right e)) -
    planeOperator (f (S.left e)) (g (S.left e))) + S.fourthResponse (fun e =>
      planeOperator (f (S.right e)) ((-g) (S.right e)) -
      planeOperator (f (S.left e)) ((-g) (S.left e))) = _
  rw [S.fourthResponse_gauge _ (hsk f g) hp,
    S.fourthResponse_gauge _ (hsk f (-g)) hm]
  let w := S.crossForm f g
  have he (σ : V → RP3.Spin) :
      S.gaugeEnergy (fun x => planeOperator (f x) (g x)) 4 0 σ +
      S.gaugeEnergy (fun x => planeOperator (f x) ((-g) x)) 4 0 σ =
        6 * S.secondAxisEnergy w w σ :=
    S.gaugeEnergy_plane_four_even f g σ
  have hcm : (fun e =>
      planeOperator (f (S.left e)) ((-g) (S.left e)) *
        planeOperator (f (S.right e)) ((-g) (S.right e)) -
      planeOperator (f (S.right e)) ((-g) (S.right e)) *
        planeOperator (f (S.left e)) ((-g) (S.left e))) = -(fun e => w e • axisC) := by
    funext e
    rw [planeOperator_commutator]
    change (f (S.left e) * (-g) (S.right e) - (-g) (S.left e) * f (S.right e)) • axisC = -(w e • axisC)
    rw [← neg_smul (w e) axisC]
    congr 1
    dsimp only [w, crossForm, Pi.neg_apply]
    ring
  have hcp : (fun e =>
      planeOperator (f (S.left e)) (g (S.left e)) *
        planeOperator (f (S.right e)) (g (S.right e)) -
      planeOperator (f (S.right e)) (g (S.right e)) *
        planeOperator (f (S.left e)) (g (S.left e))) = (fun e => w e • axisC) := by
    funext e
    exact planeOperator_commutator _ _ _ _
  rw [hcp, hcm]
  simp only [S.firstEnergy_neg, neg_sq]
  have hc (F : V → SpinOperator 4) : Continuous (fun σ =>
      S.gaugeEnergy F 4 0 σ + 3 * (S.firstEnergy (fun e => w e • axisC) σ)^2) :=
    ((S.continuous_gaugeEnergy F 4).comp (continuous_const.prodMk continuous_id)).add
      (continuous_const.mul ((S.continuous_firstEnergy _).pow 2))
  rw [← S.average_add (hc _) (hc _)]
  have hpoint : (fun σ =>
      (S.gaugeEnergy (fun x => planeOperator (f x) (g x)) 4 0 σ +
        3 * (S.firstEnergy (fun e => w e • axisC) σ)^2) +
      (S.gaugeEnergy (fun x => planeOperator (f x) ((-g) x)) 4 0 σ +
        3 * (S.firstEnergy (fun e => w e • axisC) σ)^2)) =
      (fun σ => 6 * (S.secondAxisEnergy w w σ +
        S.firstEnergy (fun e => w e • axisC) σ * S.firstEnergy (fun e => w e • axisC) σ)) := by
    funext σ
    have ht := he σ
    linarith
  change S.average (fun σ =>
      (S.gaugeEnergy (fun x => planeOperator (f x) (g x)) 4 0 σ +
        3 * (S.firstEnergy (fun e => w e • axisC) σ)^2) +
      (S.gaugeEnergy (fun x => planeOperator (f x) ((-g) x)) 4 0 σ +
        3 * (S.firstEnergy (fun e => w e • axisC) σ)^2)) = _
  rw [hpoint, S.average_mul_const]
  rfl


theorem fourthResponse_axisGradient (S : SpinSystem V E)
    (g : SpinOperator 4) (hg : g ∈ skewAdjoint (SpinOperator 4)) (f : V → ℝ)
    (hP : ∀ x s, S.pin x = some s → f x = 0) :
    S.fourthResponse (S.axisGradient f g) = 0 := by
  let A := S.axisGradient f g
  have hZ : (fun t => S.Z (fun e => NormedSpace.exp (t • A e))) =
      (fun _ : ℝ => S.Z (fun _ => 1)) := funext (S.Z_gradient_line g hg f hP)
  have hfirst : (fun t => ∫ σ, S.firstWeight A t σ ∂S.reference) = (fun _ : ℝ => 0) := by
    funext t
    have h := S.hasDerivAt_twistZ A t
    rw [hZ] at h
    exact h.unique (hasDerivAt_const t _)
  have hsecond : (fun t => ∫ σ, S.secondWeight A t σ ∂S.reference) = (fun _ : ℝ => 0) := by
    funext t
    have h := S.hasDerivAt_firstVariation A t
    rw [hfirst] at h
    exact h.unique (hasDerivAt_const t 0)
  have hthird : (fun t => ∫ σ, S.thirdWeight A t σ ∂S.reference) = (fun _ : ℝ => 0) := by
    funext t
    have h := S.hasDerivAt_secondVariation A t
    rw [hsecond] at h
    exact h.unique (hasDerivAt_const t 0)
  have hfourth : (∫ σ, S.fourthWeight A 0 σ ∂S.reference) = 0 := by
    have h := S.hasDerivAt_thirdVariation A 0
    rw [hthird] at h
    exact h.unique (hasDerivAt_const 0 0)
  rw [S.fourthResponse_integral, hfourth, zero_div]

end SpinSystem
end
end RP3.Quadratic
end StandalonePart29

/- ===== RP3/QuadraticAverages.lean ===== -/
section StandalonePart30
/-!
# Real and complex Gibbs expectation as linear maps
Adapted from OpenAI's ClassicalON MixedWard and ComplexWard, commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a (Apache-2.0, copyright OpenAI).
-/
namespace RP3.Quadratic
universe uV uE uΩ
noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace ComplexConjugate
namespace SpinSystem
variable {V : Type uV} {E : Type uE} [Fintype V] [Fintype E]

def averageLinear (S : SpinSystem V E) : C((V → RP3.Spin), ℝ) →ₗ[ℝ] ℝ where
  toFun f := S.average f
  map_add' f g := S.average_add f.continuous g.continuous
  map_smul' r f := S.average_mul_const r f

@[simp] theorem averageLinear_apply (S : SpinSystem V E)
    (f : C((V → RP3.Spin), ℝ)) : S.averageLinear f = S.average f := rfl

theorem integrable_complex_integrand (S : SpinSystem V E)
    {f : (V → RP3.Spin) → ℂ} (hf : Continuous f) :
    Integrable (fun σ => f σ * (Real.exp (S.energy (fun _ => 1) σ) : ℂ)) S.reference :=
  (hf.mul (Complex.continuous_ofReal.comp (S.continuous_energy _).rexp)).integrable_of_hasCompactSupport
    (HasCompactSupport.of_compactSpace _)

def averageComplexLinear (S : SpinSystem V E) : C((V → RP3.Spin), ℂ) →ₗ[ℂ] ℂ where
  toFun f := (∫ σ, f σ * (Real.exp (S.energy (fun _ => 1) σ) : ℂ) ∂S.reference) /
    (S.Z (fun _ => 1) : ℂ)
  map_add' f g := by
    simp only [ContinuousMap.add_apply, add_mul]
    rw [integral_add (S.integrable_complex_integrand f.continuous)
      (S.integrable_complex_integrand g.continuous), add_div]
  map_smul' c f := by
    simp only [ContinuousMap.smul_apply, smul_eq_mul, mul_assoc,
      integral_const_mul, RingHom.id_apply, mul_div_assoc]

def ofRealObservable {Ω : Type uΩ} [TopologicalSpace Ω] (f : C(Ω, ℝ)) : C(Ω, ℂ) :=
  ⟨fun σ => (f σ : ℂ), Complex.continuous_ofReal.comp f.continuous⟩

@[simp] theorem averageComplex_ofReal (S : SpinSystem V E)
    (f : C((V → RP3.Spin), ℝ)) :
    S.averageComplexLinear (ofRealObservable f) = (S.averageLinear f : ℂ) := by
  change (∫ σ, (f σ : ℂ) * (Real.exp (S.energy (fun _ => 1) σ) : ℂ) ∂S.reference) /
    (S.Z (fun _ => 1) : ℂ) = _
  simp only [← Complex.ofReal_mul, integral_complex_ofReal, ← Complex.ofReal_div]
  rfl


def normObservable {Ω : Type uΩ} [TopologicalSpace Ω] (f : C(Ω, ℂ)) : C(Ω, ℝ) :=
  ⟨fun σ => ‖f σ‖, f.continuous.norm⟩

def reObservable {Ω : Type uΩ} [TopologicalSpace Ω] (f : C(Ω, ℂ)) : C(Ω, ℝ) :=
  ⟨fun σ => (f σ).re, Complex.continuous_re.comp f.continuous⟩

def imObservable {Ω : Type uΩ} [TopologicalSpace Ω] (f : C(Ω, ℂ)) : C(Ω, ℝ) :=
  ⟨fun σ => (f σ).im, Complex.continuous_im.comp f.continuous⟩

theorem averageLinear_nonneg (S : SpinSystem V E)
    (f : C((V → RP3.Spin), ℝ)) (hf : ∀ σ, 0 ≤ f σ) : 0 ≤ S.averageLinear f :=
  S.average_nonneg hf

theorem averageLinear_mono (S : SpinSystem V E)
    (f g : C((V → RP3.Spin), ℝ)) (hfg : ∀ σ, f σ ≤ g σ) :
    S.averageLinear f ≤ S.averageLinear g := S.average_mono f.continuous g.continuous hfg

theorem averageLinear_mul_self_nonneg (S : SpinSystem V E)
    (f : C((V → RP3.Spin), ℝ)) : 0 ≤ S.averageLinear (f*f) :=
  S.averageLinear_nonneg _ (fun σ => mul_self_nonneg (f σ))

theorem averageLinear_cauchySchwarz (S : SpinSystem V E)
    (f g : C((V → RP3.Spin), ℝ)) :
    (S.averageLinear (f*g))^2 ≤ S.averageLinear (f*f) * S.averageLinear (g*g) := by
  have hp (t : ℝ) : 0 ≤ S.averageLinear (f*f) * (t*t) +
      (2*S.averageLinear (f*g))*t + S.averageLinear (g*g) := by
    have h := S.averageLinear_mul_self_nonneg (t • f + g)
    have he : (t • f + g)*(t • f + g) =
        (t*t) • (f*f) + (2*t) • (f*g) + g*g := by
      ext σ
      simp only [ContinuousMap.mul_apply, ContinuousMap.add_apply,
        ContinuousMap.smul_apply, smul_eq_mul]
      ring
    rw [he, map_add, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul] at h
    nlinarith
  have h := discrim_le_zero hp
  unfold discrim at h
  nlinarith

theorem averageLinear_mul_le_sqrt (S : SpinSystem V E)
    (f g : C((V → RP3.Spin), ℝ)) :
    S.averageLinear (f*g) ≤
      Real.sqrt (S.averageLinear (f*f)) * Real.sqrt (S.averageLinear (g*g)) := by
  rw [← Real.sqrt_mul (S.averageLinear_mul_self_nonneg f)]
  exact Real.le_sqrt_of_sq_le (S.averageLinear_cauchySchwarz f g)

theorem norm_averageComplex_le (S : SpinSystem V E)
    (f : C((V → RP3.Spin), ℂ)) :
    ‖S.averageComplexLinear f‖ ≤ S.averageLinear (normObservable f) := by
  change ‖(∫ σ, f σ * (Real.exp (S.energy (fun _ => 1) σ) : ℂ) ∂S.reference) /
    (S.Z (fun _ => 1) : ℂ)‖ ≤ _
  rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (S.Z_pos _)]
  calc _ ≤ (∫ σ, ‖f σ * (Real.exp (S.energy (fun _ => 1) σ) : ℂ)‖ ∂S.reference) /
      S.Z (fun _ => 1) :=
      div_le_div_of_nonneg_right (norm_integral_le_integral_norm _) (S.Z_pos _).le
    _ = S.averageLinear (normObservable f) := by
      simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (Real.exp_pos _)]
      rfl

theorem averageComplex_re (S : SpinSystem V E)
    (f : C((V → RP3.Spin), ℂ)) :
    (S.averageComplexLinear f).re = S.averageLinear (reObservable f) := by
  change ((∫ σ, f σ * (Real.exp (S.energy (fun _ => 1) σ) : ℂ) ∂S.reference) /
    (S.Z (fun _ => 1) : ℂ)).re = _
  rw [Complex.div_ofReal_re]
  have h := integral_re (S.integrable_complex_integrand f.continuous)
  simp only [RCLike.re_to_complex] at h
  rw [← h]
  simp only [Complex.mul_re, Complex.ofReal_re,
    Complex.ofReal_im, mul_zero, sub_zero]
  rfl

theorem averageComplex_conj (S : SpinSystem V E)
    (f : C((V → RP3.Spin), ℂ)) :
    S.averageComplexLinear ⟨fun σ => conj (f σ), Complex.continuous_conj.comp f.continuous⟩ =
      conj (S.averageComplexLinear f) := by
  change (∫ σ, conj (f σ) * (Real.exp (S.energy (fun _ => 1) σ) : ℂ) ∂S.reference) /
    (S.Z (fun _ => 1) : ℂ) =
      conj ((∫ σ, f σ * (Real.exp (S.energy (fun _ => 1) σ) : ℂ) ∂S.reference) /
        (S.Z (fun _ => 1) : ℂ))
  conv_lhs => arg 1; arg 2; ext σ; rw [← Complex.conj_ofReal (Real.exp _), ← map_mul]
  rw [integral_conj, map_div₀]
  congr 1
  exact (Complex.conj_ofReal _).symm

@[simp] theorem averageLinear_const (S : SpinSystem V E) (c : ℝ) :
    S.averageLinear (ContinuousMap.const _ c) = c := S.average_const c

@[simp] theorem averageLinear_one (S : SpinSystem V E) : S.averageLinear 1 = 1 :=
  S.average_const 1

@[simp] theorem normObservable_mul {Ω : Type uΩ} [TopologicalSpace Ω] (f g : C(Ω, ℂ)) :
    normObservable (f*g) = normObservable f * normObservable g := by
  ext x
  exact norm_mul (f x) (g x)

theorem norm_averageComplex_le_const (S : SpinSystem V E)
    (f : C((V → RP3.Spin), ℂ)) (c : ℝ) (h : ∀ σ, ‖f σ‖ ≤ c) :
    ‖S.averageComplexLinear f‖ ≤ c := by
  calc _ ≤ S.averageLinear (normObservable f) := S.norm_averageComplex_le f
       _ ≤ S.averageLinear (ContinuousMap.const _ c) := S.averageLinear_mono _ _ h
       _ = c := S.averageLinear_const c

theorem norm_averageComplex_mul_le (S : SpinSystem V E)
    (f g : C((V → RP3.Spin), ℂ)) :
    ‖S.averageComplexLinear (f*g)‖ ≤
      Real.sqrt (S.averageLinear (normObservable f * normObservable f)) *
      Real.sqrt (S.averageLinear (normObservable g * normObservable g)) := by
  calc _ ≤ S.averageLinear (normObservable (f*g)) := S.norm_averageComplex_le _
       _ = S.averageLinear (normObservable f * normObservable g) := by rw [normObservable_mul]
       _ ≤ _ := S.averageLinear_mul_le_sqrt _ _

theorem averageLinear_norm_le_sqrt (S : SpinSystem V E)
    (f : C((V → RP3.Spin), ℂ)) :
    S.averageLinear (normObservable f) ≤
      Real.sqrt (S.averageLinear (normObservable f * normObservable f)) := by
  simpa only [mul_one, one_mul, S.averageLinear_one, Real.sqrt_one] using
    S.averageLinear_mul_le_sqrt (normObservable f) 1

theorem norm_averageComplex_mul_mul_le (S : SpinSystem V E)
    (a f g : C((V → RP3.Spin), ℂ)) (c : ℝ) (hc : 0 ≤ c)
    (ha : ∀ σ, ‖a σ‖ ≤ c) :
    ‖S.averageComplexLinear (a*f*g)‖ ≤ c *
      (Real.sqrt (S.averageLinear (normObservable f * normObservable f)) *
       Real.sqrt (S.averageLinear (normObservable g * normObservable g))) := by
  have hpt : ∀ σ, normObservable (a*f*g) σ ≤
      (c • (normObservable f * normObservable g)) σ := by
    intro σ
    change ‖a σ*f σ*g σ‖ ≤ c * (‖f σ‖*‖g σ‖)
    rw [norm_mul, norm_mul, mul_assoc]
    exact mul_le_mul_of_nonneg_right (ha σ) (mul_nonneg (norm_nonneg _) (norm_nonneg _))
  calc _ ≤ S.averageLinear (normObservable (a*f*g)) := S.norm_averageComplex_le _
       _ ≤ S.averageLinear (c • (normObservable f * normObservable g)) :=
          S.averageLinear_mono _ _ hpt
       _ = c * S.averageLinear (normObservable f * normObservable g) := by
          rw [map_smul, smul_eq_mul]
       _ ≤ _ := mul_le_mul_of_nonneg_left (S.averageLinear_mul_le_sqrt _ _) hc

theorem norm_averageComplex_mul_mul_le_of_moments (S : SpinSystem V E)
    (a f g : C((V → RP3.Spin), ℂ)) (c v : ℝ) (hc : 0 ≤ c)
    (ha : ∀ σ, ‖a σ‖ ≤ c)
    (hf : S.averageLinear (normObservable f * normObservable f) ≤ v)
    (hg : S.averageLinear (normObservable g * normObservable g) ≤ v) :
    ‖S.averageComplexLinear (a*f*g)‖ ≤ c*v := by
  have hv : 0 ≤ v := (S.averageLinear_mul_self_nonneg (normObservable f)).trans hf
  calc _ ≤ c * (Real.sqrt (S.averageLinear (normObservable f * normObservable f)) *
      Real.sqrt (S.averageLinear (normObservable g * normObservable g))) :=
      S.norm_averageComplex_mul_mul_le a f g c hc ha
       _ ≤ c * (Real.sqrt v * Real.sqrt v) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul (Real.sqrt_le_sqrt hf) (Real.sqrt_le_sqrt hg)
              (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)) hc
       _ = c*v := by rw [Real.mul_self_sqrt hv]

theorem norm_averageComplex_mul_le_of_moment (S : SpinSystem V E)
    (a f : C((V → RP3.Spin), ℂ)) (c v : ℝ) (hc : 0 ≤ c)
    (ha : ∀ σ, ‖a σ‖ ≤ c)
    (hf : S.averageLinear (normObservable f * normObservable f) ≤ v) :
    ‖S.averageComplexLinear (a*f)‖ ≤ c*Real.sqrt v := by
  have h := S.norm_averageComplex_mul_mul_le a f 1 c hc ha
  simp only [mul_one] at h
  have h1 : normObservable (1 : C((V → RP3.Spin), ℂ)) = 1 := by
    ext σ
    change ‖(1 : ℂ)‖ = (1 : ℝ)
    exact norm_one
  rw [h1, mul_one, S.averageLinear_one, Real.sqrt_one, mul_one] at h
  exact h.trans (mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hf) hc)


end SpinSystem
end
end RP3.Quadratic
end StandalonePart30

/- ===== RP3/ComplexCurrents.lean ===== -/
section StandalonePart31

/-!
# Complex currents for the quadratic interaction

This module extends the proved real gradient-current estimate to genuinely
complex vertex functions. The complex current is defined by its real and
imaginary parts, using the actual first derivative of the RP³ energy.
No positivity of the response bilinear form is assumed.
-/

namespace RP3.Quadratic
noncomputable section
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace

namespace SpinSystem
variable {V E : Type*} [Fintype V] [Fintype E]

omit [Fintype V] [Fintype E] in
/-- The oriented discrete gradient, also for complex potentials. -/
def edgeGradient (S : SpinSystem V E) {𝕜 : Type*} [Sub 𝕜] (f : V → 𝕜) : E → 𝕜 :=
  fun e => f (S.right e) - f (S.left e)

/-- The first derivative in a fixed real rotation axis, complexified linearly. -/
def complexCurrent (S : SpinSystem V E) (g : SpinOperator 4)
    (h : E → ℂ) (σ : V → RP3.Spin) : ℂ :=
  ⟨S.firstEnergy (fun e => (h e).re • g) σ,
    S.firstEnergy (fun e => (h e).im • g) σ⟩

omit [Fintype V] in
@[simp] theorem complexCurrent_re (S : SpinSystem V E) (g : SpinOperator 4)
    (h : E → ℂ) (σ : V → RP3.Spin) :
    (S.complexCurrent g h σ).re = S.firstEnergy (fun e => (h e).re • g) σ := rfl

omit [Fintype V] in
@[simp] theorem complexCurrent_im (S : SpinSystem V E) (g : SpinOperator 4)
    (h : E → ℂ) (σ : V → RP3.Spin) :
    (S.complexCurrent g h σ).im = S.firstEnergy (fun e => (h e).im • g) σ := rfl

omit [Fintype V] in
theorem complexCurrent_eq_sum (S : SpinSystem V E) (g : SpinOperator 4)
    (h : E → ℂ) (σ : V → RP3.Spin) :
    S.complexCurrent g h σ = ∑ e,
      ((2 * S.strength e *
        ⟪(σ (S.left e)).val, (σ (S.right e)).val⟫_ℝ *
        ⟪(σ (S.left e)).val, g (σ (S.right e)).val⟫_ℝ : ℝ) : ℂ) * h e := by
  apply Complex.ext <;>
    simp [complexCurrent, firstEnergy, smul_apply, real_inner_smul_right,
      Complex.re_sum, Complex.im_sum, mul_assoc, mul_left_comm, mul_comm]

omit [Fintype V] in
theorem complexCurrent_add (S : SpinSystem V E) (g : SpinOperator 4)
    (h k : E → ℂ) (σ : V → RP3.Spin) :
    S.complexCurrent g (h + k) σ =
      S.complexCurrent g h σ + S.complexCurrent g k σ := by
  simp only [S.complexCurrent_eq_sum, Pi.add_apply, mul_add, Finset.sum_add_distrib]

omit [Fintype V] in
theorem complexCurrent_smul (S : SpinSystem V E) (g : SpinOperator 4)
    (c : ℂ) (h : E → ℂ) (σ : V → RP3.Spin) :
    S.complexCurrent g (c • h) σ = c * S.complexCurrent g h σ := by
  simp only [S.complexCurrent_eq_sum, Pi.smul_apply, smul_eq_mul,
    Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro e _
  ring

omit [Fintype V] in
theorem complexCurrent_conj (S : SpinSystem V E) (g : SpinOperator 4)
    (h : E → ℂ) (σ : V → RP3.Spin) :
    S.complexCurrent g (fun e => star (h e)) σ = star (S.complexCurrent g h σ) := by
  simp only [S.complexCurrent_eq_sum, map_sum, map_mul, Complex.star_def,
    Complex.conj_ofReal]

omit [Fintype V] in
theorem continuous_complexCurrent (S : SpinSystem V E) (g : SpinOperator 4)
    (h : E → ℂ) : Continuous (S.complexCurrent g h) := by
  have he : S.complexCurrent g h = fun σ => ∑ e,
      ((2 * S.strength e *
        ⟪(σ (S.left e)).val, (σ (S.right e)).val⟫_ℝ *
        ⟪(σ (S.left e)).val, g (σ (S.right e)).val⟫_ℝ : ℝ) : ℂ) * h e :=
    funext (S.complexCurrent_eq_sum g h)
  rw [he]
  fun_prop

omit [Fintype V] in
theorem complexCurrent_gradient_normSq (S : SpinSystem V E) (g : SpinOperator 4)
    (f : V → ℂ) (σ : V → RP3.Spin) :
    Complex.normSq (S.complexCurrent g (S.edgeGradient f) σ) =
      (S.firstEnergy (S.axisGradient (fun x => (f x).re) g) σ)^2 +
      (S.firstEnergy (S.axisGradient (fun x => (f x).im) g) σ)^2 := by
  simp only [Complex.normSq_apply, complexCurrent, edgeGradient, axisGradient,
    Complex.sub_re, Complex.sub_im, pow_two]
  rfl

/-- Appendix A.1 for arbitrary complex potentials, proved by applying the
real Ward estimate separately to the real and imaginary parts. -/
theorem complex_gradient_current_bound (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β) (g : SpinOperator 4)
    (hg : g ∈ skewAdjoint (SpinOperator 4)) (hgn : ‖g‖ ≤ 1) (f : V → ℂ)
    (hP : ∀ x s, S.pin x = some s → f x = 0) :
    S.average (fun σ => Complex.normSq (S.complexCurrent g (S.edgeGradient f) σ)) ≤
      4 * β * ∑ e, Complex.normSq (S.edgeGradient f e) := by
  have hr := S.gradient_current_bound β hb g hg hgn (fun x => (f x).re)
    (fun x s hs => by rw [hP x s hs]; rfl)
  have hi := S.gradient_current_bound β hb g hg hgn (fun x => (f x).im)
    (fun x s hs => by rw [hP x s hs]; rfl)
  simp_rw [S.complexCurrent_gradient_normSq]
  change S.average
    ((fun σ => (S.firstEnergy (S.axisGradient (fun x => (f x).re) g) σ)^2) +
      (fun σ => (S.firstEnergy (S.axisGradient (fun x => (f x).im) g) σ)^2)) ≤ _
  rw [S.average_add
    (f := fun σ => (S.firstEnergy (S.axisGradient (fun x => (f x).re) g) σ)^2)
    (g := fun σ => (S.firstEnergy (S.axisGradient (fun x => (f x).im) g) σ)^2)
    ((S.continuous_firstEnergy _).pow 2) ((S.continuous_firstEnergy _).pow 2)]
  calc
    _ ≤ 4 * β * ∑ e, ((f (S.right e)).re - (f (S.left e)).re)^2 +
        4 * β * ∑ e, ((f (S.right e)).im - (f (S.left e)).im)^2 := add_le_add hr hi
    _ = _ := by
      simp only [edgeGradient, Complex.normSq_apply, Complex.sub_re,
        Complex.sub_im, pow_two, Finset.sum_add_distrib, mul_add]

omit [Fintype V] in
theorem abs_scalar_secondEnergy_le (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β) (g : SpinOperator 4) (hg : ‖g‖ ≤ 1)
    (h : E → ℝ) (σ : V → RP3.Spin) :
    |S.secondEnergy (fun e => h e • g) σ| ≤ 4 * β * ∑ e, (h e)^2 := by
  apply (S.abs_secondEnergy_le _ σ).trans
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro e _
  have hβ := (abs_nonneg _).trans (hb e)
  have hn : ‖h e • g‖ ≤ |h e| := by
    rw [norm_smul, Real.norm_eq_abs]
    exact mul_le_of_le_one_right (abs_nonneg _) hg
  have hn2 : ‖h e • g‖^2 ≤ (h e)^2 := by
    simpa only [sq_abs] using pow_le_pow_left₀ (norm_nonneg _) hn 2
  exact mul_le_mul (mul_le_mul_of_nonneg_left (hb e) (by norm_num)) hn2
    (sq_nonneg _) (by positivity)

/-- The real value `R(h, conj h)` of the complex-bilinear second response.
The negative current-square term is retained explicitly. -/
def hermitianResponse (S : SpinSystem V E) (g : SpinOperator 4) (h : E → ℂ) : ℝ :=
  -S.average (fun σ =>
    S.secondEnergy (fun e => (h e).re • g) σ +
    S.secondEnergy (fun e => (h e).im • g) σ +
    Complex.normSq (S.complexCurrent g h σ))

/-- Appendix A.2: an upper bound for the actual second response. This uses
positivity only of the squared current, not of the response. -/
theorem hermitianResponse_le (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β) (g : SpinOperator 4) (hg : ‖g‖ ≤ 1)
    (h : E → ℂ) :
    S.hermitianResponse g h ≤ 4 * β * ∑ e, Complex.normSq (h e) := by
  let C := 4 * β * ∑ e, Complex.normSq (h e)
  have hp (σ : V → RP3.Spin) :
      -C ≤ S.secondEnergy (fun e => (h e).re • g) σ +
        S.secondEnergy (fun e => (h e).im • g) σ +
        Complex.normSq (S.complexCurrent g h σ) := by
    have hr := (abs_le.mp (S.abs_scalar_secondEnergy_le β hb g hg
      (fun e => (h e).re) σ)).1
    have hi := (abs_le.mp (S.abs_scalar_secondEnergy_le β hb g hg
      (fun e => (h e).im) σ)).1
    have hn := Complex.normSq_nonneg (S.complexCurrent g h σ)
    have hC : C = 4 * β * ∑ e, (h e).re^2 + 4 * β * ∑ e, (h e).im^2 := by
      simp only [C, Complex.normSq_apply, pow_two, Finset.sum_add_distrib, mul_add]
    linarith
  have hc : Continuous (fun σ =>
      S.secondEnergy (fun e => (h e).re • g) σ +
      S.secondEnergy (fun e => (h e).im • g) σ +
      Complex.normSq (S.complexCurrent g h σ)) := by
    exact ((S.continuous_secondEnergy _).add (S.continuous_secondEnergy _)).add
      (Complex.continuous_normSq.comp (S.continuous_complexCurrent g h))
  have h := S.average_mono continuous_const hc hp
  rw [S.average_const] at h
  unfold hermitianResponse
  linarith

end SpinSystem
end
end RP3.Quadratic
end StandalonePart31

/- ===== RP3/MixedAlgebra.lean ===== -/
section StandalonePart32
/-!
# Fourth-order polarization and finite-family algebra

Adapted from OpenAI's ClassicalON RotationWork, MixedWard, ComplexWard, and
FamilyAlgebra at adc7f1241b42e322a6451854ab7e4b4c146bf78a.
Copyright OpenAI; Apache-2.0. All statements here are generic commutative-ring
identities; no spin-model hypotheses enter them.
-/
namespace RP3.Quadratic
universe uA uE uI uJ uK uL uV
noncomputable section
open scoped BigOperators ComplexConjugate
namespace MixedAlgebra
variable {E : Type uE} {K : Type uK} [Fintype E] [CommRing K]

def weighted (J u : E → K) : K := ∑ e, J e * u e

@[simp] theorem weighted_add (J u v : E → K) :
    weighted J (u+v) = weighted J u + weighted J v := by
  simp [weighted, mul_add, Finset.sum_add_distrib]

@[simp] theorem weighted_neg (J u : E → K) : weighted J (-u) = -weighted J u := by
  simp [weighted]

structure Coeffs (E : Type uE) (K : Type uK) where
  a : E → K
  b : E → K
  aa : E → K
  ab : E → K
  bb : E → K
  aab : E → K
  abb : E → K
  aabb : E → K

inductive Slot where
  | a | b | aa | ab | bb | aab | abb | aabb

def Coeffs.get (J : Coeffs E K) : Slot → E → K
  | .a => J.a
  | .b => J.b
  | .aa => J.aa
  | .ab => J.ab
  | .bb => J.bb
  | .aab => J.aab
  | .abb => J.abb
  | .aabb => J.aabb

def four (J : Coeffs E K) (u v w z : E → K) : K :=
  weighted J.a u * weighted J.b v * weighted J.a w * weighted J.b z +
  weighted J.ab (u*v) * weighted J.a w * weighted J.b z +
  weighted J.aa (u*w) * weighted J.b v * weighted J.b z +
  weighted J.ab (u*z) * weighted J.b v * weighted J.a w +
  weighted J.ab (v*w) * weighted J.a u * weighted J.b z +
  weighted J.bb (v*z) * weighted J.a u * weighted J.a w +
  weighted J.ab (w*z) * weighted J.a u * weighted J.b v +
  weighted J.ab (u*v) * weighted J.ab (w*z) +
  weighted J.aa (u*w) * weighted J.bb (v*z) +
  weighted J.ab (u*z) * weighted J.ab (v*w) +
  weighted J.aab (u*v*w) * weighted J.b z +
  weighted J.abb (u*v*z) * weighted J.a w +
  weighted J.aab (u*w*z) * weighted J.b v +
  weighted J.abb (v*w*z) * weighted J.a u +
  weighted J.aabb (u*v*w*z)

theorem four_add_first (J : Coeffs E K) (u u' v w z : E → K) :
    four J (u+u') v w z = four J u v w z + four J u' v w z := by
  simp only [four, add_mul, weighted_add]
  ring

theorem four_add_second (J : Coeffs E K) (u v v' w z : E → K) :
    four J u (v+v') w z = four J u v w z + four J u v' w z := by
  simp only [four, add_mul, mul_add, weighted_add]
  ring

theorem four_swap_first_third (J : Coeffs E K) (u v w z : E → K) :
    four J u v w z = four J w v u z := by
  unfold four
  simp only [mul_comm, mul_left_comm, mul_assoc]
  ring

theorem four_swap_second_fourth (J : Coeffs E K) (u v w z : E → K) :
    four J u v w z = four J u z w v := by
  unfold four
  simp only [mul_comm, mul_left_comm, mul_assoc]
  ring

end MixedAlgebra

namespace MixedAlgebra
variable {E : Type uE} {K : Type uK} [Fintype E] [CommRing K]

theorem four_add_third (J : Coeffs E K) (u v w w' z : E → K) :
    four J u v (w+w') z = four J u v w z + four J u v w' z := by
  rw [four_swap_first_third, four_add_first, four_swap_first_third J w,
    four_swap_first_third J w']

theorem four_add_fourth (J : Coeffs E K) (u v w z z' : E → K) :
    four J u v w (z+z') = four J u v w z + four J u v w z' := by
  rw [four_swap_second_fourth, four_add_second, four_swap_second_fourth J u z,
    four_swap_second_fourth J u z']

theorem four_polarize_a (J : Coeffs E K) (u w v : E → K) :
    four J (u+w) v (u+w) v = four J u v u v + 2 * four J u v w v + four J w v w v := by
  rw [four_add_first, four_add_third, four_add_third, four_swap_first_third J w v u]
  ring

theorem four_polarize_b (J : Coeffs E K) (u w v z : E → K) :
    four J u (v+z) w (v+z) = four J u v w v + 2 * four J u v w z + four J u z w z := by
  rw [four_add_second, four_add_fourth, four_add_fourth, four_swap_second_fourth J u z w v]
  ring

end MixedAlgebra

namespace MixedAlgebra
variable {E : Type uE} {K : Type uK} [Fintype E] [CommRing K]

theorem four_diagonal (J : Coeffs E K) (u v : E → K) :
    four J u v u v =
      (weighted J.a u)^2 * (weighted J.b v)^2 +
      weighted J.aa (u*u) * (weighted J.b v)^2 +
      weighted J.bb (v*v) * (weighted J.a u)^2 +
      4 * weighted J.ab (u*v) * weighted J.a u * weighted J.b v +
      weighted J.aa (u*u) * weighted J.bb (v*v) +
      2 * (weighted J.ab (u*v))^2 +
      2 * weighted J.aab (u*u*v) * weighted J.b v +
      2 * weighted J.abb (u*v*v) * weighted J.a u +
      weighted J.aabb (u*u*v*v) := by
  simp only [four, mul_comm, mul_left_comm]
  ring

end MixedAlgebra

def bell4 (x y z w : ℝ) : ℝ := w+4*x*z+3*y^2+6*x^2*y+x^4

theorem bell4_even (a b aa ab bb aaa aab abb bbb p q aaaa aabb bbbb : ℝ)
    (h : p+q = 2*aaaa+12*aabb+2*bbbb) :
    bell4 (a+b) (aa+2*ab+bb) (aaa+3*aab+3*abb+bbb) p +
      bell4 (a-b) (aa-2*ab+bb) (aaa-3*aab+3*abb-bbb) q -
      2*bell4 a aa aaa aaaa - 2*bell4 b bb bbb bbbb =
      12*(a^2*b^2+aa*b^2+bb*a^2+4*ab*a*b+aa*bb+2*ab^2+
        2*aab*b+2*abb*a+aabb) := by
  unfold bell4
  nlinarith only [h]


namespace MixedAlgebra
variable {E : Type uE} {K : Type uK} [Fintype E] [CommRing K]
theorem weighted_const_mul (J u : E → K) (r : K) :
    weighted J (fun e => r * u e) = r * weighted J u := by
  simp only [weighted, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro e _
  ring
end MixedAlgebra

structure ComplexFourForm (A : Type uA) [AddCommMonoid A] [Module ℂ A] where
  toFun : A → A → A → A → ℂ
  add_first : ∀ u u' v w z, toFun (u+u') v w z = toFun u v w z + toFun u' v w z
  add_second : ∀ u v v' w z, toFun u (v+v') w z = toFun u v w z + toFun u v' w z
  add_third : ∀ u v w w' z, toFun u v (w+w') z = toFun u v w z + toFun u v w' z
  add_fourth : ∀ u v w z z', toFun u v w (z+z') = toFun u v w z + toFun u v w z'
  smul_first : ∀ r u v w z, toFun (r • u) v w z = r * toFun u v w z
  smul_second : ∀ r u v w z, toFun u (r • v) w z = r * toFun u v w z
  smul_third : ∀ r u v w z, toFun u v (r • w) z = r * toFun u v w z
  smul_fourth : ∀ r u v w z, toFun u v w (r • z) = r * toFun u v w z

instance {A : Type uA} [AddCommMonoid A] [Module ℂ A] :
    CoeFun (ComplexFourForm A) (fun _ => A → A → A → A → ℂ) := ⟨ComplexFourForm.toFun⟩

theorem complex_linear_zero_of_real {V : Type uV} (P : V → Prop)
    (L : (V → ℂ) → ℂ)
    (ha : ∀ u v, L (u+v) = L u + L v)
    (hs : ∀ r u, L (r • u) = r * L u)
    (hr : ∀ u : V → ℝ, (∀ x, P x → u x = 0) → L (fun x => (u x : ℂ)) = 0)
    (u : V → ℂ) (hu : ∀ x, P x → u x = 0) : L u = 0 := by
  have hre : ∀ x, P x → (u x).re = 0 := by
    intro x hx
    rw [hu x hx, Complex.zero_re]
  have him : ∀ x, P x → (u x).im = 0 := by
    intro x hx
    rw [hu x hx, Complex.zero_im]
  have hd : u = (fun x => ((u x).re : ℂ)) + Complex.I • (fun x => ((u x).im : ℂ)) := by
    ext x
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    rw [mul_comm]
    exact (Complex.re_add_im (u x)).symm
  rw [hd, ha, hs, hr _ hre, hr _ him]
  simp only [mul_zero, add_zero]

theorem ComplexFourForm.zero_of_real {V : Type uV} (F : ComplexFourForm (V → ℂ))
    (P : V → Prop)
    (hr : ∀ u v w z : V → ℝ,
      (∀ x, P x → u x = 0) → (∀ x, P x → v x = 0) →
      (∀ x, P x → w x = 0) → (∀ x, P x → z x = 0) →
      F (fun x => (u x : ℂ)) (fun x => (v x : ℂ))
        (fun x => (w x : ℂ)) (fun x => (z x : ℂ)) = 0)
    (u v w z : V → ℂ)
    (hu : ∀ x, P x → u x = 0) (hv : ∀ x, P x → v x = 0)
    (hw : ∀ x, P x → w x = 0) (hz : ∀ x, P x → z x = 0) :
    F u v w z = 0 := by
  apply complex_linear_zero_of_real P (fun u => F u v w z)
    (fun u u' => F.add_first u u' v w z) (fun r u => F.smul_first r u v w z) ?_ u hu
  intro a ha
  apply complex_linear_zero_of_real P (fun v => F (fun x => (a x : ℂ)) v w z)
    (fun v v' => F.add_second (fun x => (a x : ℂ)) v v' w z)
    (fun r v => F.smul_second r (fun x => (a x : ℂ)) v w z) ?_ v hv
  intro b hb
  apply complex_linear_zero_of_real P
    (fun w => F (fun x => (a x : ℂ)) (fun x => (b x : ℂ)) w z)
    (fun w w' => F.add_third (fun x => (a x : ℂ)) (fun x => (b x : ℂ)) w w' z)
    (fun r w => F.smul_third r (fun x => (a x : ℂ)) (fun x => (b x : ℂ)) w z) ?_ w hw
  intro c hc
  apply complex_linear_zero_of_real P
    (fun z => F (fun x => (a x : ℂ)) (fun x => (b x : ℂ)) (fun x => (c x : ℂ)) z)
    (fun z z' => F.add_fourth (fun x => (a x : ℂ)) (fun x => (b x : ℂ)) (fun x => (c x : ℂ)) z z')
    (fun r z => F.smul_fourth r (fun x => (a x : ℂ)) (fun x => (b x : ℂ)) (fun x => (c x : ℂ)) z)
    ?_ z hz
  intro d hd
  exact hr a b c d ha hb hc hd

namespace MixedAlgebra
variable {E : Type uE} {K : Type uK} {L : Type uL} [Fintype E] [CommRing K] [CommRing L]

def Coeffs.map (φ : K →+* L) (J : Coeffs E K) : Coeffs E L where
  a := φ ∘ J.a
  b := φ ∘ J.b
  aa := φ ∘ J.aa
  ab := φ ∘ J.ab
  bb := φ ∘ J.bb
  aab := φ ∘ J.aab
  abb := φ ∘ J.abb
  aabb := φ ∘ J.aabb

theorem weighted_map (φ : K →+* L) (J u : E → K) :
    weighted (φ ∘ J) (φ ∘ u) = φ (weighted J u) := by
  simp [weighted]

theorem four_map (φ : K →+* L) (J : Coeffs E K) (u v w z : E → K) :
    four (J.map φ) (φ ∘ u) (φ ∘ v) (φ ∘ w) (φ ∘ z) = φ (four J u v w z) := by
  simp only [four, Coeffs.map, weighted, Function.comp_apply, Pi.mul_apply,
    map_add, map_mul, map_sum]

theorem weighted_smul (J u : E → K) (r : K) :
    weighted J (r • u) = r * weighted J u := by
  exact weighted_const_mul J u r

theorem four_smul_first (J : Coeffs E K) (u v w z : E → K) (r : K) :
    four J (r • u) v w z = r * four J u v w z := by
  simp only [four, smul_mul_assoc, weighted_smul]
  ring

theorem four_smul_second (J : Coeffs E K) (u v w z : E → K) (r : K) :
    four J u (r • v) w z = r * four J u v w z := by
  simp only [four, mul_smul_comm, smul_mul_assoc, weighted_smul]
  ring

theorem four_smul_third (J : Coeffs E K) (u v w z : E → K) (r : K) :
    four J u v (r • w) z = r * four J u v w z := by
  rw [four_swap_first_third, four_smul_first, four_swap_first_third J w]

theorem four_smul_fourth (J : Coeffs E K) (u v w z : E → K) (r : K) :
    four J u v w (r • z) = r * four J u v w z := by
  rw [four_swap_second_fourth, four_smul_second, four_swap_second_fourth J u z]

end MixedAlgebra


namespace MixedAlgebra
variable {I : Type uI} {J : Type uJ} {E : Type uE} {K : Type uK} [Fintype I] [Fintype J] [Fintype E] [CommRing K]

lemma sum_three_rotate (F : I → J → E → K) :
    (∑ i, ∑ j, ∑ e, F i j e) = ∑ e, ∑ i, ∑ j, F i j e := by
  calc _ = ∑ i, ∑ e, ∑ j, F i j e := by
         apply Finset.sum_congr rfl
         intro i _
         exact Finset.sum_comm
       _ = _ := Finset.sum_comm

lemma sum_weighted_separated (A : E → K) (p : I → E → K) (q : J → E → K)
    (a : I → K) (b : J → K) :
    (∑ i, ∑ j, weighted A (p i * q j) * a i * b j) =
      ∑ e, A e * (∑ i, p i e * a i) * (∑ j, q j e * b j) := by
  simp only [weighted, Finset.sum_mul, Pi.mul_apply]
  rw [sum_three_rotate]
  apply Finset.sum_congr rfl
  intro e _
  simp only [Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

lemma sum_current (B : E → K) (p : I → E → K) (a : I → K) :
    (∑ i, a i * weighted B (p i)) = weighted B (fun e => ∑ i, a i * p i e) := by
  simp only [weighted, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro e _
  apply Finset.sum_congr rfl
  intro i _
  ring

lemma contract_two_current (A B C : E → K) (p q : I → E → K) (r s : J → E → K) :
    (∑ i, ∑ j, weighted A (p i * r j) * weighted B (q i) * weighted C (s j)) =
      ∑ e, A e * weighted B (fun l => ∑ i, p i e * q i l) *
        weighted C (fun l => ∑ j, r j e * s j l) := by
  rw [sum_weighted_separated]
  simp only [sum_current]

lemma contract_two_two (A B : E → K) (p q : I → E → K) (r s : J → E → K) :
    (∑ i, ∑ j, weighted A (p i * r j) * weighted B (q i * s j)) =
      ∑ e, ∑ l, A e * B l * (∑ i, p i e * q i l) * (∑ j, r j e * s j l) := by
  have h (i : I) (j : J) : weighted A (p i * r j) * weighted B (q i * s j) =
      ∑ l, B l * (weighted A (p i*r j) * q i l * s j l) := by
    simp only [weighted, Finset.mul_sum, Pi.mul_apply]
    apply Finset.sum_congr rfl
    intro l _
    ring
  simp_rw [h]
  rw [sum_three_rotate]
  simp_rw [← Finset.mul_sum]
  simp_rw [sum_weighted_separated]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro e _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro l _
  ring

lemma contract_three_current (A B : E → K) (p q : I → E → K) (r s : J → E → K) :
    (∑ i, ∑ j, weighted A (p i*q i*r j) * weighted B (s j)) =
      ∑ e, A e * (∑ i, p i e*q i e) * weighted B (fun l => ∑ j, r j e*s j l) := by
  have h := sum_weighted_separated A (fun i => p i*q i) r (fun _ => 1)
    (fun j => weighted B (s j))
  simpa only [mul_one, Pi.mul_apply, sum_current] using h

lemma contract_four (A : E → K) (p q : I → E → K) (r s : J → E → K) :
    (∑ i, ∑ j, weighted A (p i*q i*r j*s j)) =
      ∑ e, A e * (∑ i, p i e*q i e) * (∑ j, r j e*s j e) := by
  have h := sum_weighted_separated A (fun i => p i*q i) (fun j => r j*s j)
    (fun _ => 1) (fun _ => 1)
  simpa only [mul_one, Pi.mul_apply, mul_assoc] using h

lemma four_grouped (C : Coeffs E K) (u v w z : E → K) :
    four C u v w z =
    (weighted C.a u * weighted C.b v + weighted C.ab (u*v)) *
      (weighted C.a w * weighted C.b z + weighted C.ab (w*z)) +
    (weighted C.aa (u*w) * weighted C.b v * weighted C.b z +
      weighted C.ab (u*z) * weighted C.b v * weighted C.a w +
      weighted C.ab (v*w) * weighted C.a u * weighted C.b z +
      weighted C.bb (v*z) * weighted C.a u * weighted C.a w +
      weighted C.aa (u*w) * weighted C.bb (v*z) +
      weighted C.ab (u*z) * weighted C.ab (v*w) +
      weighted C.aab (u*v*w) * weighted C.b z +
      weighted C.abb (u*v*z) * weighted C.a w +
      weighted C.aab (u*w*z) * weighted C.b v +
      weighted C.abb (v*w*z) * weighted C.a u +
      weighted C.aabb (u*v*w*z)) := by
  unfold four
  ring

lemma contract_current_three (A B : E → K) (p q : I → E → K) (r s : J → E → K) :
    (∑ i, ∑ j, weighted A (p i*r j*s j) * weighted B (q i)) =
      ∑ e, A e * (∑ j, r j e*s j e) * weighted B (fun l => ∑ i, p i e*q i l) := by
  rw [Finset.sum_comm]
  simpa only [mul_comm, mul_left_comm, mul_assoc] using contract_three_current A B r s p q

omit [Fintype J] in
def paired (C : Coeffs E K) (p q : I → E → K) : K :=
  ∑ i, (weighted C.a (p i) * weighted C.b (q i) + weighted C.ab (p i*q i))

omit [Fintype J] in
def kernel (p q : I → E → K) (e l : E) : K := ∑ i, p i e*q i l

lemma four_family_contraction (C : Coeffs E K) (p q : I → E → K) (r s : J → E → K) :
    (∑ i, ∑ j, four C (p i) (q i) (r j) (s j)) =
      paired C p q * paired C r s +
    ((∑ e, C.aa e * weighted C.b (kernel p q e) * weighted C.b (kernel r s e)) +
      (∑ e, C.ab e * weighted C.b (kernel p q e) * weighted C.a (kernel s r e)) +
      (∑ e, C.ab e * weighted C.a (kernel q p e) * weighted C.b (kernel r s e)) +
      (∑ e, C.bb e * weighted C.a (kernel q p e) * weighted C.a (kernel s r e)) +
      (∑ e, ∑ l, C.aa e*C.bb l * kernel p q e l * kernel r s e l) +
      (∑ e, ∑ l, C.ab e*C.ab l * kernel p q e l * kernel s r e l) +
      (∑ e, C.aab e * kernel p q e e * weighted C.b (kernel r s e)) +
      (∑ e, C.abb e * kernel p q e e * weighted C.a (kernel s r e)) +
      (∑ e, C.aab e * kernel r s e e * weighted C.b (kernel p q e)) +
      (∑ e, C.abb e * kernel r s e e * weighted C.a (kernel q p e)) +
      (∑ e, C.aabb e * kernel p q e e * kernel r s e e)) := by
  simp only [four_grouped, Finset.sum_add_distrib]
  have hp : (∑ i, ∑ j,
      (weighted C.a (p i)*weighted C.b (q i) + weighted C.ab (p i*q i)) *
      (weighted C.a (r j)*weighted C.b (s j) + weighted C.ab (r j*s j))) =
      paired C p q * paired C r s := by
    simp only [paired, Finset.sum_mul_sum]
  rw [hp, contract_two_current, contract_two_current, contract_two_current,
    contract_two_current, contract_two_two, contract_two_two,
    contract_three_current, contract_three_current, contract_current_three,
    contract_current_three, contract_four]
  rfl

end MixedAlgebra
end
end RP3.Quadratic
end StandalonePart32

/- ===== RP3/QuadraticSecondResponse.lean ===== -/
section StandalonePart33

/-!
# The real and complex bilinear second response for RP³

The algebraic response interface is adapted from OpenAI's ClassicalON
MixedWard and ComplexWard at adc7f1241b42e322a6451854ab7e4b4c146bf78a
(Apache-2.0, copyright OpenAI). The coefficients below are the derivatives
of the squared interaction, including the square of the first inner-product
derivative in the Hessian.
-/
namespace RP3.Quadratic
universe uV uE
noncomputable section
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace ComplexConjugate
namespace SpinSystem
variable {V : Type uV} {E : Type uE} [Fintype V] [Fintype E]

omit [Fintype V] in
theorem firstEnergy_add (S : SpinSystem V E) (A B : E → SpinOperator 4)
    (σ : V → RP3.Spin) : S.firstEnergy (A+B) σ = S.firstEnergy A σ + S.firstEnergy B σ := by
  simp only [firstEnergy, Pi.add_apply, add_apply, inner_add_right,
    mul_add, Finset.sum_add_distrib]

omit [Fintype V] in
theorem secondAxisEnergy_add_left (S : SpinSystem V E) (h k l : E → ℝ)
    (σ : V → RP3.Spin) :
    S.secondAxisEnergy (h+k) l σ = S.secondAxisEnergy h l σ + S.secondAxisEnergy k l σ := by
  simp only [secondAxisEnergy, Pi.add_apply, add_mul, mul_add, Finset.sum_add_distrib]
  abel

omit [Fintype V] in
theorem secondAxisEnergy_symm (S : SpinSystem V E) (h k : E → ℝ)
    (σ : V → RP3.Spin) : S.secondAxisEnergy h k σ = S.secondAxisEnergy k h σ := by
  simp only [secondAxisEnergy, mul_comm]

omit [Fintype V] in
@[fun_prop] theorem continuous_secondPolynomial (S : SpinSystem V E) (h k : E → ℝ) :
    Continuous (fun σ => S.secondAxisEnergy h k σ +
      S.firstEnergy (fun e => h e • axisC) σ * S.firstEnergy (fun e => k e • axisC) σ) := by
  unfold secondAxisEnergy firstEnergy
  fun_prop

def secondObservable (S : SpinSystem V E) (h k : E → ℝ) : C((V → RP3.Spin), ℝ) :=
  ⟨_, S.continuous_secondPolynomial h k⟩

@[simp] theorem secondObservable_average (S : SpinSystem V E) (h k : E → ℝ) :
    S.averageLinear (S.secondObservable h k) = S.secondAxisResponse h k := rfl

omit [Fintype V] in
theorem secondObservable_add_left (S : SpinSystem V E) (u v w : E → ℝ) :
    S.secondObservable (u+v) w = S.secondObservable u w + S.secondObservable v w := by
  ext σ
  have hs : (fun e => (u+v) e • axisC) =
      (fun e => u e • axisC) + (fun e => v e • axisC) := by
    funext e
    exact add_smul (u e) (v e) axisC
  simp only [secondObservable, ContinuousMap.coe_mk, ContinuousMap.add_apply,
    secondAxisEnergy_add_left, hs, firstEnergy_add]
  ring

omit [Fintype V] in
theorem secondObservable_symm (S : SpinSystem V E) (u v : E → ℝ) :
    S.secondObservable u v = S.secondObservable v u := by
  ext σ
  simp only [secondObservable, ContinuousMap.coe_mk,
    S.secondAxisEnergy_symm u v, mul_comm]

theorem secondAxisResponse_add_left (S : SpinSystem V E) (u v w : E → ℝ) :
    S.secondAxisResponse (u+v) w = S.secondAxisResponse u w + S.secondAxisResponse v w := by
  have h := congrArg S.averageLinear (S.secondObservable_add_left u v w)
  simpa only [map_add, secondObservable_average] using h

theorem secondAxisResponse_symm (S : SpinSystem V E) (u v : E → ℝ) :
    S.secondAxisResponse u v = S.secondAxisResponse v u :=
  congrArg S.averageLinear (S.secondObservable_symm u v)

theorem secondAxisResponse_add_right (S : SpinSystem V E) (u v w : E → ℝ) :
    S.secondAxisResponse u (v+w) = S.secondAxisResponse u v + S.secondAxisResponse u w := by
  rw [S.secondAxisResponse_symm, S.secondAxisResponse_add_left,
    S.secondAxisResponse_symm v, S.secondAxisResponse_symm w]

omit [Fintype V] [Fintype E] in
def scalarHessianCoefficient (S : SpinSystem V E) (g : SpinOperator 4)
    (σ : V → RP3.Spin) (e : E) : ℝ :=
  2 * S.strength e *
    (⟪(σ (S.left e)).val, g (σ (S.right e)).val⟫_ℝ ^ 2 +
      ⟪(σ (S.left e)).val, (σ (S.right e)).val⟫_ℝ *
        ⟪(σ (S.left e)).val, (g ^ 2) (σ (S.right e)).val⟫_ℝ)

/-- Complex-linear combination of the second-derivative coefficients. -/
def complexHessian (S : SpinSystem V E) (g : SpinOperator 4)
    (h : E → ℂ) (σ : V → RP3.Spin) : ℂ :=
  MixedAlgebra.weighted (fun e => (S.scalarHessianCoefficient g σ e : ℂ)) h

omit [Fintype V] in
@[fun_prop] theorem continuous_complexHessian (S : SpinSystem V E)
    (g : SpinOperator 4) (h : E → ℂ) : Continuous (S.complexHessian g h) := by
  unfold complexHessian MixedAlgebra.weighted scalarHessianCoefficient
  fun_prop

omit [Fintype V] in
theorem complexCurrent_ofReal (S : SpinSystem V E) (g : SpinOperator 4)
    (h : E → ℝ) (σ : V → RP3.Spin) :
    S.complexCurrent g (fun e => (h e : ℂ)) σ =
      (S.firstEnergy (fun e => h e • g) σ : ℂ) := by
  apply Complex.ext
  · rfl
  · simp [complexCurrent, firstEnergy]

omit [Fintype V] in
theorem complexHessian_ofReal_mul (S : SpinSystem V E) (h k : E → ℝ)
    (σ : V → RP3.Spin) :
    S.complexHessian axisC (fun e => ((h e*k e : ℝ) : ℂ)) σ =
      (S.secondAxisEnergy h k σ : ℂ) := by
  simp only [complexHessian, MixedAlgebra.weighted, scalarHessianCoefficient,
    secondAxisEnergy, ← Complex.ofReal_mul, ← Complex.ofReal_sum]
  congr 1
  apply Finset.sum_congr rfl
  intro e _
  ring

omit [Fintype V] in
@[simp] theorem complexHessian_add (S : SpinSystem V E) (g : SpinOperator 4)
    (u v : E → ℂ) (σ : V → RP3.Spin) :
    S.complexHessian g (u+v) σ = S.complexHessian g u σ + S.complexHessian g v σ :=
  MixedAlgebra.weighted_add _ u v

omit [Fintype V] in
@[simp] theorem complexHessian_smul (S : SpinSystem V E) (g : SpinOperator 4)
    (u : E → ℂ) (r : ℂ) (σ : V → RP3.Spin) :
    S.complexHessian g (r • u) σ = r * S.complexHessian g u σ :=
  MixedAlgebra.weighted_smul _ u r

omit [Fintype V] in
@[fun_prop] theorem continuous_complexSecondPolynomial (S : SpinSystem V E)
    (u v : E → ℂ) : Continuous (fun σ => S.complexHessian axisC (u*v) σ +
      S.complexCurrent axisC u σ * S.complexCurrent axisC v σ) :=
  (S.continuous_complexHessian _ _).add
    ((S.continuous_complexCurrent _ _).mul (S.continuous_complexCurrent _ _))

def complexSecondObservable (S : SpinSystem V E) (u v : E → ℂ) : C((V → RP3.Spin), ℂ) :=
  ⟨_, S.continuous_complexSecondPolynomial u v⟩

def complexSecondResponse (S : SpinSystem V E) (u v : E → ℂ) : ℂ :=
  S.averageComplexLinear (S.complexSecondObservable u v)

theorem complexSecondResponse_ofReal (S : SpinSystem V E) (u v : E → ℝ) :
    S.complexSecondResponse (fun e => (u e : ℂ)) (fun e => (v e : ℂ)) =
      (S.secondAxisResponse u v : ℂ) := by
  have hp : S.complexSecondObservable (fun e => (u e : ℂ)) (fun e => (v e : ℂ)) =
      ofRealObservable (S.secondObservable u v) := by
    ext σ
    change S.complexHessian axisC ((fun e => (u e : ℂ)) * (fun e => (v e : ℂ))) σ +
      S.complexCurrent axisC (fun e => (u e : ℂ)) σ *
        S.complexCurrent axisC (fun e => (v e : ℂ)) σ = _
    rw [show ((fun e => (u e : ℂ)) * (fun e => (v e : ℂ))) =
      (fun e => ((u e*v e : ℝ) : ℂ)) from by ext; simp]
    simp only [complexHessian_ofReal_mul, complexCurrent_ofReal,
      ← Complex.ofReal_add, ← Complex.ofReal_mul]
    rfl
  unfold complexSecondResponse
  rw [hp, S.averageComplex_ofReal, S.secondObservable_average]

theorem complexSecondResponse_add_left (S : SpinSystem V E) (u v w : E → ℂ) :
    S.complexSecondResponse (u+v) w = S.complexSecondResponse u w + S.complexSecondResponse v w := by
  have hp : S.complexSecondObservable (u+v) w =
      S.complexSecondObservable u w + S.complexSecondObservable v w := by
    ext σ
    change S.complexHessian axisC ((u+v)*w) σ +
      S.complexCurrent axisC (u+v) σ * S.complexCurrent axisC w σ =
      (S.complexHessian axisC (u*w) σ +
        S.complexCurrent axisC u σ * S.complexCurrent axisC w σ) +
      (S.complexHessian axisC (v*w) σ +
        S.complexCurrent axisC v σ * S.complexCurrent axisC w σ)
    rw [add_mul, complexHessian_add, complexCurrent_add]
    ring
  unfold complexSecondResponse
  rw [hp, map_add]

theorem complexSecondResponse_symm (S : SpinSystem V E) (u v : E → ℂ) :
    S.complexSecondResponse u v = S.complexSecondResponse v u := by
  have hp : S.complexSecondObservable u v = S.complexSecondObservable v u := by
    ext σ
    change S.complexHessian axisC (u*v) σ +
      S.complexCurrent axisC u σ * S.complexCurrent axisC v σ =
      S.complexHessian axisC (v*u) σ +
        S.complexCurrent axisC v σ * S.complexCurrent axisC u σ
    rw [mul_comm u v, mul_comm (S.complexCurrent axisC u σ)]
  exact congrArg S.averageComplexLinear hp

theorem complexSecondResponse_add_right (S : SpinSystem V E) (u v w : E → ℂ) :
    S.complexSecondResponse u (v+w) = S.complexSecondResponse u v + S.complexSecondResponse u w := by
  rw [S.complexSecondResponse_symm, S.complexSecondResponse_add_left,
    S.complexSecondResponse_symm v, S.complexSecondResponse_symm w]

theorem complexSecondResponse_smul_left (S : SpinSystem V E) (u v : E → ℂ) (r : ℂ) :
    S.complexSecondResponse (r • u) v = r * S.complexSecondResponse u v := by
  have hp : S.complexSecondObservable (r • u) v = r • S.complexSecondObservable u v := by
    ext σ
    change S.complexHessian axisC ((r • u)*v) σ +
      S.complexCurrent axisC (r • u) σ * S.complexCurrent axisC v σ =
      r * (S.complexHessian axisC (u*v) σ +
        S.complexCurrent axisC u σ * S.complexCurrent axisC v σ)
    rw [smul_mul_assoc, complexHessian_smul, complexCurrent_smul]
    ring
  unfold complexSecondResponse
  rw [hp, map_smul, smul_eq_mul]

theorem complexSecondResponse_smul_right (S : SpinSystem V E) (u v : E → ℂ) (r : ℂ) :
    S.complexSecondResponse u (r • v) = r * S.complexSecondResponse u v := by
  rw [S.complexSecondResponse_symm, S.complexSecondResponse_smul_left,
    S.complexSecondResponse_symm v]

omit [Fintype V] [Fintype E] in
def complexCross (S : SpinSystem V E) (f g : V → ℂ) : E → ℂ :=
  fun e => f (S.left e)*g (S.right e) - g (S.left e)*f (S.right e)

omit [Fintype V] [Fintype E] in
theorem complexCross_ofReal (S : SpinSystem V E) (f g : V → ℝ) :
    S.complexCross (fun x => (f x : ℂ)) (fun x => (g x : ℂ)) =
      fun e => (S.crossForm f g e : ℂ) := by
  ext e
  simp [complexCross, crossForm]

omit [Fintype V] [Fintype E] in
theorem edgeGradient_ofReal (S : SpinSystem V E) (f : V → ℝ) :
    S.edgeGradient (fun x => (f x : ℂ)) = fun e => (S.edgeGradient (𝕜 := ℝ) f e : ℂ) := by
  ext e
  simp [edgeGradient]

omit [Fintype V] [Fintype E] in
theorem complexCross_add_left (S : SpinSystem V E) (f g h : V → ℂ) :
    S.complexCross (f+h) g = S.complexCross f g + S.complexCross h g := by
  ext e
  simp only [complexCross, Pi.add_apply]
  ring

omit [Fintype V] [Fintype E] in
theorem complexCross_smul_left (S : SpinSystem V E) (f g : V → ℂ) (r : ℂ) :
    S.complexCross (r • f) g = r • S.complexCross f g := by
  ext e
  simp only [complexCross, Pi.smul_apply, smul_eq_mul]
  ring

omit [Fintype V] [Fintype E] in
theorem complexCross_add_right (S : SpinSystem V E) (f g h : V → ℂ) :
    S.complexCross f (g+h) = S.complexCross f g + S.complexCross f h := by
  ext e
  simp only [complexCross, Pi.add_apply]
  ring

omit [Fintype V] [Fintype E] in
theorem complexCross_smul_right (S : SpinSystem V E) (f g : V → ℂ) (r : ℂ) :
    S.complexCross f (r • g) = r • S.complexCross f g := by
  ext e
  simp only [complexCross, Pi.smul_apply, smul_eq_mul]
  ring

omit [Fintype V] [Fintype E] in
theorem complexDifferential_add (S : SpinSystem V E) (f g : V → ℂ) :
    S.edgeGradient (f+g) = S.edgeGradient f + S.edgeGradient g := by
  ext e
  simp only [edgeGradient, Pi.add_apply]
  ring

omit [Fintype V] [Fintype E] in
theorem complexDifferential_smul (S : SpinSystem V E) (f : V → ℂ) (r : ℂ) :
    S.edgeGradient (r • f) = r • S.edgeGradient f := by
  ext e
  simp only [edgeGradient, Pi.smul_apply, smul_eq_mul]
  ring


end SpinSystem
end
end RP3.Quadratic
end StandalonePart33

/- ===== RP3/QuadraticSecondGauge.lean ===== -/
section StandalonePart34

/-!
# Gauge invariance of the RP³ second response

Adapted from OpenAI ClassicalON/SecondGauge.lean at commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a (Apache-2.0, copyright OpenAI).
The partition function and all derivatives are those of the squared RP³ interaction.
-/

namespace RP3.Quadratic

universe uE uV

noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace ComplexConjugate

namespace SpinSystem
variable {V : Type uV} {E : Type uE} [Fintype V] [Fintype E]

theorem secondAxisResponse_integral (S : SpinSystem V E) (u : E → ℝ) :
    S.secondAxisResponse u u =
      (∫ σ, S.secondWeight (fun e => u e • axisC) 0 σ ∂S.reference) / S.Z (fun _ => 1) := by
  unfold secondAxisResponse average
  congr 1
  apply integral_congr_ae (Filter.Eventually.of_forall _)
  intro σ
  have hE : S.secondEnergy (fun e => u e • axisC) σ = S.secondAxisEnergy u u σ := by
    unfold secondEnergy secondAxisEnergy
    apply Finset.sum_congr rfl
    intro e _
    have hp : (u e • axisC)^2 = (u e*u e) • axisC^2 := by
      rw [pow_two, pow_two, Algebra.smul_mul_assoc (u e) axisC (u e • axisC),
        Algebra.mul_smul_comm (u e) axisC axisC, smul_smul]
    rw [hp]
    simp only [smul_apply, real_inner_smul_right]
    ring
  have hz (e : E) : (0 : ℝ) • (u e • axisC) = 0 := zero_smul ℝ (u e • axisC)
  simp only [secondWeight, S.twistEnergy_zero, hz, NormedSpace.exp_zero,
    S.twistEnergy_one_at_zero, S.twistEnergy_two_at_zero, hE, pow_two]
  ring

theorem Z_axis_add_gradient (S : SpinSystem V E) (u : E → ℝ) (f : V → ℝ)
    (hP : ∀ x s, S.pin x = some s → f x = 0) (t : ℝ) :
    S.Z (fun e => NormedSpace.exp (t • ((u+S.edgeGradient f) e • axisC))) =
      S.Z (fun e => NormedSpace.exp (t • (u e • axisC))) := by
  have hp (x) (s) (hs : S.pin x = some s) : t*f x = 0 := by rw [hP x s hs, mul_zero]
  have h := S.W_add_gradient axisC axisC_skew (fun e => t*u e) (fun x => t*f x) hp
  unfold W at h
  have ha : (fun e => (t*u e + t*f (S.right e) - t*f (S.left e)) • axisC) =
      (fun e => t • ((u+S.edgeGradient f) e • axisC)) := by
    funext e
    simp only [Pi.add_apply, edgeGradient, smul_smul]
    congr 1
    ring
  rw [ha] at h
  simpa only [← smul_smul] using (div_left_inj' (S.Z_pos _).ne').mp h

theorem secondAxisResponse_gradient_diag (S : SpinSystem V E) (u : E → ℝ)
    (f : V → ℝ) (hP : ∀ x s, S.pin x = some s → f x = 0) :
    S.secondAxisResponse (u+S.edgeGradient f) (u+S.edgeGradient f) =
      S.secondAxisResponse u u := by
  let A : E → SpinOperator 4 := fun e => (u+S.edgeGradient f) e • axisC
  let B : E → SpinOperator 4 := fun e => u e • axisC
  have hZ : (fun t => S.Z (fun e => NormedSpace.exp (t • A e))) =
      (fun t => S.Z (fun e => NormedSpace.exp (t • B e))) :=
    funext (S.Z_axis_add_gradient u f hP)
  have hfirst : (fun t => ∫ σ, S.firstWeight A t σ ∂S.reference) =
      (fun t => ∫ σ, S.firstWeight B t σ ∂S.reference) := by
    funext t
    have h := S.hasDerivAt_twistZ A t
    rw [hZ] at h
    exact h.unique (S.hasDerivAt_twistZ B t)
  have hsecond : (∫ σ, S.secondWeight A 0 σ ∂S.reference) =
      (∫ σ, S.secondWeight B 0 σ ∂S.reference) := by
    have h := S.hasDerivAt_firstVariation A 0
    rw [hfirst] at h
    exact h.unique (S.hasDerivAt_firstVariation B 0)
  rw [S.secondAxisResponse_integral, S.secondAxisResponse_integral]
  exact congrArg (fun q => q / S.Z (fun _ => 1)) hsecond

theorem secondAxisResponse_gradient_right (S : SpinSystem V E) (u : E → ℝ)
    (f : V → ℝ) (hP : ∀ x s, S.pin x = some s → f x = 0) :
    S.secondAxisResponse u (S.edgeGradient f) = 0 := by
  have h := S.secondAxisResponse_gradient_diag u f hP
  have hz := S.secondAxisResponse_gradient_diag 0 f hP
  have he (v : E → ℝ) : S.secondAxisResponse 0 v = 0 := by
    unfold secondAxisResponse
    have h0 : (fun σ => S.secondAxisEnergy 0 v σ +
        S.firstEnergy (fun e => (0 : E → ℝ) e • axisC) σ *
          S.firstEnergy (fun e => v e • axisC) σ) = (fun _ => 0) := by
      funext σ
      simp [secondAxisEnergy, firstEnergy]
    rw [h0, S.average_const]
  simp only [zero_add, he] at hz
  rw [S.secondAxisResponse_add_left, S.secondAxisResponse_add_right,
    S.secondAxisResponse_add_right, S.secondAxisResponse_symm (S.edgeGradient f), hz] at h
  linarith

omit [Fintype V] [Fintype E] in
theorem edgeGradient_add_complex (S : SpinSystem V E) (f g : V → ℂ) :
    S.edgeGradient (f+g) = S.edgeGradient f + S.edgeGradient g := by
  ext e
  simp only [edgeGradient, Pi.add_apply]
  ring

omit [Fintype V] [Fintype E] in
theorem edgeGradient_smul_complex (S : SpinSystem V E) (r : ℂ) (f : V → ℂ) :
    S.edgeGradient (r • f) = r • S.edgeGradient f := by
  ext e
  simp only [edgeGradient, Pi.smul_apply, smul_eq_mul, mul_sub]

theorem complexSecondResponse_gradient_right (S : SpinSystem V E) (u : E → ℂ)
    (f : V → ℂ) (hP : ∀ x s, S.pin x = some s → f x = 0) :
    S.complexSecondResponse u (S.edgeGradient f) = 0 := by
  apply complex_linear_zero_of_real (fun _ : E => False)
    (fun u => S.complexSecondResponse u (S.edgeGradient f))
    (fun u v => S.complexSecondResponse_add_left u v _)
    (fun r u => S.complexSecondResponse_smul_left u _ r) ?_ u (fun _ h => h.elim)
  intro a _
  apply complex_linear_zero_of_real (fun x => ∃ s, S.pin x = some s)
    (fun f => S.complexSecondResponse (fun e => (a e : ℂ)) (S.edgeGradient f)) ?_ ?_ ?_ f ?_
  · intro f g
    rw [S.edgeGradient_add_complex, S.complexSecondResponse_add_right]
  · intro r f
    rw [S.edgeGradient_smul_complex, S.complexSecondResponse_smul_right]
  · intro b hb
    rw [S.edgeGradient_ofReal, S.complexSecondResponse_ofReal,
      S.secondAxisResponse_gradient_right a b (fun x s hs => hb x ⟨s,hs⟩),
      Complex.ofReal_zero]
  · intro x hx
    obtain ⟨s, hs⟩ := hx
    exact hP x s hs

theorem complexSecondResponse_add_gradient_right (S : SpinSystem V E) (u v : E → ℂ)
    (f : V → ℂ) (hP : ∀ x s, S.pin x = some s → f x = 0) :
    S.complexSecondResponse u (v+S.edgeGradient f) = S.complexSecondResponse u v := by
  rw [S.complexSecondResponse_add_right, S.complexSecondResponse_gradient_right u f hP, add_zero]

theorem complexSecondResponse_add_gradients (S : SpinSystem V E) (u v : E → ℂ)
    (f g : V → ℂ) (hP : ∀ x s, S.pin x = some s → f x = 0)
    (hQ : ∀ x s, S.pin x = some s → g x = 0) :
    S.complexSecondResponse (u+S.edgeGradient f) (v+S.edgeGradient g) =
      S.complexSecondResponse u v := by
  rw [S.complexSecondResponse_add_gradient_right _ v g hQ,
    S.complexSecondResponse_symm, S.complexSecondResponse_add_gradient_right _ u f hP,
    S.complexSecondResponse_symm]

end SpinSystem

end

end RP3.Quadratic
end StandalonePart34

/- ===== RP3/QuaternionPaths.lean ===== -/
section StandalonePart35

/-! Quaternion half-generators satisfy [a,b]=c and have period 4π on S³. -/
namespace RP3.Rotation
noncomputable section
open scoped Real

theorem axis_smul_mul (r : ℝ) (A B : SpinOperator 4) :
    (r • A) * B = r • (A * B) := Algebra.smul_mul_assoc r A B
theorem axis_mul_smul (r : ℝ) (A B : SpinOperator 4) :
    A * (r • B) = r • (A * B) := Algebra.mul_smul_comm r A B

def axisPolynomialFor (X : SpinOperator 4) (t : ℝ) : SpinOperator 4 :=
  (Real.cos (t/2)) • 1 + (2*Real.sin (t/2)) • X

theorem axisPolynomialFor_derivative (X : SpinOperator 4)
    (hX : X^2 = (-1/4 : ℝ) • 1) (t : ℝ) :
    HasDerivAt (axisPolynomialFor X) (axisPolynomialFor X t * X) t := by
  have hc := (Real.hasDerivAt_cos (t/2)).comp t ((hasDerivAt_id t).div_const 2)
  have hs := (Real.hasDerivAt_sin (t/2)).comp t ((hasDerivAt_id t).div_const 2)
  apply ((hc.smul_const (1 : SpinOperator 4)).add ((hs.const_mul 2).smul_const X)).congr_deriv
  simp only [axisPolynomialFor, add_mul, axis_smul_mul, one_mul, ← pow_two, hX, smul_smul]
  module

theorem axisPolynomialFor_commute (X : SpinOperator 4) (t : ℝ) :
    Commute (axisPolynomialFor X t) X := by
  change axisPolynomialFor X t * X = X * axisPolynomialFor X t
  simp only [axisPolynomialFor, add_mul, mul_add, one_mul, mul_one,
    axis_smul_mul, axis_mul_smul]

theorem exp_eq_axisPolynomialFor (X : SpinOperator 4)
    (hX : X^2 = (-1/4 : ℝ) • 1) (t : ℝ) :
    NormedSpace.exp (t • X) = axisPolynomialFor X t := by
  let f := fun t : ℝ => NormedSpace.exp (t • (-X)) * axisPolynomialFor X t
  have hd (t : ℝ) : HasDerivAt f 0 t := by
    apply ((hasDerivAt_exp_smul_const (-X) t).mul
      (axisPolynomialFor_derivative X hX t)).congr_deriv
    rw [mul_assoc, neg_mul X (axisPolynomialFor X t), ← (axisPolynomialFor_commute X t).eq]
    simp
  have he : f t = f 0 := is_const_of_deriv_eq_zero (fun t => (hd t).differentiableAt)
    (fun t => (hd t).deriv) t 0
  have h0 : f 0 = 1 := by simp [f, axisPolynomialFor, zero_smul ℝ X]
  rw [h0] at he
  have hm := congrArg (fun Q : SpinOperator 4 => NormedSpace.exp (t • X) * Q) he
  dsimp only [f] at hm
  rw [← mul_assoc, smul_neg,
    ← NormedSpace.exp_add_of_commute (Commute.refl (t • X)).neg_right,
    add_neg_cancel, NormedSpace.exp_zero, mul_one, one_mul] at hm
  exact hm.symm

theorem axisA_square : axisA^2 = (-1/4 : ℝ) • 1 := by
  have hm : axisMatrixA^2 = (-1/4 : ℝ) • (1 : Matrix (Fin 4) (Fin 4) ℝ) := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [axisMatrixA, pow_succ, Matrix.mul_apply, Fin.sum_univ_succ]
  rw [axisA, ← map_pow, hm, map_smul, map_one]
theorem axisB_square : axisB^2 = (-1/4 : ℝ) • 1 := by
  have hm : axisMatrixB^2 = (-1/4 : ℝ) • (1 : Matrix (Fin 4) (Fin 4) ℝ) := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [axisMatrixB, pow_succ, Matrix.mul_apply, Fin.sum_univ_succ]
  rw [axisB, ← map_pow, hm, map_smul, map_one]
theorem axisC_square : axisC^2 = (-1/4 : ℝ) • 1 := by
  have hm : axisMatrixC^2 = (-1/4 : ℝ) • (1 : Matrix (Fin 4) (Fin 4) ℝ) := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [axisMatrixC, pow_succ, Matrix.mul_apply, Fin.sum_univ_succ]
  rw [axisC, ← map_pow, hm, map_smul, map_one]

theorem exp_axisA (t : ℝ) : NormedSpace.exp (t • axisA) = axisPolynomialFor axisA t :=
  exp_eq_axisPolynomialFor axisA axisA_square t
theorem exp_axisB (t : ℝ) : NormedSpace.exp (t • axisB) = axisPolynomialFor axisB t :=
  exp_eq_axisPolynomialFor axisB axisB_square t
theorem exp_axisC (t : ℝ) : NormedSpace.exp (t • axisC) = axisPolynomialFor axisC t :=
  exp_eq_axisPolynomialFor axisC axisC_square t

theorem exp_axis_periodic (X : SpinOperator 4) (hX : X^2 = (-1/4 : ℝ) • 1) :
    Function.Periodic (fun t : ℝ => NormedSpace.exp (t • X)) (4 * Real.pi) := by
  intro t
  have ht : (t+4*Real.pi)/2 = t/2+2*Real.pi := by ring
  simp [exp_eq_axisPolynomialFor X hX, axisPolynomialFor, ht,
    Real.sin_add_two_pi, Real.cos_add_two_pi]
theorem exp_axisC_periodic :
    Function.Periodic (fun t : ℝ => NormedSpace.exp (t • axisC)) (4 * Real.pi) :=
  exp_axis_periodic axisC axisC_square

def coordinateAxis (a : Fin 3) : SpinOperator 4 := ![axisA, axisB, axisC] a
theorem coordinateAxis_skew (a : Fin 3) : coordinateAxis a ∈ skewAdjoint (SpinOperator 4) := by
  fin_cases a
  · exact axisA_skew
  · exact axisB_skew
  · exact axisC_skew
theorem coordinateAxis_square (a : Fin 3) : (coordinateAxis a)^2 = (-1/4 : ℝ) • 1 := by
  fin_cases a
  · exact axisA_square
  · exact axisB_square
  · exact axisC_square
theorem coordinateAxis_norm_le (a : Fin 3) : ‖coordinateAxis a‖ ≤ 1 := by
  fin_cases a
  · exact axisA_norm_le
  · exact axisB_norm_le
  · exact axisC_norm_le

def coordinateRotation (a : Fin 3) (t : ℝ) : E4 ≃ₗᵢ[ℝ] E4 :=
  rotationExp (t • coordinateAxis a) (skewAdjoint.smul_mem t (coordinateAxis_skew a))
@[simp] theorem coordinateRotation_apply (a : Fin 3) (t : ℝ) (u : E4) :
    coordinateRotation a t u = NormedSpace.exp (t • coordinateAxis a) u := rfl
@[simp] theorem coordinateRotation_zero (a : Fin 3) (u : E4) :
    coordinateRotation a 0 u = u := by
  rw [coordinateRotation_apply, zero_smul ℝ (coordinateAxis a), NormedSpace.exp_zero]
  rfl

def conjugatorCoordinates (a : Fin 3) (u : Fin 4 → ℝ) : Fin 4 → ℝ :=
  ![![u 0,u 2,u 3,u 1], ![u 0,u 3,u 1,u 2], ![u 0,u 1,u 2,u 3]] a
def conjugatorInverse (a : Fin 3) : Fin 3 := ![1,0,2] a
def conjugatorLinear (a : Fin 3) : E4 →ₗ[ℝ] E4 where
  toFun u := WithLp.toLp 2 (conjugatorCoordinates a u)
  map_add' u v := by ext i; fin_cases a <;> fin_cases i <;> simp [conjugatorCoordinates]
  map_smul' r u := by ext i; fin_cases a <;> fin_cases i <;> simp [conjugatorCoordinates]
def axisConjugator (a : Fin 3) : E4 ≃ₗᵢ[ℝ] E4 where
  toLinearEquiv := {
    conjugatorLinear a with
    invFun := conjugatorLinear (conjugatorInverse a)
    left_inv := by
      intro u
      ext i
      fin_cases a <;> fin_cases i <;> simp [conjugatorLinear, conjugatorCoordinates, conjugatorInverse]
    right_inv := by
      intro u
      ext i
      fin_cases a <;> fin_cases i <;> simp [conjugatorLinear, conjugatorCoordinates, conjugatorInverse] }
  norm_map' := by
    intro u
    change ‖conjugatorLinear a u‖ = ‖u‖
    have hs : ‖conjugatorLinear a u‖^2 = ‖u‖^2 := by
      rw [EuclideanSpace.real_norm_sq_eq, EuclideanSpace.real_norm_sq_eq]
      fin_cases a <;> simp [conjugatorLinear, conjugatorCoordinates, Fin.sum_univ_succ] <;> ring
    nlinarith [norm_nonneg (conjugatorLinear a u), norm_nonneg u]

theorem coordinateRotation_intertwine_axisC (a : Fin 3) (t : ℝ) (u : E4) :
    axisConjugator a (coordinateRotation a t u) =
      coordinateRotation 2 t (axisConjugator a u) := by
  fin_cases a <;> ext i <;> fin_cases i <;>
    simp [axisConjugator, conjugatorLinear, conjugatorCoordinates,
      coordinateRotation_apply, coordinateAxis, exp_axisA, exp_axisB, exp_axisC,
      axisPolynomialFor, axisA_apply, axisB_apply, axisC_apply] <;> ring
theorem spinRotation_intertwine_axisC (a : Fin 3) (t : ℝ) (s : RP3.Spin) :
    spinRotation (axisConjugator a) (spinRotation (coordinateRotation a t) s) =
      spinRotation (coordinateRotation 2 t) (spinRotation (axisConjugator a) s) :=
  Subtype.ext (coordinateRotation_intertwine_axisC a t s.val)

def quaternionPathAxis (g : Quaternion) (_ : Fin 3) : Fin 3 :=
  ![2,0,1,2,2,0,1,2] g.index
def quaternionPathAngle (g : Quaternion) (k : Fin 3) : ℝ :=
  if k = 0 then ![0,Real.pi,Real.pi,Real.pi,2*Real.pi,-Real.pi,-Real.pi,-Real.pi] g.index else 0

set_option maxHeartbeats 800000 in
theorem quaternionLinearIsometry_eq_three_rotations (g : Quaternion) (u : E4) :
    quaternionLinearIsometry g u =
      coordinateRotation (quaternionPathAxis g 0) (quaternionPathAngle g 0)
        (coordinateRotation (quaternionPathAxis g 1) (quaternionPathAngle g 1)
          (coordinateRotation (quaternionPathAxis g 2) (quaternionPathAngle g 2) u)) := by
  have hn : Real.pi*(-1/2) = -(Real.pi/2) := by ring
  have hc : Real.cos (Real.pi*(-1/2)) = 0 := by rw [hn, Real.cos_neg, Real.cos_pi_div_two]
  have hs : Real.sin (Real.pi*(-1/2)) = -1 := by rw [hn, Real.sin_neg, Real.sin_pi_div_two]
  rcases g with ⟨g⟩
  fin_cases g <;> ext i <;> fin_cases i <;>
    norm_num [quaternionLinearIsometry, quaternionLinear, quaternionRotate,
      quaternionPathAxis, quaternionPathAngle, coordinateRotation_apply, coordinateAxis,
      exp_axisA, exp_axisB, exp_axisC, axisPolynomialFor,
      axisA_apply, axisB_apply, axisC_apply, hc, hs, neg_div] <;> ring

end
end RP3.Rotation
end StandalonePart35

/- ===== RP3/QuadraticPotential.lean ===== -/
section StandalonePart36

/-! Gauge shifts and boundary rotation paths for the actual squared RP³ interaction.
Adapted from OpenAI ClassicalON/PotentialRotation.lean and PeriodicPartition.lean
at adc7f1241b42e322a6451854ab7e4b4c146bf78a (Apache-2.0). -/

namespace RP3

universe uE uV

noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
namespace Quadratic
namespace SpinSystem
variable {V : Type uV} {E : Type uE} [Fintype V] [Fintype E]

def potentialRotation (f : V → ℝ) (t : ℝ) (x : V) :
    EuclideanSpace ℝ (Fin 4) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin 4) :=
  rotationExp ((t*f x) • axisC) (skewAdjoint.smul_mem _ axisC_skew)

def rotatePotential (S : SpinSystem V E) (f : V → ℝ) (t : ℝ) : SpinSystem V E :=
  S.rotatePins (potentialRotation f t)

def potentialOperators (S : SpinSystem V E) (f : V → ℝ) : E → SpinOperator 4 :=
  fun e => S.edgeGradient f e • axisC

omit [Fintype V] [Fintype E] in
theorem gauge_potential_shift (S : SpinSystem V E) (f : V → ℝ) (t u : ℝ) :
    S.gauge (fun e => NormedSpace.exp (u • S.potentialOperators f e)) (potentialRotation f t) =
      (fun e => NormedSpace.exp ((t+u) • S.potentialOperators f e)) := by
  funext e
  apply ContinuousLinearMap.ext
  intro v
  change (potentialRotation f t (S.left e)).symm
    (NormedSpace.exp (u • S.potentialOperators f e) (potentialRotation f t (S.right e) v)) = _
  simp only [potentialRotation,rotationExp_symm_apply,rotationExp_apply,potentialOperators,
    smul_smul,← neg_smul (t*f (S.left e)) axisC]
  rw [← mul_apply_eq_comp,← mul_apply_eq_comp,← exp_smul_add,← exp_smul_add]
  apply congrArg (fun r : ℝ => NormedSpace.exp (r • axisC) v)
  simp only [edgeGradient]
  ring

theorem potential_shift_Z (S : SpinSystem V E) (f : V → ℝ) (t u : ℝ) :
    S.Z (fun e => NormedSpace.exp ((t+u) • S.potentialOperators f e)) =
      (S.rotatePotential f t).Z (fun e => NormedSpace.exp (u • S.potentialOperators f e)) := by
  rw [← S.gauge_potential_shift]
  exact S.Z_gauge _ _

theorem potential_shift_first (S : SpinSystem V E) (f : V → ℝ) (t u : ℝ) :
    (∫ σ, S.firstWeight (S.potentialOperators f) (t+u) σ ∂S.reference) =
      ∫ σ, (S.rotatePotential f t).firstWeight (S.potentialOperators f) u σ ∂(S.rotatePotential f t).reference := by
  have h := (S.hasDerivAt_twistZ (S.potentialOperators f) (t+u)).comp u
    ((hasDerivAt_id u).const_add t)
  simp only [mul_one] at h
  have he : (fun v => S.Z (fun e => NormedSpace.exp ((t+v) • S.potentialOperators f e))) =
      (fun v => (S.rotatePotential f t).Z (fun e => NormedSpace.exp (v • S.potentialOperators f e))) :=
    funext fun v => S.potential_shift_Z f t v
  change HasDerivAt (fun v => S.Z (fun e => NormedSpace.exp ((t+v) • S.potentialOperators f e))) _ u at h
  rw [he] at h
  exact h.unique ((S.rotatePotential f t).hasDerivAt_twistZ (S.potentialOperators f) u)

theorem potential_shift_second (S : SpinSystem V E) (f : V → ℝ) (t u : ℝ) :
    (∫ σ, S.secondWeight (S.potentialOperators f) (t+u) σ ∂S.reference) =
      ∫ σ, (S.rotatePotential f t).secondWeight (S.potentialOperators f) u σ ∂(S.rotatePotential f t).reference := by
  have h := (S.hasDerivAt_firstVariation (S.potentialOperators f) (t+u)).comp u
    ((hasDerivAt_id u).const_add t)
  simp only [mul_one] at h
  have he : (fun v => ∫ σ, S.firstWeight (S.potentialOperators f) (t+v) σ ∂S.reference) =
      (fun v => ∫ σ, (S.rotatePotential f t).firstWeight (S.potentialOperators f) v σ ∂(S.rotatePotential f t).reference) :=
    funext fun v => S.potential_shift_first f t v
  change HasDerivAt (fun v => ∫ σ, S.firstWeight (S.potentialOperators f) (t+v) σ ∂S.reference) _ u at h
  rw [he] at h
  exact h.unique ((S.rotatePotential f t).hasDerivAt_firstVariation (S.potentialOperators f) u)

theorem potential_second_response (S : SpinSystem V E) (f : V → ℝ) (t : ℝ) :
    (∫ σ, S.secondWeight (S.potentialOperators f) t σ ∂S.reference) /
      S.Z (fun e => NormedSpace.exp (t • S.potentialOperators f e)) =
      (S.rotatePotential f t).secondAxisResponse (S.edgeGradient f) (S.edgeGradient f) := by
  have hZ := S.potential_shift_Z f t 0
  have h2 := S.potential_shift_second f t 0
  simp only [add_zero,zero_smul ℝ (S.potentialOperators f _),NormedSpace.exp_zero] at hZ
  simp only [add_zero] at h2
  rw [hZ,h2,(S.rotatePotential f t).secondAxisResponse_integral]
  rfl

omit [Fintype V] [Fintype E] in
theorem spinRotation_potential_periodic (f : V → ℝ) (x : V)
    (h : f x=0 ∨ f x=1) (s : RP3.Spin) (t : ℝ) :
    spinRotation (potentialRotation f (t+4*Real.pi) x) s =
      spinRotation (potentialRotation f t x) s := by
  apply Subtype.ext
  simp only [spinRotation_val,potentialRotation,rotationExp_apply]
  rcases h with h | h
  · simp only [h,mul_zero]
  · simp only [h,mul_one,exp_axisC_periodic t]

omit [Fintype V] [Fintype E] in
theorem rotatePotential_periodic (S : SpinSystem V E) (f : V → ℝ)
    (hP : ∀ x s, S.pin x=some s → f x=0 ∨ f x=1) :
    Function.Periodic (S.rotatePotential f) (4*Real.pi) := by
  intro t
  have hpin : (S.rotatePotential f (t+4*Real.pi)).pin = (S.rotatePotential f t).pin := by
    funext x
    apply Option.map_congr
    intro s hs
    exact spinRotation_potential_periodic f x (hP x s hs) s t
  exact congrArg (fun p => SpinSystem.mk S.left S.right S.strength p) hpin

theorem potential_partition_ratio (S : SpinSystem V E) (f : V → ℝ) (δ : ℝ) (hδ : 0 ≤ δ)
    (hP : ∀ x s, S.pin x=some s → f x=0 ∨ f x=1)
    (hR : ∀ t, -(S.rotatePotential f t).secondAxisResponse (S.edgeGradient f) (S.edgeGradient f) ≤ δ)
    (x y : ℝ) :
    1-δ*(4*Real.pi)^2/2 ≤ (S.rotatePotential f x).Z (fun _ => 1) /
      (S.rotatePotential f y).Z (fun _ => 1) := by
  let A := S.potentialOperators f
  let F := fun t : ℝ => S.Z (fun e => NormedSpace.exp (t • A e))
  let F' := fun t => ∫ σ, S.firstWeight A t σ ∂S.reference
  let F'' := fun t => ∫ σ, S.secondWeight A t σ ∂S.reference
  have hZ (t : ℝ) : F t=(S.rotatePotential f t).Z (fun _ => 1) := by
    have h := S.potential_shift_Z f t 0
    simpa only [add_zero,zero_smul ℝ (S.potentialOperators f _),NormedSpace.exp_zero] using h
  have hper : Function.Periodic F (4*Real.pi) := by
    intro t
    rw [hZ,hZ,S.rotatePotential_periodic f hP t]
  have hpos (t : ℝ) : 0<F t := S.Z_pos _
  have hode (t : ℝ) : -(δ*F t) ≤ F'' t := by
    have hr := hR t
    rw [← S.potential_second_response] at hr
    change -(F'' t/F t) ≤ δ at hr
    rw [← neg_div,div_le_iff₀ (hpos t)] at hr
    linarith
  have h := RP3.periodic_ode_ratio F F' F'' (4*Real.pi) δ (by positivity) hδ
    hper hpos (S.hasDerivAt_twistZ A) (S.hasDerivAt_firstVariation A) hode x y
  simpa only [hZ] using h


end SpinSystem
end Quadratic

end

end RP3
end StandalonePart36

/- ===== RP3/QuadraticSecondBound.lean ===== -/
section StandalonePart37
/-!
# Quantitative bounds for the RP³ second response
Adapted from OpenAI ClassicalON/SecondBound.lean at commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a (Apache-2.0, copyright OpenAI).
The coefficient estimate is proved for the quadratic interaction, giving 4β.
-/

namespace RP3.Quadratic

universe uE uV

noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace ComplexConjugate

namespace SpinSystem
variable {V : Type uV} {E : Type uE} [Fintype V] [Fintype E]

omit [Fintype V] [Fintype E] in
theorem abs_scalarHessianCoefficient_le (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β) (g : SpinOperator 4) (hg : ‖g‖ ≤ 1)
    (σ : V → RP3.Spin) (e : E) : |S.scalarHessianCoefficient g σ e| ≤ 4*β := by
  have hu := (abs_inner_operator_le (σ (S.left e)) (σ (S.right e)) g).trans hg
  have hv : |⟪(σ (S.left e)).val, (g^2) (σ (S.right e)).val⟫_ℝ| ≤ 1 :=
    (abs_inner_operator_le _ _ _).trans
      ((norm_pow_le g 2).trans (pow_le_one₀ (norm_nonneg _) hg))
  have hw : |⟪(σ (S.left e)).val, (σ (S.right e)).val⟫_ℝ| ≤ 1 := by
    simpa only [RP3.spin_norm, one_mul] using
      abs_real_inner_le_norm (σ (S.left e)).val (σ (S.right e)).val
  have hu2 : |⟪(σ (S.left e)).val, g (σ (S.right e)).val⟫_ℝ ^ 2| ≤ 1 := by
    rw [abs_pow]
    simpa using pow_le_pow_left₀ (abs_nonneg _) hu 2
  have huv : |⟪(σ (S.left e)).val, (σ (S.right e)).val⟫_ℝ *
      ⟪(σ (S.left e)).val, (g^2) (σ (S.right e)).val⟫_ℝ| ≤ 1 := by
    rw [abs_mul]
    simpa using mul_le_mul hw hv (abs_nonneg _) zero_le_one
  have hs := (abs_add_le _ _).trans (add_le_add hu2 huv)
  norm_num at hs
  unfold scalarHessianCoefficient
  rw [abs_mul, abs_mul, abs_of_nonneg (by norm_num : (0:ℝ) ≤ 2)]
  calc _ ≤ (2*β)*2 :=
      mul_le_mul (mul_le_mul_of_nonneg_left (hb e) (by norm_num)) hs
        (abs_nonneg _) (by have := (abs_nonneg _).trans (hb e); positivity)
    _ = 4*β := by ring

omit [Fintype V] in
theorem complexHessian_normSq_re (S : SpinSystem V E) (M : SpinOperator 4)
    (u : E → ℂ) (σ : V → RP3.Spin) :
    (S.complexHessian M (fun e => u e * conj (u e)) σ).re =
      ∑ e, S.scalarHessianCoefficient M σ e * ‖u e‖^2 := by
  simp [complexHessian, MixedAlgebra.weighted, Complex.mul_conj, Complex.normSq_eq_norm_sq, -Complex.ofReal_pow]

theorem complexSecondResponse_upper (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β) (u : E → ℂ) :
    -(S.complexSecondResponse u (fun e => conj (u e))).re ≤ (4*β)*∑ e, ‖u e‖^2 := by
  unfold complexSecondResponse
  rw [S.averageComplex_re]
  have h (σ : V → RP3.Spin) :
      -((4*β)*∑ e, ‖u e‖^2) ≤
        reObservable (S.complexSecondObservable u (fun e => conj (u e))) σ := by
    change _ ≤ (S.complexHessian axisC (u*(fun e => conj (u e))) σ +
      S.complexCurrent axisC u σ * S.complexCurrent axisC (fun e => conj (u e)) σ).re
    have hcc : S.complexCurrent axisC (fun e => conj (u e)) σ =
        conj (S.complexCurrent axisC u σ) := by
      simpa only [Complex.star_def] using S.complexCurrent_conj axisC u σ
    rw [hcc, Complex.mul_conj, Complex.add_re, Complex.ofReal_re]
    have hc := S.complexHessian_normSq_re axisC u σ
    change (S.complexHessian axisC (u*(fun e => conj (u e))) σ).re = _ at hc
    rw [hc]
    have he : -((4*β)*∑ e, ‖u e‖^2) ≤ ∑ e, S.scalarHessianCoefficient axisC σ e*‖u e‖^2 := by
      rw [Finset.mul_sum, ← Finset.sum_neg_distrib]
      apply Finset.sum_le_sum
      intro e _
      have hb' := (abs_le.mp (S.abs_scalarHessianCoefficient_le β hb axisC axisC_norm_le σ e)).1
      nlinarith [sq_nonneg ‖u e‖]
    exact he.trans (le_add_of_nonneg_right (Complex.normSq_nonneg _))
  have hm := S.averageLinear_mono (ContinuousMap.const _ (-((4*β)*∑ e, ‖u e‖^2)))
    (reObservable (S.complexSecondObservable u (fun e => conj (u e)))) h
  rw [S.averageLinear_const] at hm
  linarith

omit [Fintype V] [Fintype E] in

def commutatorForm (S : SpinSystem V E) (f g : V → ℂ) : E → ℂ :=
  (1/2 : ℂ) • S.complexCross f g

omit [Fintype V] [Fintype E] in
theorem commutatorForm_adjust (S : SpinSystem V E) (f g : V → ℂ) :
    S.commutatorForm f g + S.edgeGradient ((1/2 : ℂ) • (f*g)) =
      fun e => ((f (S.left e)+f (S.right e))/2) * S.edgeGradient g e := by
  ext e
  simp only [commutatorForm, complexCross, edgeGradient, Pi.add_apply, Pi.mul_apply,
    Pi.smul_apply, smul_eq_mul]
  ring

omit [Fintype E] in
theorem commutatorForm_adjust_norm (S : SpinSystem V E) (f g : V → ℂ) (e : E) :
    ‖((f (S.left e)+f (S.right e))/2) * S.edgeGradient g e‖ ≤
      ‖f‖ * ‖S.edgeGradient g e‖ := by
  rw [norm_mul, norm_div]
  apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
  norm_num
  have h := norm_add_le (f (S.left e)) (f (S.right e))
  have hx := norm_le_pi_norm f (S.left e)
  have hy := norm_le_pi_norm f (S.right e)
  linarith

theorem commutatorForm_bound_left (S : SpinSystem V E) (β : ℝ) (hβ : 0 ≤ β)
    (hb : ∀ e, |S.strength e| ≤ β)
    (f g : V → ℂ) (hP : ∀ x s, S.pin x = some s → f x = 0) :
    -(S.complexSecondResponse (S.commutatorForm f g)
      (fun e => conj (S.commutatorForm f g e))).re ≤
        (4*β)*(‖f‖^2*∑ e, ‖S.edgeGradient g e‖^2) := by
  let F : V → ℂ := (1/2 : ℂ) • (f*g)
  have hp (x) (s) (hs : S.pin x = some s) : F x = 0 := by
    simp only [F, Pi.smul_apply, Pi.mul_apply, hP x s hs, zero_mul, smul_zero]
  have hq (x) (s) (hs : S.pin x = some s) : conj (F x) = 0 := by rw [hp x s hs, map_zero]
  have hd : S.edgeGradient (fun x => conj (F x)) = fun e => conj (S.edgeGradient F e) := by
    ext e
    simp only [edgeGradient, map_sub]
  have hid := S.complexSecondResponse_add_gradients (S.commutatorForm f g)
    (fun e => conj (S.commutatorForm f g e)) F (fun x => conj (F x)) hp hq
  rw [hd] at hid
  have hc : ((fun e => conj (S.commutatorForm f g e)) + (fun e => conj (S.edgeGradient F e))) =
      (fun e => conj ((S.commutatorForm f g + S.edgeGradient F) e)) := by
    ext e
    simp only [Pi.add_apply, map_add]
  rw [hc] at hid
  rw [← hid]
  apply (S.complexSecondResponse_upper β hb _).trans
  apply mul_le_mul_of_nonneg_left _ (by positivity : 0 ≤ 4*β)
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro e _
  change ‖(S.commutatorForm f g + S.edgeGradient ((1/2 : ℂ) • (f*g))) e‖^2 ≤ _
  rw [S.commutatorForm_adjust]
  have h := S.commutatorForm_adjust_norm f g e
  exact (pow_le_pow_left₀ (norm_nonneg _) h 2).trans_eq (mul_pow _ _ _)

/-- Simultaneous sign reversal leaves the bilinear response unchanged. -/
theorem complexSecondResponse_neg_neg (S : SpinSystem V E) (u v : E → ℂ) :
    S.complexSecondResponse (-u) (-v) = S.complexSecondResponse u v := by
  calc
    _ = -S.complexSecondResponse u (-v) := by
      simpa using S.complexSecondResponse_smul_left u (-v) (-1 : ℂ)
    _ = S.complexSecondResponse u v := by
      rw [show S.complexSecondResponse u (-v) = -S.complexSecondResponse u v from by
        simpa using S.complexSecondResponse_smul_right u v (-1 : ℂ)]
      exact neg_neg _

omit [Fintype V] [Fintype E] in
theorem commutatorForm_swap (S : SpinSystem V E) (f g : V → ℂ) :
    S.commutatorForm g f = -S.commutatorForm f g := by
  ext e
  simp only [commutatorForm, complexCross, Pi.smul_apply, smul_eq_mul, Pi.neg_apply]
  ring

theorem commutatorForm_bound_right (S : SpinSystem V E) (β : ℝ) (hβ : 0 ≤ β)
    (hb : ∀ e, |S.strength e| ≤ β)
    (f g : V → ℂ) (hQ : ∀ x s, S.pin x = some s → g x = 0) :
    -(S.complexSecondResponse (S.commutatorForm f g)
      (fun e => conj (S.commutatorForm f g e))).re ≤
        (4*β)*(‖g‖^2*∑ e, ‖S.edgeGradient f e‖^2) := by
  have h := S.commutatorForm_bound_left β hβ hb g f hQ
  simp only [S.commutatorForm_swap f g] at h
  have hc : (fun e => conj ((-S.commutatorForm f g) e)) =
      -(fun e => conj (S.commutatorForm f g e)) := by
    ext e
    simp only [Pi.neg_apply, map_neg]
  rw [hc, S.complexSecondResponse_neg_neg] at h
  exact h

/-- Appendix A.4, with the coefficient proved for the squared interaction. -/
theorem commutatorForm_bound (S : SpinSystem V E) (β : ℝ) (hβ : 0 ≤ β)
    (hb : ∀ e, |S.strength e| ≤ β) (f g : V → ℂ)
    (hP : ∀ x s, S.pin x = some s → f x = 0)
    (hQ : ∀ x s, S.pin x = some s → g x = 0) :
    -(S.complexSecondResponse (S.commutatorForm f g)
      (fun e => conj (S.commutatorForm f g e))).re ≤
      (4*β)*min (‖f‖^2*∑ e, ‖S.edgeGradient g e‖^2)
        (‖g‖^2*∑ e, ‖S.edgeGradient f e‖^2) := by
  rcases le_total (‖f‖^2*∑ e, ‖S.edgeGradient g e‖^2)
      (‖g‖^2*∑ e, ‖S.edgeGradient f e‖^2) with h | h
  · rw [min_eq_left h]
    exact S.commutatorForm_bound_left β hβ hb f g hP
  · rw [min_eq_right h]
    exact S.commutatorForm_bound_right β hβ hb f g hQ

end SpinSystem

end

end RP3.Quadratic
end StandalonePart37

/- ===== RP3/Fourier/ModelModes.lean ===== -/
section StandalonePart38

/-! Fourier modes on the actual pinned squared-interaction spin system. -/
namespace RP3
noncomputable section
open scoped BigOperators ComplexConjugate
namespace Quadratic.SpinSystem
variable {V E : Type*} [Fintype V] [Fintype E]

theorem response_imaginary_multiple (S : SpinSystem V E) (u : E → ℝ) (r : ℝ) :
    (S.complexSecondResponse (fun e => -Complex.I*((r*u e:ℝ):ℂ))
      (fun e => conj (-Complex.I*((r*u e:ℝ):ℂ)))).re = r^2*S.secondAxisResponse u u := by
  have hf : (fun e => -Complex.I*((r*u e:ℝ):ℂ)) = (-Complex.I*(r:ℂ)) • (fun e => (u e:ℂ)) := by
    ext e; simp only [Pi.smul_apply,smul_eq_mul,Complex.ofReal_mul]; ring
  have hg : (fun e => conj (-Complex.I*((r*u e:ℝ):ℂ))) = (Complex.I*(r:ℂ)) • (fun e => (u e:ℂ)) := by
    ext e; simp only [map_mul,map_neg,Complex.conj_I,neg_neg,Complex.conj_ofReal,Pi.smul_apply,smul_eq_mul,Complex.ofReal_mul]; ring
  rw [hf,hg,S.complexSecondResponse_smul_left,S.complexSecondResponse_smul_right,S.complexSecondResponse_ofReal]
  simp only [Complex.mul_re,Complex.mul_im,Complex.neg_re,Complex.neg_im,Complex.I_re,Complex.I_im,Complex.ofReal_re,Complex.ofReal_im]
  ring
end Quadratic.SpinSystem

namespace Fourier.LatticeGraph

def spinSystem (G : LatticeGraph) (b : G.edges → ℝ) (P : G.vertices → Option RP3.Spin) :
    Quadratic.SpinSystem G.vertices G.edges := ⟨fun e => e.val.1, fun e => e.val.2, b, P⟩

def BoundaryPins (G : LatticeGraph) (k : ℕ) (P : G.vertices → Option RP3.Spin) : Prop :=
  ∀ x s, P x=some s →
    (|(scaledSite k x.val).1| ≤ 1 ∧ |(scaledSite k x.val).2| ≤ 1) ∨
    (2 ≤ |(scaledSite k x.val).1| ∨ 2 ≤ |(scaledSite k x.val).2|)

theorem modes_zero_pins (G : LatticeGraph) (k : ℕ) (P : G.vertices → Option RP3.Spin)
    (hP : G.BoundaryPins k P) (i : ModeIndex k) (x : G.vertices) (s : RP3.Spin) (hs : P x=some s) :
    G.modes i x=0 := by
  have hp : squareProfile i.1.1 i.1.2 (scaledSite k x.val)=0 := by
    rcases hP x s hs with h | h
    · exact squareProfile_zero_inner _ _ _ h.1 h.2
    · exact squareProfile_zero_outer _ _ _ h
  simp [modes,latticeMode,hp]

theorem system_modes_commutator (G : LatticeGraph) (k : ℕ) (b : G.edges → ℝ)
    (P : G.vertices → Option RP3.Spin) :
    (∑ i : ModeIndex k, (G.spinSystem b P).commutatorForm (G.modes i) (fun x => conj (G.modes i x))) =
      (fun e => -Complex.I*((dyadicLambda k*G.profileEdge k e:ℝ):ℂ)) := by
  ext e
  rw [Finset.sum_apply]
  convert G.modes_commutator e using 1
  apply Finset.sum_congr rfl
  intro i _
  simp only [Quadratic.SpinSystem.commutatorForm,Quadratic.SpinSystem.complexCross,
    Pi.smul_apply,smul_eq_mul,spinSystem,modes,modeCommutator]
  ring

end Fourier.LatticeGraph
end
end RP3
end StandalonePart38

/- ===== RP3/Fourier/ResponseTransfer.lean ===== -/
section StandalonePart39

/-!
# Transferring a small response between nearby real edge fields

The estimate is proved for the squared interaction. The elementary Young
inequality bounds the current cross term and gives an error of order N⁻¹
for the Fourier profile approximation. No sign of the response is assumed.
-/
namespace RP3.Quadratic
noncomputable section
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace
namespace SpinSystem
variable {V E : Type*} [Fintype V] [Fintype E]

omit [Fintype V] in
def axisSecondCoefficient (S : SpinSystem V E) (σ : V → RP3.Spin) (e : E) : ℝ :=
  2 * S.strength e *
    (⟪(σ (S.left e)).val, axisC (σ (S.right e)).val⟫_ℝ ^ 2 +
      ⟪(σ (S.left e)).val, (σ (S.right e)).val⟫_ℝ *
        ⟪(σ (S.left e)).val, (axisC ^ 2) (σ (S.right e)).val⟫_ℝ)

omit [Fintype V] in
theorem secondAxisEnergy_eq_sum (S : SpinSystem V E) (u v : E → ℝ) (σ) :
    S.secondAxisEnergy u v σ = ∑ e, S.axisSecondCoefficient σ e * (u e * v e) := by
  apply Finset.sum_congr rfl
  intro e _
  unfold axisSecondCoefficient
  ring

omit [Fintype V] in
theorem abs_axisSecondCoefficient_le (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β) (σ) (e : E) :
    |S.axisSecondCoefficient σ e| ≤ 4 * β := by
  have hc := (abs_inner_operator_le (σ (S.left e)) (σ (S.right e)) axisC).trans axisC_norm_le
  have hd := abs_real_inner_le_norm (σ (S.left e)).val (σ (S.right e)).val
  simp only [RP3.spin_norm, one_mul] at hd
  have hcc : ‖axisC ^ 2‖ ≤ 1 := (norm_pow_le _ _).trans
    (pow_le_one₀ (norm_nonneg _) axisC_norm_le)
  have he := (abs_inner_operator_le (σ (S.left e)) (σ (S.right e)) (axisC ^ 2)).trans hcc
  have hs : |⟪(σ (S.left e)).val, axisC (σ (S.right e)).val⟫_ℝ ^ 2| ≤ 1 := by
    rw [abs_pow]
    exact (pow_le_one₀ (abs_nonneg _) hc)
  have hp : |⟪(σ (S.left e)).val, (σ (S.right e)).val⟫_ℝ *
      ⟪(σ (S.left e)).val, (axisC ^ 2) (σ (S.right e)).val⟫_ℝ| ≤ 1 := by
    rw [abs_mul]
    exact mul_le_one₀ hd (abs_nonneg _) he
  have hsum := (abs_add_le _ _).trans (add_le_add hs hp)
  unfold axisSecondCoefficient
  rw [abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
  calc
    _ ≤ (2 * β) * (1 + 1) :=
      mul_le_mul (mul_le_mul_of_nonneg_left (hb e) (by norm_num)) hsum
        (abs_nonneg _) (by have := (abs_nonneg _).trans (hb e); positivity)
    _ = _ := by ring

omit [Fintype V] in
theorem abs_axisCurrent_le (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β) (u : E → ℝ) (σ) :
    |S.firstEnergy (fun e => u e • axisC) σ| ≤ 2 * β * ∑ e, |u e| := by
  unfold firstEnergy
  rw [Finset.mul_sum]
  apply (Finset.abs_sum_le_sum_abs _ _).trans
  apply Finset.sum_le_sum
  intro e _
  have hβ : 0 ≤ β := (abs_nonneg _).trans (hb e)
  have hi := abs_real_inner_le_norm (σ (S.left e)).val (σ (S.right e)).val
  simp only [RP3.spin_norm, one_mul] at hi
  have hc := (abs_inner_operator_le (σ (S.left e)) (σ (S.right e)) axisC).trans axisC_norm_le
  simp only [smul_apply, real_inner_smul_right, abs_mul,
    abs_of_pos (by norm_num : (0 : ℝ) < 2)]
  calc
    _ ≤ 2 * β * 1 * (|u e| * 1) := by
      gcongr
      exact hb e
    _ = _ := by ring

omit [Fintype V] in
theorem axisCurrent_sub (S : SpinSystem V E) (u v : E → ℝ) (σ) :
    S.firstEnergy (fun e => (u e - v e) • axisC) σ =
      S.firstEnergy (fun e => u e • axisC) σ -
        S.firstEnergy (fun e => v e • axisC) σ := by
  simp only [firstEnergy, smul_apply, real_inner_smul_right, sub_mul, mul_sub,
    Finset.sum_sub_distrib]

omit [Fintype V] in
theorem secondAxisEnergy_lower (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β) (u : E → ℝ) (σ) :
    -(4 * β * ∑ e, (u e)^2) ≤ S.secondAxisEnergy u u σ := by
  rw [S.secondAxisEnergy_eq_sum, Finset.mul_sum, ← Finset.sum_neg_distrib]
  apply Finset.sum_le_sum
  intro e _
  have h := (abs_le.mp (S.abs_axisSecondCoefficient_le β hb σ e)).1
  simpa only [pow_two, neg_mul] using mul_le_mul_of_nonneg_right h (sq_nonneg (u e))

omit [Fintype V] in
theorem secondAxisEnergy_difference_le (S : SpinSystem V E) (β : ℝ)
    (hβ : 0 ≤ β) (hb : ∀ e, |S.strength e| ≤ β) (u v : E → ℝ) (σ) :
    S.secondAxisEnergy v v σ - S.secondAxisEnergy u u σ ≤
      4 * β * ∑ e, |u e - v e| * (|u e| + |v e|) := by
  simp only [S.secondAxisEnergy_eq_sum, ← Finset.sum_sub_distrib, Finset.mul_sum, ← mul_sub]
  apply Finset.sum_le_sum
  intro e _
  have hs : |v e * v e - u e * u e| ≤ |u e - v e| * (|u e| + |v e|) := by
    rw [show v e*v e-u e*u e=(v e-u e)*(v e+u e) by ring, abs_mul, abs_sub_comm]
    exact mul_le_mul_of_nonneg_left ((abs_add_le _ _).trans_eq (add_comm _ _)) (abs_nonneg _)
  calc
    _ ≤ |S.axisSecondCoefficient σ e * (v e*v e-u e*u e)| := le_abs_self _
    _ = |S.axisSecondCoefficient σ e| * |v e*v e-u e*u e| := abs_mul _ _
    _ ≤ _ := mul_le_mul (S.abs_axisSecondCoefficient_le β hb σ e) hs (abs_nonneg _) (by positivity)

omit [Fintype V] in
theorem continuous_secondAxisEnergy (S : SpinSystem V E) (u v : E → ℝ) :
    Continuous (S.secondAxisEnergy u v) := by unfold secondAxisEnergy; fun_prop

theorem transfer_average_add (S : SpinSystem V E)
    {f g : (V → RP3.Spin) → ℝ} (hf : Continuous f) (hg : Continuous g) :
    S.average (fun σ => f σ + g σ) = S.average f + S.average g :=
  S.average_add (f := f) (g := g) hf hg

/-- A model-specific response transfer estimate. Only explicit couplings and
actual Gibbs averages occur in the statement. -/
theorem real_response_transfer (S : SpinSystem V E) (β a : ℝ)
    (hβ : 0 ≤ β) (ha : 0 ≤ a) (hb : ∀ e, |S.strength e| ≤ β)
    (u v : E → ℝ) (hr : -S.secondAxisResponse v v ≤ a) :
    -S.secondAxisResponse u u ≤ a +
      4 * β * ∑ e, |u e-v e| * (|u e|+|v e|) +
      (2 * β * ∑ e, |u e-v e|) * (4 * β * ∑ e, (u e)^2 + 1) +
      (2 * β * ∑ e, |u e-v e|)^2 := by
  let A := 4 * β * ∑ e, (u e)^2
  let B := 2 * β * ∑ e, |u e-v e|
  let C := 4 * β * ∑ e, |u e-v e| * (|u e|+|v e|)
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hC : 0 ≤ C := by dsimp [C]; positivity
  have hA : 0 ≤ A := by dsimp [A]; positivity
  let Ju := fun σ => S.firstEnergy (fun e => u e • axisC) σ
  let Jv := fun σ => S.firstEnergy (fun e => v e • axisC) σ
  have hJu : Continuous Ju := S.continuous_firstEnergy _
  have hJv : Continuous Jv := S.continuous_firstEnergy _
  have hu : S.secondAxisResponse u u =
      S.average (S.secondAxisEnergy u u) + S.average (fun σ => (Ju σ)^2) := by
    calc
      S.secondAxisResponse u u = S.average (fun σ => S.secondAxisEnergy u u σ+(Ju σ)^2) := by
        unfold secondAxisResponse
        congr 1
        funext σ
        dsimp only [Ju]
        ring
      _ = _ := S.transfer_average_add (f := S.secondAxisEnergy u u) (g := fun σ => (Ju σ)^2)
        (S.continuous_secondAxisEnergy u u) (hJu.pow 2)
  have hv : S.average (fun σ => S.secondAxisEnergy v v σ + (Jv σ)^2) =
      S.secondAxisResponse v v := by
    unfold secondAxisResponse
    congr 1
    funext σ
    simp only [Jv, pow_two]
  by_cases hR : S.secondAxisResponse u u ≤ 0
  · have hQ : -A ≤ S.average (S.secondAxisEnergy u u) := by
      rw [← S.average_const (-A)]
      exact S.average_mono continuous_const (S.continuous_secondAxisEnergy u u)
        (S.secondAxisEnergy_lower β hb u)
    have hM : S.average (fun σ => (Ju σ)^2) ≤ A := by rw [hu] at hR; linarith
    have hpoint (σ : V → RP3.Spin) :
        S.secondAxisEnergy v v σ + (Jv σ)^2 ≤
          S.secondAxisEnergy u u σ + (Ju σ)^2 + C + B*((Ju σ)^2+1)+B^2 := by
      have hd : |Jv σ-Ju σ| ≤ B := by
        rw [abs_sub_comm]
        simpa only [S.axisCurrent_sub] using S.abs_axisCurrent_le β hb (fun e => u e-v e) σ
      have htri : |Jv σ| ≤ |Jv σ-Ju σ|+|Ju σ| := by
        simpa only [sub_add_cancel] using abs_add_le (Jv σ-Ju σ) (Ju σ)
      have hnorm : |Jv σ| ≤ |Ju σ| + B := htri.trans (by linarith)
      have hsq : (Jv σ)^2 ≤ (|Ju σ|+B)^2 := by
        simpa only [sq_abs] using pow_le_pow_left₀ (abs_nonneg _) hnorm 2
      have hy : 2*|Ju σ| ≤ (Ju σ)^2+1 := by nlinarith [sq_nonneg (|Ju σ|-1), sq_abs (Ju σ)]
      have hby := mul_le_mul_of_nonneg_left hy hB
      have hq := S.secondAxisEnergy_difference_le β hβ hb u v σ
      change S.secondAxisEnergy v v σ-S.secondAxisEnergy u u σ ≤ C at hq
      nlinarith [sq_abs (Ju σ)]
    have hav := S.average_mono
      (f := fun σ => S.secondAxisEnergy v v σ+(Jv σ)^2)
      (g := fun σ => S.secondAxisEnergy u u σ+(Ju σ)^2+C+B*((Ju σ)^2+1)+B^2)
      ((S.continuous_secondAxisEnergy v v).add (hJv.pow 2))
      (((((S.continuous_secondAxisEnergy u u).add (hJu.pow 2)).add continuous_const).add
        (continuous_const.mul ((hJu.pow 2).add continuous_const))).add continuous_const) hpoint
    rw [hv] at hav
    rw [S.transfer_average_add
      (f := fun σ => S.secondAxisEnergy u u σ+(Ju σ)^2+C+B*((Ju σ)^2+1))
      (g := fun _ => B^2)
      ((((S.continuous_secondAxisEnergy u u).add (hJu.pow 2)).add continuous_const).add
        (continuous_const.mul ((hJu.pow 2).add continuous_const))) continuous_const,
      S.average_const,
      S.transfer_average_add
        (f := fun σ => S.secondAxisEnergy u u σ+(Ju σ)^2+C)
        (g := fun σ => B*((Ju σ)^2+1))
        (((S.continuous_secondAxisEnergy u u).add (hJu.pow 2)).add continuous_const)
        (continuous_const.mul ((hJu.pow 2).add continuous_const)),
      S.transfer_average_add
        (f := fun σ => S.secondAxisEnergy u u σ+(Ju σ)^2)
        (g := fun _ => C)
        ((S.continuous_secondAxisEnergy u u).add (hJu.pow 2)) continuous_const,
      S.average_const, S.average_mul_const B (fun σ => (Ju σ)^2+1),
      S.transfer_average_add (f := fun σ => (Ju σ)^2) (g := fun _ => 1)
        (hJu.pow 2) continuous_const, S.average_const] at hav
    have hu' : S.average (fun σ => S.secondAxisEnergy u u σ+(Ju σ)^2) =
        S.secondAxisResponse u u := by
      unfold secondAxisResponse
      congr 1
      funext σ
      simp only [Ju, pow_two]
    rw [hu'] at hav
    have hm := mul_le_mul_of_nonneg_left hM hB
    change -S.secondAxisResponse u u ≤ a+C+B*(A+1)+B^2
    linarith
  · change -S.secondAxisResponse u u ≤ a+C+B*(A+1)+B^2
    have ht : 0 ≤ a+C+B*(A+1)+B^2 := by positivity
    linarith

end SpinSystem
end
end RP3.Quadratic
end StandalonePart39

/- ===== RP3/QuadraticMixedJets.lean ===== -/
section StandalonePart40

/-!
# Mixed fourth derivatives of the squared interaction

All local coefficients below are obtained by differentiating the actual
squared scalar product. The terms quadratic in lower scalar-product jets
are retained at every order.
-/
namespace RP3.Quadratic
noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace

namespace SpinSystem
variable {V E : Type*} [Fintype V] [Fintype E]

omit [Fintype V] [Fintype E] in
def localInner (S : SpinSystem V E) (M : SpinOperator 4)
    (σ : V → RP3.Spin) (e : E) : ℝ :=
  ⟪(σ (S.left e)).val, M (σ (S.right e)).val⟫_ℝ

omit [Fintype V] [Fintype E] in
def axisCoefficient (S : SpinSystem V E) (M : SpinOperator 4)
    (k : ℕ) (σ : V → RP3.Spin) (e : E) : ℝ :=
  S.strength e * productJet
    (fun n (_ : ℝ) (_ : Unit) => S.localInner (M^n) σ e)
    (fun n (_ : ℝ) (_ : Unit) => S.localInner (M^n) σ e) k 0 0 0 ()

omit [Fintype V] [Fintype E] in
def mixedCoefficients (S : SpinSystem V E) (σ : V → RP3.Spin) :
    MixedAlgebra.Coeffs E ℝ where
  a e := 2 * S.strength e * S.localInner 1 σ e * S.localInner axisA σ e
  b e := 2 * S.strength e * S.localInner 1 σ e * S.localInner axisB σ e
  aa e := 2 * S.strength e * ((S.localInner axisA σ e)^2 +
    S.localInner 1 σ e * S.localInner (axisA^2) σ e)
  ab e := 2 * S.strength e * (S.localInner axisA σ e * S.localInner axisB σ e +
    S.localInner 1 σ e * S.localInner mixedAB σ e)
  bb e := 2 * S.strength e * ((S.localInner axisB σ e)^2 +
    S.localInner 1 σ e * S.localInner (axisB^2) σ e)
  aab e := 2 * S.strength e * (S.localInner axisB σ e * S.localInner (axisA^2) σ e +
    2 * S.localInner axisA σ e * S.localInner mixedAB σ e +
    S.localInner 1 σ e * S.localInner mixedAAB σ e)
  abb e := 2 * S.strength e * (S.localInner axisA σ e * S.localInner (axisB^2) σ e +
    2 * S.localInner axisB σ e * S.localInner mixedAB σ e +
    S.localInner 1 σ e * S.localInner mixedABB σ e)
  aabb e := 2 * S.strength e * (S.localInner (axisA^2) σ e * S.localInner (axisB^2) σ e +
    2 * (S.localInner mixedAB σ e)^2 +
    2 * S.localInner axisA σ e * S.localInner mixedABB σ e +
    2 * S.localInner axisB σ e * S.localInner mixedAAB σ e +
    S.localInner 1 σ e * S.localInner mixedAABB σ e)

omit [Fintype V] in
theorem weighted_mixed_a (S : SpinSystem V E) (u : E → ℝ) (σ : V → RP3.Spin) :
    MixedAlgebra.weighted (S.mixedCoefficients σ).a u =
      S.firstEnergy (fun e => u e • axisA) σ := by
  unfold MixedAlgebra.weighted firstEnergy
  apply Finset.sum_congr rfl
  intro e _
  simp only [mixedCoefficients, localInner, one_apply_eq_self, smul_apply,
    real_inner_smul_right]
  ring

omit [Fintype V] in
theorem weighted_mixed_b (S : SpinSystem V E) (u : E → ℝ) (σ : V → RP3.Spin) :
    MixedAlgebra.weighted (S.mixedCoefficients σ).b u =
      S.firstEnergy (fun e => u e • axisB) σ := by
  unfold MixedAlgebra.weighted firstEnergy
  apply Finset.sum_congr rfl
  intro e _
  simp only [mixedCoefficients, localInner, one_apply_eq_self, smul_apply,
    real_inner_smul_right]
  ring

omit [Fintype V] [Fintype E] in
theorem operator_smul_pow (r : ℝ) (M : SpinOperator 4) (k : ℕ) :
    (r • M)^k = r^k • M^k := by
  induction k with
  | zero => simp only [pow_zero, one_smul]
  | succ k ih =>
    rw [pow_succ, ih, Algebra.smul_mul_assoc (r^k) (M^k) (r • M),
      Algebra.mul_smul_comm r (M^k) M, smul_smul (r^k) r (M^k*M),
      ← pow_succ, ← pow_succ]

omit [Fintype V] in
theorem energy_scaled_power (S : SpinSystem V E) (M : SpinOperator 4)
    (u : E → ℝ) (k : ℕ) (hk : k ≤ 4) (σ : V → RP3.Spin) :
    S.twistEnergy (fun e => u e • M) k 0 σ =
      MixedAlgebra.weighted (S.axisCoefficient M k σ) (u^k) := by
  unfold twistEnergy pathEnergy MixedAlgebra.weighted axisCoefficient
  apply Finset.sum_congr rfl
  intro e _
  interval_cases k <;>
    simp only [productJet, innerJet, expPower_zero, localInner, operator_smul_pow,
      smul_apply, real_inner_smul_right, Pi.pow_apply, pow_zero, pow_one,
      one_apply_eq_self] <;> ring

omit [Fintype V] in
theorem planeEnergy_one (S : SpinSystem V E) (u v : E → ℝ) (σ : V → RP3.Spin) :
    S.twistEnergy (fun e => planeOperator (u e) (v e)) 1 0 σ =
      MixedAlgebra.weighted (S.mixedCoefficients σ).a u +
      MixedAlgebra.weighted (S.mixedCoefficients σ).b v := by
  unfold twistEnergy pathEnergy MixedAlgebra.weighted
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e _
  simp only [squareJet_one, innerJet, expPower_zero, pow_zero, pow_one,
    planeOperator_eq, add_apply, smul_apply, inner_add_right, real_inner_smul_right,
    mixedCoefficients, localInner, one_apply_eq_self]
  ring

omit [Fintype V] in
theorem planeEnergy_two (S : SpinSystem V E) (u v : E → ℝ) (σ : V → RP3.Spin) :
    S.twistEnergy (fun e => planeOperator (u e) (v e)) 2 0 σ =
      MixedAlgebra.weighted (S.mixedCoefficients σ).aa (u*u) +
      2 * MixedAlgebra.weighted (S.mixedCoefficients σ).ab (u*v) +
      MixedAlgebra.weighted (S.mixedCoefficients σ).bb (v*v) := by
  unfold twistEnergy pathEnergy MixedAlgebra.weighted
  rw [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e _
  simp only [squareJet_two, innerJet, expPower_zero, pow_zero, pow_one,
    planeOperator_square]
  simp only [planeOperator_eq, add_apply, smul_apply, inner_add_right,
    real_inner_smul_right, mixedCoefficients, localInner, one_apply_eq_self, Pi.mul_apply]
  ring

omit [Fintype V] in
theorem planeEnergy_three (S : SpinSystem V E) (u v : E → ℝ) (σ : V → RP3.Spin) :
    S.twistEnergy (fun e => planeOperator (u e) (v e)) 3 0 σ =
      MixedAlgebra.weighted (S.axisCoefficient axisA 3 σ) (u^3) +
      3 * MixedAlgebra.weighted (S.mixedCoefficients σ).aab (u*u*v) +
      3 * MixedAlgebra.weighted (S.mixedCoefficients σ).abb (u*v*v) +
      MixedAlgebra.weighted (S.axisCoefficient axisB 3 σ) (v^3) := by
  unfold twistEnergy pathEnergy MixedAlgebra.weighted
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e _
  simp only [axisCoefficient, squareJet_three, innerJet, expPower_zero, pow_zero, pow_one,
    planeOperator_cube, planeOperator_square]
  simp only [planeOperator_eq, add_apply, smul_apply,
    inner_add_right, real_inner_smul_right, mixedCoefficients, localInner,
    one_apply_eq_self, Pi.mul_apply, Pi.pow_apply]
  ring

omit [Fintype V] in
set_option maxRecDepth 4096 in
set_option maxHeartbeats 800000 in
theorem planeEnergy_four_even (S : SpinSystem V E) (u v : E → ℝ) (σ : V → RP3.Spin) :
    S.twistEnergy (fun e => planeOperator (u e) (v e)) 4 0 σ +
      S.twistEnergy (fun e => planeOperator (u e) (-v e)) 4 0 σ =
      2 * MixedAlgebra.weighted (S.axisCoefficient axisA 4 σ) (u^4) +
      12 * MixedAlgebra.weighted (S.mixedCoefficients σ).aabb (u*u*v*v) +
      2 * MixedAlgebra.weighted (S.axisCoefficient axisB 4 σ) (v^4) := by
  unfold twistEnergy pathEnergy MixedAlgebra.weighted
  simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e _
  have h4 := congrArg (fun M : SpinOperator 4 => S.localInner M σ e)
    (planeOperator_four_even (u e) (v e))
  simp only [localInner, planeOperator_eq, add_apply, smul_apply, inner_add_right,
    real_inner_smul_right] at h4
  simp only [axisCoefficient, squareJet_four, innerJet, expPower_zero, pow_zero, pow_one,
    planeOperator_cube, planeOperator_square]
  simp only [planeOperator_eq, add_apply, smul_apply,
    inner_add_right, real_inner_smul_right, mixedCoefficients, localInner,
    one_apply_eq_self, Pi.mul_apply, Pi.pow_apply]
  linear_combination 2 * S.strength e *
    ⟪(σ (S.left e)).val, (σ (S.right e)).val⟫_ℝ * h4

omit [Fintype V] [Fintype E] in
@[fun_prop] theorem continuous_localInner (S : SpinSystem V E) (M : SpinOperator 4) (e : E) :
    Continuous (fun σ => S.localInner M σ e) := by
  exact ((continuous_apply (S.left e)).subtype_val).inner
    (continuous_const.clm_apply ((continuous_apply (S.right e)).subtype_val))

omit [Fintype V] in
@[fun_prop] theorem continuous_mixedPolynomial (S : SpinSystem V E) (u v w z : E → ℝ) :
    Continuous (fun σ => MixedAlgebra.four (S.mixedCoefficients σ) u v w z) := by
  simp only [MixedAlgebra.four, MixedAlgebra.weighted, mixedCoefficients]
  fun_prop

omit [Fintype V] in
@[fun_prop] theorem continuous_fourthPolynomial (S : SpinSystem V E) (A : E → SpinOperator 4) :
    Continuous (fun σ => fourthPolynomial (fun k => S.twistEnergy A k 0 σ)) := by
  have h (k : ℕ) : Continuous (fun σ => S.twistEnergy A k 0 σ) :=
    (S.continuous_twistEnergy A k).comp (continuous_const.prodMk continuous_id)
  unfold fourthPolynomial
  exact ((((h 4).add ((continuous_const.mul (h 1)).mul (h 3))).add
    (continuous_const.mul ((h 2).pow 2))).add
    ((continuous_const.mul ((h 1).pow 2)).mul (h 2))).add ((h 1).pow 4)

def fourthObservable (S : SpinSystem V E) (A : E → SpinOperator 4) : C((V → RP3.Spin), ℝ) :=
  ⟨_, S.continuous_fourthPolynomial A⟩

def mixedObservable (S : SpinSystem V E) (u v w z : E → ℝ) : C((V → RP3.Spin), ℝ) :=
  ⟨_, S.continuous_mixedPolynomial u v w z⟩

def mixedResponse (S : SpinSystem V E) (u v w z : E → ℝ) : ℝ :=
  S.averageLinear (S.mixedObservable u v w z)

@[simp] theorem average_fourthObservable (S : SpinSystem V E) (A : E → SpinOperator 4) :
    S.averageLinear (S.fourthObservable A) = S.fourthResponse A := rfl

omit [Fintype V] [Fintype E] in
theorem axisCoefficient_one (S : SpinSystem V E) (σ : V → RP3.Spin) :
    S.axisCoefficient axisA 1 σ = (S.mixedCoefficients σ).a ∧
    S.axisCoefficient axisB 1 σ = (S.mixedCoefficients σ).b := by
  constructor <;> funext e <;>
    simp only [axisCoefficient, squareJet_one, pow_zero, pow_one, mixedCoefficients] <;> ring

omit [Fintype V] [Fintype E] in
theorem axisCoefficient_two (S : SpinSystem V E) (σ : V → RP3.Spin) :
    S.axisCoefficient axisA 2 σ = (S.mixedCoefficients σ).aa ∧
    S.axisCoefficient axisB 2 σ = (S.mixedCoefficients σ).bb := by
  constructor <;> funext e <;>
    simp only [axisCoefficient, squareJet_two, pow_zero, pow_one, mixedCoefficients] <;> ring

omit [Fintype V] in
theorem fourthObservable_even (S : SpinSystem V E) (u v : E → ℝ) :
    S.fourthObservable (fun e => planeOperator (u e) (v e)) +
      S.fourthObservable (fun e => planeOperator (u e) (-v e)) -
      (2:ℝ) • S.fourthObservable (fun e => u e • axisA) -
      (2:ℝ) • S.fourthObservable (fun e => v e • axisB) =
      (12:ℝ) • S.mixedObservable u v u v := by
  ext σ
  change fourthPolynomial (fun k => S.twistEnergy (fun e => planeOperator (u e) (v e)) k 0 σ) +
    fourthPolynomial (fun k => S.twistEnergy (fun e => planeOperator (u e) (-v e)) k 0 σ) -
    2 * fourthPolynomial (fun k => S.twistEnergy (fun e => u e • axisA) k 0 σ) -
    2 * fourthPolynomial (fun k => S.twistEnergy (fun e => v e • axisB) k 0 σ) =
    12 * MixedAlgebra.four (S.mixedCoefficients σ) u v u v
  simp only [fourthPolynomial, planeEnergy_one, planeEnergy_two, planeEnergy_three,
    energy_scaled_power S axisA u 1 (by decide), energy_scaled_power S axisA u 2 (by decide),
    energy_scaled_power S axisA u 3 (by decide), energy_scaled_power S axisA u 4 (by decide),
    energy_scaled_power S axisB v 1 (by decide), energy_scaled_power S axisB v 2 (by decide),
    energy_scaled_power S axisB v 3 (by decide), energy_scaled_power S axisB v 4 (by decide),
    (S.axisCoefficient_one σ).1, (S.axisCoefficient_one σ).2,
    (S.axisCoefficient_two σ).1, (S.axisCoefficient_two σ).2, pow_one]
  have hn : (fun e => -v e) = -v := rfl
  have hv3 : (-v)^3 = -(v^3) := by ring
  simp only [hn, hv3, neg_mul, mul_neg, neg_neg, MixedAlgebra.weighted_neg]
  have hb := bell4_even
    (MixedAlgebra.weighted (S.mixedCoefficients σ).a u)
    (MixedAlgebra.weighted (S.mixedCoefficients σ).b v)
    (MixedAlgebra.weighted (S.mixedCoefficients σ).aa (u*u))
    (MixedAlgebra.weighted (S.mixedCoefficients σ).ab (u*v))
    (MixedAlgebra.weighted (S.mixedCoefficients σ).bb (v*v))
    (MixedAlgebra.weighted (S.axisCoefficient axisA 3 σ) (u^3))
    (MixedAlgebra.weighted (S.mixedCoefficients σ).aab (u*u*v))
    (MixedAlgebra.weighted (S.mixedCoefficients σ).abb (u*v*v))
    (MixedAlgebra.weighted (S.axisCoefficient axisB 3 σ) (v^3))
    (S.twistEnergy (fun e => planeOperator (u e) (v e)) 4 0 σ)
    (S.twistEnergy (fun e => planeOperator (u e) (-v e)) 4 0 σ)
    (MixedAlgebra.weighted (S.axisCoefficient axisA 4 σ) (u^4))
    (MixedAlgebra.weighted (S.mixedCoefficients σ).aabb (u*u*v*v))
    (MixedAlgebra.weighted (S.axisCoefficient axisB 4 σ) (v^4))
    (S.planeEnergy_four_even u v σ)
  rw [MixedAlgebra.four_diagonal]
  simp only [bell4] at hb
  convert hb using 1 <;> ring_nf

end SpinSystem
end
end RP3.Quadratic
end StandalonePart40

/- ===== RP3/QuadraticMixedWard.lean ===== -/
section StandalonePart41
/-!
# Polarized fourth Ward identity for the squared RP³ interaction
Adapted from OpenAI ClassicalON/MixedWard, commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a (Apache-2.0, copyright OpenAI).
The model-specific coefficient identity is proved in QuadraticMixedJets.
-/
namespace RP3.Quadratic
universe uV uE
noncomputable section
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace
namespace SpinSystem
variable {V : Type uV} {E : Type uE} [Fintype V] [Fintype E]

omit [Fintype V] [Fintype E] in
theorem planarGradient_eq (S : SpinSystem V E) (f g : V → ℝ) :
    S.planarGradient f g = fun e => planeOperator (S.edgeGradient f e) (S.edgeGradient g e) := by
  funext e
  simp only [planarGradient, planeOperator_eq]
  change (f (S.right e) • axisA + g (S.right e) • axisB) -
      (f (S.left e) • axisA + g (S.left e) • axisB) =
    (f (S.right e) - f (S.left e)) • axisA +
      (g (S.right e) - g (S.left e)) • axisB
  rw [sub_smul (f (S.right e)) (f (S.left e)) axisA,
    sub_smul (g (S.right e)) (g (S.left e)) axisB]
  abel

theorem mixedResponse_diagonal (S : SpinSystem V E) (f g : V → ℝ)
    (hf : ∀ x s, S.pin x = some s → f x = 0)
    (hg : ∀ x s, S.pin x = some s → g x = 0) :
    2 * S.mixedResponse (S.edgeGradient f) (S.edgeGradient g)
      (S.edgeGradient f) (S.edgeGradient g) =
      S.secondAxisResponse (S.crossForm f g) (S.crossForm f g) := by
  have h := congrArg S.averageLinear
    (S.fourthObservable_even (S.edgeGradient f) (S.edgeGradient g))
  simp only [map_sub, map_add, map_smul, smul_eq_mul,
    average_fourthObservable] at h
  have hp := S.fourthResponse_plane_even f g hf hg
  have ha := S.fourthResponse_axisGradient axisA axisA_skew f hf
  have hb := S.fourthResponse_axisGradient axisB axisB_skew g hg
  rw [S.planarGradient_eq, S.planarGradient_eq] at hp
  have hm : S.edgeGradient (-g) = fun e => -S.edgeGradient g e := by
    funext e
    simp only [edgeGradient, Pi.neg_apply]
    ring
  rw [hm] at hp
  change S.fourthResponse (fun e => S.edgeGradient f e • axisA) = 0 at ha
  change S.fourthResponse (fun e => S.edgeGradient g e • axisB) = 0 at hb
  rw [ha, hb] at h
  unfold mixedResponse
  linarith

theorem mixedResponse_polarize_a (S : SpinSystem V E) (u w v : E → ℝ) :
    S.mixedResponse (u+w) v (u+w) v = S.mixedResponse u v u v +
      2 * S.mixedResponse u v w v + S.mixedResponse w v w v := by
  have hp : S.mixedObservable (u+w) v (u+w) v = S.mixedObservable u v u v +
      (2:ℝ) • S.mixedObservable u v w v + S.mixedObservable w v w v := by
    ext σ
    exact MixedAlgebra.four_polarize_a (S.mixedCoefficients σ) u w v
  unfold mixedResponse
  rw [hp, map_add, map_add, map_smul, smul_eq_mul]

theorem mixedResponse_polarize_b (S : SpinSystem V E) (u w v z : E → ℝ) :
    S.mixedResponse u (v+z) w (v+z) = S.mixedResponse u v w v +
      2 * S.mixedResponse u v w z + S.mixedResponse u z w z := by
  have hp : S.mixedObservable u (v+z) w (v+z) = S.mixedObservable u v w v +
      (2:ℝ) • S.mixedObservable u v w z + S.mixedObservable u z w z := by
    ext σ
    exact MixedAlgebra.four_polarize_b (S.mixedCoefficients σ) u w v z
  unfold mixedResponse
  rw [hp, map_add, map_add, map_smul, smul_eq_mul]

omit [Fintype V] [Fintype E] in
theorem edgeGradient_add (S : SpinSystem V E) (f g : V → ℝ) :
    S.edgeGradient (f+g) = S.edgeGradient f + S.edgeGradient g := by
  funext e
  simp only [edgeGradient, Pi.add_apply]
  ring

omit [Fintype V] [Fintype E] in
theorem crossForm_add_left (S : SpinSystem V E) (f g h : V → ℝ) :
    S.crossForm (f+g) h = S.crossForm f h + S.crossForm g h := by
  funext e
  simp only [crossForm, Pi.add_apply]
  ring

omit [Fintype V] [Fintype E] in
theorem crossForm_add_right (S : SpinSystem V E) (f g h : V → ℝ) :
    S.crossForm f (g+h) = S.crossForm f g + S.crossForm f h := by
  funext e
  simp only [crossForm, Pi.add_apply]
  ring

theorem mixedResponse_a_polarized (S : SpinSystem V E) (f h g : V → ℝ)
    (hf : ∀ x s, S.pin x = some s → f x = 0)
    (hh : ∀ x s, S.pin x = some s → h x = 0)
    (hg : ∀ x s, S.pin x = some s → g x = 0) :
    2 * S.mixedResponse (S.edgeGradient f) (S.edgeGradient g)
      (S.edgeGradient h) (S.edgeGradient g) =
      S.secondAxisResponse (S.crossForm f g) (S.crossForm h g) := by
  have hfh : ∀ x s, S.pin x = some s → (f+h) x = 0 := by
    intro x s hs
    simp only [Pi.add_apply, hf x s hs, hh x s hs, add_zero]
  have hp := S.mixedResponse_diagonal (f+h) g hfh hg
  rw [S.edgeGradient_add, S.mixedResponse_polarize_a, S.crossForm_add_left,
    S.secondAxisResponse_add_left, S.secondAxisResponse_add_right,
    S.secondAxisResponse_add_right, S.secondAxisResponse_symm (S.crossForm h g)] at hp
  have hdiagf := S.mixedResponse_diagonal f g hf hg
  have hdiagh := S.mixedResponse_diagonal h g hh hg
  linarith

theorem mixedResponse_ward (S : SpinSystem V E) (f g h k : V → ℝ)
    (hf : ∀ x s, S.pin x = some s → f x = 0)
    (hg : ∀ x s, S.pin x = some s → g x = 0)
    (hh : ∀ x s, S.pin x = some s → h x = 0)
    (hk : ∀ x s, S.pin x = some s → k x = 0) :
    4 * S.mixedResponse (S.edgeGradient f) (S.edgeGradient g)
      (S.edgeGradient h) (S.edgeGradient k) =
      S.secondAxisResponse (S.crossForm f g) (S.crossForm h k) +
        S.secondAxisResponse (S.crossForm f k) (S.crossForm h g) := by
  have hgk : ∀ x s, S.pin x = some s → (g+k) x = 0 := by
    intro x s hs
    simp only [Pi.add_apply, hg x s hs, hk x s hs, add_zero]
  have hp := S.mixedResponse_a_polarized f h (g+k) hf hh hgk
  rw [S.edgeGradient_add, S.mixedResponse_polarize_b, S.crossForm_add_right,
    S.crossForm_add_right, S.secondAxisResponse_add_left,
    S.secondAxisResponse_add_right, S.secondAxisResponse_add_right] at hp
  have hdiagg := S.mixedResponse_a_polarized f h g hf hh hg
  have hdiagk := S.mixedResponse_a_polarized f h k hf hh hk
  linarith


end SpinSystem
end
end RP3.Quadratic
end StandalonePart41

/- ===== RP3/QuadraticComplexWard.lean ===== -/
section StandalonePart42
/-!
# Complex polarization of the quadratic fourth Ward identity
Adapted from OpenAI ClassicalON/ComplexWard, commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a (Apache-2.0, copyright OpenAI).
-/
namespace RP3.Quadratic
universe uV uE
noncomputable section
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace
namespace SpinSystem
variable {V : Type uV} {E : Type uE} [Fintype V] [Fintype E]
def complexCoefficients (S : SpinSystem V E) (σ : V → RP3.Spin) : MixedAlgebra.Coeffs E ℂ :=
  (S.mixedCoefficients σ).map Complex.ofRealHom

omit [Fintype V] in
@[fun_prop] theorem continuous_complexMixedPolynomial (S : SpinSystem V E)
    (u v w z : E → ℂ) :
    Continuous (fun σ => MixedAlgebra.four (S.complexCoefficients σ) u v w z) := by
  simp only [MixedAlgebra.four, complexCoefficients, MixedAlgebra.Coeffs.map,
    mixedCoefficients, Function.comp_def, Complex.ofRealHom_eq_coe]
  unfold MixedAlgebra.weighted localInner
  fun_prop

def complexMixedObservable (S : SpinSystem V E) (u v w z : E → ℂ) : C((V → RP3.Spin), ℂ) :=
  ⟨_, S.continuous_complexMixedPolynomial u v w z⟩

def complexMixedResponse (S : SpinSystem V E) (u v w z : E → ℂ) : ℂ :=
  S.averageComplexLinear (S.complexMixedObservable u v w z)

theorem complexMixedResponse_ofReal (S : SpinSystem V E) (u v w z : E → ℝ) :
    S.complexMixedResponse (fun e => (u e : ℂ)) (fun e => (v e : ℂ))
      (fun e => (w e : ℂ)) (fun e => (z e : ℂ)) = (S.mixedResponse u v w z : ℂ) := by
  have hc : S.complexMixedObservable (fun e => (u e : ℂ)) (fun e => (v e : ℂ))
      (fun e => (w e : ℂ)) (fun e => (z e : ℂ)) = ofRealObservable (S.mixedObservable u v w z) := by
    ext σ
    exact MixedAlgebra.four_map Complex.ofRealHom (S.mixedCoefficients σ) u v w z
  unfold complexMixedResponse
  rw [hc, S.averageComplex_ofReal]
  rfl

theorem complexMixedResponse_add_first (S : SpinSystem V E) (u v w z u' : E → ℂ) :
    S.complexMixedResponse (u+u') v w z = S.complexMixedResponse u v w z + S.complexMixedResponse u' v w z := by
  have hp : S.complexMixedObservable (u+u') v w z = S.complexMixedObservable u v w z +
      S.complexMixedObservable u' v w z := by
    ext σ
    exact MixedAlgebra.four_add_first (S.complexCoefficients σ) u u' v w z
  unfold complexMixedResponse
  rw [hp, map_add]

theorem complexMixedResponse_smul_first (S : SpinSystem V E) (u v w z : E → ℂ) (r : ℂ) :
    S.complexMixedResponse (r • u) v w z = r * S.complexMixedResponse u v w z := by
  have hp : S.complexMixedObservable (r • u) v w z = r • S.complexMixedObservable u v w z := by
    ext σ
    exact MixedAlgebra.four_smul_first (S.complexCoefficients σ) u v w z r
  unfold complexMixedResponse
  rw [hp, map_smul, smul_eq_mul]

theorem complexMixedResponse_add_second (S : SpinSystem V E) (u v w z v' : E → ℂ) :
    S.complexMixedResponse u (v+v') w z = S.complexMixedResponse u v w z + S.complexMixedResponse u v' w z := by
  have hp : S.complexMixedObservable u (v+v') w z = S.complexMixedObservable u v w z +
      S.complexMixedObservable u v' w z := by
    ext σ
    exact MixedAlgebra.four_add_second (S.complexCoefficients σ) u v v' w z
  unfold complexMixedResponse
  rw [hp, map_add]

theorem complexMixedResponse_smul_second (S : SpinSystem V E) (u v w z : E → ℂ) (r : ℂ) :
    S.complexMixedResponse u (r • v) w z = r * S.complexMixedResponse u v w z := by
  have hp : S.complexMixedObservable u (r • v) w z = r • S.complexMixedObservable u v w z := by
    ext σ
    exact MixedAlgebra.four_smul_second (S.complexCoefficients σ) u v w z r
  unfold complexMixedResponse
  rw [hp, map_smul, smul_eq_mul]

theorem complexMixedResponse_add_third (S : SpinSystem V E) (u v w z w' : E → ℂ) :
    S.complexMixedResponse u v (w+w') z = S.complexMixedResponse u v w z + S.complexMixedResponse u v w' z := by
  have hp : S.complexMixedObservable u v (w+w') z = S.complexMixedObservable u v w z +
      S.complexMixedObservable u v w' z := by
    ext σ
    exact MixedAlgebra.four_add_third (S.complexCoefficients σ) u v w w' z
  unfold complexMixedResponse
  rw [hp, map_add]

theorem complexMixedResponse_smul_third (S : SpinSystem V E) (u v w z : E → ℂ) (r : ℂ) :
    S.complexMixedResponse u v (r • w) z = r * S.complexMixedResponse u v w z := by
  have hp : S.complexMixedObservable u v (r • w) z = r • S.complexMixedObservable u v w z := by
    ext σ
    exact MixedAlgebra.four_smul_third (S.complexCoefficients σ) u v w z r
  unfold complexMixedResponse
  rw [hp, map_smul, smul_eq_mul]

theorem complexMixedResponse_add_fourth (S : SpinSystem V E) (u v w z z' : E → ℂ) :
    S.complexMixedResponse u v w (z+z') = S.complexMixedResponse u v w z + S.complexMixedResponse u v w z' := by
  have hp : S.complexMixedObservable u v w (z+z') = S.complexMixedObservable u v w z +
      S.complexMixedObservable u v w z' := by
    ext σ
    exact MixedAlgebra.four_add_fourth (S.complexCoefficients σ) u v w z z'
  unfold complexMixedResponse
  rw [hp, map_add]

theorem complexMixedResponse_smul_fourth (S : SpinSystem V E) (u v w z : E → ℂ) (r : ℂ) :
    S.complexMixedResponse u v w (r • z) = r * S.complexMixedResponse u v w z := by
  have hp : S.complexMixedObservable u v w (r • z) = r • S.complexMixedObservable u v w z := by
    ext σ
    exact MixedAlgebra.four_smul_fourth (S.complexCoefficients σ) u v w z r
  unfold complexMixedResponse
  rw [hp, map_smul, smul_eq_mul]

def complexWardDefect (S : SpinSystem V E) : ComplexFourForm (V → ℂ) where
  toFun f g h k := 4 * S.complexMixedResponse (S.edgeGradient f) (S.edgeGradient g)
    (S.edgeGradient h) (S.edgeGradient k) -
    (S.complexSecondResponse (S.complexCross f g) (S.complexCross h k) +
      S.complexSecondResponse (S.complexCross f k) (S.complexCross h g))
  add_first := by
    intro f f' g h k
    simp only [complexDifferential_add, complexMixedResponse_add_first,
      complexCross_add_left, complexSecondResponse_add_left]
    ring
  add_second := by
    intro f g g' h k
    simp only [complexDifferential_add, complexMixedResponse_add_second,
      complexCross_add_right, complexSecondResponse_add_left, complexSecondResponse_add_right]
    ring
  add_third := by
    intro f g h h' k
    simp only [complexDifferential_add, complexMixedResponse_add_third,
      complexCross_add_left, complexSecondResponse_add_right]
    ring
  add_fourth := by
    intro f g h k k'
    simp only [complexDifferential_add, complexMixedResponse_add_fourth,
      complexCross_add_right, complexSecondResponse_add_left, complexSecondResponse_add_right]
    ring
  smul_first := by
    intro r f g h k
    simp only [complexDifferential_smul, complexMixedResponse_smul_first,
      complexCross_smul_left, complexSecondResponse_smul_left]
    ring
  smul_second := by
    intro r f g h k
    simp only [complexDifferential_smul, complexMixedResponse_smul_second,
      complexCross_smul_right, complexSecondResponse_smul_left, complexSecondResponse_smul_right]
    ring
  smul_third := by
    intro r f g h k
    simp only [complexDifferential_smul, complexMixedResponse_smul_third,
      complexCross_smul_left, complexSecondResponse_smul_right]
    ring
  smul_fourth := by
    intro r f g h k
    simp only [complexDifferential_smul, complexMixedResponse_smul_fourth,
      complexCross_smul_right, complexSecondResponse_smul_left, complexSecondResponse_smul_right]
    ring

theorem complexWardDefect_real (S : SpinSystem V E) (f g h k : V → ℝ)
    (hf : ∀ x s, S.pin x = some s → f x = 0)
    (hg : ∀ x s, S.pin x = some s → g x = 0)
    (hh : ∀ x s, S.pin x = some s → h x = 0)
    (hk : ∀ x s, S.pin x = some s → k x = 0) :
    S.complexWardDefect (fun x => (f x : ℂ)) (fun x => (g x : ℂ))
      (fun x => (h x : ℂ)) (fun x => (k x : ℂ)) = 0 := by
  change _ - _ = 0
  apply sub_eq_zero.mpr
  simp only [edgeGradient_ofReal, complexCross_ofReal, complexMixedResponse_ofReal,
    complexSecondResponse_ofReal]
  exact_mod_cast S.mixedResponse_ward f g h k hf hg hh hk

theorem complexMixedResponse_ward (S : SpinSystem V E) (f g h k : V → ℂ)
    (hf : ∀ x s, S.pin x = some s → f x = 0)
    (hg : ∀ x s, S.pin x = some s → g x = 0)
    (hh : ∀ x s, S.pin x = some s → h x = 0)
    (hk : ∀ x s, S.pin x = some s → k x = 0) :
    4 * S.complexMixedResponse (S.edgeGradient f) (S.edgeGradient g)
      (S.edgeGradient h) (S.edgeGradient k) =
      S.complexSecondResponse (S.complexCross f g) (S.complexCross h k) +
        S.complexSecondResponse (S.complexCross f k) (S.complexCross h g) := by
  apply sub_eq_zero.mp
  change S.complexWardDefect f g h k = 0
  refine S.complexWardDefect.zero_of_real (fun x => ∃ s, S.pin x = some s) ?_ f g h k ?_ ?_ ?_ ?_
  · intro a b c d ha hb hc hd
    exact S.complexWardDefect_real a b c d
      (fun x s hs => ha x ⟨s, hs⟩) (fun x s hs => hb x ⟨s, hs⟩)
      (fun x s hs => hc x ⟨s, hs⟩) (fun x s hs => hd x ⟨s, hs⟩)
  · rintro x ⟨s, hs⟩; exact hf x s hs
  · rintro x ⟨s, hs⟩; exact hg x s hs
  · rintro x ⟨s, hs⟩; exact hh x s hs
  · rintro x ⟨s, hs⟩; exact hk x s hs


end SpinSystem
end
end RP3.Quadratic
end StandalonePart42

/- ===== RP3/QuadraticCoefficientBounds.lean ===== -/
section StandalonePart43

/-! # Uniform bounds on the actual mixed RP³ coefficients -/
namespace RP3.Quadratic
noncomputable section
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace

theorem norm_square_le_one (M : SpinOperator 4) (hM : ‖M‖ ≤ 1) : ‖M^2‖ ≤ 1 := by
  calc ‖M^2‖ ≤ ‖M‖ * ‖M‖ := by simpa only [pow_two] using norm_mul_le M M
       _ ≤ 1 * 1 := mul_le_mul hM hM (norm_nonneg _) zero_le_one
       _ = 1 := one_mul _

theorem mixedAB_norm_le : ‖mixedAB‖ ≤ 1 := by
  have he : mixedAB = (1/2 : ℝ) • (axisA*axisB+axisB*axisA) := by
    have h := congrArg matrixOperator mixedMatrixAB_sym
    simpa only [map_smul, map_add, map_mul, mixedAB, axisA, axisB] using h
  rw [he, norm_smul]
  have hab := (norm_mul_le axisA axisB).trans
    (mul_le_mul axisA_norm_le axisB_norm_le (norm_nonneg _) zero_le_one)
  have hba := (norm_mul_le axisB axisA).trans
    (mul_le_mul axisB_norm_le axisA_norm_le (norm_nonneg _) zero_le_one)
  have hsum := norm_add_le (axisA*axisB) (axisB*axisA)
  norm_num at hab hba ⊢
  linarith

theorem mixedAAB_norm_le : ‖mixedAAB‖ ≤ 1 := by
  have he : mixedAAB = (-1/12 : ℝ) • axisB := by
    simp only [mixedAAB, mixedMatrixAAB, map_smul, axisB]
  rw [he, norm_smul]
  norm_num
  linarith [axisB_norm_le]

theorem mixedABB_norm_le : ‖mixedABB‖ ≤ 1 := by
  have he : mixedABB = (-1/12 : ℝ) • axisA := by
    simp only [mixedABB, mixedMatrixABB, map_smul, axisA]
  rw [he, norm_smul]
  norm_num
  linarith [axisA_norm_le]

theorem mixedAABB_norm_le : ‖mixedAABB‖ ≤ 1 := by
  have he : mixedAABB = (-1/24 : ℝ) • (axisA^2+axisB^2) := by
    simp only [mixedAABB, mixedMatrixAABB, map_smul, map_add, map_pow, axisA, axisB]
  rw [he, norm_smul]
  have hsum := norm_add_le (axisA^2) (axisB^2)
  have ha := norm_square_le_one axisA axisA_norm_le
  have hb := norm_square_le_one axisB axisB_norm_le
  norm_num
  linarith


namespace SpinSystem
variable {V E : Type*} [Fintype V] [Fintype E]

omit [Fintype V] [Fintype E] in
theorem abs_localInner_le_one (S : SpinSystem V E) (M : SpinOperator 4)
    (hM : ‖M‖ ≤ 1) (σ : V → RP3.Spin) (e : E) :
    |S.localInner M σ e| ≤ 1 :=
  (abs_inner_operator_le _ _ _).trans hM

omit [Fintype V] [Fintype E] in
theorem abs_mixedCoefficient_le_sixteen (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β) (s : MixedAlgebra.Slot)
    (σ : V → RP3.Spin) (e : E) :
    |(S.mixedCoefficients σ).get s e| ≤ 16 * β := by
  let I := fun M => S.localInner M σ e
  have hβ : 0 ≤ β := (abs_nonneg _).trans (hb e)
  have hi (M : SpinOperator 4) (hM : ‖M‖ ≤ 1) : |I M| ≤ 1 :=
    S.abs_localInner_le_one M hM σ e
  have hm (M N : SpinOperator 4) (hM : ‖M‖ ≤ 1) (hN : ‖N‖ ≤ 1) :
      |I M * I N| ≤ 1 := by
    rw [abs_mul]
    simpa only [one_mul] using mul_le_mul (hi M hM) (hi N hN)
      (abs_nonneg _) zero_le_one
  have h1 : ‖(1 : SpinOperator 4)‖ ≤ 1 := norm_one.le
  have hAA := norm_square_le_one axisA axisA_norm_le
  have hBB := norm_square_le_one axisB axisB_norm_le
  have ha := hm 1 axisA h1 axisA_norm_le
  have hb' := hm 1 axisB h1 axisB_norm_le
  have haa : |I axisA ^ 2 + I 1 * I (axisA^2)| ≤ 2 := by
    rw [pow_two]
    exact (abs_add_le _ _).trans (by linarith [hm axisA axisA axisA_norm_le axisA_norm_le, hm 1 (axisA^2) h1 hAA])
  have hab : |I axisA * I axisB + I 1 * I mixedAB| ≤ 2 :=
    (abs_add_le _ _).trans (by linarith [hm axisA axisB axisA_norm_le axisB_norm_le, hm 1 mixedAB h1 mixedAB_norm_le])
  have hbb : |I axisB ^ 2 + I 1 * I (axisB^2)| ≤ 2 := by
    rw [pow_two]
    exact (abs_add_le _ _).trans (by linarith [hm axisB axisB axisB_norm_le axisB_norm_le, hm 1 (axisB^2) h1 hBB])
  have htwo (M N : SpinOperator 4) (hM : ‖M‖ ≤ 1) (hN : ‖N‖ ≤ 1) :
      |2 * I M * I N| ≤ 2 := by
    rw [mul_assoc, abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 2)]
    linarith [hm M N hM hN]
  have haab : |I axisB * I (axisA^2) + 2 * I axisA * I mixedAB +
      I 1 * I mixedAAB| ≤ 4 := by
    calc _ ≤ |I axisB * I (axisA^2) + 2 * I axisA * I mixedAB| +
        |I 1 * I mixedAAB| := abs_add_le _ _
      _ ≤ |I axisB * I (axisA^2)| + |2 * I axisA * I mixedAB| +
        |I 1 * I mixedAAB| := add_le_add (abs_add_le _ _) le_rfl
      _ ≤ 4 := by linarith [hm axisB (axisA^2) axisB_norm_le hAA, htwo axisA mixedAB axisA_norm_le mixedAB_norm_le, hm 1 mixedAAB h1 mixedAAB_norm_le]
  have habb : |I axisA * I (axisB^2) + 2 * I axisB * I mixedAB +
      I 1 * I mixedABB| ≤ 4 := by
    calc _ ≤ |I axisA * I (axisB^2) + 2 * I axisB * I mixedAB| +
        |I 1 * I mixedABB| := abs_add_le _ _
      _ ≤ |I axisA * I (axisB^2)| + |2 * I axisB * I mixedAB| +
        |I 1 * I mixedABB| := add_le_add (abs_add_le _ _) le_rfl
      _ ≤ 4 := by linarith [hm axisA (axisB^2) axisA_norm_le hBB, htwo axisB mixedAB axisB_norm_le mixedAB_norm_le, hm 1 mixedABB h1 mixedABB_norm_le]
  have haabb : |I (axisA^2) * I (axisB^2) + 2 * (I mixedAB)^2 +
      2 * I axisA * I mixedABB + 2 * I axisB * I mixedAAB + I 1 * I mixedAABB| ≤ 8 := by
    have hAB : |2 * (I mixedAB)^2| ≤ 2 := by
      simpa only [pow_two, mul_assoc] using htwo mixedAB mixedAB mixedAB_norm_le mixedAB_norm_le
    calc _ ≤ |I (axisA^2) * I (axisB^2) + 2 * (I mixedAB)^2 +
        2 * I axisA * I mixedABB + 2 * I axisB * I mixedAAB| + |I 1 * I mixedAABB| :=
        abs_add_le _ _
      _ ≤ (|I (axisA^2) * I (axisB^2) + 2 * (I mixedAB)^2 +
        2 * I axisA * I mixedABB| + |2 * I axisB * I mixedAAB|) + |I 1 * I mixedAABB| :=
        add_le_add (abs_add_le _ _) le_rfl
      _ ≤ ((|I (axisA^2) * I (axisB^2) + 2 * (I mixedAB)^2| +
        |2 * I axisA * I mixedABB|) + |2 * I axisB * I mixedAAB|) + |I 1 * I mixedAABB| :=
        add_le_add (add_le_add (abs_add_le _ _) le_rfl) le_rfl
      _ ≤ (((|I (axisA^2) * I (axisB^2)| + |2 * (I mixedAB)^2|) +
        |2 * I axisA * I mixedABB|) + |2 * I axisB * I mixedAAB|) + |I 1 * I mixedAABB| :=
        add_le_add (add_le_add (add_le_add (abs_add_le _ _) le_rfl) le_rfl) le_rfl
      _ ≤ 8 := by linarith [hm (axisA^2) (axisB^2) hAA hBB, hAB, htwo axisA mixedABB axisA_norm_le mixedABB_norm_le, htwo axisB mixedAAB axisB_norm_le mixedAAB_norm_le, hm 1 mixedAABB h1 mixedAABB_norm_le]
  have hs (p : ℝ) (hp : |p| ≤ 8) : |2 * S.strength e * p| ≤ 16 * β := by
    simp only [abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 2)]
    calc 2 * |S.strength e| * |p| ≤ 2 * β * 8 :=
      mul_le_mul (mul_le_mul_of_nonneg_left (hb e) (by norm_num)) hp (abs_nonneg _) (by positivity)
      _ = 16 * β := by ring
  cases s with
  | a => simpa only [MixedAlgebra.Coeffs.get, mixedCoefficients, mul_assoc] using (hs (I 1 * I axisA) (ha.trans (by norm_num)))
  | b => simpa only [MixedAlgebra.Coeffs.get, mixedCoefficients, mul_assoc] using (hs (I 1 * I axisB) (hb'.trans (by norm_num)))
  | aa => exact hs _ (haa.trans (by norm_num))
  | ab => exact hs _ (hab.trans (by norm_num))
  | bb => exact hs _ (hbb.trans (by norm_num))
  | aab => exact hs _ (haab.trans (by norm_num))
  | abb => exact hs _ (habb.trans (by norm_num))
  | aabb => exact hs _ haabb

end SpinSystem
end
end RP3.Quadratic
end StandalonePart43

/- ===== RP3/QuadraticFamilyKernel.lean ===== -/
section StandalonePart44
/-!
# Actual finite-family observables for RP³
Adapted from OpenAI ClassicalON FamilyKernel/FamilyBound, commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a (Apache-2.0, copyright OpenAI).
-/
namespace RP3.Quadratic
universe uV uE uI uJ uΩ
noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
open RP3.Fourier
open scoped BigOperators InnerProductSpace ComplexConjugate
namespace SpinSystem
variable {V : Type uV} {E : Type uE} {I : Type uI} [Fintype V] [Fintype E] [Fintype I]

omit [Fintype V] [Fintype I] in
def currentObservable (S : SpinSystem V E) (M : SpinOperator 4) (u : E → ℂ) :
    C((V → RP3.Spin), ℂ) := ⟨_, S.continuous_complexCurrent M u⟩

omit [Fintype V] [Fintype I] in
def mixedCoefficientObservable (S : SpinSystem V E) (a : MixedAlgebra.Slot) (e : E) :
    C((V → RP3.Spin), ℂ) := ⟨fun σ => ((S.mixedCoefficients σ).get a e : ℂ), by
  cases a <;> unfold MixedAlgebra.Coeffs.get mixedCoefficients localInner <;> fun_prop⟩

omit [Fintype V] [Fintype I] in
def mixedWeightedObservable (S : SpinSystem V E) (a : MixedAlgebra.Slot) (u : E → ℂ) :
    C((V → RP3.Spin), ℂ) := ∑ e, S.mixedCoefficientObservable a e * ContinuousMap.const _ (u e)

omit [Fintype V] [Fintype I] [Fintype E] in
def conjugateObservable {Ω : Type uΩ} [TopologicalSpace Ω] (f : C(Ω, ℂ)) : C(Ω, ℂ) :=
  ⟨fun σ => conj (f σ), Complex.continuous_conj.comp f.continuous⟩

omit [Fintype V] [Fintype I] [Fintype E] in
@[simp] theorem conjugateObservable_apply {Ω : Type uΩ} [TopologicalSpace Ω]
    (f : C(Ω, ℂ)) (σ : Ω) : conjugateObservable f σ = conj (f σ) := rfl

omit [Fintype V] [Fintype I] [Fintype E] in
@[simp] theorem normObservable_conjugate {Ω : Type uΩ} [TopologicalSpace Ω]
    (f : C(Ω, ℂ)) : normObservable (conjugateObservable f) = normObservable f := by
  ext σ
  exact Complex.norm_conj (f σ)


omit [Fintype V] [Fintype I] in
@[simp] theorem currentObservable_conj (S : SpinSystem V E) (M : SpinOperator 4)
    (u : E → ℂ) : S.currentObservable M (fun e => conj (u e)) =
      conjugateObservable (S.currentObservable M u) := by
  ext σ
  exact S.complexCurrent_conj M u σ

omit [Fintype V] [Fintype I] in
@[simp] theorem mixedCoefficientObservable_conj (S : SpinSystem V E)
    (a : MixedAlgebra.Slot) (e : E) :
    conjugateObservable (S.mixedCoefficientObservable a e) = S.mixedCoefficientObservable a e := by
  ext σ
  exact Complex.conj_ofReal _

omit [Fintype V] [Fintype E] in
theorem familyKernel_differential (S : SpinSystem V E) (f : I → V → ℂ) (e : E) :
    familyKernel (fun i => S.edgeGradient (f i)) e =
      S.edgeGradient (fun x => ∑ i, S.edgeGradient (f i) e * conj (f i x)) := by
  funext l
  simp only [familyKernel, edgeGradient, map_sub, mul_sub, Finset.sum_sub_distrib]

theorem row_current_moment (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β)
    (M : SpinOperator 4) (hM : M ∈ skewAdjoint (SpinOperator 4)) (hMn : ‖M‖ ≤ 1)
    (f : I → V → ℂ) (hP : ∀ i x s, S.pin x = some s → f i x = 0) (e : E) :
    S.averageLinear (normObservable (S.currentObservable M
      (familyKernel (fun i => S.edgeGradient (f i)) e)) *
      normObservable (S.currentObservable M
      (familyKernel (fun i => S.edgeGradient (f i)) e))) ≤
        4 * β * rowSquare (fun i => S.edgeGradient (f i)) e := by
  have hp : ∀ x s, S.pin x = some s →
      (∑ i, S.edgeGradient (f i) e * conj (f i x)) = 0 := by
    intro x s hs
    simp [hP _ x s hs]
  have h := S.complex_gradient_current_bound β hb M hM hMn
    (fun x => ∑ i, S.edgeGradient (f i) e * conj (f i x)) hp
  rw [← S.familyKernel_differential f e] at h
  change S.average (fun σ =>
    ‖S.complexCurrent M (familyKernel (fun i => S.edgeGradient (f i)) e) σ‖ *
    ‖S.complexCurrent M (familyKernel (fun i => S.edgeGradient (f i)) e) σ‖) ≤ _
  simpa only [rowSquare, ← Complex.sq_norm, pow_two] using h

omit [Fintype V] [Fintype E] [Fintype I] in
theorem mixedCoefficientObservable_norm_le (S : SpinSystem V E) (β : ℝ)
    (hb : ∀ e, |S.strength e| ≤ β)
    (a : MixedAlgebra.Slot) (e : E) (σ : V → RP3.Spin) :
    ‖S.mixedCoefficientObservable a e σ‖ ≤ 16 * β := by
  change ‖(((S.mixedCoefficients σ).get a e : ℝ) : ℂ)‖ ≤ _
  rw [Complex.norm_real, Real.norm_eq_abs]
  exact S.abs_mixedCoefficient_le_sixteen β hb a σ e

omit [Fintype I] in
theorem averageComplex_pos_square (S : SpinSystem V E) (F : C((V → RP3.Spin), ℂ)) :
    0 ≤ (S.averageComplexLinear (F * conjugateObservable F)).re := by
  rw [S.averageComplex_re]
  apply S.averageLinear_nonneg
  intro σ
  change 0 ≤ (F σ * conj (F σ)).re
  rw [Complex.mul_conj, Complex.ofReal_re]
  exact Complex.normSq_nonneg _

omit [Fintype I] in
theorem norm_averageComplex_sum_le {J : Type uJ} [Fintype J]
    (S : SpinSystem V E) (F : J → C((V → RP3.Spin), ℂ)) (bound : J → ℝ)
    (hF : ∀ j, ‖S.averageComplexLinear (F j)‖ ≤ bound j) :
    ‖S.averageComplexLinear (∑ j, F j)‖ ≤ ∑ j, bound j := by
  rw [map_sum]
  exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => hF j)

def familyPaired (S : SpinSystem V E) (u : I → E → ℂ) : C((V → RP3.Spin), ℂ) :=
  ∑ i, (S.currentObservable axisA (u i) *
    S.currentObservable axisB (fun e => conj (u i e)) +
    S.mixedWeightedObservable .ab (fun e => u i e * conj (u i e)))

def familyRemainder (S : SpinSystem V E) (u : I → E → ℂ) : C((V → RP3.Spin), ℂ) :=
  let T := familyKernel u
  let X := fun M e => S.currentObservable M (T e)
  let C := S.mixedCoefficientObservable
  let bar := conjugateObservable
  let k := fun z => ContinuousMap.const (V → RP3.Spin) z
  (∑ e, C .aa e * X axisB e * bar (X axisB e)) +
  (∑ e, C .ab e * X axisB e * X axisA e) +
  (∑ e, C .ab e * bar (X axisA e) * bar (X axisB e)) +
  (∑ e, C .bb e * bar (X axisA e) * X axisA e) +
  (∑ e, ∑ l, C .aa e * C .bb l * k (T e l * conj (T e l))) +
  (∑ e, ∑ l, C .ab e * C .ab l * k (T e l ^ 2)) +
  (∑ e, C .aab e * k (T e e) * bar (X axisB e)) +
  (∑ e, C .abb e * k (T e e) * X axisA e) +
  (∑ e, C .aab e * k (conj (T e e)) * X axisB e) +
  (∑ e, C .abb e * k (conj (T e e)) * bar (X axisA e)) +
  (∑ e, C .aabb e * k (T e e * conj (T e e)))

omit [Fintype V] in

theorem familyObservable_contraction (S : SpinSystem V E) (u : I → E → ℂ) :
    (∑ i, ∑ j, S.complexMixedObservable (u i) (fun e => conj (u i e))
      (fun e => conj (u j e)) (u j)) =
        S.familyPaired u * conjugateObservable (S.familyPaired u) + S.familyRemainder u := by
  ext σ
  have h := MixedAlgebra.four_family_contraction (S.complexCoefficients σ) u
    (fun i e => conj (u i e)) (fun i e => conj (u i e)) u
  simp only [ContinuousMap.sum_apply, ContinuousMap.mul_apply, ContinuousMap.add_apply,
    complexMixedObservable, ContinuousMap.coe_mk]
  rw [h]
  simp only [familyPaired, familyRemainder, ContinuousMap.sum_apply,
    ContinuousMap.add_apply, ContinuousMap.mul_apply, conjugateObservable_apply,
    ContinuousMap.const_apply, currentObservable, mixedCoefficientObservable,
    ContinuousMap.coe_mk, MixedAlgebra.paired, MixedAlgebra.kernel,
    familyKernel, complexCoefficients, MixedAlgebra.Coeffs.map,
    mixedCoefficients, Function.comp_def, Complex.ofRealHom_eq_coe,
    complexCurrent_eq_sum, mixedWeightedObservable, MixedAlgebra.Coeffs.get, localInner,
    map_sum, map_add, map_mul,
    starRingEnd_self_apply, pow_two]
  congr 1
  all_goals simp only [MixedAlgebra.weighted, MixedAlgebra.kernel, familyKernel,
    map_sum, map_mul, map_add, map_ofNat, Complex.conj_ofReal,
    starRingEnd_self_apply, Pi.mul_apply, Complex.ofReal_mul, Complex.ofReal_add,
    Complex.ofReal_pow, one_apply_eq_self, mul_assoc]


end SpinSystem
end
end RP3.Quadratic
end StandalonePart44

/- ===== RP3/QuadraticFamilyEstimates.lean ===== -/
section StandalonePart45

/-! # Quantitative contraction estimates for quadratic RP³
Adapted from OpenAI ClassicalON/FamilyEstimate, commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a (Apache-2.0, copyright OpenAI).
-/
namespace RP3.Quadratic
universe uV uE
noncomputable section
open RP3.Rotation hiding Spin
open scoped BigOperators InnerProductSpace ComplexConjugate
namespace SpinSystem
variable {V : Type uV} {E : Type uE} [Fintype V] [Fintype E]

theorem norm_avg_coeff_two (S : SpinSystem V E) (M v : ℝ) (hM : 0 ≤ M)
    (hcoeff : ∀ a e σ, ‖S.mixedCoefficientObservable a e σ‖ ≤ M)
    (a : MixedAlgebra.Slot) (e : E) (F G : C((V → RP3.Spin), ℂ))
    (hF : S.averageLinear (normObservable F * normObservable F) ≤ v)
    (hG : S.averageLinear (normObservable G * normObservable G) ≤ v) :
    ‖S.averageComplexLinear (S.mixedCoefficientObservable a e * F * G)‖ ≤ M*v :=
  S.norm_averageComplex_mul_mul_le_of_moments _ F G M v hM (hcoeff a e) hF hG

theorem norm_avg_coeff_coeff_const (S : SpinSystem V E) (M : ℝ) (hM : 0 ≤ M)
    (hcoeff : ∀ a e σ, ‖S.mixedCoefficientObservable a e σ‖ ≤ M)
    (a b : MixedAlgebra.Slot) (e l : E) (z : ℂ) :
    ‖S.averageComplexLinear (S.mixedCoefficientObservable a e *
      S.mixedCoefficientObservable b l * ContinuousMap.const _ z)‖ ≤ M^2*‖z‖ := by
  apply S.norm_averageComplex_le_const
  intro σ
  simp only [ContinuousMap.mul_apply, ContinuousMap.const_apply, norm_mul]
  apply mul_le_mul_of_nonneg_right _ (norm_nonneg z)
  rw [pow_two]
  exact mul_le_mul (hcoeff a e σ) (hcoeff b l σ) (norm_nonneg _) hM

theorem norm_avg_coeff_const_current (S : SpinSystem V E) (M q : ℝ)
    (hM : 0 ≤ M) (hq : 0 ≤ q)
    (hcoeff : ∀ a e σ, ‖S.mixedCoefficientObservable a e σ‖ ≤ M)
    (a : MixedAlgebra.Slot) (e : E) (z : ℂ)
    (hz : ‖z‖ ≤ Real.sqrt q) (F : C((V → RP3.Spin), ℂ))
    (hF : S.averageLinear (normObservable F * normObservable F) ≤ M*q) :
    ‖S.averageComplexLinear (S.mixedCoefficientObservable a e * ContinuousMap.const _ z * F)‖ ≤
      M*Real.sqrt M*q := by
  have hC (σ : V → RP3.Spin) :
      ‖(S.mixedCoefficientObservable a e * ContinuousMap.const (V → RP3.Spin) z) σ‖ ≤ M*‖z‖ := by
    simp only [ContinuousMap.mul_apply, ContinuousMap.const_apply, norm_mul]
    exact mul_le_mul_of_nonneg_right (hcoeff a e σ) (norm_nonneg z)
  calc _ ≤ (M*‖z‖)*Real.sqrt (M*q) :=
        S.norm_averageComplex_mul_le_of_moment _ F (M*‖z‖) (M*q)
          (mul_nonneg hM (norm_nonneg z)) hC hF
       _ ≤ (M*Real.sqrt q)*Real.sqrt (M*q) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hz hM) (Real.sqrt_nonneg _)
       _ = M*Real.sqrt M*q := by
          rw [Real.sqrt_mul hM]
          calc _ = M*Real.sqrt M*(Real.sqrt q*Real.sqrt q) := by ring
               _ = _ := by rw [Real.mul_self_sqrt hq]

theorem norm_avg_coeff_const (S : SpinSystem V E) (M : ℝ)
    (hcoeff : ∀ a e σ, ‖S.mixedCoefficientObservable a e σ‖ ≤ M)
    (a : MixedAlgebra.Slot) (e : E) (z : ℂ) :
    ‖S.averageComplexLinear (S.mixedCoefficientObservable a e * ContinuousMap.const _ z)‖ ≤ M*‖z‖ := by
  apply S.norm_averageComplex_le_const
  intro σ
  simp only [ContinuousMap.mul_apply, ContinuousMap.const_apply, norm_mul]
  exact mul_le_mul_of_nonneg_right (hcoeff a e σ) (norm_nonneg z)

end SpinSystem
end
end RP3.Quadratic
end StandalonePart45

/- ===== RP3/QuadraticFamilyLower.lean ===== -/
section StandalonePart46

namespace RP3.Quadratic

universe uE uI uV

noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
open RP3.Fourier
open scoped BigOperators InnerProductSpace ComplexConjugate

namespace SpinSystem
variable {V : Type uV} {E : Type uE} {I : Type uI} [Fintype V] [Fintype E] [Fintype I]

theorem norm_avg_row_sum (S : SpinSystem V E) (u : I → E → ℂ)
    (F : E → C((V → RP3.Spin), ℂ)) (c : ℝ)
    (hF : ∀ e, ‖S.averageComplexLinear (F e)‖ ≤ c * rowSquare u e) :
    ‖S.averageComplexLinear (∑ e, F e)‖ ≤ c * familyHSSquare u := by
  simpa only [familyHSSquare, Finset.mul_sum] using
    S.norm_averageComplex_sum_le F (fun e => c * rowSquare u e) hF

omit [Fintype I] in
theorem norm_avg_add_le (S : SpinSystem V E) (F G : C((V → RP3.Spin), ℂ))
    (a b : ℝ) (hF : ‖S.averageComplexLinear F‖ ≤ a)
    (hG : ‖S.averageComplexLinear G‖ ≤ b) :
    ‖S.averageComplexLinear (F+G)‖ ≤ a+b := by
  rw [map_add]
  exact (norm_add_le _ _).trans (add_le_add hF hG)

theorem norm_familyRemainder_le (S : SpinSystem V E) (β : ℝ) (hβ : 0 ≤ β)
    (hb : ∀ e, |S.strength e| ≤ β)
    (f : I → V → ℂ) (hP : ∀ i x s, S.pin x = some s → f i x = 0) :
    ‖S.averageComplexLinear (S.familyRemainder (fun i => S.edgeGradient (f i)))‖ ≤
      (6*(16*β)^2+4*(16*β)*Real.sqrt (16*β)+16*β) * familyHSSquare (fun i => S.edgeGradient (f i)) := by
  let B : ℝ := 16*β
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hcoeff : ∀ a e σ, ‖S.mixedCoefficientObservable a e σ‖ ≤ B :=
    fun a e σ => S.mixedCoefficientObservable_norm_le β hb a e σ
  let u := fun i => S.edgeGradient (f i)
  let T := familyKernel u
  let X := fun M e => S.currentObservable M (T e)
  let C := S.mixedCoefficientObservable
  let bar := conjugateObservable (Ω := V → RP3.Spin)
  let k : ℂ → C((V → RP3.Spin), ℂ) := ContinuousMap.const (V → RP3.Spin)
  let H := familyHSSquare u
  have ha (e : E) : S.averageLinear (normObservable (X axisA e) * normObservable (X axisA e)) ≤
      B * rowSquare u e := (S.row_current_moment β hb axisA axisA_skew axisA_norm_le f hP e).trans
        (mul_le_mul_of_nonneg_right (by dsimp [B]; linarith) (rowSquare_nonneg u e))
  have hb' (e : E) : S.averageLinear (normObservable (X axisB e) * normObservable (X axisB e)) ≤
      B * rowSquare u e := (S.row_current_moment β hb axisB axisB_skew axisB_norm_le f hP e).trans
        (mul_le_mul_of_nonneg_right (by dsimp [B]; linarith) (rowSquare_nonneg u e))
  have hac (e : E) : S.averageLinear (normObservable (bar (X axisA e)) *
      normObservable (bar (X axisA e))) ≤ B * rowSquare u e := by
    simpa only [bar, normObservable_conjugate] using ha e
  have hbc (e : E) : S.averageLinear (normObservable (bar (X axisB e)) *
      normObservable (bar (X axisB e))) ≤ B * rowSquare u e := by
    simpa only [bar, normObservable_conjugate] using hb' e
  have row (a : MixedAlgebra.Slot)
      (F G : E → C((V → RP3.Spin), ℂ))
      (hF : ∀ e, S.averageLinear (normObservable (F e)*normObservable (F e)) ≤ B*rowSquare u e)
      (hG : ∀ e, S.averageLinear (normObservable (G e)*normObservable (G e)) ≤ B*rowSquare u e) :
      ‖S.averageComplexLinear (∑ e, C a e * F e * G e)‖ ≤ B^2*H := by
    apply S.norm_avg_row_sum u _ (B^2)
    intro e
    exact (S.norm_avg_coeff_two B (B*rowSquare u e) hB hcoeff a e (F e) (G e)
      (hF e) (hG e)).trans_eq (by ring)
  have b1 := row .aa
    (X axisB) (fun e => bar (X axisB e)) hb' hbc
  have b2 := row .ab (X axisB) (X axisA) hb' ha
  have b3 := row .ab (fun e => bar (X axisA e))
    (fun e => bar (X axisB e)) hac hbc
  have b4 := row .bb
    (fun e => bar (X axisA e)) (X axisA) hac ha
  have pair (a b : MixedAlgebra.Slot)
      (z : E → E → ℂ) (hz : ∀ e l, ‖z e l‖ = ‖T e l‖^2) :
      ‖S.averageComplexLinear (∑ e, ∑ l, C a e * C b l * k (z e l))‖ ≤ B^2*H := by
    apply S.norm_avg_row_sum u _ (B^2)
    intro e
    calc _ ≤ ∑ l, B^2*‖T e l‖^2 := by
          apply S.norm_averageComplex_sum_le
          intro l
          exact (S.norm_avg_coeff_coeff_const B hB hcoeff a b e l (z e l)).trans_eq
            (by rw [hz e l])
         _ = _ := by rw [← Finset.mul_sum]; rfl
  have b5 := pair .aa .bb (fun e l => T e l*conj (T e l))
    (by intro e l; simp only [norm_mul, Complex.norm_conj, pow_two])
  have b6 := pair .ab .ab (fun e l => T e l^2)
    (by intro e l; exact norm_pow _ _)
  have triple (a : MixedAlgebra.Slot)
      (z : E → ℂ) (hz : ∀ e, ‖z e‖ ≤ Real.sqrt (rowSquare u e))
      (F : E → C((V → RP3.Spin), ℂ))
      (hF : ∀ e, S.averageLinear (normObservable (F e)*normObservable (F e)) ≤ B*rowSquare u e) :
      ‖S.averageComplexLinear (∑ e, C a e * k (z e) * F e)‖ ≤ B*Real.sqrt B*H := by
    apply S.norm_avg_row_sum u _ (B*Real.sqrt B)
    intro e
    exact S.norm_avg_coeff_const_current B (rowSquare u e) hB (rowSquare_nonneg u e)
      hcoeff a e (z e) (hz e) (F e) (hF e)
  have hz (e : E) : ‖T e e‖ ≤ Real.sqrt (rowSquare u e) := kernel_diag_norm_le_sqrt u e
  have hzc (e : E) : ‖conj (T e e)‖ ≤ Real.sqrt (rowSquare u e) := by
    rw [Complex.norm_conj]; exact hz e
  have b7 := triple .aab (fun e => T e e) hz
    (fun e => bar (X axisB e)) hbc
  have b8 := triple .abb (fun e => T e e) hz (X axisA) ha
  have b9 := triple .aab (fun e => conj (T e e)) hzc (X axisB) hb'
  have b10 := triple .abb (fun e => conj (T e e)) hzc
    (fun e => bar (X axisA e)) hac
  have b11 : ‖S.averageComplexLinear (∑ e, C .aabb e * k (T e e*conj (T e e)))‖ ≤ B*H := by
    apply S.norm_avg_row_sum u _ B
    intro e
    calc _ ≤ B*‖T e e*conj (T e e)‖ := S.norm_avg_coeff_const B hcoeff .aabb e _
         _ = B*‖T e e‖^2 := by rw [norm_mul, Complex.norm_conj, pow_two]
         _ ≤ B*rowSquare u e := mul_le_mul_of_nonneg_left (kernel_diag_sq_le_row u e) hB
  have hadd := S.norm_avg_add_le
  have h := hadd _ _ _ _ (hadd _ _ _ _ (hadd _ _ _ _ (hadd _ _ _ _ (hadd _ _ _ _
    (hadd _ _ _ _ (hadd _ _ _ _ (hadd _ _ _ _ (hadd _ _ _ _ (hadd _ _ _ _ b1 b2)
      b3) b4) b5) b6) b7) b8) b9) b10) b11
  change ‖S.averageComplexLinear (S.familyRemainder u)‖ ≤ _ at h ⊢
  exact h.trans_eq (by dsimp only [H, B]; ring)

theorem fourth_family_lower (S : SpinSystem V E) (β : ℝ) (hβ : 0 ≤ β)
    (hb : ∀ e, |S.strength e| ≤ β)
    (f : I → V → ℂ) (hP : ∀ i x s, S.pin x = some s → f i x = 0) :
    -((6*(16*β)^2+4*(16*β)*Real.sqrt (16*β)+16*β)*familyHSSquare (fun i => S.edgeGradient (f i))) ≤
      (S.averageComplexLinear (∑ i, ∑ j,
        S.complexMixedObservable (S.edgeGradient (f i)) (fun e => conj (S.edgeGradient (f i) e))
          (fun e => conj (S.edgeGradient (f j) e)) (S.edgeGradient (f j)))).re := by
  rw [S.familyObservable_contraction, map_add, Complex.add_re]
  have hp := S.averageComplex_pos_square (S.familyPaired (fun i => S.edgeGradient (f i)))
  have hr := S.norm_familyRemainder_le β hβ hb f hP
  have hre := (abs_le.mp (Complex.abs_re_le_norm (S.averageComplexLinear
    (S.familyRemainder (fun i => S.edgeGradient (f i)))))).1
  linarith

end SpinSystem

end

end RP3.Quadratic
end StandalonePart46

/- ===== RP3/QuadraticFamily.lean ===== -/
section StandalonePart47
/-!
# Fourth-order family inequality for pinned quadratic RP³ systems
Adapted from OpenAI ClassicalON/RotationInequality, commit
adc7f1241b42e322a6451854ab7e4b4c146bf78a (Apache-2.0, copyright OpenAI).
The mixed coefficients, Ward identities, and bounds are all the proved
quadratic-interaction versions.
-/
namespace RP3.Quadratic
universe uV uE uI
noncomputable section
open MeasureTheory
open RP3.Rotation hiding Spin
open RP3.Fourier
open scoped BigOperators InnerProductSpace ComplexConjugate
namespace SpinSystem
variable {V : Type uV} {E : Type uE} {I : Type uI} [Fintype V] [Fintype E] [Fintype I]
omit [Fintype I] in
def complexSecondBilin (S : SpinSystem V E) : (E → ℂ) →ₗ[ℂ] (E → ℂ) →ₗ[ℂ] ℂ where
  toFun u := {
    toFun := S.complexSecondResponse u
    map_add' := S.complexSecondResponse_add_right u
    map_smul' := fun r v => by simpa only [smul_eq_mul, RingHom.id_apply] using S.complexSecondResponse_smul_right u v r }
  map_add' u v := by ext w; exact S.complexSecondResponse_add_left u v w
  map_smul' r u := by
    ext v
    change S.complexSecondResponse (r • u) v = r * S.complexSecondResponse u v
    exact S.complexSecondResponse_smul_left u v r

omit [Fintype V] [Fintype E] [Fintype I] in
theorem commutatorForm_antisymm (S : SpinSystem V E) (f g : V → ℂ) :
    S.commutatorForm g f = -S.commutatorForm f g := by
  ext e
  simp only [commutatorForm, complexCross, Pi.neg_apply, Pi.smul_apply, smul_eq_mul]
  ring

omit [Fintype V] [Fintype E] [Fintype I] in
theorem commutatorForm_conj (S : SpinSystem V E) (f g : V → ℂ) :
    S.commutatorForm (fun x => conj (f x)) (fun x => conj (g x)) =
      (fun e => conj (S.commutatorForm f g e)) := by
  ext e
  simp only [commutatorForm, complexCross, Pi.smul_apply, smul_eq_mul,
    map_mul, map_sub, map_div₀, map_one, map_ofNat]

omit [Fintype I] in
theorem complexMixedResponse_commutator (S : SpinSystem V E) (f g h k : V → ℂ)
    (hf : ∀ x s, S.pin x = some s → f x = 0)
    (hg : ∀ x s, S.pin x = some s → g x = 0)
    (hh : ∀ x s, S.pin x = some s → h x = 0)
    (hk : ∀ x s, S.pin x = some s → k x = 0) :
    S.complexMixedResponse (S.edgeGradient f) (S.edgeGradient g)
      (S.edgeGradient h) (S.edgeGradient k) =
      S.complexSecondResponse (S.commutatorForm f g) (S.commutatorForm h k) +
        S.complexSecondResponse (S.commutatorForm f k) (S.commutatorForm h g) := by
  have hw := S.complexMixedResponse_ward f g h k hf hg hh hk
  simp only [commutatorForm, S.complexSecondResponse_smul_left, S.complexSecondResponse_smul_right]
  linear_combination (1/4 : ℂ) * hw

omit [Fintype I] in
theorem complexMixedResponse_paired (S : SpinSystem V E) (f g : V → ℂ)
    (hf : ∀ x s, S.pin x = some s → f x = 0)
    (hg : ∀ x s, S.pin x = some s → g x = 0) :
    S.complexMixedResponse (S.edgeGradient f) (fun e => conj (S.edgeGradient f e))
      (fun e => conj (S.edgeGradient g e)) (S.edgeGradient g) =
      S.complexSecondResponse (S.commutatorForm f (fun x => conj (f x)))
        (fun e => conj (S.commutatorForm g (fun x => conj (g x)) e)) -
      S.complexSecondResponse (S.commutatorForm f g) (fun e => conj (S.commutatorForm f g e)) := by
  have hfc : ∀ x s, S.pin x = some s → conj (f x) = 0 := by
    intro x s hs; rw [hf x s hs, map_zero]
  have hgc : ∀ x s, S.pin x = some s → conj (g x) = 0 := by
    intro x s hs; rw [hg x s hs, map_zero]
  have h := S.complexMixedResponse_commutator f (fun x => conj (f x))
    (fun x => conj (g x)) g hf hfc hgc hg
  have df (a : V → ℂ) : S.edgeGradient (fun x => conj (a x)) =
      fun e => conj (S.edgeGradient a e) := by ext e; simp only [edgeGradient, map_sub]
  have cc : S.commutatorForm (fun x => conj (g x)) g =
      (fun e => conj (S.commutatorForm g (fun x => conj (g x)) e)) := by
    simpa only [starRingEnd_self_apply] using S.commutatorForm_conj g (fun x => conj (g x))
  have cd : S.commutatorForm (fun x => conj (g x)) (fun x => conj (f x)) =
      -(fun e => conj (S.commutatorForm f g e)) := by
    rw [S.commutatorForm_antisymm, S.commutatorForm_conj]
  rw [df f, df g, cc, cd] at h
  change S.complexMixedResponse _ _ _ _ = S.complexSecondBilin _ _ + S.complexSecondBilin _ (-_) at h
  simpa only [map_neg, sub_eq_add_neg, complexSecondBilin, LinearMap.coe_mk, AddHom.coe_mk] using h

theorem rotation_family_bound (S : SpinSystem V E) (β : ℝ) (hβ : 0 ≤ β)
    (hb : ∀ e, |S.strength e| ≤ β)
    (f : I → V → ℂ) (hP : ∀ i x s, S.pin x = some s → f i x = 0) :
    -(S.complexSecondResponse (∑ i, S.commutatorForm (f i) (fun x => conj (f i x)))
      (fun e => conj ((∑ i, S.commutatorForm (f i) (fun x => conj (f i x))) e))).re ≤
      (6*(16*β)^2+4*(16*β)*Real.sqrt (16*β)+16*β) * familyHSSquare (fun i => S.edgeGradient (f i)) +
        (4*β)*∑ i, ∑ j, min (‖f i‖^2*∑ e, ‖S.edgeGradient (f j) e‖^2)
          (‖f j‖^2*∑ e, ‖S.edgeGradient (f i) e‖^2) := by
  let Q := ∑ i, S.commutatorForm (f i) (fun x => conj (f i x))
  have hsum : S.complexSecondResponse Q (fun e => conj (Q e)) =
      ∑ i, ∑ j, S.complexSecondResponse (S.commutatorForm (f i) (fun x => conj (f i x)))
        (fun e => conj (S.commutatorForm (f j) (fun x => conj (f j x)) e)) := by
    have hq : (fun e => conj (Q e)) = ∑ i, (fun e => conj (S.commutatorForm (f i) (fun x => conj (f i x)) e)) := by
      ext e; simp only [Q, Finset.sum_apply, map_sum]
    rw [hq]
    change S.complexSecondBilin (∑ i, _) (∑ j, _) = _
    simp only [map_sum, LinearMap.sum_apply]
    rw [Finset.sum_comm]
    rfl
  have hid : (∑ i, ∑ j, S.complexMixedResponse (S.edgeGradient (f i))
      (fun e => conj (S.edgeGradient (f i) e)) (fun e => conj (S.edgeGradient (f j) e))
        (S.edgeGradient (f j))) = S.complexSecondResponse Q (fun e => conj (Q e)) -
      ∑ i, ∑ j, S.complexSecondResponse (S.commutatorForm (f i) (f j))
        (fun e => conj (S.commutatorForm (f i) (f j) e)) := by
    simp only [S.complexMixedResponse_paired _ _ (hP _) (hP _),
      Finset.sum_sub_distrib, hsum]
  have hl := S.fourth_family_lower β hβ hb f hP
  simp only [map_sum] at hl
  have hu : ∑ i, ∑ j, -(S.complexSecondResponse (S.commutatorForm (f i) (f j))
        (fun e => conj (S.commutatorForm (f i) (f j) e))).re ≤
      (4*β)*∑ i, ∑ j, min (‖f i‖^2*∑ e, ‖S.edgeGradient (f j) e‖^2)
        (‖f j‖^2*∑ e, ‖S.edgeGradient (f i) e‖^2) := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro i _
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun j _ =>
      S.commutatorForm_bound β hβ hb (f i) (f j) (hP i) (hP j)
  have hir := congrArg Complex.re hid
  simp only [Complex.sub_re, complexMixedResponse] at hir
  simp only [Complex.re_sum, Finset.sum_neg_distrib] at hir hl hu
  change -(S.complexSecondResponse Q (fun e => conj (Q e))).re ≤ _
  linarith


end SpinSystem
end
end RP3.Quadratic
end StandalonePart47

/- ===== RP3/Fourier/AnnulusResponse.lean ===== -/
section StandalonePart48

/-!
# Uniform inverse-logarithmic annular response of the RP³ model

This file substitutes the actual squared-interaction response in the proved
Fourier estimates. All pins are arbitrary directors, including at intermediate
rotation angles. The graph may omit vertices and edges.
-/
namespace RP3.Fourier
noncomputable section
open scoped BigOperators ComplexConjugate
namespace LatticeGraph

theorem profile_response_bound (G : LatticeGraph) (k : ℕ) (hk : 0 < k)
    (hG : G.WithinDyadicBox k) (β : ℝ) (hβ : 0 ≤ β)
    (b : G.edges → ℝ) (hb : ∀ e, |b e| ≤ β)
    (P : G.vertices → Option RP3.Spin) (hP : G.BoundaryPins k P)
    (C : ℝ) (hC : 0 ≤ C) (hv : ∀ m s z, |squareProfile m s z| ≤ C)
    (hLip : ∀ m s z w, |squareProfile m s w-squareProfile m s z| ≤ C*‖w-z‖) :
    -(G.spinSystem b P).secondAxisResponse (G.profileEdge k) (G.profileEdge k) ≤
      rotationCostConstant (16*β) C/(k:ℝ) := by
  have h := (G.spinSystem b P).rotation_family_bound β hβ hb (G.modes (k := k))
    (fun i x s hs => G.modes_zero_pins k P hP i x s hs)
  have hd : (fun i : ModeIndex k => (G.spinSystem b P).edgeGradient (G.modes i)) =
      G.modeDifferences := rfl
  rw [G.system_modes_commutator k b P,
    (G.spinSystem b P).response_imaginary_multiple, hd] at h
  have hde (i : ModeIndex k) (e : G.edges) :
      (G.spinSystem b P).edgeGradient (G.modes i) e = G.modeDifferences i e := rfl
  simp only [hde] at h
  apply G.profile_response_bound_of_family k hk hG (16*β) (by positivity) C hC hv hLip
  refine le_trans (by simpa only [neg_mul] using h) ?_
  gcongr <;> linarith

theorem theta_response_bound (G : LatticeGraph) (k : ℕ) (hk : 0 < k)
    (hG : G.WithinDyadicBox k) (β : ℝ) (hβ : 0 ≤ β)
    (b : G.edges → ℝ) (hb : ∀ e, |b e| ≤ β)
    (P : G.vertices → Option RP3.Spin) (hP : G.BoundaryPins k P)
    (C L D : ℝ) (hC : 0 ≤ C) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hv : ∀ m s z, |squareProfile m s z| ≤ C)
    (hLip : ∀ m s z w, |squareProfile m s w-squareProfile m s z| ≤ C*‖w-z‖)
    (he : ∀ e : G.edges, |G.thetaEdge k e| ≤ L/(2:ℝ)^k ∧
      |G.thetaEdge k e-G.profileEdge k e| ≤ D/((2:ℝ)^k)^3) :
    -(G.spinSystem b P).secondAxisResponse (G.thetaEdge k) (G.thetaEdge k) ≤
      rotationCostConstant (16*β) C/(k:ℝ)+transferCostConstant (16*β) L D/(2:ℝ)^k := by
  let a := rotationCostConstant (16*β) C/(k:ℝ)
  have ha : 0 ≤ a := div_nonneg (rotationCostConstant_nonneg _ _ (by positivity)) (Nat.cast_nonneg _)
  have hp := G.profile_response_bound k hk hG β hβ b hb P hP C hC hv hLip
  have ht := (G.spinSystem b P).real_response_transfer β a hβ ha hb
    (G.thetaEdge k) (G.profileEdge k) hp
  apply G.theta_response_bound_of_transfer k hG (16*β) L D a
    ((G.spinSystem b P).secondAxisResponse (G.thetaEdge k) (G.thetaEdge k))
    (by positivity) hL hD he
  apply ht.trans
  gcongr <;> linarith

/-- The analytic input is now proved for the actual RP³ Gibbs expectation,
uniformly over all finite retained annular graphs and all pinned directors. -/
theorem annulus_response_inverse_scale (β : ℝ) (hβ : 0 ≤ β) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (k : ℕ), 4 ≤ k →
      ∀ (G : LatticeGraph), G.WithinDyadicBox k →
      ∀ (b : G.edges → ℝ), (∀ e, |b e| ≤ β) →
      ∀ (P : G.vertices → Option RP3.Spin), G.BoundaryPins k P →
        -(G.spinSystem b P).secondAxisResponse (G.thetaEdge k) (G.thetaEdge k) ≤ K/(k:ℝ) := by
  obtain ⟨C,hC,hv,hLip⟩ := profiles_uniform_bound
  obtain ⟨L,D,hL,hD,he⟩ := theta_edge_bounds
  let A := rotationCostConstant (16*β) C
  let B := transferCostConstant (16*β) L D
  have hA : 0 ≤ A := rotationCostConstant_nonneg _ _ (by positivity)
  have hB : 0 ≤ B := transferCostConstant_nonneg _ _ _ (by positivity) hL hD
  refine ⟨A+B, add_nonneg hA hB, ?_⟩
  intro k hk G hG b hb P hP
  exact (G.theta_response_bound k (by omega) hG β hβ b hb P hP C L D (by linarith)
    hL hD hv hLip (he G k hk)).trans (dyadic_error_le_inverse_scale k (by omega) A B hB)

end LatticeGraph
end
end RP3.Fourier
end StandalonePart48

/- ===== RP3/AnnularEstimate.lean ===== -/
section StandalonePart49

/-! Uniform periodic boundary-rotation estimates for the squared RP³ model.
Adapted from OpenAI ClassicalON/AnnulusPartition.lean, Apache-2.0. -/

namespace RP3

noncomputable section
open RP3.Rotation hiding Spin
open RP3.Quadratic
namespace Fourier.LatticeGraph

def thetaPotential (G : LatticeGraph) (k : ℕ) (x : G.vertices) : ℝ :=
  squareTheta (scaledSite k x.val)

def rotatedBoundaryPins (G : LatticeGraph) (k : ℕ) (P : G.vertices → Option (RP3.Spin))
    (t : ℝ) : G.vertices → Option (RP3.Spin) :=
  fun x => (P x).map (spinRotation (Quadratic.SpinSystem.potentialRotation (G.thetaPotential k) t x))

theorem thetaPotential_binary_pins (G : LatticeGraph) (k : ℕ)
    (P : G.vertices → Option (RP3.Spin)) (hP : G.BoundaryPins k P) :
    ∀ x s, P x=some s → G.thetaPotential k x=0 ∨ G.thetaPotential k x=1 := by
  intro x s hs
  rcases hP x s hs with h | h
  · exact Or.inr (squareTheta_one _ h.1 h.2)
  · exact Or.inl (squareTheta_zero _ h)

theorem rotatedBoundaryPins_boundary (G : LatticeGraph) (k : ℕ)
    (P : G.vertices → Option (RP3.Spin)) (hP : G.BoundaryPins k P) (t : ℝ) :
    G.BoundaryPins k (G.rotatedBoundaryPins k P t) := by
  intro x s hs
  cases hp : P x with
  | none => simp [rotatedBoundaryPins,hp] at hs
  | some u => exact hP x u hp

theorem rotatePotential_spinSystem (G : LatticeGraph) (k : ℕ) (b : G.edges → ℝ)
    (P : G.vertices → Option (RP3.Spin)) (t : ℝ) :
    (G.spinSystem b P).rotatePotential (G.thetaPotential k) t =
      G.spinSystem b (G.rotatedBoundaryPins k P t) := rfl


/-- Quantitative ratio comparison at every sufficiently large dyadic scale. -/
theorem annulus_partition_inverse_scale (β : ℝ) (hβ : 0 ≤ β) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ k : ℕ, 4 ≤ k →
      ∀ G : LatticeGraph, G.WithinDyadicBox k →
      ∀ b : G.edges → ℝ, (∀ e, |b e| ≤ β) →
      ∀ P : G.vertices → Option RP3.Spin, G.BoundaryPins k P → ∀ x y : ℝ,
      1-D/(k:ℝ) ≤ (G.spinSystem b (G.rotatedBoundaryPins k P x)).Z (fun _ => 1) /
        (G.spinSystem b (G.rotatedBoundaryPins k P y)).Z (fun _ => 1) := by
  obtain ⟨K, hK, hresponse⟩ := annulus_response_inverse_scale β hβ
  refine ⟨K*(4*Real.pi)^2/2, by positivity, ?_⟩
  intro k hk G hG b hb P hP x y
  have hp := G.thetaPotential_binary_pins k P hP
  have hr (t : ℝ) :
      -((G.spinSystem b P).rotatePotential (G.thetaPotential k) t).secondAxisResponse
        ((G.spinSystem b P).edgeGradient (G.thetaPotential k))
        ((G.spinSystem b P).edgeGradient (G.thetaPotential k)) ≤ K/(k:ℝ) := by
    exact hresponse k hk G hG b hb (G.rotatedBoundaryPins k P t)
      (G.rotatedBoundaryPins_boundary k P hP t)
  have h := (G.spinSystem b P).potential_partition_ratio (G.thetaPotential k)
    (K/(k:ℝ)) (div_nonneg hK (Nat.cast_nonneg k)) hp hr x y
  simp only [rotatePotential_spinSystem] at h
  convert h using 1 <;> ring

end Fourier.LatticeGraph
end
end RP3
end StandalonePart49

/- ===== RP3/QuaternionComparison.lean ===== -/
section StandalonePart50

/-!
# From one periodic axis estimate to the quaternion comparison

The only analytic input is the pointwise comparison for the axis-C cut rotation.
Global rotational invariance transfers it to each coordinate axis.  The exact
three-factor decomposition then gives the finite-group kernel comparison.
-/
namespace RP3

noncomputable section
open Rotation

variable {V : Type*} [DecidableEq V]

/-- Rotate every spin of a configuration by the same quaternion element. -/
def globalMove (g : E4 ≃ₗᵢ[ℝ] E4) (σ : Configuration V) : Configuration V :=
  fun v => Rotation.spinRotation g (σ v)

/-- Rotate only sites in a cut by an arbitrary orthogonal transformation. -/
def rotateCut (cut : Finset V) (R : E4 ≃ₗᵢ[ℝ] E4)
    (σ : Configuration V) : Configuration V :=
  fun v => if v ∈ cut then Rotation.spinRotation R (σ v) else σ v

/-- One coordinate-axis rotation localized to a cut. -/
def coordinateCut (cut : Finset V) (a : Fin 3) (t : ℝ)
    (σ : Configuration V) : Configuration V :=
  rotateCut cut (coordinateRotation a t) σ

theorem global_coordinateCut_intertwine (cut : Finset V) (a : Fin 3) (t : ℝ)
    (σ : Configuration V) :
    globalMove (axisConjugator a) (coordinateCut cut a t σ) =
      coordinateCut cut 2 t (globalMove (axisConjugator a) σ) := by
  funext v
  by_cases hv : v ∈ cut
  · simpa only [globalMove, coordinateCut, rotateCut, hv, ite_true] using
      spinRotation_intertwine_axisC a t (σ v)
  · simp only [globalMove, coordinateCut, rotateCut, hv, ite_false]

/-- Global invariance transports the single-axis analytic estimate to all axes. -/
theorem coordinateCut_comparison_of_axisC (K : Configuration V → ℝ)
    (hglobal : ∀ g σ, K (globalMove g σ) = K σ)
    (cut : Finset V) (η : ℝ)
    (hC : ∀ t σ, (1 - η) * K (coordinateCut cut 2 t σ) ≤ K σ)
    (a : Fin 3) (t : ℝ) (σ : Configuration V) :
    (1 - η) * K (coordinateCut cut a t σ) ≤ K σ := by
  have h := hC t (globalMove (axisConjugator a) σ)
  rw [← global_coordinateCut_intertwine, hglobal, hglobal] at h
  exact h

/-- The quaternion cut action is the composition of three coordinate cut rotations. -/
theorem quaternionCut_eq_three_coordinateCuts (cut : Finset V) (g : Quaternion)
    (σ : Configuration V) :
    (quaternionAction.onCut cut).move g σ =
      coordinateCut cut (quaternionPathAxis g 0) (quaternionPathAngle g 0)
        (coordinateCut cut (quaternionPathAxis g 1) (quaternionPathAngle g 1)
          (coordinateCut cut (quaternionPathAxis g 2) (quaternionPathAngle g 2) σ)) := by
  funext v
  by_cases hv : v ∈ cut
  · simp only [FiniteAction.onCut_apply, coordinateCut, rotateCut, hv, ite_true]
    apply Subtype.ext
    exact quaternionLinearIsometry_eq_three_rotations g (σ v).val
  · simp only [FiniteAction.onCut_apply, coordinateCut, rotateCut, hv, ite_false]

/-- Three comparisons multiply to a cube, which is at least `1 - 3η` on `[0,1]`. -/
theorem quaternionCut_comparison_of_axisC (K : Configuration V → ℝ)
    (hK : ∀ σ, 0 ≤ K σ)
    (hglobal : ∀ g σ, K (globalMove g σ) = K σ)
    (cut : Finset V) {η : ℝ} (hη0 : 0 ≤ η) (hη1 : η ≤ 1)
    (hC : ∀ t σ, (1 - η) * K (coordinateCut cut 2 t σ) ≤ K σ)
    (g : Quaternion) (σ : Configuration V) :
    (1 - 3 * η) * K ((quaternionAction.onCut cut).move g σ) ≤ K σ := by
  let σ₁ := coordinateCut cut (quaternionPathAxis g 2) (quaternionPathAngle g 2) σ
  let σ₂ := coordinateCut cut (quaternionPathAxis g 1) (quaternionPathAngle g 1) σ₁
  let σ₃ := coordinateCut cut (quaternionPathAxis g 0) (quaternionPathAngle g 0) σ₂
  have h₁ : (1 - η) * K σ₁ ≤ K σ :=
    coordinateCut_comparison_of_axisC K hglobal cut η hC _ _ _
  have h₂ : (1 - η) * K σ₂ ≤ K σ₁ :=
    coordinateCut_comparison_of_axisC K hglobal cut η hC _ _ _
  have h₃ : (1 - η) * K σ₃ ≤ K σ₂ :=
    coordinateCut_comparison_of_axisC K hglobal cut η hC _ _ _
  have hc : 0 ≤ 1 - η := sub_nonneg.mpr hη1
  have hpow : (1 - η)^3 * K σ₃ ≤ K σ := by
    calc
      (1 - η)^3 * K σ₃ = (1 - η) * ((1 - η) * ((1 - η) * K σ₃)) := by ring
      _ ≤ (1 - η) * ((1 - η) * K σ₂) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h₃ hc) hc
      _ ≤ (1 - η) * K σ₁ := mul_le_mul_of_nonneg_left h₂ hc
      _ ≤ K σ := h₁
  have hb : 1 - 3 * η ≤ (1 - η)^3 := by
    nlinarith [mul_nonneg (sq_nonneg η) (show 0 ≤ 3 - η by linarith)]
  rw [quaternionCut_eq_three_coordinateCuts]
  exact (mul_le_mul_of_nonneg_right hb (hK σ₃)).trans hpow

end
end RP3
end StandalonePart50

/- ===== RP3/SquareRates.lean ===== -/
section StandalonePart51

/-! Quantitative assembly of the dyadic kernel estimate into a uniform bound
for actual square-lattice correlations. -/
namespace RP3
noncomputable section
open Finset
open RP3.Fourier

def dyadicRadius (a j : ℕ) : ℕ := 2^(a+2*j)

theorem dyadicRadius_eq (a j : ℕ) : RP3.dyadicRadius a j = 2^a * 4^j := by
  simp only [dyadicRadius, pow_add, pow_mul]
  norm_num

theorem dyadicRadius_separated (a i j : ℕ) (hij : i < j) :
    2*RP3.dyadicRadius a i < RP3.dyadicRadius a j := by
  rw [dyadicRadius_eq, dyadicRadius_eq]
  have hp : 4^(i+1) ≤ (4:ℕ)^j := pow_le_pow_right₀ (by norm_num) hij
  have ha : 0 < (2:ℕ)^a := by positivity
  have hi : 0 < (4:ℕ)^i := by positivity
  rw [pow_succ] at hp
  nlinarith

theorem dyadic_factor_le {D : ℝ} (hD : 0 ≤ D) {a : ℕ} (ha : 2 ≤ a) (j : ℕ) :
    D / (a+2*(j:ℝ)) ≤ (D/2)/(j+1) := by
  have haR : (2:ℝ) ≤ a := by exact_mod_cast ha
  calc
    D / (a+2*(j:ℝ)) ≤ D / ((j+1)*2) :=
      div_le_div_of_nonneg_left hD (by positivity) (by linarith)
    _ = _ := by rw [div_div]; congr 1; ring

namespace Fourier.LatticeGraph

/-- The exact comparison proposition required at all large dyadic scales.
It refers to actual pinned RP³ integrals, never abstract kernel certificates. -/
def DyadicKernelComparison (β D : ℝ) (a : ℕ) : Prop :=
  ∀ n : ℕ, a ≤ n → ∀ (G : LatticeGraph) (b : G.edges → ℝ),
    (∀ e, 0 ≤ b e ∧ b e ≤ β) → ∀ (z : Site) (g : Quaternion) τ,
      (1-D/(n:ℝ)) * pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (2^n:ℕ) z) b) (G.strictLayer (2^n:ℕ) z)ᶜ
        ((quaternionAction.onCut (G.innerCut (2^n:ℕ) z)).move g τ) ≤
      pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (2^n:ℕ) z) b) (G.strictLayer (2^n:ℕ) z)ᶜ τ

/-- The dyadic comparison for arbitrary real couplings bounded in absolute value. -/
def SignedDyadicKernelComparison (β D : ℝ) (a : ℕ) : Prop :=
  ∀ n : ℕ, a ≤ n → ∀ (G : LatticeGraph) (b : G.edges → ℝ),
    (∀ e, |b e| ≤ β) → ∀ (z : Site) (g : Quaternion) τ,
      (1-D/(n:ℝ)) * pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (2^n:ℕ) z) b) (G.strictLayer (2^n:ℕ) z)ᶜ
        ((quaternionAction.onCut (G.innerCut (2^n:ℕ) z)).move g τ) ≤
      pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (2^n:ℕ) z) b) (G.strictLayer (2^n:ℕ) z)ᶜ τ

/-- A comparison for signed couplings includes the ferromagnetic case. -/
theorem SignedDyadicKernelComparison.toNonnegative {β D : ℝ} {a : ℕ}
    (h : SignedDyadicKernelComparison β D a) : DyadicKernelComparison β D a := by
  intro n hn G b hb z g τ
  exact h n hn G b (fun e => by rw [abs_of_nonneg (hb e).1]; exact (hb e).2) z g τ

/-- Assembly uses only the comparisons for the chosen graph and couplings;
no sign condition on those couplings enters the positive-kernel argument. -/
theorem factorial_of_dyadic_kernel_bounds {D : ℝ} (hD : 0 < D)
    (a : ℕ) (ha : 2 ≤ a) (G : LatticeGraph) (b : G.edges → ℝ)
    (hcomp : ∀ n : ℕ, a ≤ n → ∀ (z : Site) (g : Quaternion) τ,
      (1-D/(n:ℝ)) * pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (2^n:ℕ) z) b) (G.strictLayer (2^n:ℕ) z)ᶜ
        ((quaternionAction.onCut (G.innerCut (2^n:ℕ) z)).move g τ) ≤
      pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (2^n:ℕ) z) b) (G.strictLayer (2^n:ℕ) z)ᶜ τ)
    (x y : G.vertices) :
    let r := (siteRadius x.val y.val).toNat
    let k := annulusCount (2^a) r (by positivity)
    |correlation (fun e : G.edges => e.val) b x y| ≤ (3 : ℝ) / 4 * (D/2)^k/k.factorial := by
  classical
  dsimp only
  let r := (siteRadius x.val y.val).toNat
  let k := annulusCount (2^a) r (by positivity)
  let N : Fin k → ℤ := fun i => RP3.dyadicRadius a i
  let ε : Fin k → ℝ := fun i => D/(a+2*(i.val:ℝ))
  have hN (i : Fin k) : 2 ≤ N i := by
    have hpow : 2^1 ≤ (2:ℕ)^(a+2*i.val) :=
      pow_le_pow_right₀ (by norm_num) (by omega)
    dsimp [N, RP3.dyadicRadius]
    norm_num only [pow_one] at hpow
    exact_mod_cast hpow
  have hsep (i j : Fin k) (hij : i < j) : 2*N i < N j := by
    dsimp [N]
    exact_mod_cast dyadicRadius_separated a i.val j.val hij
  have hfar (i : Fin k) : 2*N i < siteRadius x.val y.val := by
    have hi := annulusCount_inside (2^a) r (by positivity) i.isLt
    have he : 2*(RP3.dyadicRadius a i.val) < r := by
      simpa only [dyadicRadius_eq, mul_assoc] using hi
    have hr : (r:ℤ) = siteRadius x.val y.val :=
      Int.toNat_of_nonneg (siteRadius_nonneg _ _)
    have hiR : 2*N i < (r:ℤ) := by
      dsimp [N]
      exact_mod_cast he
    rwa [hr] at hiR
  have hε (i : Fin k) : 0 < ε i := by
    apply div_pos hD
    have haR : (2:ℝ) ≤ a := by exact_mod_cast ha
    positivity
  have hc := G.square_annuli_product_bound b k N hN hsep x y hfar ε hε
    (by
      intro i g τ
      have h := hcomp (a+2*i.val) (by omega) x.val g τ
      simpa only [ε, N, RP3.dyadicRadius, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat] using h)
  have hp := annular_product_le_factorial (fun j => D/(a+2*(j:ℝ))) (D/2)
    (by positivity) (fun j => div_nonneg hD.le (by positivity)) (dyadic_factor_le hD.le ha) k
  have hprod : (∏ i : Fin k, ε i) = ∏ j ∈ range k, D/(a+2*(j:ℝ)) := by
    exact Fin.prod_univ_eq_prod_range (fun j => D/(a+2*(j:ℝ))) k
  rw [hprod] at hc
  calc
    _ ≤ (3 : ℝ) / 4 * ∏ j ∈ range k, D/(a+2*(j:ℝ)) := hc
    _ ≤ (3 : ℝ) / 4 * ((D/2)^k/k.factorial) := by gcongr
    _ = _ := by ring


/-- The factorial bound is uniform in the retained graph and admissible couplings. -/
theorem factorial_of_dyadic_comparison_signed {β D : ℝ} (hD : 0 < D)
    (a : ℕ) (ha : 2 ≤ a) (hcomp : SignedDyadicKernelComparison β D a)
    (G : LatticeGraph) (b : G.edges → ℝ) (hb : ∀ e, |b e| ≤ β)
    (x y : G.vertices) :
    let r := (siteRadius x.val y.val).toNat
    let k := annulusCount (2^a) r (by positivity)
    |correlation (fun e : G.edges => e.val) b x y| ≤ (3 : ℝ) / 4 * (D/2)^k/k.factorial := by
  exact factorial_of_dyadic_kernel_bounds hD a ha G b
    (fun n hn z g τ => hcomp n hn G b hb z g τ) x y

/-- The factorial bound is uniform in the retained graph and admissible couplings. -/
theorem factorial_of_dyadic_comparison {β D : ℝ} (hD : 0 < D)
    (a : ℕ) (ha : 2 ≤ a) (hcomp : DyadicKernelComparison β D a)
    (G : LatticeGraph) (b : G.edges → ℝ) (hb : ∀ e, 0 ≤ b e ∧ b e ≤ β)
    (x y : G.vertices) :
    let r := (siteRadius x.val y.val).toNat
    let k := annulusCount (2^a) r (by positivity)
    |correlation (fun e : G.edges => e.val) b x y| ≤ (3 : ℝ) / 4 * (D/2)^k/k.factorial := by
  exact factorial_of_dyadic_kernel_bounds hD a ha G b
    (fun n hn z g τ => hcomp n hn G b hb z g τ) x y

end Fourier.LatticeGraph
end
end RP3
end StandalonePart51

/- ===== RP3/KernelEstimate.lean ===== -/
section StandalonePart52

/-!
# Uniform quaternion comparison for actual annular RP³ kernels

This module connects the analytic annulus estimate, the exact restricted and
translated Gibbs integral, and the finite rotational averaging group.
-/
namespace RP3
noncomputable section
open scoped Classical
open Rotation hiding Spin
open Quadratic
open Fourier

variable {V : Type*} [DecidableEq V]

theorem coordinateCut_zero (cut : Finset V) (a : Fin 3) (τ : Configuration V) :
    coordinateCut cut a 0 τ = τ := by
  funext v
  by_cases hv : v ∈ cut
  · apply Subtype.ext
    simpa only [coordinateCut, rotateCut, hv, ite_true, spinRotation_val] using
      coordinateRotation_zero a (τ v).val
  · simp only [coordinateCut, rotateCut, hv, ite_false]

namespace Fourier

theorem scaledSite_inner_of_radius {n : ℕ} {x : Site}
    (h : siteRadius 0 x ≤ (2:ℤ)^n) :
    |(scaledSite n x).1| ≤ 1 ∧ |(scaledSite n x).2| ≤ 1 := by
  have hn : 0 < (2:ℝ)^n := by positivity
  have hxy : |x.1| ≤ (2:ℤ)^n ∧ |x.2| ≤ (2:ℤ)^n := by
    simpa only [siteRadius, Prod.fst_zero, Prod.snd_zero, sub_zero, max_le_iff] using h
  have hx : |(x.1:ℝ)| ≤ (2:ℝ)^n := by exact_mod_cast hxy.1
  have hy : |(x.2:ℝ)| ≤ (2:ℝ)^n := by exact_mod_cast hxy.2
  simpa only [scaledSite, abs_div, abs_of_pos hn, div_le_one hn] using And.intro hx hy

theorem scaledSite_outer_of_radius {n : ℕ} {x : Site}
    (h : 2*(2:ℤ)^n ≤ siteRadius 0 x) :
    2 ≤ |(scaledSite n x).1| ∨ 2 ≤ |(scaledSite n x).2| := by
  have hn : 0 < (2:ℝ)^n := by positivity
  have hxy : 2*(2:ℤ)^n ≤ |x.1| ∨ 2*(2:ℤ)^n ≤ |x.2| := by
    simpa only [siteRadius, Prod.fst_zero, Prod.snd_zero, sub_zero, le_max_iff] using h
  rcases hxy with hx | hy
  · left
    have hxR : 2*(2:ℝ)^n ≤ |(x.1:ℝ)| := by exact_mod_cast hx
    simpa only [scaledSite, abs_div, abs_of_pos hn, le_div_iff₀ hn] using hxR
  · right
    have hyR : 2*(2:ℝ)^n ≤ |(x.2:ℝ)| := by exact_mod_cast hy
    simpa only [scaledSite, abs_div, abs_of_pos hn, le_div_iff₀ hn] using hyR

namespace LatticeGraph

/-- The continuum cutoff takes exactly the required values on both lattice
boundary layers, including nonconstant prescribed spin arrays. -/
theorem thetaPotential_of_boundary_radius (H : LatticeGraph) (n : ℕ)
    (v : H.vertices)
    (hv : siteRadius 0 v.val = (2:ℤ)^n ∨ siteRadius 0 v.val = 2*(2:ℤ)^n) :
    H.thetaPotential n v = if siteRadius 0 v.val ≤ (2:ℤ)^n then 1 else 0 := by
  by_cases hi : siteRadius 0 v.val ≤ (2:ℤ)^n
  · simp only [hi, ite_true, thetaPotential]
    exact squareTheta_one _ (scaledSite_inner_of_radius hi).1
      (scaledSite_inner_of_radius hi).2
  · simp only [hi, ite_false, thetaPotential]
    have ho : siteRadius 0 v.val = 2*(2:ℤ)^n :=
      hv.resolve_left (fun h => hi h.le)
    exact squareTheta_zero _ (scaledSite_outer_of_radius ho.ge)

/-- The actual full-graph annular kernel satisfies the uniform axis-C
comparison, with constants independent of graph and pinned spins. -/
theorem full_kernel_axisC_comparison (β : ℝ) (hβ : 0 ≤ β) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ n : ℕ, 4 ≤ n →
      ∀ (G : LatticeGraph) (b : G.edges → ℝ), (∀ e, |b e| ≤ β) →
      ∀ (z : Site) (t : ℝ) (τ : Configuration G.vertices),
      (1-D/(n:ℝ)) * pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (2^n) z) b) (G.strictLayer (2^n) z)ᶜ
        (coordinateCut (G.innerCut (2^n) z) 2 t τ) ≤
      pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (2^n) z) b) (G.strictLayer (2^n) z)ᶜ τ := by
  obtain ⟨D, hD, hratio⟩ := annulus_partition_inverse_scale β hβ
  refine ⟨D, hD, ?_⟩
  intro n hn G b hb z t τ
  let H := (G.annulusGraph (2^n) z).translate z
  let B : H.edges → ℝ := fun e => maskedCoupling (G.kernelEdges (2^n) z) b
    (G.restrictEdge (· ∈ annulusSites (2^n) z)
      (((G.annulusGraph (2^n) z).translateEdgeEquiv z).symm e))
  let pins : Finset H.vertices :=
    (G.annulusGraph (2^n) z).translatePins z (G.annulusPinFinset (2^n) z)
  let original : H.vertices → G.vertices := G.annulusOriginalVertex (2^n) z
  let P : H.vertices → Option RP3.Spin :=
    fun v => if v ∈ pins then some (τ (original v)) else none
  let τt : ℝ → Configuration H.vertices := fun s v =>
    coordinateCut (G.innerCut (2^n) z) 2 s τ (original v)
  have hB : ∀ e, |B e| ≤ β := by
    intro e
    dsimp only [B, maskedCoupling]
    split_ifs
    · exact hb _
    · simpa using hβ
  have hpRadius (v : H.vertices) (hv : v ∈ pins) :
      siteRadius 0 v.val = (2:ℤ)^n ∨ siteRadius 0 v.val = 2*(2:ℤ)^n :=
    G.translated_annulus_pin_radius (2^n) z v hv
  have hP : H.BoundaryPins n P := by
    intro v s hs
    by_cases hv : v ∈ pins
    · rcases hpRadius v hv with hi | ho
      · exact Or.inl (scaledSite_inner_of_radius hi.le)
      · exact Or.inr (scaledSite_outer_of_radius ho.ge)
    · simp only [P, hv, ite_false] at hs
      cases hs
  have hpin (s : ℝ) : H.rotatedBoundaryPins n P s =
      (fun v => if v ∈ pins then some (τt s v) else none) := by
    funext v
    by_cases hv : v ∈ pins
    · simp only [rotatedBoundaryPins, P, hv, ite_true, Option.map_some]
      apply congrArg some
      apply Subtype.ext
      have hθ := H.thetaPotential_of_boundary_radius n v (hpRadius v hv)
      have hr := G.annulusOriginalVertex_radius (2^n) z v
      by_cases hi : siteRadius 0 v.val ≤ (2:ℤ)^n
      · simp only [hi, ite_true] at hθ
        simp only [τt, coordinateCut, rotateCut, original, mem_innerCut,
          annulusOriginalVertex_radius, hi, ite_true, spinRotation_val,
          SpinSystem.potentialRotation, hθ, mul_one,
          coordinateRotation_apply, coordinateAxis, rotationExp_apply]
        try rfl
      · simp only [hi, ite_false] at hθ
        simp only [τt, coordinateCut, rotateCut, original, mem_innerCut,
          annulusOriginalVertex_radius, hi, ite_false, spinRotation_val,
          SpinSystem.potentialRotation, hθ, mul_zero, zero_smul ℝ axisC,
          rotationExp_apply, NormedSpace.exp_zero, one_apply_eq_self]
    · simp only [rotatedBoundaryPins, P, hv, ite_false, Option.map_none]
  have hZ (s : ℝ) : (H.spinSystem B (H.rotatedBoundaryPins n P s)).Z (fun _ => 1) =
      pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (2^n) z) b) (G.strictLayer (2^n) z)ᶜ
        (coordinateCut (G.innerCut (2^n) z) 2 s τ) := by
    rw [hpin]
    change (Quadratic.pinnedSystem (fun e : H.edges => e.val) B pins (τt s)).Z
      (fun _ => 1) = _
    rw [Quadratic.pinnedSystem_partition]
    exact (G.pinnedKernel_centered_annulus (2^n) z b
      (coordinateCut (G.innerCut (2^n) z) 2 s τ)).symm
  have h := hratio n hn H (G.translated_annulus_within_box n z) B hB P hP 0 t
  rw [hZ, hZ, coordinateCut_zero] at h
  exact (le_div_iff₀ (pinnedPartition_pos _ _ _ _)).mp h

/-- All analytic and geometric obligations for the actual quaternion kernel
comparison are now discharged. -/
theorem exists_dyadicKernelComparison_signed (β : ℝ) (hβ : 0 ≤ β) :
    ∃ (D : ℝ) (a : ℕ), 0 < D ∧ 4 ≤ a ∧ SignedDyadicKernelComparison β D a := by
  obtain ⟨D, hD, haxis⟩ := full_kernel_axisC_comparison β hβ
  obtain ⟨m, hm⟩ := exists_nat_gt (D+1)
  refine ⟨3*(D+1), max 4 m, by positivity, le_max_left _ _, ?_⟩
  intro n hn G b hb z g τ
  simp only [Nat.cast_pow, Nat.cast_ofNat]
  let K := fun υ => pinnedKernel (fun e : G.edges => e.val)
    (maskedCoupling (G.kernelEdges (2^n) z) b) (G.strictLayer (2^n) z)ᶜ υ
  have hn4 : 4 ≤ n := (le_max_left _ _).trans hn
  have hnpos : (0:ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have hnD : D+1 ≤ (n:ℝ) := by
    have hmn : (m:ℝ) ≤ n := by exact_mod_cast ((le_max_right 4 m).trans hn)
    linarith
  have hK : ∀ υ, 0 ≤ K υ := fun υ => (pinnedPartition_pos _ _ _ υ).le
  have hglobal : ∀ h υ, K (globalMove h υ) = K υ := by
    intro h υ
    exact pinnedPartition_globalRotation _ _ _ h υ
  have hC : ∀ s υ, (1-(D+1)/(n:ℝ)) * K (coordinateCut (G.innerCut (2^n) z) 2 s υ) ≤ K υ := by
    intro s υ
    have hh := haxis n hn4 G b hb z s υ
    have hfactor : 1-(D+1)/(n:ℝ) ≤ 1-D/(n:ℝ) := by
      apply sub_le_sub_left
      exact div_le_div_of_nonneg_right (by linarith) hnpos.le
    exact (mul_le_mul_of_nonneg_right hfactor (hK _)).trans hh
  have h := quaternionCut_comparison_of_axisC K hK hglobal (G.innerCut (2^n) z)
    (div_nonneg (by positivity) hnpos.le) ((div_le_one hnpos).mpr hnD) hC g τ
  convert h using 1 <;> ring

theorem dyadic_kernel_comparison_signed (β : ℝ) (hβ : 0 ≤ β) :
    ∃ D > 0, ∃ a : ℕ, 2 ≤ a ∧ SignedDyadicKernelComparison β D a := by
  obtain ⟨D, a, hD, ha, hcomp⟩ := exists_dyadicKernelComparison_signed β hβ
  exact ⟨D, hD, a, by omega, hcomp⟩
/-- The original ferromagnetic comparison is a consequence of the signed one. -/
theorem exists_dyadicKernelComparison (β : ℝ) (hβ : 0 ≤ β) :
    ∃ (D : ℝ) (a : ℕ), 0 < D ∧ 4 ≤ a ∧ DyadicKernelComparison β D a := by
  obtain ⟨D, a, hD, ha, hcomp⟩ := exists_dyadicKernelComparison_signed β hβ
  exact ⟨D, a, hD, ha, hcomp.toNonnegative⟩

theorem dyadic_kernel_comparison (β : ℝ) (hβ : 0 ≤ β) :
    ∃ D > 0, ∃ a : ℕ, 2 ≤ a ∧ DyadicKernelComparison β D a := by
  obtain ⟨D, hD, a, ha, hcomp⟩ := dyadic_kernel_comparison_signed β hβ
  exact ⟨D, hD, a, ha, hcomp.toNonnegative⟩

end LatticeGraph
end Fourier
end
end RP3
end StandalonePart52

/- ===== RP3/ThinKernel.lean ===== -/
section StandalonePart53

/-! Exact restriction and centering of arbitrary-width annular kernels. -/
namespace RP3.Fourier.LatticeGraph
noncomputable section
open scoped Classical
open RP3

def thinAnnulusGraph (G : LatticeGraph) (R S : ℤ) (z : Site) :=
  G.restrict (· ∈ thinAnnulusSites R S z)

def thinAnnulusInner (G : LatticeGraph) (R S : ℤ) (z : Site) :
    Set (G.thinAnnulusGraph R S z).vertices := {v | siteRadius z v.val = R}

def thinAnnulusOuter (G : LatticeGraph) (R S : ℤ) (z : Site) :
    Set (G.thinAnnulusGraph R S z).vertices := {v | siteRadius z v.val = S}

def thinAnnulusPins (G : LatticeGraph) (R S : ℤ) (z : Site) :
    Set (G.thinAnnulusGraph R S z).vertices :=
  G.thinAnnulusInner R S z ∪ G.thinAnnulusOuter R S z

/-- The finite pin set on the two boundary layers of the restricted annulus. -/
def thinAnnulusPinFinset (G : LatticeGraph) (R S : ℤ) (z : Site) :
    Finset (G.thinAnnulusGraph R S z).vertices :=
  Finset.univ.filter (fun v => v ∈ G.thinAnnulusPins R S z)

set_option backward.isDefEq.respectTransparency false in
/-- Outside the strict annular interior, the remaining vertices of the
restricted annulus are exactly its two boundary layers. -/
theorem restrictionPins_thinLayer_compl (G : LatticeGraph) (R S : ℤ) (z : Site) :
    G.restrictionPins (· ∈ thinAnnulusSites R S z) (G.thinLayer R S z)ᶜ =
      G.thinAnnulusPinFinset R S z := by
  classical
  ext v
  have hv : R ≤ siteRadius z v.val ∧ siteRadius z v.val ≤ S :=
    (Finset.mem_filter.mp v.property).2
  simp only [restrictionPins, thinAnnulusPinFinset, Finset.mem_filter, Finset.mem_univ,
    true_and, Finset.mem_compl, mem_thinLayer, restrictVertex,
    Set.mem_ofPred_eq, thinAnnulusPins, thinAnnulusInner, thinAnnulusOuter, Set.mem_union]
  change ¬ (R < siteRadius z v.val ∧ siteRadius z v.val < S) ↔
    siteRadius z v.val = R ∨ siteRadius z v.val = S
  omega

/-- The full-graph masked pinned kernel equals the actual annular partition
with its boundary-only couplings set to zero. -/
theorem pinnedKernel_thinAnnulus_restrict (G : LatticeGraph) (R S : ℤ) (z : Site)
    (b : G.edges → ℝ) (τ : Configuration G.vertices) :
    pinnedKernel (fun e : G.edges => e.val)
      (maskedCoupling (G.thinKernelEdges R S z) b) (G.thinLayer R S z)ᶜ τ =
    pinnedPartition (fun e : (G.thinAnnulusGraph R S z).edges => e.val)
      (fun e => maskedCoupling (G.thinKernelEdges R S z) b
        (G.restrictEdge (· ∈ thinAnnulusSites R S z) e))
      (G.thinAnnulusPinFinset R S z)
      (fun v => τ (G.restrictVertex (· ∈ thinAnnulusSites R S z) v)) := by
  have hb : ∀ e : G.edges,
      ¬ (e.val.1.val ∈ thinAnnulusSites R S z ∧ e.val.2.val ∈ thinAnnulusSites R S z) →
      maskedCoupling (G.thinKernelEdges R S z) b e = 0 := by
    intro e he
    by_cases hm : e ∈ G.thinKernelEdges R S z
    · exact False.elim (he (G.thinKernelEdges_endpoints R S z e hm))
    · simp only [maskedCoupling, hm, ite_false]
  have h := G.pinnedPartition_restrict_graph (· ∈ thinAnnulusSites R S z)
    (maskedCoupling (G.thinKernelEdges R S z) b) hb (G.thinLayer R S z)ᶜ τ
  rw [restrictionPins_thinLayer_compl] at h
  exact h

/-- The original vertex corresponding to a site of the centered annulus. -/
def thinAnnulusOriginalVertex (G : LatticeGraph) (R S : ℤ) (z : Site)
    (v : ((G.thinAnnulusGraph R S z).translate z).vertices) : G.vertices :=
  G.restrictVertex (· ∈ thinAnnulusSites R S z)
    (((G.thinAnnulusGraph R S z).translateVertexEquiv z).symm v)

theorem thinAnnulusOriginalVertex_radius (G : LatticeGraph) (R S : ℤ) (z : Site)
    (v : ((G.thinAnnulusGraph R S z).translate z).vertices) :
    siteRadius z (G.thinAnnulusOriginalVertex R S z v).val = siteRadius 0 v.val := by
  have h := (G.thinAnnulusGraph R S z).translateVertexEquiv_val z
    (((G.thinAnnulusGraph R S z).translateVertexEquiv z).symm v)
  have hc := congrArg (fun w => w.val)
    (((G.thinAnnulusGraph R S z).translateVertexEquiv z).apply_symm_apply v)
  have h' : v.val = (((G.thinAnnulusGraph R S z).translateVertexEquiv z).symm v).val - z :=
    hc.symm.trans h
  calc
    _ = siteRadius 0 ((((G.thinAnnulusGraph R S z).translateVertexEquiv z).symm v).val - z) := by
      simp only [thinAnnulusOriginalVertex, restrictVertex, siteRadius,
        Prod.fst_sub, Prod.snd_sub, Prod.fst_zero, Prod.snd_zero, sub_zero]
    _ = _ := congrArg (siteRadius 0) h'.symm

theorem translated_thinAnnulus_within_box (G : LatticeGraph) (R S : ℤ)
    (k : ℕ) (z : Site) (hS : S ≤ 2*(2:ℤ)^k) :
    ((G.thinAnnulusGraph R S z).translate z).WithinDyadicBox k := by
  intro v
  let w := (((G.thinAnnulusGraph R S z).translateVertexEquiv z).symm v)
  have hv : R ≤ siteRadius z w.val ∧ siteRadius z w.val ≤ S :=
    (Finset.mem_filter.mp w.property).2
  have hr := G.thinAnnulusOriginalVertex_radius R S z v
  have hbound : siteRadius 0 v.val ≤ 2*(2:ℤ)^k := by
    rw [← hr]
    exact hv.2.trans hS
  simpa only [siteRadius, Prod.fst_zero, Prod.snd_zero, sub_zero,
    max_le_iff, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_pow] using hbound

theorem translated_thinAnnulus_pin_radius (G : LatticeGraph) (R S : ℤ) (z : Site)
    (v : ((G.thinAnnulusGraph R S z).translate z).vertices)
    (hv : v ∈ (G.thinAnnulusGraph R S z).translatePins z (G.thinAnnulusPinFinset R S z)) :
    siteRadius 0 v.val = R ∨ siteRadius 0 v.val = S := by
  have hr := G.thinAnnulusOriginalVertex_radius R S z v
  simp only [translatePins, Finset.mem_filter, Finset.mem_univ, true_and,
    thinAnnulusPinFinset] at hv
  change siteRadius z (G.thinAnnulusOriginalVertex R S z v).val = R ∨
    siteRadius z (G.thinAnnulusOriginalVertex R S z v).val = S at hv
  rwa [hr] at hv

/-- An inner cut on the original graph becomes the radial inner cut after
restriction and translation. This identity holds for every boundary array. -/
theorem thinAnnulusOriginalVertex_cut (G : LatticeGraph) (R S : ℤ) (z : Site)
    {H : Type*} [Group H] (A : FiniteAction H Spin) (g : H)
    (τ : Configuration G.vertices)
    (v : ((G.thinAnnulusGraph R S z).translate z).vertices) :
    (A.onCut (G.innerCut R z)).move g τ (G.thinAnnulusOriginalVertex R S z v) =
      if siteRadius 0 v.val ≤ R then A.move g (τ (G.thinAnnulusOriginalVertex R S z v))
      else τ (G.thinAnnulusOriginalVertex R S z v) := by
  simp only [FiniteAction.onCut_apply, mem_innerCut, thinAnnulusOriginalVertex_radius]

/-- A single exact equality from the full-graph kernel to the origin-centered
annular pinned model used by the Fourier estimates. -/
theorem pinnedKernel_centered_thinAnnulus (G : LatticeGraph) (R S : ℤ) (z : Site)
    (b : G.edges → ℝ) (τ : Configuration G.vertices) :
    pinnedKernel (fun e : G.edges => e.val)
      (maskedCoupling (G.thinKernelEdges R S z) b) (G.thinLayer R S z)ᶜ τ =
    pinnedPartition (fun e : ((G.thinAnnulusGraph R S z).translate z).edges => e.val)
      (fun e => maskedCoupling (G.thinKernelEdges R S z) b
        (G.restrictEdge (· ∈ thinAnnulusSites R S z)
          (((G.thinAnnulusGraph R S z).translateEdgeEquiv z).symm e)))
      ((G.thinAnnulusGraph R S z).translatePins z (G.thinAnnulusPinFinset R S z))
      (fun v => τ (G.thinAnnulusOriginalVertex R S z v)) := by
  exact (G.pinnedKernel_thinAnnulus_restrict R S z b τ).trans
    ((G.thinAnnulusGraph R S z).pinnedPartition_translate z _ _ _)

/-- Cut rotations commute with the restriction-and-translation map. -/
theorem thinAnnulusOriginalVertex_cut_array (G : LatticeGraph) (R S : ℤ) (z : Site)
    {H : Type*} [Group H] (A : FiniteAction H Spin) (g : H)
    (τ : Configuration G.vertices) :
    (fun v => (A.onCut (G.innerCut R z)).move g τ
      (G.thinAnnulusOriginalVertex R S z v)) =
      (A.onCut (((G.thinAnnulusGraph R S z).translate z).innerCut R 0)).move g
        (fun v => τ (G.thinAnnulusOriginalVertex R S z v)) := by
  funext v
  simp only [FiniteAction.onCut_apply, mem_innerCut, thinAnnulusOriginalVertex_radius]

/-- The same exact identification for a rotated inner boundary. -/
theorem pinnedKernel_centered_thinAnnulus_cut (G : LatticeGraph)
    (R S : ℤ) (z : Site) (b : G.edges → ℝ)
    {H : Type*} [Group H] (A : FiniteAction H Spin) (g : H)
    (τ : Configuration G.vertices) :
    pinnedKernel (fun e : G.edges => e.val)
      (maskedCoupling (G.thinKernelEdges R S z) b) (G.thinLayer R S z)ᶜ
      ((A.onCut (G.innerCut R z)).move g τ) =
    pinnedPartition (fun e : ((G.thinAnnulusGraph R S z).translate z).edges => e.val)
      (fun e => maskedCoupling (G.thinKernelEdges R S z) b
        (G.restrictEdge (· ∈ thinAnnulusSites R S z)
          (((G.thinAnnulusGraph R S z).translateEdgeEquiv z).symm e)))
      ((G.thinAnnulusGraph R S z).translatePins z (G.thinAnnulusPinFinset R S z))
      ((A.onCut (((G.thinAnnulusGraph R S z).translate z).innerCut R 0)).move g
        (fun v => τ (G.thinAnnulusOriginalVertex R S z v))) := by
  rw [pinnedKernel_centered_thinAnnulus, thinAnnulusOriginalVertex_cut_array]

end
end RP3.Fourier.LatticeGraph

namespace RP3
noncomputable section
open Rotation hiding Spin
open Quadratic
open scoped Classical

variable {V E : Type*} [Fintype V] [Fintype E] [DecidableEq V]

/-- An arbitrary interpolation potential gives the prescribed cut rotation
whenever it is the cut indicator at the pinned vertices. -/
theorem pinnedSystem_rotatePotential_eq_cut
    (edge : E → V × V) (b : E → ℝ) (pins cut : Finset V)
    (θ : V → ℝ) (hθ : ∀ v ∈ pins, θ v = if v ∈ cut then 1 else 0)
    (τ : Configuration V) (t : ℝ) :
    (pinnedSystem edge b pins τ).rotatePotential θ t =
      pinnedSystem edge b pins (coordinateCut cut 2 t τ) := by
  have hp : ((pinnedSystem edge b pins τ).rotatePotential θ t).pin =
      (pinnedSystem edge b pins (coordinateCut cut 2 t τ)).pin := by
    funext v
    by_cases hv : v ∈ pins
    · simp only [SpinSystem.rotatePotential, SpinSystem.rotatePins, pinnedSystem,
        hv, ite_true, Option.map_some]
      apply congrArg some
      apply Subtype.ext
      have hh := hθ v hv
      by_cases hc : v ∈ cut
      · simp only [hc, ite_true] at hh
        simp only [coordinateCut, rotateCut, hc, ite_true, spinRotation_val,
          SpinSystem.potentialRotation, hh, mul_one,
          coordinateRotation_apply, coordinateAxis, rotationExp_apply]
        try rfl
      · simp only [hc, ite_false] at hh
        simp only [coordinateCut, rotateCut, hc, ite_false, spinRotation_val,
          SpinSystem.potentialRotation, hh, mul_zero, zero_smul ℝ axisC,
          rotationExp_apply, NormedSpace.exp_zero, one_apply_eq_self]
    · simp only [SpinSystem.rotatePotential, SpinSystem.rotatePins, pinnedSystem,
        hv, ite_false, Option.map_none]
  exact congrArg (fun p => SpinSystem.mk (fun e => (edge e).1)
    (fun e => (edge e).2) b p) hp

/-- The generic periodic-ODE argument, expressed directly for the actual
pinned partition. The sole analytic premise is the model's second response. -/
theorem pinnedKernel_axisC_of_response
    (edge : E → V × V) (b : E → ℝ) (pins cut : Finset V)
    (θ : V → ℝ) (hθ : ∀ v ∈ pins, θ v = if v ∈ cut then 1 else 0)
    (B : ℝ) (hB : 0 ≤ B) (τ : Configuration V)
    (hresponse : ∀ t : ℝ,
      -((pinnedSystem edge b pins τ).rotatePotential θ t).secondAxisResponse
        ((pinnedSystem edge b pins τ).edgeGradient θ)
        ((pinnedSystem edge b pins τ).edgeGradient θ) ≤ B)
    (t : ℝ) :
    (1-B*(4*Real.pi)^2/2) * pinnedKernel edge b pins (coordinateCut cut 2 t τ) ≤
      pinnedKernel edge b pins τ := by
  have hbinary : ∀ v s, (pinnedSystem edge b pins τ).pin v = some s →
      θ v = 0 ∨ θ v = 1 := by
    intro v s hs
    by_cases hv : v ∈ pins
    · rw [hθ v hv]
      split_ifs <;> simp
    · simp [pinnedSystem, hv] at hs
  have h := (pinnedSystem edge b pins τ).potential_partition_ratio θ B hB
    hbinary hresponse 0 t
  rw [pinnedSystem_rotatePotential_eq_cut edge b pins cut θ hθ τ 0,
    pinnedSystem_rotatePotential_eq_cut edge b pins cut θ hθ τ t,
    coordinateCut_zero, pinnedSystem_partition, pinnedSystem_partition] at h
  exact (le_div_iff₀ (pinnedPartition_pos edge b pins _)).mp h

/-- Convert a uniform response estimate into the quaternion comparison
required by the exact product bound. -/
theorem pinnedKernel_quaternion_of_response
    (edge : E → V × V) (b : E → ℝ) (pins cut : Finset V)
    (θ : V → ℝ) (hθ : ∀ v ∈ pins, θ v = if v ∈ cut then 1 else 0)
    (B : ℝ) (hB : 0 ≤ B) (hsmall : B*(4*Real.pi)^2/2 ≤ 1)
    (hresponse : ∀ (τ : Configuration V) (t : ℝ),
      -((pinnedSystem edge b pins τ).rotatePotential θ t).secondAxisResponse
        ((pinnedSystem edge b pins τ).edgeGradient θ)
        ((pinnedSystem edge b pins τ).edgeGradient θ) ≤ B)
    (g : Quaternion) (τ : Configuration V) :
    (1-3*(B*(4*Real.pi)^2/2)) * pinnedKernel edge b pins
      ((quaternionAction.onCut cut).move g τ) ≤ pinnedKernel edge b pins τ := by
  let K := fun υ => pinnedKernel edge b pins υ
  have hnonneg : ∀ υ, 0 ≤ K υ := fun υ => (pinnedPartition_pos _ _ _ υ).le
  have hglobal : ∀ h υ, K (globalMove h υ) = K υ := by
    intro h υ
    exact pinnedPartition_globalRotation _ _ _ h υ
  exact quaternionCut_comparison_of_axisC K hnonneg hglobal cut (by positivity) hsmall
    (fun t υ => pinnedKernel_axisC_of_response edge b pins cut θ hθ B hB υ
      (hresponse υ) t) g τ

end
end RP3
end StandalonePart53

/- ===== RP3/ThinProfileLattice.lean ===== -/
section StandalonePart54

/-! The thin smooth cutoffs on actual centered lattice shells. -/
namespace RP3.Fourier
noncomputable section
open scoped BigOperators Classical

theorem scaledSite_norm_radius (k : ℕ) (x : Site) :
    ‖scaledSite k x‖ = (siteRadius 0 x:ℝ)/(2:ℝ)^k := by
  have hN : 0 < (2:ℝ)^k := by positivity
  simp only [scaledSite, Prod.norm_def, Real.norm_eq_abs, abs_div, abs_of_pos hN,
    max_div_div_right hN.le, siteRadius, Prod.fst_zero, Prod.snd_zero, sub_zero,
    Int.cast_max, Int.cast_abs]

theorem scaledSite_thin_inner {k : ℕ} {x : Site} {a : ℝ}
    (h : (siteRadius 0 x:ℝ) ≤ a*(2:ℝ)^k) :
    |(scaledSite k x).1| ≤ a ∧ |(scaledSite k x).2| ≤ a := by
  have hn : ‖scaledSite k x‖ ≤ a := by
    rw [scaledSite_norm_radius, div_le_iff₀ (by positivity : 0 < (2:ℝ)^k)]
    exact h
  simpa only [Prod.norm_def, Real.norm_eq_abs, max_le_iff] using hn

theorem scaledSite_thin_outer {k : ℕ} {x : Site} {a : ℝ}
    (h : a*(2:ℝ)^k ≤ (siteRadius 0 x:ℝ)) :
    a ≤ |(scaledSite k x).1| ∨ a ≤ |(scaledSite k x).2| := by
  have hn : a ≤ ‖scaledSite k x‖ := by
    rw [scaledSite_norm_radius, le_div_iff₀ (by positivity : 0 < (2:ℝ)^k)]
    exact h
  simpa only [Prod.norm_def, Real.norm_eq_abs, le_max_iff] using hn

namespace LatticeGraph

def thinThetaPotential (G : LatticeGraph) (k : ℕ) (a δ : ℝ) (v : G.vertices) : ℝ :=
  thinTheta a δ (scaledSite k v.val)

def thinThetaEdge (G : LatticeGraph) (k : ℕ) (a δ : ℝ) (e : G.edges) : ℝ :=
  G.thinThetaPotential k a δ e.val.2-G.thinThetaPotential k a δ e.val.1

def ThinBoundaryPins (G : LatticeGraph) (k : ℕ) (a δ : ℝ)
    (P : G.vertices → Option RP3.Spin) : Prop :=
  ∀ v s, P v = some s →
    (|(scaledSite k v.val).1| ≤ a ∧ |(scaledSite k v.val).2| ≤ a) ∨
    (a+δ ≤ |(scaledSite k v.val).1| ∨ a+δ ≤ |(scaledSite k v.val).2|)

theorem thinProfiles_zero_pins (G : LatticeGraph) (k : ℕ) (a δ : ℝ)
    (hδ : 0 < δ) (ha : δ ≤ a) (P : G.vertices → Option RP3.Spin)
    (hP : G.ThinBoundaryPins k a δ P) (m s : Bool) (v : G.vertices)
    (t : RP3.Spin) (hv : P v = some t) :
    thinProfile a δ m s (scaledSite k v.val) = 0 := by
  rcases hP v t hv with hh | hh
  · exact thinProfile_zero_inner a δ hδ ha m s _ hh.1 hh.2
  · exact thinProfile_zero_outer a δ hδ ha m s _ hh

theorem thinBoundaryPins_of_radius (G : LatticeGraph) (k : ℕ) (a δ : ℝ)
    (R S : ℤ) (hR : (R:ℝ) = a*(2:ℝ)^k) (hS : (S:ℝ) = (a+δ)*(2:ℝ)^k)
    (P : G.vertices → Option RP3.Spin)
    (hP : ∀ v s, P v = some s → siteRadius 0 v.val = R ∨ siteRadius 0 v.val = S) :
    G.ThinBoundaryPins k a δ P := by
  intro v s hs
  rcases hP v s hs with hh | hh
  · left
    apply scaledSite_thin_inner
    rw [hh,hR]
  · right
    apply scaledSite_thin_outer
    rw [hh,hS]

theorem thinThetaPotential_of_boundary_radius (G : LatticeGraph) (k : ℕ) (a δ : ℝ)
    (hδ : 0 < δ) (ha : δ ≤ a) (R S : ℤ)
    (hR : (R:ℝ) = a*(2:ℝ)^k) (hS : (S:ℝ) = (a+δ)*(2:ℝ)^k)
    (v : G.vertices) (hv : siteRadius 0 v.val = R ∨ siteRadius 0 v.val = S) :
    G.thinThetaPotential k a δ v = if siteRadius 0 v.val ≤ R then 1 else 0 := by
  by_cases hi : siteRadius 0 v.val ≤ R
  · simp only [hi,ite_true,thinThetaPotential]
    have hh : (siteRadius 0 v.val:ℝ) ≤ a*(2:ℝ)^k := by
      rw [←hR]
      exact_mod_cast hi
    exact thinTheta_one a δ hδ ha _ (scaledSite_thin_inner hh).1 (scaledSite_thin_inner hh).2
  · simp only [hi,ite_false,thinThetaPotential]
    have hh : (a+δ)*(2:ℝ)^k ≤ (siteRadius 0 v.val:ℝ) := by
      rw [hv.resolve_left (fun he => hi he.le), hS]
    exact thinTheta_zero a δ hδ ha _ (scaledSite_thin_outer hh)

theorem thinProfile_zero_outside_layer (G : LatticeGraph) (k : ℕ) (a δ : ℝ)
    (hδ : 0 < δ) (ha : δ ≤ a) (R S : ℤ)
    (hR : (R:ℝ) = a*(2:ℝ)^k) (hS : (S:ℝ) = (a+δ)*(2:ℝ)^k)
    (m s : Bool) (v : G.vertices) (hv : v ∉ G.thinLayer R S 0) :
    thinProfile a δ m s (scaledSite k v.val) = 0 := by
  simp only [mem_thinLayer,not_and_or,not_lt] at hv
  rcases hv with hv | hv
  · have hh : (siteRadius 0 v.val:ℝ) ≤ a*(2:ℝ)^k := by
      rw [←hR]; exact_mod_cast hv
    exact thinProfile_zero_inner a δ hδ ha m s _
      (scaledSite_thin_inner hh).1 (scaledSite_thin_inner hh).2
  · have hh : (a+δ)*(2:ℝ)^k ≤ (siteRadius 0 v.val:ℝ) := by
      rw [←hS]; exact_mod_cast hv
    exact thinProfile_zero_outer a δ hδ ha m s _ (scaledSite_thin_outer hh)

theorem thin_transfer_sum_bounds (G : LatticeGraph) (k : ℕ) (hG : G.WithinDyadicBox k)
    (u v : G.edges → ℝ) (L D : ℝ) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (he : ∀ e : G.edges, |u e| ≤ L/(2:ℝ)^k ∧
      |u e-v e| ≤ D/((2:ℝ)^k)^3) :
    (∑ e, |u e-v e|) ≤ 512*D/(2:ℝ)^k ∧
    (∑ e, |u e|^2) ≤ 512*L^2 ∧
    (∑ e, |u e-v e| *
      (|u e| + |v e|)) ≤ 512*D*(2*L+D)/((2:ℝ)^k)^2 := by
  let N : ℝ := (2:ℝ)^k
  have hN : 0 < N := by dsimp [N]; positivity
  have hN1 : 1 ≤ N := one_le_pow₀ (by norm_num)
  have hcount := G.edge_card_bound k hG
  change (Fintype.card G.edges:ℝ) ≤ 512*N^2 at hcount
  have hv (e : G.edges) : |v e| ≤ (L+D)/N := by
    have htri : |v e| ≤ |u e| + |u e-v e| := by
      simpa only [add_sub_cancel, abs_sub_comm] using abs_add_le (u e) (v e-u e)
    have hpow : N ≤ N^3 := by nlinarith [sq_nonneg (N-1)]
    calc _ ≤ L/N+D/N^3 := htri.trans (add_le_add (he e).1 (he e).2)
         _ ≤ L/N+D/N := add_le_add_right (div_le_div_of_nonneg_left hD hN hpow) _
         _ = _ := by ring
  have hs1 : (∑ e, |u e-v e|) ≤ (Fintype.card G.edges:ℝ)*(D/N^3) := by
    simpa only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul] using Finset.sum_le_sum (s := Finset.univ) (fun e _ => (he e).2)
  have hs2 : (∑ e, |u e|^2) ≤ (Fintype.card G.edges:ℝ)*(L/N)^2 := by
    simpa only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul] using Finset.sum_le_sum (s := Finset.univ)
      (fun e _ => pow_le_pow_left₀ (abs_nonneg _) (he e).1 2)
  have hs3 : (∑ e, |u e-v e| *(|u e| + |v e|)) ≤
      (Fintype.card G.edges:ℝ)*(D/N^3*((2*L+D)/N)) := by
    simpa only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul] using Finset.sum_le_sum (s := Finset.univ)
      (fun e _ => mul_le_mul (he e).2 (show |u e| + |v e| ≤ (2*L+D)/N from
        (add_le_add (he e).1 (hv e)).trans_eq (by ring)) (by positivity) (by positivity))
  refine ⟨hs1.trans ?_,hs2.trans ?_,hs3.trans ?_⟩
  all_goals
    calc _ ≤ 512*N^2*_ := mul_le_mul_of_nonneg_right hcount (by positivity)
         _ = _ := by dsimp only [N]; field_simp

theorem thin_response_bound_of_transfer (G : LatticeGraph) (k : ℕ)
    (hG : G.WithinDyadicBox k) (u v : G.edges → ℝ) (M L D a R : ℝ)
    (hM : 0 ≤ M) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (he : ∀ e : G.edges, |u e| ≤ L/(2:ℝ)^k ∧
      |u e-v e| ≤ D/((2:ℝ)^k)^3)
    (htransfer : -R ≤ a +
      M*(∑ e, |u e-v e| *
        (|u e|+|v e|)) +
      (M*∑ e, |u e-v e|) *
        (M*(∑ e, (u e)^2)+1) +
      (M*∑ e, |u e-v e|)^2) :
    -R ≤ a+transferCostConstant M L D/(2:ℝ)^k := by
  let N : ℝ := (2:ℝ)^k
  have hN : 0 < N := by dsimp [N]; positivity
  have hN1 : 1 ≤ N := one_le_pow₀ (by norm_num)
  obtain ⟨hs1,hs2,hs3⟩ := G.thin_transfer_sum_bounds k hG u v L D hL hD he
  simp only [sq_abs] at hs2
  have h1n : 0 ≤ M*∑ e, |u e-v e| := by positivity
  have hh : -R ≤ a + M*(512*D*(2*L+D)/N^2) +
      (M*(512*D/N))*(M*(512*L^2)+1)+(M*(512*D/N))^2 := by
    apply htransfer.trans
    apply add_le_add
    · apply add_le_add
      · exact add_le_add le_rfl (mul_le_mul_of_nonneg_left hs3 hM)
      · exact mul_le_mul (mul_le_mul_of_nonneg_left hs1 hM)
          (add_le_add (mul_le_mul_of_nonneg_left hs2 hM) le_rfl) (by positivity) (by positivity)
    · exact pow_le_pow_left₀ h1n (mul_le_mul_of_nonneg_left hs1 hM) 2
  apply hh.trans
  rw [add_assoc a, add_assoc a]
  apply add_le_add le_rfl
  have hN2 : N ≤ N^2 := by nlinarith
  have hQ : 0 ≤ M*(512*D*(2*L+D))+(M*512*D)^2 := by positivity
  calc _ = (M*(512*D*(2*L+D))+(M*512*D)^2)/N^2+
        ((M*512*D)*(M*(512*L^2)+1))/N := by ring
    _ ≤ (M*(512*D*(2*L+D))+(M*512*D)^2)/N+
        ((M*512*D)*(M*(512*L^2)+1))/N :=
      add_le_add (div_le_div_of_nonneg_left hQ hN hN2) le_rfl
    _ = _ := by unfold transferCostConstant; dsimp only [N]; ring


end LatticeGraph
end
end RP3.Fourier
end StandalonePart54

/- ===== RP3/ThinFourier.lean ===== -/
section StandalonePart55

/-! Truncated Fourier families for thin annuli. The low shells are represented
by zero modes, retaining the existing finite index and its exact symmetries. -/
namespace RP3.Fourier
noncomputable section
open scoped BigOperators ComplexConjugate

variable {k : ℕ}

def tailWeight (h : ℕ) (p : DyadicFreq k) : ℝ :=
  if h ≤ p.1.val then dyadicWeight p else 0

def tailReciprocal (h : ℕ) (p : DyadicFreq k) : ℝ :=
  if h ≤ p.1.val then 1 / (dyadicRadius p : ℝ) else 0

theorem tailWeight_nonneg (h : ℕ) (p : DyadicFreq k) : 0 ≤ tailWeight h p := by
  unfold tailWeight; split_ifs
  · exact (dyadicWeight_pos p).le
  · rfl

theorem tailWeight_le (h : ℕ) (p : DyadicFreq k) : tailWeight h p ≤ dyadicWeight p := by
  unfold tailWeight; split_ifs
  · rfl
  · exact (dyadicWeight_pos p).le

theorem tailWeight_sq (h : ℕ) (p : DyadicFreq k) :
    tailWeight h p ^ 2 = if h ≤ p.1.val then (1 / (dyadicRadius p : ℝ))^3 else 0 := by
  unfold tailWeight
  split_ifs <;> simp [dyadicWeight_sq]

theorem tailWeight_mul_sqrt (h : ℕ) (p : DyadicFreq k) :
    tailWeight h p * Real.sqrt (dyadicRadius p : ℝ) = tailReciprocal h p := by
  unfold tailWeight tailReciprocal
  split_ifs <;> simp [dyadicWeight_mul_sqrt]

theorem tailReciprocal_nonneg (h : ℕ) (p : DyadicFreq k) : 0 ≤ tailReciprocal h p := by
  unfold tailReciprocal; split_ifs <;> positivity

theorem tailReciprocal_le (h : ℕ) (δ : ℝ) (hδ : 0 ≤ δ)
    (hh : 1 / (2:ℝ)^h ≤ δ) (p : DyadicFreq k) : tailReciprocal h p ≤ δ := by
  unfold tailReciprocal
  split_ifs with hp
  · apply le_trans _ hh
    have hr : (2:ℝ)^h ≤ (dyadicRadius p:ℝ) := by
      exact_mod_cast Nat.pow_le_pow_right (by decide : 1 ≤ 2) hp
    exact one_div_le_one_div_of_le (by positivity) hr
  · exact hδ

def tailLambda (k h : ℕ) : ℝ :=
  (2:ℝ)^k * ∑ p : DyadicFreq k,
    tailWeight h p ^ 2 * Real.sin (dyadicAngle k (dyadicPoint p).1)

theorem tailLambda_lower (k h : ℕ) : ((k-h:ℕ):ℝ)/2 ≤ tailLambda k h := by
  have hp (p : DyadicFreq k) :
      (if h ≤ p.1.val then (1/(dyadicRadius p:ℝ))^2/4 else 0) ≤
        (2:ℝ)^k*(tailWeight h p ^ 2*Real.sin (dyadicAngle k (dyadicPoint p).1)) := by
    rw [tailWeight_sq]
    split_ifs with hj
    · have hr : (0:ℝ)<dyadicRadius p := by exact_mod_cast dyadicRadius_pos p
      have hpr : (dyadicRadius p:ℝ) ≤ ((dyadicPoint p).1:ℝ) := by
        exact_mod_cast (dyadicPoint_bounds p).1
      have hs := dyadic_sin_lower k ((dyadicPoint p).1:ℝ) (by linarith) (dyadicPoint_fst_le_N p)
      calc _ = (2:ℝ)^k*((1/(dyadicRadius p:ℝ))^3*((dyadicRadius p:ℝ)/(4*(2:ℝ)^k))) := by field_simp
           _ ≤ _ := by gcongr; exact (div_le_div_of_nonneg_right hpr (by positivity)).trans hs
    · simp
  have hs : (∑ j : Fin k, if h ≤ j.val then (1/2:ℝ) else 0) = ((k-h:ℕ):ℝ)/2 := by
    rw [← Finset.sum_range (fun j => if h ≤ j then (1/2:ℝ) else 0)]
    rw [← Finset.sum_filter]
    have hf : (Finset.range k).filter (fun j => h ≤ j) = Finset.Ico h k := by
      ext j; simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_Ico]; omega
    rw [hf]
    simp [Nat.card_Ico, nsmul_eq_mul, div_eq_mul_inv]
  unfold tailLambda
  rw [Finset.mul_sum]
  calc _ = ∑ j : Fin k, if h ≤ j.val then (1/2:ℝ) else 0 := hs.symm
       _ ≤ ∑ p : DyadicFreq k, if h ≤ p.1.val then (1/(dyadicRadius p:ℝ))^2/4 else 0 := by
         rw [Fintype.sum_sigma]
         apply Finset.sum_le_sum
         intro j _
         by_cases hj : h ≤ j.val
         · simp only [hj, ↓reduceIte, dyadicRadius, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
           have hr : (0:ℝ)<(2^j.val:ℕ) := by positivity
           have hc : 2*((2^j.val:ℕ):ℝ)^2 ≤ (Fintype.card (Fin (2^j.val) × Fin (2*2^j.val+1)):ℝ) := by
             exact_mod_cast (dyadic_shell_card_bounds j.val).1
           calc (1/2:ℝ) = (2*((2^j.val:ℕ):ℝ)^2)*((1/((2^j.val:ℕ):ℝ))^2/4) := by field_simp; norm_num
                _ ≤ _ := mul_le_mul_of_nonneg_right hc (by positivity)
         · simp [hj]
       _ ≤ _ := Finset.sum_le_sum fun p _ => hp p

theorem tailLambda_lower_quarter (k h : ℕ) (hh : 2*h ≤ k) : (k:ℝ)/4 ≤ tailLambda k h := by
  have hc : k ≤ 2*(k-h) := by omega
  have hc' : (k:ℝ) ≤ 2*((k-h:ℕ):ℝ) := by exact_mod_cast hc
  exact le_trans (by linarith) (tailLambda_lower k h)

theorem tail_sin_cancel (k h : ℕ) :
    (∑ p : DyadicFreq k, tailWeight h p ^ 2 *
      Real.sin (dyadicAngle k (dyadicPoint p).2)) = 0 := by
  let e : DyadicFreq k ≃ DyadicFreq k :=
    ⟨dyadicReflect, dyadicReflect, dyadicReflect_involution, dyadicReflect_involution⟩
  have he := Equiv.sum_comp e
    (fun p : DyadicFreq k => tailWeight h p ^ 2 * Real.sin (dyadicAngle k (dyadicPoint p).2))
  have hw (p : DyadicFreq k) : tailWeight h (dyadicReflect p) = tailWeight h p := by
    rfl
  change (∑ p : DyadicFreq k, tailWeight h (dyadicReflect p) ^ 2 *
    Real.sin (dyadicAngle k (dyadicPoint (dyadicReflect p)).2)) = _ at he
  simp only [hw, dyadicReflect_point, Int.cast_neg, dyadicAngle_neg,
    Real.sin_neg, mul_neg, Finset.sum_neg_distrib] at he
  linarith

theorem tail_sine_main_sum (k h : ℕ) :
    (∑ p : DyadicFreq k, tailWeight h p ^ 2 * Real.sin (dyadicAngle k (dyadicPoint p).1)) =
      tailLambda k h/(2:ℝ)^k := by
  simp only [tailLambda]
  rw [mul_div_cancel_left₀ _ (by positivity : (2:ℝ)^k ≠ 0)]

theorem tail_grouped_sine_sum (h : ℕ) (m s j : Bool) :
    (∑ p : DyadicFreq k, tailWeight h p ^ 2 *
      Real.sin (dyadicAngle k (if j then (groupedPoint m s p).2 else (groupedPoint m s p).1))) =
      if m=j then (if s then -(tailLambda k h/(2:ℝ)^k) else tailLambda k h/(2:ℝ)^k) else 0 := by
  have h1 := tail_sine_main_sum k h
  have h2 := tail_sin_cancel k h
  cases m <;> cases s <;> cases j <;> simp_all [groupedPoint]

/-- The column energy is retained instead of bounded by the operator norm. -/
theorem SquareBound.gram_weighted_columns
    {X P : Type*} [Fintype X] [Fintype P] {U : X → P → ℂ} {a : ℝ}
    (h : SquareBound U a) (d : P → ℂ) :
    (∑ x, ∑ y, ‖∑ p, U x p*d p*conj (U y p)‖^2) ≤
      a^2*∑ p, ‖d p‖^2*(∑ y, ‖U y p‖^2) := by
  calc _ = ∑ y, ∑ x, ‖∑ p, U x p*(d p*conj (U y p))‖^2 := by
          simp only [mul_assoc]; exact Finset.sum_comm
       _ ≤ ∑ y, a^2*∑ p, ‖d p*conj (U y p)‖^2 :=
          Finset.sum_le_sum fun y _ => h (fun p => d p*conj (U y p))
       _ = _ := by
          simp only [norm_mul, Complex.norm_conj, mul_pow, Finset.mul_sum]
          rw [Finset.sum_comm]

theorem SquareBound.gram_weighted_column_bound
    {X P : Type*} [Fintype X] [Fintype P] {U : X → P → ℂ} {a J : ℝ}
    (h : SquareBound U a) (hc : ∀ p, (∑ y, ‖U y p‖^2) ≤ J) (d : P → ℂ) :
    (∑ x, ∑ y, ‖∑ p, U x p*d p*conj (U y p)‖^2) ≤
      a^2*J*∑ p, ‖d p‖^2 := by
  apply (h.gram_weighted_columns d).trans
  calc _ ≤ a^2*∑ p, ‖d p‖^2*J := by
          apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
          exact Finset.sum_le_sum fun p _ => mul_le_mul_of_nonneg_left (hc p) (sq_nonneg _)
       _ = _ := by rw [← Finset.sum_mul]; ring


def thinLatticeMode (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ)
    (m s : Bool) (p : DyadicFreq k) (x : Site) : ℂ :=
  (tailWeight h p:ℂ) * (f m s (scaledSite k x):ℂ) *
    torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) x)

theorem thinLatticeMode_norm_bound (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ)
    (m s : Bool) (p : DyadicFreq k) (x : Site) (C : ℝ)
    (hC : 0 ≤ C) (hv : |f m s (scaledSite k x)| ≤ C) :
    ‖thinLatticeMode h f m s p x‖ ≤ dyadicWeight p*C := by
  simp only [thinLatticeMode, norm_mul, torusWave_norm, mul_one, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (tailWeight_nonneg h p)]
  exact mul_le_mul (tailWeight_le h p) hv (abs_nonneg _) (dyadicWeight_pos p).le

theorem tailWave_multiplier_bound (h : ℕ) (m s j : Bool) (p : DyadicFreq k) :
    ‖(tailReciprocal h p:ℂ) *
      (torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) (latticeAxis j))-1)‖ ≤
        Real.pi/(4*(2:ℝ)^k) := by
  unfold tailReciprocal
  split_ifs
  · simpa only [Complex.ofReal_div, Complex.ofReal_one] using groupedWave_multiplier_bound m s j p
  · simp only [Complex.ofReal_zero, zero_mul, norm_zero]; positivity

namespace LatticeGraph

def thinModeGradient (G : LatticeGraph) (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ)
    (m s : Bool) (p : DyadicFreq k) (e : G.edges) : ℂ :=
  thinLatticeMode h f m s p e.val.2.val-thinLatticeMode h f m s p e.val.1.val

def thinScaledModeGradient (G : LatticeGraph) (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ)
    (m s : Bool) (p : DyadicFreq k) (e : G.edges) : ℂ :=
  (Real.sqrt (dyadicRadius p:ℝ):ℂ)*G.thinModeGradient h f m s p e

theorem thinScaledModeGradient_formula (G : LatticeGraph) (h : ℕ)
    (f : Bool → Bool → ℝ × ℝ → ℝ) (m s : Bool) (p : DyadicFreq k) (e : G.edges) :
    G.thinScaledModeGradient h f m s p e =
      (tailReciprocal h p:ℂ) *
      ((f m s (scaledSite k e.val.2.val):ℂ)*torusWave (groupedTorusPoint m s p)
        (latticeTorus (16*2^k) e.val.1.val+latticeTorus (16*2^k) (latticeAxis (G.edgeDirection e))) -
       (f m s (scaledSite k e.val.1.val):ℂ)*torusWave (groupedTorusPoint m s p)
        (latticeTorus (16*2^k) e.val.1.val)) := by
  have hw := congrArg Complex.ofReal (tailWeight_mul_sqrt h p)
  push_cast at hw
  simp only [thinScaledModeGradient, thinModeGradient, thinLatticeMode]
  rw [G.edge_step e, latticeTorus_add]
  linear_combination ( ((f m s (scaledSite k (e.val.1.val+latticeAxis (G.edgeDirection e))):ℂ)*
    torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) e.val.1.val+latticeTorus (16*2^k) (latticeAxis (G.edgeDirection e)))) -
    ((f m s (scaledSite k e.val.1.val):ℂ)*torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) e.val.1.val)) ) * hw

def thinModeBlockConstant (C L δ : ℝ) : ℝ :=
  Real.sqrt (512*((L*δ)^2+C^2*(Real.pi/4)^2))

theorem thinScaledModes_direction_bound (G : LatticeGraph) (hG : G.WithinDyadicBox k)
    (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ) (C L δ : ℝ)
    (hδ : 0 ≤ δ) (hh : 1/(2:ℝ)^h ≤ δ)
    (hval : ∀ m s z, |f m s z| ≤ C)
    (hLip : ∀ m s z w, |f m s w-f m s z| ≤ L*‖w-z‖)
    (m s j : Bool) :
    SquareBound (fun (e : G.DirectionalEdges j) (p : DyadicFreq k) =>
      G.thinScaledModeGradient h f m s p e.val) (thinModeBlockConstant C L δ) := by
  classical
  have hN : (2:ℝ)^k ≠ 0 := by positivity
  have hd (e : G.DirectionalEdges j) :
      ‖(f m s (scaledSite k e.val.val.2.val):ℂ)-
        (f m s (scaledSite k e.val.val.1.val):ℂ)‖ ≤ L/(2:ℝ)^k := by
    rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
    simpa only [G.scaled_edge_distance, div_eq_mul_inv, one_mul] using
      hLip m s (scaledSite k e.val.val.1.val) (scaledSite k e.val.val.2.val)
  have hv (e : G.DirectionalEdges j) :
      ‖(f m s (scaledSite k e.val.val.2.val):ℂ)‖ ≤ C := by
    simpa only [Complex.norm_real, Real.norm_eq_abs] using hval m s (scaledSite k e.val.val.2.val)
  have ha (p : DyadicFreq k) : ‖(tailReciprocal h p:ℂ)‖ ≤ δ := by
    simpa only [Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (tailReciprocal_nonneg h p)] using tailReciprocal_le h δ hδ hh p
  have hb := edge_cutoff_squareBound (groupedTorusPoint m s) (groupedTorusPoint_injective m s)
    (fun e : G.DirectionalEdges j => latticeTorus (16*2^k) e.val.val.1.val)
    (G.directional_torus_injective k hG j) (latticeTorus (16*2^k) (latticeAxis j))
    (fun e => (f m s (scaledSite k e.val.val.1.val):ℂ))
    (fun e => (f m s (scaledSite k e.val.val.2.val):ℂ))
    (fun p => (tailReciprocal h p:ℂ)) (L/(2:ℝ)^k) C δ (Real.pi/(4*(2:ℝ)^k))
    hd hv ha (tailWave_multiplier_bound h m s j)
  have hc : Real.sqrt (2*((16*2^k:ℕ):ℝ)^2*((L/(2:ℝ)^k)^2*δ^2+C^2*(Real.pi/(4*(2:ℝ)^k))^2)) =
      thinModeBlockConstant C L δ := by
    congr 1
    push_cast
    field_simp [hN]
    ring
  rw [hc] at hb
  have hdir (e : G.DirectionalEdges j) : G.edgeDirection e.val=j := e.property
  exact fun v => by simpa only [G.thinScaledModeGradient_formula, hdir] using hb v

theorem thinScaledModes_squareBound (G : LatticeGraph) (hG : G.WithinDyadicBox k)
    (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ) (C L δ : ℝ)
    (hδ : 0 ≤ δ) (hh : 1/(2:ℝ)^h ≤ δ)
    (hval : ∀ m s z, |f m s z| ≤ C)
    (hLip : ∀ m s z w, |f m s w-f m s z| ≤ L*‖w-z‖) (m s : Bool) :
    SquareBound (fun e (p : DyadicFreq k) => G.thinScaledModeGradient h f m s p e)
      (2*thinModeBlockConstant C L δ) := by
  apply SquareBound.combine_directions _ G.edgeDirection
  exact fun j => G.thinScaledModes_direction_bound hG h f C L δ hδ hh hval hLip m s j


theorem thinScaledModeGradient_norm_le (G : LatticeGraph)
    (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ) (C L δ : ℝ)
    (hC : 0 ≤ C) (hL : 0 ≤ L) (hδ : 0 ≤ δ) (hh : 1/(2:ℝ)^h ≤ δ)
    (hval : ∀ m s z, |f m s z| ≤ C)
    (hLip : ∀ m s z w, |f m s w-f m s z| ≤ L*‖w-z‖)
    (m s : Bool) (p : DyadicFreq k) (e : G.edges) :
    ‖G.thinScaledModeGradient h f m s p e‖ ≤ (L*δ+C*(Real.pi/4))/(2:ℝ)^k := by
  let W := torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) e.val.1.val)
  let Z := torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) (latticeAxis (G.edgeDirection e)))
  let f₀ := f m s (scaledSite k e.val.1.val)
  let f₁ := f m s (scaledSite k e.val.2.val)
  have heq : G.thinScaledModeGradient h f m s p e =
      (tailReciprocal h p:ℂ)*((f₁-f₀:ℝ):ℂ)*W +
      (f₁:ℂ)*W*((tailReciprocal h p:ℂ)*(Z-1)) := by
    rw [G.thinScaledModeGradient_formula, torusWave_add]
    dsimp only [W, Z, f₀, f₁]
    push_cast
    ring
  have hd : |f₁-f₀| ≤ L/(2:ℝ)^k := by
    simpa only [f₀, f₁, G.scaled_edge_distance, div_eq_mul_inv, one_mul] using
      hLip m s (scaledSite k e.val.1.val) (scaledSite k e.val.2.val)
  have hw : ‖W‖=1 := torusWave_norm _ _
  rw [heq]
  calc _ ≤ ‖(tailReciprocal h p:ℂ)*((f₁-f₀:ℝ):ℂ)*W‖ +
      ‖(f₁:ℂ)*W*((tailReciprocal h p:ℂ)*(Z-1))‖ := norm_add_le _ _
       _ = tailReciprocal h p*|f₁-f₀| + |f₁| *‖(tailReciprocal h p:ℂ)*(Z-1)‖ := by
         simp only [norm_mul, hw, mul_one, Complex.norm_real, Real.norm_eq_abs,
           abs_of_nonneg (tailReciprocal_nonneg h p)]
       _ ≤ δ*(L/(2:ℝ)^k)+C*(Real.pi/(4*(2:ℝ)^k)) :=
         add_le_add (mul_le_mul (tailReciprocal_le h δ hδ hh p) hd (abs_nonneg _) hδ)
           (mul_le_mul (hval m s _) (tailWave_multiplier_bound h m s (G.edgeDirection e) p)
             (norm_nonneg _) hC)
       _ = _ := by ring

/-- Only edges in the explicit support set contribute to a column. -/
theorem thinScaledModes_column_bound (G : LatticeGraph)
    (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ) (C L δ K : ℝ)
    (hC : 0 ≤ C) (hL : 0 ≤ L) (hδ : 0 ≤ δ) (hh : 1/(2:ℝ)^h ≤ δ)
    (hval : ∀ m s z, |f m s z| ≤ C)
    (hLip : ∀ m s z w, |f m s w-f m s z| ≤ L*‖w-z‖)
    (S : Finset G.edges) (hcount : (S.card:ℝ) ≤ K*(2:ℝ)^(2*k))
    (hsupport : ∀ e : G.edges, e ∉ S → ∀ m s,
      f m s (scaledSite k e.val.1.val)=0 ∧ f m s (scaledSite k e.val.2.val)=0)
    (m s : Bool) (p : DyadicFreq k) :
    (∑ e, ‖G.thinScaledModeGradient h f m s p e‖^2) ≤ K*(L*δ+C*(Real.pi/4))^2 := by
  classical
  have hz (e : G.edges) (he : e ∉ S) : G.thinScaledModeGradient h f m s p e=0 := by
    obtain ⟨hl,hr⟩ := hsupport e he m s
    simp [thinScaledModeGradient, thinModeGradient, thinLatticeMode, hl, hr]
  calc _ = ∑ e ∈ S, ‖G.thinScaledModeGradient h f m s p e‖^2 := by
          symm
          apply Finset.sum_subset (Finset.subset_univ S)
          intro e _ he
          simp [hz e he]
       _ ≤ ∑ _e ∈ S, ((L*δ+C*(Real.pi/4))/(2:ℝ)^k)^2 :=
          Finset.sum_le_sum fun e _ => pow_le_pow_left₀ (norm_nonneg _)
            (G.thinScaledModeGradient_norm_le h f C L δ hC hL hδ hh hval hLip m s p e) 2
       _ = (S.card:ℝ)*((L*δ+C*(Real.pi/4))/(2:ℝ)^k)^2 := by simp
       _ ≤ (K*(2:ℝ)^(2*k))*((L*δ+C*(Real.pi/4))/(2:ℝ)^k)^2 :=
          mul_le_mul_of_nonneg_right hcount (sq_nonneg _)
       _ = _ := by rw [mul_comm 2 k, pow_mul]; field_simp

theorem thinMode_gradient_square_sum_le (G : LatticeGraph) (h : ℕ)
    (f : Bool → Bool → ℝ × ℝ → ℝ) (m s : Bool) (J : ℝ)
    (hc : ∀ p : DyadicFreq k, (∑ e, ‖G.thinScaledModeGradient h f m s p e‖^2) ≤ J)
    (p : DyadicFreq k) :
    (∑ e, ‖G.thinModeGradient h f m s p e‖^2) ≤ J/(dyadicRadius p:ℝ) := by
  have hr : (0:ℝ)<dyadicRadius p := by exact_mod_cast dyadicRadius_pos p
  have hd := hc p
  simp only [thinScaledModeGradient, norm_mul, mul_pow, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _), Real.sq_sqrt hr.le] at hd
  rw [← Finset.mul_sum] at hd
  exact (le_div_iff₀ hr).mpr (by simpa only [mul_comm] using hd)

theorem thinMode_sup_square_le (G : LatticeGraph) (h : ℕ)
    (f : Bool → Bool → ℝ × ℝ → ℝ) (m s : Bool) (p : DyadicFreq k)
    (C : ℝ) (hC : 0 ≤ C) (hv : ∀ z, |f m s z| ≤ C) :
    ‖(fun x : G.vertices => thinLatticeMode h f m s p x.val)‖^2 ≤ C^2*(1/(dyadicRadius p:ℝ))^3 := by
  have hnorm : ‖(fun x : G.vertices => thinLatticeMode h f m s p x.val)‖ ≤ dyadicWeight p*C := by
    apply (pi_norm_le_iff_of_nonneg (mul_nonneg (dyadicWeight_pos p).le hC)).mpr
    exact fun x => thinLatticeMode_norm_bound h f m s p x.val C hC (hv _)
  calc _ ≤ (dyadicWeight p*C)^2 := pow_le_pow_left₀ (norm_nonneg _) hnorm 2
       _ = _ := by rw [mul_pow, dyadicWeight_sq]; ring
theorem thinMode_gram_reweight (G : LatticeGraph) (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ) (m s : Bool) (e l : G.edges) :
    (∑ p : DyadicFreq k, G.thinScaledModeGradient h f m s p e*((1/(dyadicRadius p:ℝ)):ℂ)*
      conj (G.thinScaledModeGradient h f m s p l)) = ∑ p : DyadicFreq k,
        G.thinModeGradient h f m s p e*conj (G.thinModeGradient h f m s p l) := by
  apply Finset.sum_congr rfl
  intro p _
  have hr : (0:ℝ)<dyadicRadius p := by exact_mod_cast dyadicRadius_pos p
  have hs : ((Real.sqrt (dyadicRadius p:ℝ):ℂ)*((1/(dyadicRadius p:ℝ)):ℂ)*
      (Real.sqrt (dyadicRadius p:ℝ):ℂ)) = 1 := by
    have hsreal : Real.sqrt (dyadicRadius p:ℝ)*(1/(dyadicRadius p:ℝ))*Real.sqrt (dyadicRadius p:ℝ) = 1 := by
      rw [show Real.sqrt (dyadicRadius p:ℝ)*(1/(dyadicRadius p:ℝ))*Real.sqrt (dyadicRadius p:ℝ) =
      (Real.sqrt (dyadicRadius p:ℝ))^2/(dyadicRadius p:ℝ) by ring, Real.sq_sqrt hr.le, div_self hr.ne']
    exact_mod_cast hsreal
  simp only [thinScaledModeGradient, map_mul, Complex.conj_ofReal]
  linear_combination G.thinModeGradient h f m s p e*conj (G.thinModeGradient h f m s p l)*hs


theorem thinMode_group_gram_bound (G : LatticeGraph) (h : ℕ)
    (f : Bool → Bool → ℝ × ℝ → ℝ) (m s : Bool) (a J : ℝ) (hJ : 0 ≤ J)
    (hb : SquareBound (fun e (p : DyadicFreq k) => G.thinScaledModeGradient h f m s p e) a)
    (hc : ∀ p : DyadicFreq k, (∑ e, ‖G.thinScaledModeGradient h f m s p e‖^2) ≤ J) :
    (∑ e, ∑ l, ‖∑ p : DyadicFreq k, G.thinModeGradient h f m s p e*conj (G.thinModeGradient h f m s p l)‖^2)
      ≤ 3*a^2*J*(k:ℝ) := by
  have hh := hb.gram_weighted_column_bound hc (fun p => ((1/(dyadicRadius p:ℝ)):ℂ))
  simp_rw [G.thinMode_gram_reweight h f] at hh
  have he (p : DyadicFreq k) : ‖((1/(dyadicRadius p:ℝ)):ℂ)‖^2 = (1/(dyadicRadius p:ℝ))^2 := by
    have hr : (0:ℝ) ≤ dyadicRadius p := by positivity
    simp only [norm_div, norm_one, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr]
  simp_rw [he] at hh
  have hx := mul_le_mul_of_nonneg_left (dyadic_inverse_square_sum k)
    (by positivity : 0≤a^2*J)
  exact hh.trans (by nlinarith)

def thinModes (G : LatticeGraph) (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ)
    (i : ModeIndex k) (x : G.vertices) : ℂ := thinLatticeMode h f i.1.1 i.1.2 i.2 x.val

def thinModeDifferences (G : LatticeGraph) (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ)
    (i : ModeIndex k) (e : G.edges) : ℂ := G.thinModeGradient h f i.1.1 i.1.2 i.2 e

theorem thinModes_HS_bound (G : LatticeGraph) (h : ℕ)
    (f : Bool → Bool → ℝ × ℝ → ℝ) (a J : ℝ) (hJ : 0 ≤ J)
    (hb : ∀ m s, SquareBound (fun e (p : DyadicFreq k) => G.thinScaledModeGradient h f m s p e) a)
    (hc : ∀ m s (p : DyadicFreq k), (∑ e, ‖G.thinScaledModeGradient h f m s p e‖^2) ≤ J) :
    familyHSSquare (G.thinModeDifferences (k := k) h f) ≤ 48*a^2*J*(k:ℝ) := by
  unfold familyHSSquare rowSquare familyKernel thinModeDifferences
  simp only [Fintype.sum_prod_type]
  have hh := gram_groups_bound
    (fun (i : Bool × Bool) e l => ∑ p : DyadicFreq k,
      G.thinModeGradient h f i.1 i.2 p e*conj (G.thinModeGradient h f i.1 i.2 p l))
    (3*a^2*J*(k:ℝ)) (fun i => G.thinMode_group_gram_bound h f i.1 i.2 a J hJ (hb i.1 i.2) (hc i.1 i.2))
  simpa only [Fintype.sum_prod_type, Fintype.card_prod, Fintype.card_bool, Nat.cast_mul, Nat.cast_ofNat,
    show ((2:ℝ)*2)^2*(3*a^2*J*(k:ℝ)) = 48*a^2*J*(k:ℝ) by ring] using hh
theorem thinModes_min_bound (G : LatticeGraph) (h : ℕ)
    (f : Bool → Bool → ℝ × ℝ → ℝ) (J C : ℝ) (hJ : 0 ≤ J) (hC : 0 ≤ C)
    (hv : ∀ m s z, |f m s z| ≤ C)
    (hc : ∀ m s (p : DyadicFreq k), (∑ e, ‖G.thinScaledModeGradient h f m s p e‖^2) ≤ J) :
    (∑ i : ModeIndex k, ∑ j : ModeIndex k,
      min (‖G.thinModes h f i‖^2*∑ e, ‖G.thinModeDifferences h f j e‖^2)
          (‖G.thinModes h f j‖^2*∑ e, ‖G.thinModeDifferences h f i e‖^2)) ≤ 576*C^2*J*(k:ℝ) := by
  have hv' (i : ModeIndex k) : ‖G.thinModes h f i‖^2 ≤ C^2*(1/(dyadicRadius i.2:ℝ))^3 :=
    G.thinMode_sup_square_le h f i.1.1 i.1.2 i.2 C hC (hv i.1.1 i.1.2)
  have hd' (i : ModeIndex k) : (∑ e, ‖G.thinModeDifferences h f i e‖^2) ≤ J/(dyadicRadius i.2:ℝ) :=
    G.thinMode_gradient_square_sum_le h f i.1.1 i.1.2 J (hc i.1.1 i.1.2) i.2
  have hm (i j : ModeIndex k) :
      min (‖G.thinModes h f i‖^2*∑ e, ‖G.thinModeDifferences h f j e‖^2)
          (‖G.thinModes h f j‖^2*∑ e, ‖G.thinModeDifferences h f i e‖^2) ≤
      C^2*J*min ((1/(dyadicRadius i.2:ℝ))^3*(1/(dyadicRadius j.2:ℝ)))
                 ((1/(dyadicRadius j.2:ℝ))^3*(1/(dyadicRadius i.2:ℝ))) := by
    rw [mul_min_of_nonneg _ _ (mul_nonneg (sq_nonneg _) hJ)]
    apply min_le_min
    · calc _ ≤ (C^2*(1/(dyadicRadius i.2:ℝ))^3)*(J/(dyadicRadius j.2:ℝ)) :=
            mul_le_mul (hv' i) (hd' j) (Finset.sum_nonneg fun _ _ => sq_nonneg _) (by positivity)
           _ = _ := by ring
    · calc _ ≤ (C^2*(1/(dyadicRadius j.2:ℝ))^3)*(J/(dyadicRadius i.2:ℝ)) :=
            mul_le_mul (hv' j) (hd' i) (Finset.sum_nonneg fun _ _ => sq_nonneg _) (by positivity)
           _ = _ := by ring
  calc _ ≤ ∑ i : ModeIndex k, ∑ j : ModeIndex k,
        C^2*J*min ((1/(dyadicRadius i.2:ℝ))^3*(1/(dyadicRadius j.2:ℝ)))
                   ((1/(dyadicRadius j.2:ℝ))^3*(1/(dyadicRadius i.2:ℝ))) :=
           Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => hm i j
       _ = 16*C^2*J*∑ p : DyadicFreq k, ∑ q : DyadicFreq k,
           min ((1/(dyadicRadius p:ℝ))^3*(1/(dyadicRadius q:ℝ)))
               ((1/(dyadicRadius q:ℝ))^3*(1/(dyadicRadius p:ℝ))) := by
          simp only [ModeIndex, Fintype.sum_prod_type, Finset.sum_const, Finset.card_univ,
            Fintype.card_prod, Fintype.card_bool, Nat.cast_mul, nsmul_eq_mul, Nat.cast_ofNat, ← Finset.mul_sum]
          ring
       _ ≤ _ := by
          have hd := mul_le_mul_of_nonneg_left (dyadic_min_cost_sum k)
            (by positivity : 0 ≤ 16*C^2*J)
          nlinarith

def thinModeCommutator (G : LatticeGraph) (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ) (m s : Bool) (p : DyadicFreq k) (e : G.edges) : ℂ :=
  (thinLatticeMode h f m s p e.val.1.val*conj (thinLatticeMode h f m s p e.val.2.val)-
    conj (thinLatticeMode h f m s p e.val.1.val)*thinLatticeMode h f m s p e.val.2.val)/2

def thinProfileEdge (G : LatticeGraph) (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ) (k : ℕ) (e : G.edges) : ℝ :=
  (1/(2:ℝ)^k)*(f (G.edgeDirection e) false (scaledSite k e.val.1.val)*
    f (G.edgeDirection e) false (scaledSite k e.val.2.val)-
    f (G.edgeDirection e) true (scaledSite k e.val.1.val)*
    f (G.edgeDirection e) true (scaledSite k e.val.2.val))

theorem thinModeCommutator_formula (G : LatticeGraph) (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ) (m s : Bool) (p : DyadicFreq k) (e : G.edges) :
    G.thinModeCommutator h f m s p e = -Complex.I *
      ((f m s (scaledSite k e.val.1.val)*f m s (scaledSite k e.val.2.val)*
        ((tailWeight h p)^2*Real.sin (dyadicAngle k
          (if G.edgeDirection e then (groupedPoint m s p).2 else (groupedPoint m s p).1))):ℝ):ℂ) := by
  have hy : thinLatticeMode h f m s p e.val.2.val =
      (((tailWeight h p*f m s (scaledSite k e.val.2.val)):ℝ):ℂ)*
        torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) e.val.1.val)*
        Complex.exp (Complex.I*((dyadicAngle k
          (if G.edgeDirection e then (groupedPoint m s p).2 else (groupedPoint m s p).1):ℝ):ℂ)) := by
    unfold thinLatticeMode
    rw [show latticeTorus (16*2^k) e.val.2.val = latticeTorus (16*2^k) e.val.1.val+
      latticeTorus (16*2^k) (latticeAxis (G.edgeDirection e)) by rw [G.edge_step e,latticeTorus_add],
      torusWave_add, groupedWave_axis_sine]
    push_cast
    ring
  have hh := wave_commutator (tailWeight h p)
    (f m s (scaledSite k e.val.1.val)) (f m s (scaledSite k e.val.2.val))
    (dyadicAngle k (if G.edgeDirection e then (groupedPoint m s p).2 else (groupedPoint m s p).1))
    (torusWave (groupedTorusPoint m s p) (latticeTorus (16*2^k) e.val.1.val))
    (torusWave_norm _ _)
  unfold thinModeCommutator
  rw [hy]
  simp only [thinLatticeMode, Complex.ofReal_mul] at hh ⊢
  linear_combination hh

theorem thinMode_group_commutator (G : LatticeGraph) (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ) (m s : Bool) (e : G.edges) :
    (∑ p : DyadicFreq k, G.thinModeCommutator h f m s p e) = -Complex.I*
      ((f m s (scaledSite k e.val.1.val)*f m s (scaledSite k e.val.2.val)*
        (if m=G.edgeDirection e then (if s then -(tailLambda k h/(2:ℝ)^k) else tailLambda k h/(2:ℝ)^k) else 0):ℝ):ℂ) := by
  simp only [G.thinModeCommutator_formula h f, ← Finset.mul_sum, ← Complex.ofReal_sum]
  rw [tail_grouped_sine_sum]

theorem thinModes_commutator (G : LatticeGraph) (h : ℕ) (f : Bool → Bool → ℝ × ℝ → ℝ) (e : G.edges) :
    (∑ i : ModeIndex k, G.thinModeCommutator h f i.1.1 i.1.2 i.2 e) =
      -Complex.I*((tailLambda k h*G.thinProfileEdge h f k e:ℝ):ℂ) := by
  simp only [Fintype.sum_prod_type, G.thinMode_group_commutator h f, Fintype.sum_bool]
  cases h : G.edgeDirection e <;>
    simp [thinProfileEdge, h]
  all_goals ring



theorem thinModes_zero_pins (G : LatticeGraph) (h : ℕ)
    (f : Bool → Bool → ℝ × ℝ → ℝ) (P : G.vertices → Option RP3.Spin)
    (hP : ∀ x s, P x=some s → ∀ m t, f m t (scaledSite k x.val)=0)
    (i : ModeIndex k) (x : G.vertices) (s : RP3.Spin) (hs : P x=some s) :
    G.thinModes h f i x=0 := by
  simp [thinModes, thinLatticeMode, hP x s hs i.1.1 i.1.2]

theorem system_thinModes_commutator (G : LatticeGraph) (k h : ℕ)
    (f : Bool → Bool → ℝ × ℝ → ℝ) (b : G.edges → ℝ)
    (P : G.vertices → Option RP3.Spin) :
    (∑ i : ModeIndex k, (G.spinSystem b P).commutatorForm (G.thinModes h f i)
      (fun x => conj (G.thinModes h f i x))) =
      (fun e => -Complex.I*((tailLambda k h*G.thinProfileEdge h f k e:ℝ):ℂ)) := by
  ext e
  rw [Finset.sum_apply]
  convert G.thinModes_commutator h f e using 1
  apply Finset.sum_congr rfl
  intro i _
  simp only [RP3.Quadratic.SpinSystem.commutatorForm, RP3.Quadratic.SpinSystem.complexCross,
    Pi.smul_apply, smul_eq_mul, spinSystem, thinModes, thinModeCommutator]
  ring

def thinRotationCost (M C a J : ℝ) : ℝ :=
  16*((6*M^2+4*M*Real.sqrt M+M)*(48*a^2*J)+M*(576*C^2*J))

theorem thinRotationCost_nonneg (M C a J : ℝ) (hM : 0 ≤ M) (hJ : 0 ≤ J) :
    0 ≤ thinRotationCost M C a J := by unfold thinRotationCost; positivity

/-- Actual pinned RP³ response for a low-frequency-truncated family. All
analytic hypotheses concern explicit profiles or their finite Fourier matrix. -/
theorem thin_profile_response_bound (G : LatticeGraph) (k h : ℕ)
    (hk : 0 < k) (hh : 2*h ≤ k) (β : ℝ) (hβ : 0 ≤ β)
    (b : G.edges → ℝ) (hb : ∀ e, |b e| ≤ β)
    (P : G.vertices → Option RP3.Spin) (f : Bool → Bool → ℝ × ℝ → ℝ)
    (hP : ∀ x s, P x=some s → ∀ m t, f m t (scaledSite k x.val)=0)
    (C a J : ℝ) (hC : 0 ≤ C) (hJ : 0 ≤ J)
    (hv : ∀ m s z, |f m s z| ≤ C)
    (hsb : ∀ m s, SquareBound (fun e (p : DyadicFreq k) => G.thinScaledModeGradient h f m s p e) a)
    (hcol : ∀ m s (p : DyadicFreq k), (∑ e, ‖G.thinScaledModeGradient h f m s p e‖^2) ≤ J) :
    -(G.spinSystem b P).secondAxisResponse (G.thinProfileEdge h f k) (G.thinProfileEdge h f k) ≤
      thinRotationCost (16*β) C a J/(k:ℝ) := by
  have hfam := (G.spinSystem b P).rotation_family_bound β hβ hb (G.thinModes (k := k) h f)
    (fun i x s hs => G.thinModes_zero_pins h f P hP i x s hs)
  have hd : (fun i : ModeIndex k => (G.spinSystem b P).edgeGradient (G.thinModes h f i)) =
      G.thinModeDifferences h f := rfl
  rw [G.system_thinModes_commutator k h f b P,
    (G.spinSystem b P).response_imaginary_multiple, hd] at hfam
  have hde (i : ModeIndex k) (e : G.edges) :
      (G.spinSystem b P).edgeGradient (G.thinModes h f i) e = G.thinModeDifferences h f i e := rfl
  simp only [hde] at hfam
  let M := 16*β
  let T := (6*M^2+4*M*Real.sqrt M+M)*(48*a^2*J)+M*(576*C^2*J)
  let R := (G.spinSystem b P).secondAxisResponse (G.thinProfileEdge h f k) (G.thinProfileEdge h f k)
  have hM : 0 ≤ M := by dsimp [M]; positivity
  have hT : 0 ≤ T := by dsimp only [T]; positivity
  have hLam := tailLambda_lower_quarter k h hh
  have hkR : (0:ℝ) < k := by exact_mod_cast hk
  have hLp : 0 < tailLambda k h := by linarith
  have hHS := G.thinModes_HS_bound h f a J hJ hsb hcol
  have hmin := G.thinModes_min_bound h f J C hJ hC hv hcol
  have hcoef : 0 ≤ 6*M^2+4*M*Real.sqrt M+M := by positivity
  have hmin0 : 0 ≤ ∑ i : ModeIndex k, ∑ j : ModeIndex k,
      min (‖G.thinModes h f i‖^2*∑ e, ‖G.thinModeDifferences h f j e‖^2)
          (‖G.thinModes h f j‖^2*∑ e, ‖G.thinModeDifferences h f i e‖^2) := by positivity
  have hfamily : -(tailLambda k h)^2*R ≤ T*(k:ℝ) := by
    have hcost : (6*M^2+4*M*Real.sqrt M+M)*familyHSSquare (G.thinModeDifferences (k := k) h f)+
      M*(∑ i : ModeIndex k, ∑ j : ModeIndex k,
      min (‖G.thinModes h f i‖^2*∑ e, ‖G.thinModeDifferences h f j e‖^2)
          (‖G.thinModes h f j‖^2*∑ e, ‖G.thinModeDifferences h f i e‖^2)) ≤ T*(k:ℝ) := by
      calc _ ≤ (6*M^2+4*M*Real.sqrt M+M)*(48*a^2*J*(k:ℝ))+M*(576*C^2*J*(k:ℝ)) :=
        add_le_add (mul_le_mul_of_nonneg_left hHS hcoef) (mul_le_mul_of_nonneg_left hmin hM)
        _ = _ := by dsimp only [T]; ring
    apply le_trans _ hcost
    simpa only [R, M, neg_mul] using hfam.trans
      (add_le_add le_rfl (mul_le_mul_of_nonneg_right (show 4*β ≤ 16*β by linarith) hmin0))
  change -R ≤ 16*T/(k:ℝ)
  by_cases hr : R ≤ 0
  · apply (le_div_iff₀ hkR).mpr
    have hsq : (k:ℝ)^2/16 ≤ (tailLambda k h)^2 := by nlinarith
    have hx := mul_le_mul_of_nonneg_right hsq (neg_nonneg.mpr hr)
    nlinarith
  · have hx : 0 ≤ 16*T/(k:ℝ) := by positivity
    linarith

end LatticeGraph
end
end RP3.Fourier
end StandalonePart55

/- ===== RP3/ThinEdgeResponse.lean ===== -/
section StandalonePart56

/-! The thin-profile approximation on actual lattice edges and the corresponding
model-specific real-response transfer. -/
namespace RP3.Fourier
noncomputable section
open scoped BigOperators
namespace LatticeGraph

/-- The same two constants work for every location, shell width, mesh and graph. -/
theorem thinTheta_edge_bounds : ∃ L D : ℝ, 0 ≤ L ∧ 0 ≤ D ∧
    ∀ (a δ : ℝ), 0 < δ → δ ≤ a →
    ∀ (G : LatticeGraph) (k h : ℕ), 1/(2:ℝ)^k ≤ δ/16 → ∀ e : G.edges,
      |G.thinThetaEdge k a δ e| ≤ (L/δ)/(2:ℝ)^k ∧
      |G.thinThetaEdge k a δ e-G.thinProfileEdge h (thinProfile a δ) k e| ≤
        (D/δ^3)/((2:ℝ)^k)^3 := by
  obtain ⟨L,hL,hLip⟩ := thinTheta_lipschitz_bound
  obtain ⟨D,hD,hR⟩ := thinTheta_step_error
  refine ⟨L,D,hL,hD,?_⟩
  intro a δ hδ ha G k h hmesh e
  constructor
  · have ht := hLip a δ hδ ha (scaledSite k e.val.1.val) (scaledSite k e.val.2.val)
    rw [G.scaled_edge_distance] at ht
    exact ht.trans_eq (by ring)
  · have hs : |1/(2:ℝ)^k| ≤ δ/16 := by
      rwa [abs_of_pos (by positivity : 0 < 1/(2:ℝ)^k)]
    have ht := hR a δ hδ ha (G.edgeDirection e) (scaledSite k e.val.1.val) (1/(2:ℝ)^k) hs
    rw [← scaledSite_add_axis, ← G.edge_step e,
      abs_of_pos (by positivity : 0 < 1/(2:ℝ)^k)] at ht
    simpa only [thinThetaEdge, thinThetaPotential, thinProfileEdge,
      div_pow, one_pow, mul_one_div] using ht

/-- Transfer between two explicit real edge fields in the actual pinned model. -/
theorem thin_actual_response_transfer (G : LatticeGraph) (k : ℕ)
    (hG : G.WithinDyadicBox k) (β : ℝ) (hβ : 0 ≤ β)
    (b : G.edges → ℝ) (hb : ∀ e, |b e| ≤ β)
    (P : G.vertices → Option RP3.Spin) (u v : G.edges → ℝ)
    (A L D : ℝ) (hA : 0 ≤ A) (hL : 0 ≤ L) (hD : 0 ≤ D)
    (hp : -(G.spinSystem b P).secondAxisResponse v v ≤ A)
    (he : ∀ e : G.edges, |u e| ≤ L/(2:ℝ)^k ∧
      |u e-v e| ≤ D/((2:ℝ)^k)^3) :
    -(G.spinSystem b P).secondAxisResponse u u ≤
      A+transferCostConstant (16*β) L D/(2:ℝ)^k := by
  have ht := (G.spinSystem b P).real_response_transfer β A hβ hA hb u v hp
  apply G.thin_response_bound_of_transfer k hG u v (16*β) L D A
    ((G.spinSystem b P).secondAxisResponse u u) (by positivity) hL hD he
  apply ht.trans
  gcongr <;> linarith

end LatticeGraph
end
end RP3.Fourier
end StandalonePart56

/- ===== RP3/ThinCosts.lean ===== -/
section StandalonePart57

/-! Numerical scaling of the balanced-profile and real-response costs. -/
namespace RP3.Fourier.LatticeGraph
noncomputable section

theorem thin_balanced_column_eq (P δ : ℝ) (hδ : 0 < δ) :
    64*δ*(P/(δ*Real.sqrt δ)*δ+(P/Real.sqrt δ)*(Real.pi/4))^2 =
      64*(P+P*(Real.pi/4))^2 := by
  have hs : Real.sqrt δ ≠ 0 := (Real.sqrt_pos.mpr hδ).ne'
  have hh : P/(δ*Real.sqrt δ)*δ+(P/Real.sqrt δ)*(Real.pi/4) =
      (P+P*(Real.pi/4))/Real.sqrt δ := by field_simp
  rw [hh, div_pow, Real.sq_sqrt hδ.le]
  field_simp

theorem thin_balanced_block_square (P δ : ℝ) (hδ : 0 < δ) :
    (2*thinModeBlockConstant (P/Real.sqrt δ) (P/(δ*Real.sqrt δ)) δ)^2 =
      (2*modeBlockConstant P)^2/δ := by
  have hs : Real.sqrt δ ≠ 0 := (Real.sqrt_pos.mpr hδ).ne'
  have hh : P/(δ*Real.sqrt δ)*δ = P/Real.sqrt δ := by field_simp
  unfold thinModeBlockConstant modeBlockConstant
  rw [hh]
  simp only [mul_pow]
  rw [Real.sq_sqrt (by positivity), Real.sq_sqrt (by positivity)]
  simp only [div_pow, Real.sq_sqrt hδ.le]
  ring

theorem thin_balanced_rotation_cost (M P δ : ℝ) (hδ : 0 < δ) :
    thinRotationCost M (P/Real.sqrt δ)
      (2*thinModeBlockConstant (P/Real.sqrt δ) (P/(δ*Real.sqrt δ)) δ)
      (64*δ*(P/(δ*Real.sqrt δ)*δ+(P/Real.sqrt δ)*(Real.pi/4))^2) =
    thinRotationCost M P (2*modeBlockConstant P) (64*(P+P*(Real.pi/4))^2)/δ := by
  rw [thin_balanced_column_eq P δ hδ]
  unfold thinRotationCost
  rw [thin_balanced_block_square P δ hδ, div_pow, Real.sq_sqrt hδ.le]
  ring

/-- Every monomial in the real-response remainder costs at most six inverse
powers of the annulus width. -/
theorem thin_transfer_cost_le (M L D δ : ℝ)
    (hM : 0 ≤ M) (hL : 0 ≤ L) (hD : 0 ≤ D) (hδ : 0 < δ) (hδ1 : δ ≤ 1) :
    transferCostConstant M (L/δ) (D/δ^3) ≤
      transferCostConstant M L D / δ^6 := by
  have hd1 : δ^1 ≤ 1 := by simpa using hδ1
  have hd2 : δ^2 ≤ 1 := pow_le_one₀ hδ.le hδ1
  have hd3 : δ^3 ≤ 1 := pow_le_one₀ hδ.le hδ1
  have h4 : 1/δ^4 ≤ 1/δ^6 := by
    apply one_div_le_one_div_of_le (by positivity)
    calc δ^6 = δ^4*δ^2 := by ring
      _ ≤ δ^4*1 := mul_le_mul_of_nonneg_left hd2 (by positivity)
      _ = _ := mul_one _
  have h5 : 1/δ^5 ≤ 1/δ^6 := by
    apply one_div_le_one_div_of_le (by positivity)
    calc δ^6 = δ^5*δ := by ring
      _ ≤ δ^5*1 := mul_le_mul_of_nonneg_left hδ1 (by positivity)
      _ = _ := mul_one _
  have h3 : 1/δ^3 ≤ 1/δ^6 := by
    apply one_div_le_one_div_of_le (by positivity)
    calc δ^6 = δ^3*δ^3 := by ring
      _ ≤ δ^3*1 := mul_le_mul_of_nonneg_left hd3 (by positivity)
      _ = _ := mul_one _
  have h4' := mul_le_mul_of_nonneg_left h4 (by positivity : 0 ≤ 1024*M*D*L)
  have h5' := mul_le_mul_of_nonneg_left h5 (by positivity : 0 ≤ 262144*M^2*D*L^2)
  have h3' := mul_le_mul_of_nonneg_left h3 (by positivity : 0 ≤ 512*M*D)
  unfold transferCostConstant
  calc _ = 1024*M*D*L*(1/δ^4) + 512*M*D^2*(1/δ^6) +
        262144*M^2*D*L^2*(1/δ^5) + 512*M*D*(1/δ^3) +
        262144*M^2*D^2*(1/δ^6) := by ring
    _ ≤ 1024*M*D*L*(1/δ^6) + 512*M*D^2*(1/δ^6) +
        262144*M^2*D*L^2*(1/δ^6) + 512*M*D*(1/δ^6) +
        262144*M^2*D^2*(1/δ^6) := by linarith
    _ = _ := by ring

end
end RP3.Fourier.LatticeGraph
end StandalonePart57

/- ===== RP3/ThinSupport.lean ===== -/
section StandalonePart58

/-! Cardinality of the support of thin-annulus mode gradients. -/
namespace RP3.Fourier
noncomputable section
open Finset
open scoped BigOperators

def integerSquare (S : ℤ) : Finset Site :=
  Icc (-S) S ×ˢ Icc (-S) S

@[simp] theorem mem_integerSquare (S : ℤ) (v : Site) :
    v ∈ integerSquare S ↔ siteRadius (0,0) v ≤ S := by
  simp [integerSquare, siteRadius, max_le_iff, abs_le,
    and_assoc, and_left_comm, and_comm]

theorem integerSquare_mono {R S : ℤ} (h : R ≤ S) :
    integerSquare R ⊆ integerSquare S := by
  intro v hv
  exact (mem_integerSquare S v).mpr (((mem_integerSquare R v).mp hv).trans h)

theorem integerSquare_card (S : ℤ) (hS : 0 ≤ S) :
    ((integerSquare S).card : ℝ) = (2*(S:ℝ)+1)^2 := by
  have hi : ((Icc (-S) S).card : ℝ) = 2*(S:ℝ)+1 := by
    have hh := Int.card_Icc_of_le (-S) S (show -S ≤ S+1 by omega)
    have hh' : ((Icc (-S) S).card : ℤ) = 2*S+1 := by omega
    exact_mod_cast hh'
  simp only [integerSquare, card_product, Nat.cast_mul, hi]
  ring

def integerSquareShell (R S : ℤ) : Finset Site :=
  integerSquare S \ integerSquare (R-1)

@[simp] theorem mem_integerSquareShell (R S : ℤ) (v : Site) :
    v ∈ integerSquareShell R S ↔ R ≤ siteRadius (0,0) v ∧ siteRadius (0,0) v ≤ S := by
  simp only [integerSquareShell, mem_sdiff, mem_integerSquare]
  omega

theorem integerSquareShell_card (R S : ℤ) (hR : 1 ≤ R) (hRS : R ≤ S) :
    ((integerSquareShell R S).card : ℝ) =
      4*((S:ℝ)+R)*((S:ℝ)-R+1) := by
  have hi := integerSquare_mono (show R-1 ≤ S by omega)
  have hc := card_sdiff_add_card_eq_card hi
  have hc' : ((integerSquareShell R S).card:ℝ) +
      ((integerSquare (R-1)).card:ℝ) = ((integerSquare S).card:ℝ) := by
    exact_mod_cast hc
  rw [integerSquare_card S (by omega), integerSquare_card (R-1) (by omega)] at hc'
  push_cast at hc'
  nlinarith

theorem integerSquareShell_card_bound (N R S : ℤ)
    (hN : 1 ≤ N) (hNR : N ≤ R) (hRS : R < S) (hSN : S ≤ 2*N) :
    ((integerSquareShell R S).card : ℝ) ≤ 32*(N:ℝ)*((S:ℝ)-R) := by
  rw [integerSquareShell_card R S (by omega) hRS.le]
  have hN' : (1:ℝ) ≤ N := by exact_mod_cast hN
  have hNR' : (N:ℝ) ≤ R := by exact_mod_cast hNR
  have hRS' : (R:ℝ)+1 ≤ S := by exact_mod_cast (show R+1 ≤ S by omega)
  have hSN' : (S:ℝ) ≤ 2*N := by exact_mod_cast hSN
  have hsum : (S:ℝ)+R ≤ 4*N := by linarith
  have hwidth : (S:ℝ)-R+1 ≤ 2*((S:ℝ)-R) := by linarith
  have hp := mul_le_mul hsum hwidth (by linarith : (0:ℝ) ≤ S-R+1)
    (by linarith : (0:ℝ) ≤ 4*N)
  nlinarith

namespace LatticeGraph

/-- An edge in the support is determined by its origin and its direction.
Both endpoints lie in the closed thin shell. -/
theorem thinKernelEdges_card_bound (G : LatticeGraph) (N R S : ℤ)
    (hN : 1 ≤ N) (hNR : N ≤ R) (hRS : R < S) (hSN : S ≤ 2*N) :
    ((G.thinKernelEdges R S (0,0)).card : ℝ) ≤
      64*(N:ℝ)*((S:ℝ)-R) := by
  let i : (G.thinKernelEdges R S (0,0)) → Bool × (integerSquareShell R S) :=
    fun e => (G.edgeDirection e.val, ⟨e.val.val.1.val,
      (mem_integerSquareShell R S _).mpr
        (G.thinKernelEdges_endpoints R S (0,0) e.val e.property).1⟩)
  have hi : Function.Injective i := by
    intro e f h
    have hm : G.edgeDirection e.val = G.edgeDirection f.val := congrArg Prod.fst h
    have hx : e.val.val.1 = f.val.val.1 := by
      apply Subtype.ext
      exact congrArg (fun q : Bool × integerSquareShell R S => q.2.val) h
    have he := G.edge_step e.val
    have hf := G.edge_step f.val
    have hy : e.val.val.2 = f.val.val.2 := by
      apply Subtype.ext
      rw [he, hf, hm, hx]
    apply Subtype.ext
    apply Subtype.ext
    exact Prod.ext hx hy
  have hc := Fintype.card_le_of_injective i hi
  simp only [Fintype.card_coe, Fintype.card_prod, Fintype.card_bool] at hc
  have hc' : ((G.thinKernelEdges R S (0,0)).card:ℝ) ≤
      2*((integerSquareShell R S).card:ℝ) := by exact_mod_cast hc
  have hs := integerSquareShell_card_bound N R S hN hNR hRS hSN
  linarith

/-- A square-sum estimate that retains the thin spatial support. -/
theorem thin_supported_square_sum (G : LatticeGraph) (N R S : ℤ)
    (hN : 1 ≤ N) (hNR : N ≤ R) (hRS : R < S) (hSN : S ≤ 2*N)
    (U : G.edges → ℂ) (B : ℝ) (hB : 0 ≤ B)
    (hzero : ∀ e, e ∉ G.thinKernelEdges R S (0,0) → U e = 0)
    (hbound : ∀ e, ‖U e‖^2 ≤ B) :
    (∑ e, ‖U e‖^2) ≤ 64*(N:ℝ)*((S:ℝ)-R)*B := by
  classical
  have heq : (∑ e, ‖U e‖^2) = ∑ e ∈ G.thinKernelEdges R S (0,0), ‖U e‖^2 := by
    symm
    apply sum_subset (subset_univ _)
    intro e _ he
    simp [hzero e he]
  rw [heq]
  calc
    _ ≤ ∑ e ∈ G.thinKernelEdges R S (0,0), B := sum_le_sum fun e _ => hbound e
    _ = ((G.thinKernelEdges R S (0,0)).card:ℝ)*B := by simp
    _ ≤ _ := mul_le_mul_of_nonneg_right (G.thinKernelEdges_card_bound N R S hN hNR hRS hSN) hB

end LatticeGraph
end
end RP3.Fourier
end StandalonePart58

/- ===== RP3/ThinResponse.lean ===== -/
section StandalonePart59

/-! Uniform response estimates for the actual pinned RP³ Gibbs system on a
thin square annulus.  No analytic estimate remains as an input hypothesis. -/
namespace RP3.Fourier.LatticeGraph
noncomputable section
open scoped BigOperators Classical

/-- The constants are chosen before the shell, graph, couplings and arbitrary
pinned directors. The first error is inverse logarithmic with one inverse
power of the relative width; the mesh remainder costs six inverse powers. -/
theorem thin_annulus_response (β : ℝ) (hβ : 0 ≤ β) :
    ∃ K V : ℝ, 0 ≤ K ∧ 0 ≤ V ∧
      ∀ (k h : ℕ), 0 < k → 2*h ≤ k →
      ∀ (a δ : ℝ), 0 < δ → δ ≤ 1 → δ ≤ a →
        1/(2:ℝ)^h ≤ δ → 1/(2:ℝ)^k ≤ δ/16 →
      ∀ (R S : ℤ), (2:ℤ)^k ≤ R → R < S → S ≤ 2*(2:ℤ)^k →
        (R:ℝ) = a*(2:ℝ)^k → (S:ℝ) = (a+δ)*(2:ℝ)^k →
      ∀ (G : LatticeGraph), G.WithinDyadicBox k →
      ∀ (b : G.edges → ℝ), (∀ e, |b e| ≤ β) →
      ∀ (P : G.vertices → Option RP3.Spin), G.ThinBoundaryPins k a δ P →
      -(G.spinSystem b P).secondAxisResponse
        (G.thinThetaEdge k a δ) (G.thinThetaEdge k a δ) ≤
          K/δ/(k:ℝ)+V/δ^6/(2:ℝ)^k := by
  obtain ⟨P0,hP0,hprofiles⟩ := thinProfile_uniform_bounds
  obtain ⟨L0,D0,hL0,hD0,hedges⟩ := thinTheta_edge_bounds
  let K := thinRotationCost (16*β) P0 (2*modeBlockConstant P0)
    (64*(P0+P0*(Real.pi/4))^2)
  let V := transferCostConstant (16*β) L0 D0
  have hK : 0 ≤ K := thinRotationCost_nonneg _ _ _ _ (by positivity) (by positivity)
  have hV : 0 ≤ V := transferCostConstant_nonneg _ _ _ (by positivity) hL0 hD0
  refine ⟨K,V,hK,hV,?_⟩
  intro k h hk hh a δ hδ hδ1 ha hfreq hmesh R S hNR hRS hSN hR hS G hG b hb pins hpins
  obtain ⟨hval,hLip⟩ := hprofiles a δ hδ ha
  let C := P0/Real.sqrt δ
  let L := P0/(δ*Real.sqrt δ)
  let A := 2*thinModeBlockConstant C L δ
  let J := 64*δ*(L*δ+C*(Real.pi/4))^2
  have hC : 0 ≤ C := by dsimp [C]; positivity
  have hL : 0 ≤ L := by dsimp [L]; positivity
  have hJ : 0 ≤ J := by dsimp [J]; positivity
  have hcount : ((G.thinKernelEdges R S 0).card:ℝ) ≤ (64*δ)*(2:ℝ)^(2*k) := by
    have hc := G.thinKernelEdges_card_bound (2^k) R S
      (one_le_pow₀ (by norm_num : (1:ℤ) ≤ 2)) hNR hRS hSN
    have hc' : ((G.thinKernelEdges R S 0).card:ℝ) ≤
        64*(2:ℝ)^k*((S:ℝ)-R) := by
      simpa only [Int.cast_pow,Int.cast_ofNat, show ((0,0):Site)=0 from rfl] using hc
    apply hc'.trans_eq
    rw [hR,hS,mul_comm 2 k,pow_mul]
    ring
  have hsupport : ∀ e : G.edges, e ∉ G.thinKernelEdges R S 0 → ∀ m s,
      thinProfile a δ m s (scaledSite k e.val.1.val)=0 ∧
      thinProfile a δ m s (scaledSite k e.val.2.val)=0 := by
    intro e he m s
    simp only [mem_thinKernelEdges,not_or] at he
    exact ⟨G.thinProfile_zero_outside_layer k a δ hδ ha R S hR hS m s _ he.1,
      G.thinProfile_zero_outside_layer k a δ hδ ha R S hR hS m s _ he.2⟩
  have hsb (m s : Bool) :
      SquareBound (fun e (p : DyadicFreq k) =>
        G.thinScaledModeGradient h (thinProfile a δ) m s p e) A :=
    G.thinScaledModes_squareBound hG h (thinProfile a δ) C L δ hδ.le hfreq hval hLip m s
  have hcol (m s : Bool) (p : DyadicFreq k) :
      (∑ e, ‖G.thinScaledModeGradient h (thinProfile a δ) m s p e‖^2) ≤ J :=
    G.thinScaledModes_column_bound h (thinProfile a δ) C L δ (64*δ)
      hC hL hδ.le hfreq hval hLip (G.thinKernelEdges R S 0) hcount hsupport m s p
  have hpin : ∀ x s, pins x=some s → ∀ m t,
      thinProfile a δ m t (scaledSite k x.val)=0 := by
    intro x s hx m t
    exact G.thinProfiles_zero_pins k a δ hδ ha pins hpins m t x s hx
  have hp := G.thin_profile_response_bound k h hk hh β hβ b hb pins
    (thinProfile a δ) hpin C A J hC hJ hval hsb hcol
  have hcost : thinRotationCost (16*β) C A J = K/δ :=
    thin_balanced_rotation_cost (16*β) P0 δ hδ
  rw [hcost] at hp
  have ht := G.thin_actual_response_transfer k hG β hβ b hb pins
    (G.thinThetaEdge k a δ) (G.thinProfileEdge h (thinProfile a δ) k)
    (K/δ/(k:ℝ)) (L0/δ) (D0/δ^3) (by positivity) (by positivity) (by positivity)
    hp (hedges a δ hδ ha G k h hmesh)
  apply ht.trans
  apply add_le_add le_rfl
  exact div_le_div_of_nonneg_right
    (thin_transfer_cost_le (16*β) L0 D0 δ (by positivity) hL0 hD0 hδ hδ1)
    (by positivity)

end
end RP3.Fourier.LatticeGraph
end StandalonePart59

/- ===== RP3/ThinDyadicParameters.lean ===== -/
section StandalonePart60

/-! Numerical conversion between integer dyadic shell widths and normalized
thin-annulus parameters. -/
namespace RP3.Fourier
noncomputable section

/-- The normalized width `2⁻ʰ` corresponds to the integer width `2^(n-h)`. -/
theorem thin_dyadic_width (n h : ℕ) (hh : h ≤ n) :
    (2:ℝ)^(n-h) = (1/(2:ℝ)^h)*(2:ℝ)^n := by
  have hp : (2:ℝ)^n = (2:ℝ)^h*(2:ℝ)^(n-h) := by
    rw [←pow_add, Nat.add_sub_of_le hh]
  rw [hp]
  field_simp

/-- All geometric and mesh hypotheses for a shell in a dyadic band. -/
theorem thin_dyadic_parameters (n h : ℕ) (hh : 2*h ≤ n) (hm : 4 ≤ n-h)
    (R : ℤ) (hR : (2:ℤ)^n ≤ R)
    (hS : R+(2:ℤ)^(n-h) ≤ 2*(2:ℤ)^n) :
    let a := (R:ℝ)/(2:ℝ)^n
    let δ := 1/(2:ℝ)^h
    let S := R+(2:ℤ)^(n-h)
    0 < δ ∧ δ ≤ 1 ∧ 1 ≤ a ∧ δ ≤ a ∧ a+δ ≤ 2 ∧
      1/(2:ℝ)^n ≤ δ/16 ∧ R < S ∧
      (R:ℝ) = a*(2:ℝ)^n ∧ (S:ℝ) = (a+δ)*(2:ℝ)^n := by
  dsimp only
  have hh' : h ≤ n := by omega
  have hN : 0 < (2:ℝ)^n := by positivity
  have hH : 0 < (2:ℝ)^h := by positivity
  have hδ : 0 < 1/(2:ℝ)^h := by positivity
  have hδ1 : 1/(2:ℝ)^h ≤ 1 := by
    exact (div_le_one hH).mpr (one_le_pow₀ (by norm_num))
  have hR' : (2:ℝ)^n ≤ (R:ℝ) := by exact_mod_cast hR
  have ha : 1 ≤ (R:ℝ)/(2:ℝ)^n := by rwa [le_div_iff₀ hN, one_mul]
  have hr : (R:ℝ) = (R:ℝ)/(2:ℝ)^n*(2:ℝ)^n := by field_simp
  have hw := thin_dyadic_width n h hh'
  have hs : ((R+(2:ℤ)^(n-h):ℤ):ℝ) =
      ((R:ℝ)/(2:ℝ)^n+1/(2:ℝ)^h)*(2:ℝ)^n := by
    push_cast
    rw [hw]
    calc _ = (R:ℝ)/(2:ℝ)^n*(2:ℝ)^n+(1/(2:ℝ)^h)*(2:ℝ)^n := by rw [←hr]
         _ = _ := by ring
  have htop : (R:ℝ)/(2:ℝ)^n+1/(2:ℝ)^h ≤ 2 := by
    apply (mul_le_mul_iff_left₀ hN).mp
    rw [←hs]
    have ht : ((R+(2:ℤ)^(n-h):ℤ):ℝ) ≤ 2*(2:ℝ)^n := by exact_mod_cast hS
    exact ht
  have h16 : (16:ℝ) ≤ (2:ℝ)^(n-h) := by
    calc (16:ℝ) = (2:ℝ)^4 := by norm_num
         _ ≤ _ := pow_le_pow_right₀ (by norm_num) hm
  have hp : (2:ℝ)^n = (2:ℝ)^h*(2:ℝ)^(n-h) := by
    rw [←pow_add, Nat.add_sub_of_le hh']
  have hmesh : 1/(2:ℝ)^n ≤ (1/(2:ℝ)^h)/16 := by
    rw [div_div]
    apply one_div_le_one_div_of_le (by positivity)
    rw [hp]
    nlinarith
  refine ⟨hδ,hδ1,ha,hδ1.trans ha,htop,hmesh,?_,hr,hs⟩
  have hwpos : (0:ℤ) < 2^(n-h) := by positivity
  omega

/-- Convert the response estimate to the form used by dyadic scale selection. -/
theorem thin_dyadic_response_cost (n h : ℕ) (hm : 0 < n-h)
    (K V : ℝ) (hK : 0 ≤ K) (hV : 0 ≤ V) :
    K/(1/(2:ℝ)^h)/(n:ℝ) + V/(1/(2:ℝ)^h)^6/(2:ℝ)^n ≤
      K*(2:ℝ)^h/((n-h:ℕ):ℝ) + V*(2:ℝ)^(6*h)/(2:ℝ)^n := by
  have hnh : (0:ℝ) < (n-h:ℕ) := by exact_mod_cast hm
  have hn : 0 < n := by omega
  have hnR : (0:ℝ) < n := by exact_mod_cast hn
  have hle : ((n-h:ℕ):ℝ) ≤ n := by exact_mod_cast Nat.sub_le n h
  have hfirst : K/(1/(2:ℝ)^h)/(n:ℝ) ≤ K*(2:ℝ)^h/((n-h:ℕ):ℝ) := by
    rw [div_div_eq_mul_div, div_one]
    exact div_le_div_of_nonneg_left (by positivity) hnh hle
  have hsecond : V/(1/(2:ℝ)^h)^6/(2:ℝ)^n = V*(2:ℝ)^(6*h)/(2:ℝ)^n := by
    rw [div_pow, one_pow, div_div_eq_mul_div, div_one, Nat.mul_comm 6 h, pow_mul]
  exact add_le_add hfirst hsecond.le

end
end RP3.Fourier
end StandalonePart60

/- ===== RP3/DenseRates.lean ===== -/
section StandalonePart61

/-!
# Sharper all-temperature decay from adjacent dyadic annuli

The strict annular interiors at radii `N` and `2*N` are disjoint; their
shared pinned boundary causes no overlap of integrated variables or edges.
This retains every dyadic scale instead of every other one. All hypotheses
remain uniform over finite retained graphs and signed bounded couplings.
-/
namespace RP3
noncomputable section
open Finset MeasureTheory
open RP3.Fourier

/-- Number of adjacent dyadic annuli whose outer radius is less than `r`. -/
noncomputable def denseAnnulusCount (N r : ℕ) (hN : 0 < N) : ℕ :=
  Nat.find (show ∃ k : ℕ, r ≤ 2 * N * 2 ^ k from
    ⟨r, (Nat.lt_pow_self (by norm_num : 1 < (2 : ℕ))).le.trans
      (Nat.le_mul_of_pos_left _ (by omega))⟩)

theorem denseAnnulusCount_cover (N r : ℕ) (hN : 0 < N) :
    r ≤ 2 * N * 2 ^ denseAnnulusCount N r hN := by
  unfold denseAnnulusCount
  exact Nat.find_spec (p := fun k => r ≤ 2 * N * 2 ^ k) _

theorem denseAnnulusCount_inside (N r : ℕ) (hN : 0 < N) {j : ℕ}
    (hj : j < denseAnnulusCount N r hN) : 2 * N * 2 ^ j < r := by
  unfold denseAnnulusCount at hj
  exact Nat.lt_of_not_ge (Nat.find_min (p := fun k => r ≤ 2 * N * 2 ^ k) _ hj)

theorem denseAnnulusCount_distance (N r : ℕ) (hN : 0 < N) :
    1 + (r : ℝ) ≤ (2 * N + 1) * (2 : ℝ) ^ denseAnnulusCount N r hN := by
  have hc : (r : ℝ) ≤ 2 * N * (2 : ℝ) ^ denseAnnulusCount N r hN := by
    exact_mod_cast denseAnnulusCount_cover N r hN
  have hp : (1 : ℝ) ≤ 2 ^ denseAnnulusCount N r hN := one_le_pow₀ (by norm_num)
  nlinarith

def adjacentDyadicRadius (a j : ℕ) : ℕ := 2^(a+j)

theorem adjacentDyadicRadius_eq (a j : ℕ) :
    adjacentDyadicRadius a j = 2^a * 2^j := by
  simp only [adjacentDyadicRadius, pow_add]

theorem adjacentDyadicRadius_separated (a i j : ℕ) (hij : i < j) :
    2 * adjacentDyadicRadius a i ≤ adjacentDyadicRadius a j := by
  have h : (2:ℕ)^(a+i+1) ≤ 2^(a+j) :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  simpa only [adjacentDyadicRadius, pow_succ, Nat.mul_comm] using h

theorem dense_factor_le {D : ℝ} (hD : 0 ≤ D) {a : ℕ} (ha : 2 ≤ a) (j : ℕ) :
    D / (a+(j:ℝ)) ≤ D/(j+1) := by
  have haR : (2:ℝ) ≤ a := by exact_mod_cast ha
  exact div_le_div_of_nonneg_left hD (by positivity) (by linarith)

namespace Fourier.LatticeGraph

/-- The annular product estimate remains valid when consecutive annuli share
only their pinned boundary. -/
theorem adjacent_square_annuli_product_bound (G : LatticeGraph) (b : G.edges → ℝ)
    (k : ℕ) (N : Fin k → ℤ) (hN : ∀ i, 2 ≤ N i)
    (hsep : ∀ i j, i < j → 2*N i ≤ N j)
    (x y : G.vertices) (hy : ∀ i, 2*N i < siteRadius x.val y.val)
    (ε : Fin k → ℝ) (hε : ∀ i, 0 < ε i)
    (hcompare : ∀ i (g : Quaternion) τ,
      (1 - ε i) * pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (N i) x.val) b) (G.strictLayer (N i) x.val)ᶜ
        ((quaternionAction.onCut (G.innerCut (N i) x.val)).move g τ) ≤
      pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (N i) x.val) b) (G.strictLayer (N i) x.val)ᶜ τ) :
    |correlation (fun e : G.edges => e.val) b x y| ≤ (3 : ℝ) / 4 * ∏ i, ε i := by
  classical
  let sets := fun i => G.kernelEdges (N i) x.val
  let pins := fun i => (G.strictLayer (N i) x.val)ᶜ
  let cuts := fun i => G.innerCut (N i) x.val
  have hleft (i : Fin k) : x ∈ pins i := by
    simp only [pins, mem_compl, mem_strictLayer, siteRadius_self]
    have := hN i
    omega
  have hright (i : Fin k) : y ∈ pins i := by
    simp only [pins, mem_compl, mem_strictLayer]
    have := hy i
    omega
  apply concrete_kernel_product_bound (fun e : G.edges => e.val) b sets pins cuts
    x y ε
  · intro i j hij
    rcases lt_or_gt_of_ne hij with hij | hji
    · exact G.separated_kernelEdges_le x.val (hsep i j hij)
    · exact (G.separated_kernelEdges_le x.val (hsep j i hji)).symm
  · intro i j
    rcases le_total i j with hij | hji
    · left
      apply G.innerCut_mono
      rcases eq_or_lt_of_le hij with rfl | hij
      · exact le_rfl
      · have := hsep i j hij
        have := hN i
        omega
    · right
      apply G.innerCut_mono
      rcases eq_or_lt_of_le hji with rfl | hji
      · exact le_rfl
      · have := hsep j i hji
        have := hN j
        omega
  · intro i e
    by_cases he : ∃ j, e ∈ sets j
    · left
      simp [remainingCoupling, he]
    · right
      have hn : e ∉ sets i := fun hi => he ⟨i, hi⟩
      simpa only [sets, pins, mem_kernelEdges, not_or, mem_compl] using hn
  · intro i j hij e
    by_cases he : e ∈ sets j
    · right
      simp only [pins, mem_compl]
      rcases lt_or_gt_of_ne hij with hij | hji
      · exact G.kernelEdges_avoid_smaller_interior_le x.val (hsep i j hij) e he
      · exact G.kernelEdges_avoid_larger_interior_le x.val (hsep j i hji) e he
    · left
      simp [maskedCoupling, he]
  · exact fun i => ⟨hleft i, hright i⟩
  · intro i e
    by_cases he : ∃ j, e ∈ sets j
    · left
      simp [remainingCoupling, he]
    · right
      exact G.nonkernel_same_side (N i) (hN i) x.val e (fun hi => he ⟨i,hi⟩)
  · intro i j hij e
    by_cases he : e ∈ sets j
    · right
      rcases lt_or_gt_of_ne hij with hij | hji
      · have hn := G.kernelEdges_outside_smaller_cut_le (by have := hN i; omega)
          x.val (hsep i j hij) e he
        exact iff_of_false hn.1 hn.2
      · have hn := G.kernelEdges_inside_larger_cut_le x.val (hsep j i hji) e he
        exact iff_of_true hn.1 hn.2
    · left
      simp [maskedCoupling, he]
  · intro i
    simp only [cuts, mem_innerCut, siteRadius_self]
    have := hN i
    have := hy i
    omega
  · exact hε
  · exact hcompare


/-- Using every dyadic scale doubles the leading logarithmic decay coefficient. -/
theorem dense_factorial_of_dyadic_kernel_bounds {D : ℝ} (hD : 0 < D)
    (a : ℕ) (ha : 2 ≤ a) (G : LatticeGraph) (b : G.edges → ℝ)
    (hcomp : ∀ n : ℕ, a ≤ n → ∀ (z : Site) (g : Quaternion) τ,
      (1-D/(n:ℝ)) * pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (2^n:ℕ) z) b) (G.strictLayer (2^n:ℕ) z)ᶜ
        ((quaternionAction.onCut (G.innerCut (2^n:ℕ) z)).move g τ) ≤
      pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.kernelEdges (2^n:ℕ) z) b) (G.strictLayer (2^n:ℕ) z)ᶜ τ)
    (x y : G.vertices) :
    let r := (siteRadius x.val y.val).toNat
    let k := denseAnnulusCount (2^a) r (by positivity)
    |correlation (fun e : G.edges => e.val) b x y| ≤ (3 : ℝ) / 4 * D^k/k.factorial := by
  classical
  dsimp only
  let r := (siteRadius x.val y.val).toNat
  let k := denseAnnulusCount (2^a) r (by positivity)
  let N : Fin k → ℤ := fun i => RP3.adjacentDyadicRadius a i
  let ε : Fin k → ℝ := fun i => D/(a+(i.val:ℝ))
  have hN (i : Fin k) : 2 ≤ N i := by
    have hpow : 2^1 ≤ (2:ℕ)^(a+i.val) :=
      pow_le_pow_right₀ (by norm_num) (by omega)
    dsimp [N, RP3.adjacentDyadicRadius]
    norm_num only [pow_one] at hpow
    exact_mod_cast hpow
  have hsep (i j : Fin k) (hij : i < j) : 2*N i ≤ N j := by
    dsimp [N]
    exact_mod_cast adjacentDyadicRadius_separated a i.val j.val hij
  have hfar (i : Fin k) : 2*N i < siteRadius x.val y.val := by
    have hi := denseAnnulusCount_inside (2^a) r (by positivity) i.isLt
    have he : 2*(RP3.adjacentDyadicRadius a i.val) < r := by
      simpa only [adjacentDyadicRadius_eq, mul_assoc] using hi
    have hr : (r:ℤ) = siteRadius x.val y.val :=
      Int.toNat_of_nonneg (siteRadius_nonneg _ _)
    have hiR : 2*N i < (r:ℤ) := by
      dsimp [N]
      exact_mod_cast he
    rwa [hr] at hiR
  have hε (i : Fin k) : 0 < ε i := by
    apply div_pos hD
    have haR : (2:ℝ) ≤ a := by exact_mod_cast ha
    positivity
  have hc := G.adjacent_square_annuli_product_bound b k N hN hsep x y hfar ε hε
    (by
      intro i g τ
      have h := hcomp (a+i.val) (by omega) x.val g τ
      simpa only [ε, N, RP3.adjacentDyadicRadius, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat] using h)
  have hp := annular_product_le_factorial (fun j => D/(a+(j:ℝ))) D
    (by positivity) (fun j => div_nonneg hD.le (by positivity)) (dense_factor_le hD.le ha) k
  have hprod : (∏ i : Fin k, ε i) = ∏ j ∈ range k, D/(a+(j:ℝ)) := by
    exact Fin.prod_univ_eq_prod_range (fun j => D/(a+(j:ℝ))) k
  rw [hprod] at hc
  calc
    _ ≤ (3 : ℝ) / 4 * ∏ j ∈ range k, D/(a+(j:ℝ)) := hc
    _ ≤ (3 : ℝ) / 4 * (D^k/k.factorial) := by gcongr
    _ = _ := by ring


/-- Uniform adjacent-scale factorial bound for signed couplings. -/
theorem dense_factorial_of_dyadic_comparison_signed {β D : ℝ} (hD : 0 < D)
    (a : ℕ) (ha : 2 ≤ a) (hcomp : SignedDyadicKernelComparison β D a)
    (G : LatticeGraph) (b : G.edges → ℝ) (hb : ∀ e, |b e| ≤ β)
    (x y : G.vertices) :
    let r := (siteRadius x.val y.val).toNat
    let k := denseAnnulusCount (2^a) r (by positivity)
    |correlation (fun e : G.edges => e.val) b x y| ≤ (3 : ℝ) / 4 * D^k/k.factorial := by
  exact dense_factorial_of_dyadic_kernel_bounds hD a ha G b
    (fun n hn z g τ => hcomp n hn G b hb z g τ) x y


end Fourier.LatticeGraph
end
end RP3
end StandalonePart61

/- ===== RP3/LogSquareRates.lean ===== -/
section StandalonePart62

/-!
# From linearly many shells per scale to log-square decay

This file contains the arithmetic part of the thin-annulus argument.  Its
interfaces explicitly record the finite-volume shell bound; no comparison
estimate is postulated as an axiom.  In particular, the conversion from a
quadratic exponent in the number of dyadic bands to a log-square distance
bound holds at every distance, including zero.
-/
namespace RP3
noncomputable section
open Finset

/-- Number of thin annuli retained in the first `k` bands starting at `a`. -/
def packedAnnulusCount (m : ℕ → ℕ) (a k : ℕ) : ℕ :=
  ∑ j ∈ range k, m (a+j)

private theorem sum_range_real_index (k : ℕ) :
    (∑ j ∈ range k, (j : ℝ)) = (k : ℝ) * (k-1) / 2 := by
  induction k with
  | zero => norm_num
  | succ k ih =>
    rw [sum_range_succ, ih]
    push_cast
    ring

/-- A linear number of shells in each band gives a quadratic cumulative
count.  The fixed loss `γ/4` makes the statement valid also for `k = 0,1`. -/
theorem packedAnnulusCount_quadratic (m : ℕ → ℕ) (a : ℕ) {γ : ℝ}
    (hγ : 0 ≤ γ) (hm : ∀ j : ℕ, γ * (j : ℝ) ≤ m (a+j)) (k : ℕ) :
    γ * (k : ℝ)^2 / 4 - γ/4 ≤ (packedAnnulusCount m a k : ℝ) := by
  have hsum : γ * ((k : ℝ) * (k-1) / 2) ≤
      (packedAnnulusCount m a k : ℝ) := by
    calc
      _ = ∑ j ∈ range k, γ * (j : ℝ) := by
        rw [← mul_sum, sum_range_real_index]
      _ ≤ ∑ j ∈ range k, (m (a+j) : ℝ) :=
        sum_le_sum (fun j _ => hm j)
      _ = _ := by simp [packedAnnulusCount]
  have hsq := mul_nonneg hγ (sq_nonneg ((k : ℝ)-1))
  nlinarith

/-- The product of a common contraction `1/2` over the packed shells has a
Gaussian bound in the number of dyadic bands. -/
theorem packed_half_power_le (m : ℕ → ℕ) (a : ℕ) {γ : ℝ}
    (hγ : 0 ≤ γ) (hm : ∀ j : ℕ, γ * (j : ℝ) ≤ m (a+j)) (k : ℕ) :
    (1/2 : ℝ) ^ packedAnnulusCount m a k ≤
      Real.exp (Real.log 2 * γ / 4) *
        Real.exp (-(Real.log 2 * γ / 4) * (k : ℝ)^2) := by
  have hq : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hcount := packedAnnulusCount_quadratic m a hγ hm k
  have heq : (1/2 : ℝ) ^ packedAnnulusCount m a k =
      Real.exp (-(Real.log 2) * (packedAnnulusCount m a k : ℝ)) := by
    rw [← Real.exp_log (pow_pos (by norm_num : (0:ℝ)<1/2) _), Real.log_pow,
      Real.log_div (by norm_num) (by norm_num), Real.log_one]
    congr 1
    ring
  rw [heq, ← Real.exp_add]
  apply Real.exp_le_exp.mpr
  have hmul := mul_le_mul_of_nonneg_left hcount hq.le
  nlinarith

/-- The dyadic covering count controls `log (2+r)` uniformly at all
distances. -/
theorem denseAnnulusCount_log_distance (N r : ℕ) (hN : 0 < N) :
    Real.log (2+(r:ℝ)) ≤ Real.log (2*(N:ℝ)+2) +
      (denseAnnulusCount N r hN : ℝ) * Real.log 2 := by
  let k := denseAnnulusCount N r hN
  have hc : (r:ℝ) ≤ 2*(N:ℝ)*(2:ℝ)^k := by
    exact_mod_cast denseAnnulusCount_cover N r hN
  have hp : (1:ℝ) ≤ (2:ℝ)^k := one_le_pow₀ (by norm_num)
  have hb : 2+(r:ℝ) ≤ (2*(N:ℝ)+2)*(2:ℝ)^k := by nlinarith
  have hl := Real.log_le_log (by positivity : (0:ℝ)<2+r) hb
  rw [Real.log_mul (by positivity) (by positivity), Real.log_pow] at hl
  exact hl

/-- A Gaussian in the dyadic covering count gives a log-square envelope.
The constants depend only on `N`, `B`, and `d`, and no distance threshold
is needed. -/
theorem gaussian_annulus_log_square_bound (N : ℕ) (hN : 0 < N)
    (B d : ℝ) (hB : 0 < B) (hd : 0 < d) :
    ∃ C : ℝ, 0 < C ∧ ∃ c : ℝ, 0 < c ∧ ∀ r : ℕ,
      B * Real.exp (-d * (denseAnnulusCount N r hN : ℝ)^2) ≤
        C * Real.exp (-c * (Real.log (2+(r:ℝ)))^2) := by
  let q := Real.log 2
  let a := Real.log (2*(N:ℝ)+2)
  let c := d/(2*q^2)
  let C := B*Real.exp (2*c*a^2)
  have hq : 0 < q := Real.log_pos (by norm_num)
  have ha : 0 ≤ a := Real.log_nonneg (by have hn := Nat.cast_nonneg (α := ℝ) N; linarith)
  have hc : 0 < c := by dsimp [c]; positivity
  have hC : 0 < C := by dsimp [C]; positivity
  refine ⟨C, hC, c, hc, ?_⟩
  intro r
  let k := denseAnnulusCount N r hN
  let L := Real.log (2+(r:ℝ))
  have hL : 0 ≤ L := Real.log_nonneg (by have hr := Nat.cast_nonneg (α := ℝ) r; linarith)
  have hLa : L ≤ a+(k:ℝ)*q := denseAnnulusCount_log_distance N r hN
  have hk : 0 ≤ (k:ℝ) := Nat.cast_nonneg _
  have hs : L^2 ≤ 2*a^2+2*(k:ℝ)^2*q^2 := by
    have hprod := mul_nonneg (sub_nonneg.mpr hLa)
      (show 0 ≤ a+(k:ℝ)*q+L by positivity)
    have hsq := sq_nonneg (a-(k:ℝ)*q)
    nlinarith
  have hcq : c * (2*q^2) = d := by
    dsimp [c]
    field_simp [ne_of_gt hq]
  have hs' := mul_le_mul_of_nonneg_left hs hc.le
  have he : -d*(k:ℝ)^2 ≤ 2*c*a^2-c*L^2 := by
    have hmul := congrArg (fun t : ℝ => t*(k:ℝ)^2) hcq
    nlinarith
  change B*Real.exp (-d*(k:ℝ)^2) ≤ C*Real.exp (-c*L^2)
  dsimp only [C]
  rw [mul_assoc, ← Real.exp_add]
  exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by simpa [sub_eq_add_neg] using he)) hB.le

/-- Direct all-distance conversion for products of `1/2`, when the number
of shells in successive bands grows at least linearly. -/
theorem packed_annulus_log_square_bound (m : ℕ → ℕ) (a N : ℕ)
    (hN : 0 < N) {γ : ℝ} (hγ : 0 < γ)
    (hm : ∀ j : ℕ, γ * (j : ℝ) ≤ m (a+j)) :
    ∃ C : ℝ, 0 < C ∧ ∃ c : ℝ, 0 < c ∧ ∀ r : ℕ,
      (3/4 : ℝ)*(1/2 : ℝ)^packedAnnulusCount m a (denseAnnulusCount N r hN) ≤
        C * Real.exp (-c * (Real.log (2+(r:ℝ)))^2) := by
  let d := Real.log 2 * γ / 4
  have hd : 0 < d := by
    dsimp [d]
    positivity
  obtain ⟨C, hC, c, hc, hbound⟩ := gaussian_annulus_log_square_bound N hN
    ((3/4)*Real.exp d) d (by positivity) hd
  refine ⟨C, hC, c, hc, ?_⟩
  intro r
  have hh := packed_half_power_le m a hγ.le hm (denseAnnulusCount N r hN)
  calc
    _ ≤ (3/4 : ℝ) * (Real.exp d *
          Real.exp (-d*(denseAnnulusCount N r hN : ℝ)^2)) := by
      exact mul_le_mul_of_nonneg_left hh (by norm_num)
    _ = ((3/4)*Real.exp d) *
          Real.exp (-d*(denseAnnulusCount N r hN : ℝ)^2) := by ring
    _ ≤ _ := hbound r

end
end RP3
end StandalonePart62

/- ===== RP3/ThinScaleChoice.lean ===== -/
section StandalonePart63

/-!
# An eventual dyadic choice for thin-annulus widths

All choices here are numerical.  The constants in the response estimate are
chosen before the lattice graph, its couplings, and its two marked sites.
-/

namespace RP3
noncomputable section
open Filter
open scoped Topology

/-- A polynomial remainder is eventually smaller than any positive tolerance. -/
theorem thin_polynomial_remainder_small (F : ℝ) (p : ℕ) {ε : ℝ} (hε : 0 < ε) :
    ∃ a : ℕ, ∀ n : ℕ, a ≤ n → F * (n : ℝ)^p / (2 : ℝ)^n ≤ ε := by
  have ht : Tendsto (fun n : ℕ => F * (n : ℝ)^p / (2 : ℝ)^n) atTop (𝓝 0) := by
    simpa only [mul_zero, ← mul_div_assoc] using
      tendsto_const_nhds.mul (tendsto_pow_const_div_const_pow_of_one_lt p
        (by norm_num : (1 : ℝ) < 2))
  have he : ∀ᶠ n : ℕ in atTop, F * (n : ℝ)^p / (2 : ℝ)^n < ε :=
    ht.eventually (eventually_lt_nhds hε)
  obtain ⟨a, ha⟩ := eventually_atTop.1 he
  exact ⟨a, fun n hn => (ha n hn).le⟩

/-- The first dyadic scale reaching `n` has a matching strict lower bound. -/
theorem thin_scale_count_bounds (A n : ℕ) (hA : 0 < A) (hn : 2*A < n) :
    1 ≤ denseAnnulusCount A n hA ∧
      A * 2^denseAnnulusCount A n hA < n ∧
      n ≤ 2*A*2^denseAnnulusCount A n hA := by
  let h := denseAnnulusCount A n hA
  have hc : n ≤ 2*A*2^h := denseAnnulusCount_cover A n hA
  have hp : 1 ≤ h := by
    by_contra hp
    have hz : h = 0 := by omega
    simp only [hz, pow_zero, mul_one] at hc
    omega
  have hi := denseAnnulusCount_inside A n hA (j := h-1) (by dsimp [h] at hp ⊢; omega)
  have hh : h = h-1+1 := by omega
  have he : A*2^h = 2*A*2^(h-1) := by
    conv_lhs => rw [hh, pow_succ]
    ring
  exact ⟨hp, he.trans_lt hi, hc⟩

/-- The associated number `2^(h-1)` of disjoint layers is linear in `n`. -/
theorem thin_scale_layer_count (A n : ℕ) (hA : 0 < A) (hn : 2*A < n) :
    n ≤ 4*A*2^(denseAnnulusCount A n hA - 1) := by
  obtain ⟨hp, -, hc⟩ := thin_scale_count_bounds A n hA hn
  have hh : denseAnnulusCount A n hA = denseAnnulusCount A n hA-1+1 := by omega
  calc n ≤ 2*A*2^denseAnnulusCount A n hA := hc
    _ = 4*A*2^(denseAnnulusCount A n hA-1) := by
      conv_lhs => rw [hh, pow_succ]
      ring

/-- Choose dyadic widths so that the full thin-annulus comparison error is at
most one half, retaining a number of layers proportional to the scale index.
The constants `E,F` may already include the periodic and quaternion factors. -/
theorem thin_scale_choice (E F : ℝ) (hE : 0 ≤ E) (hF : 0 ≤ F) :
    ∃ A a : ℕ, ∃ hA : 4 ≤ A, 8 ≤ a ∧ ∀ n : ℕ, a ≤ n →
      let h := denseAnnulusCount A n (by omega)
      1 ≤ h ∧ 2*h ≤ n ∧ 4 ≤ n-h ∧ A*2^h < n ∧ n ≤ 2*A*2^h ∧
        E*(2 : ℝ)^h/(n-h : ℕ) + F*(2 : ℝ)^(6*h)/(2 : ℝ)^n ≤ 1/2 := by
  obtain ⟨A, hAr⟩ := exists_nat_ge (max (4 : ℝ) (8*E))
  have hA4r : (4 : ℝ) ≤ A := (le_max_left _ _).trans hAr
  have hA4 : 4 ≤ A := by exact_mod_cast hA4r
  have hA8 : 8*E ≤ A := (le_max_right _ _).trans hAr
  have hA : 0 < A := by omega
  have hAp : (0 : ℝ) < A := by exact_mod_cast hA
  obtain ⟨a₀, ha₀⟩ := thin_polynomial_remainder_small F 6 (by norm_num : (0 : ℝ) < 1/4)
  let a := max (2*A+1) (max 8 a₀)
  refine ⟨A, a, hA4, ?_, ?_⟩
  · exact (le_max_left 8 a₀).trans (le_max_right _ _)
  intro n hn
  dsimp only
  let h := denseAnnulusCount A n hA
  have hnA : 2*A < n := by have := (le_max_left (2*A+1) (max 8 a₀)).trans hn; omega
  have hn8 : 8 ≤ n := ((le_max_left 8 a₀).trans (le_max_right (2*A+1) _)).trans hn
  have hna₀ : a₀ ≤ n := ((le_max_right 8 a₀).trans (le_max_right (2*A+1) _)).trans hn
  obtain ⟨hh1, hlow, hhigh⟩ := thin_scale_count_bounds A n hA hnA
  change 1 ≤ h at hh1
  change A*2^h < n at hlow
  change n ≤ 2*A*2^h at hhigh
  have hhpow : h < 2^h := Nat.lt_two_pow_self
  have hh2 : 2*h ≤ n := by
    have hm : 2*2^h ≤ A*2^h := Nat.mul_le_mul_right _ (by omega : 2 ≤ A)
    omega
  have hnh : 4 ≤ n-h := by omega
  have hnp : (0 : ℝ) < n := by exact_mod_cast (by omega : 0 < n)
  have hnhp : (0 : ℝ) < (n-h : ℕ) := by exact_mod_cast (by omega : 0 < n-h)
  have hlowr : (A : ℝ)*(2 : ℝ)^h ≤ n := by exact_mod_cast hlow.le
  have hhalfr : (n : ℝ)/2 ≤ (n-h : ℕ) := by
    have hh2r : 2*(h : ℝ) ≤ n := by exact_mod_cast hh2
    rw [Nat.cast_sub (by omega : h ≤ n)]
    linarith
  have hfirst : E*(2 : ℝ)^h/(n-h : ℕ) ≤ 1/4 := by
    calc E*(2 : ℝ)^h/(n-h : ℕ) ≤ E*(2 : ℝ)^h/((n : ℝ)/2) :=
        div_le_div_of_nonneg_left (by positivity) (by positivity) hhalfr
      _ ≤ 1/4 := by
        apply (div_le_iff₀ (by positivity : (0 : ℝ) < (n : ℝ)/2)).2
        have hm := mul_le_mul_of_nonneg_right hA8 (by positivity : 0 ≤ (2 : ℝ)^h)
        nlinarith
  have hpn : (2 : ℝ)^h ≤ n := by
    have hA1 : (1 : ℝ) ≤ A := by linarith
    exact (le_mul_of_one_le_left (by positivity) hA1).trans hlowr
  have hpower : (2 : ℝ)^(6*h) ≤ (n : ℝ)^6 := by
    rw [Nat.mul_comm 6 h, pow_mul]
    exact pow_le_pow_left₀ (by positivity) hpn 6
  have hsecond : F*(2 : ℝ)^(6*h)/(2 : ℝ)^n ≤ 1/4 := by
    exact (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hpower hF)
      (by positivity)).trans (ha₀ n hna₀)
  refine ⟨hh1, hh2, hnh, hlow, hhigh, ?_⟩
  linarith

end
end RP3
end StandalonePart63

/- ===== RP3/LogSquarePacking.lean ===== -/
section StandalonePart64

/-!
# Packing dyadic thin annuli

Each band of radius `2^n` is divided into shells of width `2^(n-h)` with
an equally wide gap.  This gives `2^(h-1)` disjoint shells in that band.
-/
namespace RP3
noncomputable section
open Finset MeasureTheory
open RP3.Fourier

def thinShellCount (h : ℕ) : ℕ := 2^(h-1)

def thinShellWidth (n h : ℕ) : ℕ := 2^(n-h)

def thinShellInner (n h j : ℕ) : ℕ := 2^n + 2*j*thinShellWidth n h

def thinShellOuter (n h j : ℕ) : ℕ := thinShellInner n h j + thinShellWidth n h

theorem thinShell_fills_band {n h : ℕ} (hh : 1 ≤ h) (hhn : h ≤ n) :
    2 * thinShellCount h * thinShellWidth n h = 2^n := by
  dsimp [thinShellCount, thinShellWidth]
  calc
    2 * 2^(h-1) * 2^(n-h) = (2:ℕ)^(1+(h-1)+(n-h)) := by
      simp only [pow_add, pow_one]
    _ = _ := by congr 1; omega

theorem thinShell_inner_ge (n h j : ℕ) : 2^n ≤ thinShellInner n h j := by
  simp [thinShellInner]

theorem thinShell_outer_lt {n h j : ℕ} (hh : 1 ≤ h) (hhn : h ≤ n)
    (hj : j < thinShellCount h) : thinShellOuter n h j < 2*2^n := by
  have hf := thinShell_fills_band hh hhn
  have hw : 0 < thinShellWidth n h := by dsimp [thinShellWidth]; positivity
  have hmul := Nat.mul_le_mul_right (thinShellWidth n h)
    (show 2*j+2 ≤ 2*thinShellCount h by omega)
  dsimp [thinShellOuter, thinShellInner]
  nlinarith

theorem thinShell_width_ge {n h : ℕ} (hh : 4 ≤ n-h) :
    16 ≤ thinShellWidth n h := by
  have hp : (2:ℕ)^4 ≤ 2^(n-h) := pow_le_pow_right₀ (by norm_num) hh
  norm_num only [show (2:ℕ)^4 = 16 by norm_num] at hp
  exact hp

theorem thinShell_width {n h j : ℕ} (hh : 4 ≤ n-h) :
    thinShellInner n h j + 2 ≤ thinShellOuter n h j := by
  have hw := thinShell_width_ge hh
  dsimp [thinShellOuter]
  omega

theorem thinShell_same_band_separated {n h i j : ℕ} (hij : i < j) :
    thinShellOuter n h i ≤ thinShellInner n h j := by
  have hm := Nat.mul_le_mul_right (thinShellWidth n h)
    (show 2*i+1 ≤ 2*j by omega)
  dsimp [thinShellOuter, thinShellInner]
  nlinarith

theorem thinShell_different_band_separated {n n' h h' i j : ℕ}
    (hh : 1 ≤ h) (hhn : h ≤ n) (hi : i < thinShellCount h) (hn : n < n') :
    thinShellOuter n h i ≤ thinShellInner n' h' j := by
  have hp : (2:ℕ)^(n+1) ≤ 2^n' := pow_le_pow_right₀ (by norm_num) (by omega)
  rw [pow_succ] at hp
  have hp' : 2*2^n ≤ (2:ℕ)^n' := by simpa only [Nat.mul_comm] using hp
  exact (thinShell_outer_lt hh hhn hi).le.trans (hp'.trans (thinShell_inner_ge n' h' j))

/-- The indices of shells in the first `k` bands, ordered first by band
and then by their radius within the band. -/
abbrev ThinShellIndex (h : ℕ → ℕ) (a k : ℕ) :=
  Lex (Σ i : Fin k, Fin (thinShellCount (h (a+i.val))))

theorem thinShellIndex_card (h : ℕ → ℕ) (a k : ℕ) :
    Fintype.card (ThinShellIndex h a k) =
      packedAnnulusCount (fun n => thinShellCount (h n)) a k := by
  change Fintype.card (Σ i : Fin k, Fin (thinShellCount (h (a+i.val)))) = _
  rw [Fintype.card_sigma]
  simp only [Fintype.card_fin]
  exact Fin.sum_univ_eq_sum_range (fun j => thinShellCount (h (a+j))) k

namespace Fourier.LatticeGraph

/-- Packing all available shells in each successive dyadic band and using
the actual pinned-kernel comparison gives the exact cumulative contraction. -/
theorem packed_half_power_of_thin_kernel_bounds (a : ℕ) (h : ℕ → ℕ)
    (hh : ∀ n, a ≤ n → 1 ≤ h n ∧ h n ≤ n ∧ 4 ≤ n-h n)
    (G : LatticeGraph) (b : G.edges → ℝ)
    (hcomp : ∀ n, a ≤ n → ∀ j, j < thinShellCount (h n) →
      ∀ (z : Site) (g : Quaternion) τ,
      (1-(1/2:ℝ)) * pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.thinKernelEdges (thinShellInner n (h n) j)
          (thinShellOuter n (h n) j) z) b)
        (G.thinLayer (thinShellInner n (h n) j) (thinShellOuter n (h n) j) z)ᶜ
        ((quaternionAction.onCut (G.innerCut (thinShellInner n (h n) j) z)).move g τ) ≤
      pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.thinKernelEdges (thinShellInner n (h n) j)
          (thinShellOuter n (h n) j) z) b)
        (G.thinLayer (thinShellInner n (h n) j) (thinShellOuter n (h n) j) z)ᶜ τ)
    (x y : G.vertices) :
    let r := (siteRadius x.val y.val).toNat
    let k := denseAnnulusCount (2^a) r (by positivity)
    |correlation (fun e : G.edges => e.val) b x y| ≤
      (3 : ℝ) / 4 * (1/2:ℝ)^packedAnnulusCount (fun n => thinShellCount (h n)) a k := by
  classical
  dsimp only
  let r := (siteRadius x.val y.val).toNat
  let k := denseAnnulusCount (2^a) r (by positivity)
  let J := ThinShellIndex h a k
  let R : J → ℤ := fun i => thinShellInner (a+i.1.val) (h (a+i.1.val)) i.2.val
  let S : J → ℤ := fun i => thinShellOuter (a+i.1.val) (h (a+i.1.val)) i.2.val
  have hpar (i : J) := hh (a+i.1.val) (by omega)
  have hR (i : J) : 0 ≤ R i := by dsimp [R]; positivity
  have hwidth (i : J) : R i+2 ≤ S i := by
    dsimp only [R, S]
    exact_mod_cast thinShell_width (j := i.2.val) (hpar i).2.2
  have hsep (i j : J) (hij : i < j) : S i ≤ R j := by
    rcases i with ⟨i, u⟩
    rcases j with ⟨j, v⟩
    rcases Sigma.Lex.lt_def.mp hij with hij | ⟨heq, huv⟩
    · have hi := thinShell_different_band_separated (hpar ⟨i,u⟩).1
        (hpar ⟨i,u⟩).2.1 u.isLt (j := v.val)
        (h' := h (a+j.val)) (show a+i.val < a+j.val by exact Nat.add_lt_add_left hij a)
      dsimp only [R, S]
      exact_mod_cast hi
    · change i = j at heq
      subst j
      dsimp only at huv
      have hi := thinShell_same_band_separated (n := a+i.val) (h := h (a+i.val)) huv
      dsimp only [R, S]
      exact_mod_cast hi
  have hfar (i : J) : S i < siteRadius x.val y.val := by
    have hi := denseAnnulusCount_inside (2^a) r (by positivity) i.1.isLt
    have hs := thinShell_outer_lt (hpar i).1 (hpar i).2.1 i.2.isLt
    have hi' : 2 * 2^(a+i.1.val) < r := by
      simpa only [pow_add, mul_assoc] using hi
    have hsr : thinShellOuter (a+i.1.val) (h (a+i.1.val)) i.2.val < r := hs.trans hi'
    have hr : (r:ℤ) = siteRadius x.val y.val :=
      Int.toNat_of_nonneg (siteRadius_nonneg _ _)
    have hz : S i < (r:ℤ) := by
      dsimp only [S]
      exact_mod_cast hsr
    rwa [hr] at hz
  have hc := G.thin_square_annuli_product_bound b R S hR hwidth hsep x y hfar
    (fun _ => (1/2:ℝ)) (fun _ => by norm_num)
    (fun i g τ => hcomp (a+i.1.val) (by omega) i.2.val i.2.isLt x.val g τ)
  have hp : (∏ _i : J, (1/2:ℝ)) =
      (1/2:ℝ)^packedAnnulusCount (fun n => thinShellCount (h n)) a k := by
    simp only [prod_const, card_univ]
    rw [thinShellIndex_card]
  rw [hp] at hc
  exact hc

end Fourier.LatticeGraph

/-- Numerical error in the thin-shell comparison after the periodic and
quaternion comparison constants have been included. -/
def thinDyadicError (E F : ℝ) (n h : ℕ) : ℝ :=
  E*(2:ℝ)^h/(n-h : ℕ) + F*(2:ℝ)^(6*h)/(2:ℝ)^n

/-- The precise analytic input consumed by the packing argument.  The
eventual choice of scales below proves the small-error hypothesis, before
any finite graph or coupling is chosen. -/
def SignedThinDyadicKernelComparison (β E F : ℝ) : Prop :=
  ∀ n h : ℕ, 1 ≤ h → 2*h ≤ n → 4 ≤ n-h → thinDyadicError E F n h ≤ 1/2 →
    ∀ j : ℕ, j < thinShellCount h → ∀ (G : Fourier.LatticeGraph)
    (b : G.edges → ℝ), (∀ e, |b e| ≤ β) →
    ∀ (z : Fourier.Site) (g : Quaternion) τ,
      (1-thinDyadicError E F n h) * pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.thinKernelEdges (thinShellInner n h j)
          (thinShellOuter n h j) z) b)
        (G.thinLayer (thinShellInner n h j) (thinShellOuter n h j) z)ᶜ
        ((quaternionAction.onCut (G.innerCut (thinShellInner n h j) z)).move g τ) ≤
      pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.thinKernelEdges (thinShellInner n h j)
          (thinShellOuter n h j) z) b)
        (G.thinLayer (thinShellInner n h j) (thinShellOuter n h j) z)ᶜ τ

/-- The linear shell count is sufficient for the log-square rate. -/
theorem thinShellCount_linear {A n h : ℕ} (hA : 0 < A) (hh : 1 ≤ h)
    (hcover : n ≤ 2*A*2^h) : (1/(4*(A:ℝ))) * n ≤ thinShellCount h := by
  have he : h = h-1+1 := by omega
  have hc : n ≤ 4*A*thinShellCount h := by
    calc n ≤ 2*A*2^h := hcover
      _ = 4*A*thinShellCount h := by
        unfold thinShellCount
        conv_lhs => rw [he, pow_succ]
        ring
  have hcr : (n:ℝ) ≤ 4*(A:ℝ)*(thinShellCount h:ℝ) := by exact_mod_cast hc
  have hAp : (0:ℝ) < A := by exact_mod_cast hA
  have hd : (n:ℝ)/(4*(A:ℝ)) ≤ thinShellCount h :=
    (div_le_iff₀ (by positivity)).mpr (by nlinarith)
  simpa only [one_div, div_eq_mul_inv, mul_comm, one_mul] using hd

/-- Once the uniform thin-shell comparison is proved, the exact finite
graph argument yields an all-distance log-square bound with uniform
constants. -/
theorem log_square_of_thin_comparison_signed (β E F : ℝ)
    (hE : 0 ≤ E) (hF : 0 ≤ F)
    (hcomparison : SignedThinDyadicKernelComparison β E F) :
    ∃ C : ℝ, 0 < C ∧ ∃ c : ℝ, 0 < c ∧
      ∀ (G : Fourier.LatticeGraph) (b : G.edges → ℝ),
      (∀ e, |b e| ≤ β) → ∀ (x y : G.vertices),
      |correlation (fun e : G.edges => e.val) b x y| ≤
        C * Real.exp (-c * (Real.log (2+(Fourier.siteRadius x.val y.val:ℝ)))^2) := by
  obtain ⟨A, a, hA, ha, hchoice⟩ := thin_scale_choice E F hE hF
  let h : ℕ → ℕ := fun n => denseAnnulusCount A n (by omega)
  let γ : ℝ := 1/(4*(A:ℝ))
  have hγ : 0 < γ := by dsimp [γ]; positivity
  have hm (j : ℕ) : γ*(j:ℝ) ≤ thinShellCount (h (a+j)) := by
    have hc := hchoice (a+j) (by omega)
    have hb := thinShellCount_linear (by omega : 0 < A) hc.1 hc.2.2.2.2.1
    have hj : (j:ℝ) ≤ (a+j:ℕ) := by exact_mod_cast (show j ≤ a+j by omega)
    exact (mul_le_mul_of_nonneg_left hj hγ.le).trans hb
  obtain ⟨C, hC, c, hc, hrate⟩ := packed_annulus_log_square_bound
    (fun n => thinShellCount (h n)) a (2^a) (by positivity) hγ hm
  refine ⟨C, hC, c, hc, ?_⟩
  intro G b hb x y
  have hh : ∀ n, a ≤ n → 1 ≤ h n ∧ h n ≤ n ∧ 4 ≤ n-h n := by
    intro n hn
    have hc := hchoice n hn
    exact ⟨hc.1, by dsimp [h]; omega, hc.2.2.1⟩
  have hcomp : ∀ n, a ≤ n → ∀ j, j < thinShellCount (h n) →
      ∀ (z : Site) (g : Quaternion) τ,
      (1-(1/2:ℝ)) * pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.thinKernelEdges (thinShellInner n (h n) j)
          (thinShellOuter n (h n) j) z) b)
        (G.thinLayer (thinShellInner n (h n) j) (thinShellOuter n (h n) j) z)ᶜ
        ((quaternionAction.onCut (G.innerCut (thinShellInner n (h n) j) z)).move g τ) ≤
      pinnedKernel (fun e : G.edges => e.val)
        (maskedCoupling (G.thinKernelEdges (thinShellInner n (h n) j)
          (thinShellOuter n (h n) j) z) b)
        (G.thinLayer (thinShellInner n (h n) j) (thinShellOuter n (h n) j) z)ᶜ τ := by
    intro n hn j hj z g τ
    have hp := hchoice n hn
    have hsmall : thinDyadicError E F n (h n) ≤ 1/2 := hp.2.2.2.2.2
    have hc := hcomparison n (h n) hp.1 hp.2.1 hp.2.2.1 hsmall j hj G b hb z g τ
    exact (mul_le_mul_of_nonneg_right (by linarith : 1-(1/2:ℝ) ≤
      1-thinDyadicError E F n (h n)) (pinnedPartition_pos _ _ _ _).le).trans hc
  have hp := G.packed_half_power_of_thin_kernel_bounds a h hh b hcomp x y
  have hresult := hp.trans (hrate (siteRadius x.val y.val).toNat)
  have hdist : (((siteRadius x.val y.val).toNat : ℕ):ℝ) =
      (siteRadius x.val y.val:ℝ) := by
    exact_mod_cast Int.toNat_of_nonneg (siteRadius_nonneg x.val y.val)
  simpa only [hdist] using hresult

end
end RP3
end StandalonePart64

/- ===== RP3/ThinKernelEstimate.lean ===== -/
section StandalonePart65

/-! Actual full-graph kernel comparison from the thin-annulus response. -/
namespace RP3.Fourier.LatticeGraph
noncomputable section
open RP3 RP3.Quadratic
open scoped Classical

/-- Exact restriction and rotation transfer for an arbitrary thin shell.
The analytic premise is discharged by `thin_annulus_response` below. -/
theorem thin_kernel_comparison_of_response
    (k : ℕ) (a δ : ℝ) (hδ : 0 < δ) (ha : δ ≤ a)
    (R S : ℤ) (hR : (R:ℝ)=a*(2:ℝ)^k)
    (hS : (S:ℝ)=(a+δ)*(2:ℝ)^k) (hSbox : S ≤ 2*(2:ℤ)^k)
    (β : ℝ) (hβ : 0 ≤ β) (B : ℝ) (hB : 0 ≤ B)
    (hresponse : ∀ (H : LatticeGraph), H.WithinDyadicBox k →
      ∀ (b : H.edges → ℝ), (∀ e, |b e| ≤ β) →
      ∀ (P : H.vertices → Option RP3.Spin), H.ThinBoundaryPins k a δ P →
        -(H.spinSystem b P).secondAxisResponse
          (H.thinThetaEdge k a δ) (H.thinThetaEdge k a δ) ≤ B)
    (G : LatticeGraph) (b : G.edges → ℝ) (hb : ∀ e, |b e| ≤ β)
    (z : Site) (g : Quaternion) (τ : Configuration G.vertices) :
    (1-24*Real.pi^2*B) * pinnedKernel (fun e : G.edges => e.val)
      (maskedCoupling (G.thinKernelEdges R S z) b) (G.thinLayer R S z)ᶜ
      ((quaternionAction.onCut (G.innerCut R z)).move g τ) ≤
    pinnedKernel (fun e : G.edges => e.val)
      (maskedCoupling (G.thinKernelEdges R S z) b) (G.thinLayer R S z)ᶜ τ := by
  by_cases hsmall : B*(4*Real.pi)^2/2 ≤ 1
  · let H := (G.thinAnnulusGraph R S z).translate z
    let bH : H.edges → ℝ := fun e => maskedCoupling (G.thinKernelEdges R S z) b
      (G.restrictEdge (· ∈ thinAnnulusSites R S z)
        (((G.thinAnnulusGraph R S z).translateEdgeEquiv z).symm e))
    let pins : Finset H.vertices :=
      (G.thinAnnulusGraph R S z).translatePins z (G.thinAnnulusPinFinset R S z)
    let θ : H.vertices → ℝ := H.thinThetaPotential k a δ
    let cut := H.innerCut R 0
    have hH : H.WithinDyadicBox k := G.translated_thinAnnulus_within_box R S k z hSbox
    have hbH : ∀ e, |bH e| ≤ β := by
      intro e
      dsimp only [bH, maskedCoupling]
      split_ifs
      · exact hb _
      · simpa using hβ
    have hpinradius (v : H.vertices) (hv : v ∈ pins) :
        siteRadius 0 v.val = R ∨ siteRadius 0 v.val = S :=
      G.translated_thinAnnulus_pin_radius R S z v hv
    have hθ : ∀ v ∈ pins, θ v = if v ∈ cut then 1 else 0 := by
      intro v hv
      simpa only [θ, cut, mem_innerCut] using
        H.thinThetaPotential_of_boundary_radius k a δ hδ ha R S hR hS v (hpinradius v hv)
    have hr : ∀ (υ : Configuration H.vertices) (t : ℝ),
        -((pinnedSystem (fun e : H.edges => e.val) bH pins υ).rotatePotential θ t).secondAxisResponse
          ((pinnedSystem (fun e : H.edges => e.val) bH pins υ).edgeGradient θ)
          ((pinnedSystem (fun e : H.edges => e.val) bH pins υ).edgeGradient θ) ≤ B := by
      intro υ t
      rw [pinnedSystem_rotatePotential_eq_cut _ _ _ _ _ hθ]
      let P : H.vertices → Option RP3.Spin := fun v =>
        if v ∈ pins then some (coordinateCut cut 2 t υ v) else none
      have hP : H.ThinBoundaryPins k a δ P := by
        apply H.thinBoundaryPins_of_radius k a δ R S hR hS P
        intro v s hs
        by_cases hv : v ∈ pins
        · exact hpinradius v hv
        · simp [P, hv] at hs
      exact hresponse H hH bH hbH P hP
    have hc := pinnedKernel_quaternion_of_response (fun e : H.edges => e.val) bH pins cut
      θ hθ B hB hsmall hr g (fun v => τ (G.thinAnnulusOriginalVertex R S z v))
    have hcoef : 3*(B*(4*Real.pi)^2/2) = 24*Real.pi^2*B := by ring
    rw [hcoef] at hc
    rw [G.pinnedKernel_centered_thinAnnulus_cut R S z b quaternionAction g τ,
      G.pinnedKernel_centered_thinAnnulus R S z b τ]
    exact hc
  · have hcoef : 1-24*Real.pi^2*B ≤ 0 := by nlinarith
    exact (mul_nonpos_of_nonpos_of_nonneg hcoef
      (pinnedPartition_pos _ _ _ _).le).trans (pinnedPartition_pos _ _ _ _).le

/-- The thin-shell comparison is proved for the actual RP³ kernels. All
constants are selected before the scale, graph, couplings and pinned arrays. -/
theorem exists_thinKernelComparison_signed (β : ℝ) (hβ : 0 ≤ β) :
    ∃ E : ℝ, 0 ≤ E ∧ ∃ F : ℝ, 0 ≤ F ∧ SignedThinDyadicKernelComparison β E F := by
  obtain ⟨K,V,hK,hV,hresponse⟩ := thin_annulus_response β hβ
  let E := 24*Real.pi^2*K
  let F := 24*Real.pi^2*V
  refine ⟨E, by dsimp [E]; positivity, F, by dsimp [F]; positivity, ?_⟩
  intro n h hh hh2 hm _hsmall j hj G b hb z g τ
  let R : ℤ := thinShellInner n h j
  let S : ℤ := R+(2:ℤ)^(n-h)
  let a : ℝ := (R:ℝ)/(2:ℝ)^n
  let δ : ℝ := 1/(2:ℝ)^h
  have hNR : (2:ℤ)^n ≤ R := by
    dsimp only [R]
    exact_mod_cast thinShell_inner_ge n h j
  have hSeq : S = (thinShellOuter n h j : ℤ) := by
    simp only [S, R, thinShellOuter, thinShellWidth, Nat.cast_add, Nat.cast_pow, Nat.cast_ofNat]
  have hSN : S ≤ 2*(2:ℤ)^n := by
    rw [hSeq]
    exact_mod_cast (thinShell_outer_lt hh (by omega) hj).le
  obtain ⟨hδ,hδ1,_ha1,ha,_hatop,hmesh,hRS,hR,hS⟩ :=
    thin_dyadic_parameters n h hh2 hm R hNR hSN
  change 0 < δ at hδ
  change δ ≤ 1 at hδ1
  change δ ≤ a at ha
  change 1/(2:ℝ)^n ≤ δ/16 at hmesh
  change R < S at hRS
  change (R:ℝ)=a*(2:ℝ)^n at hR
  change (S:ℝ)=(a+δ)*(2:ℝ)^n at hS
  let B := K/δ/(n:ℝ)+V/δ^6/(2:ℝ)^n
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hc := thin_kernel_comparison_of_response n a δ hδ ha R S hR hS hSN β hβ B hB
    (hresponse n h (by omega) hh2 a δ hδ hδ1 ha le_rfl hmesh
      R S hNR hRS hSN hR hS) G b hb z g τ
  have he : 24*Real.pi^2*B ≤ thinDyadicError E F n h := by
    have hcost := thin_dyadic_response_cost n h (by omega) K V hK hV
    calc
      _ ≤ 24*Real.pi^2*(K*(2:ℝ)^h/((n-h:ℕ):ℝ)+V*(2:ℝ)^(6*h)/(2:ℝ)^n) :=
        mul_le_mul_of_nonneg_left hcost (by positivity)
      _ = _ := by dsimp [E,F,thinDyadicError]; ring
  have hnonneg : 0 ≤ pinnedKernel (fun e : G.edges => e.val)
      (maskedCoupling (G.thinKernelEdges R S z) b) (G.thinLayer R S z)ᶜ
      ((quaternionAction.onCut (G.innerCut R z)).move g τ) := (pinnedPartition_pos _ _ _ _).le
  have hfinal := (mul_le_mul_of_nonneg_right
    (show 1-thinDyadicError E F n h ≤ 1-24*Real.pi^2*B by linarith)
    hnonneg).trans hc
  simpa only [hSeq, R] using hfinal

end
end RP3.Fourier.LatticeGraph
end StandalonePart65

/- ===== RP3/UniformDecay.lean ===== -/
section StandalonePart66

/-! Uniform real-exponent decay from the concrete dyadic kernel estimate. -/
namespace RP3.Fourier.LatticeGraph
noncomputable section

/-- A uniform factorial estimate gives decay of every real polynomial order.
The admissibility predicate is arbitrary: this step uses no coupling sign. -/
theorem uniform_decay_of_factorial_bound
    {P : (G : LatticeGraph) → (G.edges → ℝ) → Prop} {D : ℝ} (hD : 0 < D)
    (a : ℕ)
    (hfactorial : ∀ (G : LatticeGraph) (b : G.edges → ℝ), P G b →
      ∀ (x y : G.vertices),
      let r := (siteRadius x.val y.val).toNat
      let k := annulusCount (2^a) r (by positivity)
      |RP3.correlation (fun e : G.edges => e.val) b x y| ≤
        (3 : ℝ) / 4 * (D/2)^k/k.factorial) (p : ℝ) :
    ∃ A : ℝ, 0 < A ∧ ∀ (G : LatticeGraph) (b : G.edges → ℝ),
      P G b → ∀ (x y : G.vertices),
      |RP3.correlation (fun e : G.edges => e.val) b x y| ≤
        A * (1 + (siteRadius x.val y.val : ℝ))^(-p) := by
  let q := ⌈p⌉₊
  let B := D/2
  let c := 2*(2^a:ℕ)+1
  let A := (3 : ℝ) / 4 * (c:ℝ)^q * Real.exp (B*(4:ℝ)^q)
  have hA : 0 ≤ A := by dsimp [A]; positivity
  refine ⟨A+1, by linarith, ?_⟩
  intro G b hb x y
  let r := (siteRadius x.val y.val).toNat
  let k := annulusCount (2^a) r (by positivity)
  have hbound := hfactorial G b hb x y
  change |RP3.correlation (fun e : G.edges => e.val) b x y| ≤
    (3 : ℝ) / 4 * B^k/k.factorial at hbound
  have hscale : 1+(r:ℝ) ≤ (c:ℝ)*(4:ℝ)^k := by
    simpa only [c, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_one] using
      annulusCount_distance (2^a) r (by positivity)
  have hw := factorial_weighted_bound (B := B) (a := (c:ℝ)) (q := (4:ℝ))
    (r := (r:ℝ)) (by dsimp [B]; positivity) (by positivity) (by norm_num)
    (Nat.cast_nonneg r) k q hscale
  have hnat : |RP3.correlation (fun e : G.edges => e.val) b x y| *
      (1+(r:ℝ))^q ≤ A := by
    calc
      _ ≤ ((3 : ℝ) / 4 * B^k/k.factorial) * (1+(r:ℝ))^q := by
        gcongr
      _ = (3 : ℝ) / 4 * ((B^k/k.factorial)*(1+(r:ℝ))^q) := by ring
      _ ≤ (3 : ℝ) / 4 * ((c:ℝ)^q * Real.exp (B*(4:ℝ)^q)) := by gcongr
      _ = A := by dsimp [A]; ring
  have hx : (0:ℝ) < 1+r := by positivity
  have hexp : (1+(r:ℝ))^p ≤ (1+(r:ℝ))^q := by
    rw [← Real.rpow_natCast]
    exact Real.rpow_le_rpow_of_exponent_le
      (by have := Nat.cast_nonneg (α := ℝ) r; linarith) (Nat.le_ceil p)
  have hreal : |RP3.correlation (fun e : G.edges => e.val) b x y| *
      (1+(r:ℝ))^p ≤ A+1 := by
    apply (mul_le_mul_of_nonneg_left hexp (abs_nonneg _)).trans
    linarith
  have hr : (r:ℝ) = (siteRadius x.val y.val:ℝ) := by
    exact_mod_cast Int.toNat_of_nonneg (siteRadius_nonneg x.val y.val)
  rw [← hr, Real.rpow_neg hx.le]
  exact (le_div_iff₀ (Real.rpow_pos_of_pos hx p)).2 hreal


/-- Uniformity is in the order of the quantifiers: the constant is selected
before the graph, all its couplings, and both sites. -/
theorem uniform_decay_of_dyadic_comparison_signed {β D : ℝ} (hD : 0 < D)
    (a : ℕ) (ha : 2 ≤ a) (hcomp : SignedDyadicKernelComparison β D a) (p : ℝ) :
    ∃ A : ℝ, 0 < A ∧ ∀ (G : LatticeGraph) (b : G.edges → ℝ),
      (∀ e, |b e| ≤ β) → ∀ (x y : G.vertices),
      |RP3.correlation (fun e : G.edges => e.val) b x y| ≤
        A * (1 + (siteRadius x.val y.val : ℝ))^(-p) := by
  exact uniform_decay_of_factorial_bound hD a
    (fun G b hb x y => factorial_of_dyadic_comparison_signed hD a ha hcomp G b hb x y) p

/-- Uniformity is in the order of the quantifiers: the constant is selected
before the graph, all its couplings, and both sites. -/
theorem uniform_decay_of_dyadic_comparison {β D : ℝ} (hD : 0 < D)
    (a : ℕ) (ha : 2 ≤ a) (hcomp : DyadicKernelComparison β D a) (p : ℝ) :
    ∃ A : ℝ, 0 < A ∧ ∀ (G : LatticeGraph) (b : G.edges → ℝ),
      (∀ e, 0 ≤ b e ∧ b e ≤ β) → ∀ (x y : G.vertices),
      |RP3.correlation (fun e : G.edges => e.val) b x y| ≤
        A * (1 + (siteRadius x.val y.val : ℝ))^(-p) := by
  exact uniform_decay_of_factorial_bound hD a
    (fun G b hb x y => factorial_of_dyadic_comparison hD a ha hcomp G b hb x y) p

end
end RP3.Fourier.LatticeGraph
end StandalonePart66

/- ===== RP3/LogarithmicRate.lean ===== -/
section StandalonePart67

/-!
# The explicit logarithmic decay envelope

The factorial annular estimate has leading logarithm
`-log r * log (log r) / log 4`, with a uniform error bounded by a constant
times `log r`. This proves the quantitative clause of the decay theorem.
-/
namespace RP3

private theorem log_factorial_lower (k : ℕ) (hk : 0 < k) :
    (k : ℝ) * Real.log k - k ≤ Real.log (k.factorial : ℝ) := by
  have h := Stirling.le_log_factorial_stirling (ne_of_gt hk)
  have hn := Real.log_natCast_nonneg k
  have hp : 0 ≤ Real.log (2 * Real.pi) :=
    Real.log_nonneg (by nlinarith [Real.pi_gt_three])
  linarith

/-- The factorial annular envelope has the leading logarithmic term
claimed in (1.7); `C` and the threshold may depend on `N` and `B` only. -/
theorem factorial_annulus_logarithmic_bound (N : ℕ) (hN : 0 < N)
    (B : ℝ) (hB : 0 < B) :
    ∃ C ≥ 0, ∃ R : ℕ, ∀ r : ℕ, R ≤ r →
      (3/4 : ℝ) * B ^ annulusCount N r hN / (annulusCount N r hN).factorial ≤
        Real.exp (-Real.log (r : ℝ) * Real.log (Real.log (r : ℝ)) / Real.log 4 +
          C * Real.log (r : ℝ)) := by
  let q := Real.log 4
  let a := Real.log (2 * (N : ℝ))
  let d := |Real.log (2*q)|
  let t := |Real.log B| + 1
  let C := (t + d + a + t*q) / q
  let H := 2*a + 2*q + Real.exp d + 1
  have hq : 0 < q := Real.log_pos (by norm_num)
  have hN' : 0 < (N : ℝ) := by exact_mod_cast hN
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast (show 1 ≤ N by omega)
  have ha : 0 ≤ a := Real.log_nonneg (by nlinarith [hN1])
  have hd : 0 ≤ d := abs_nonneg _
  have ht : 0 ≤ t := by dsimp [t]; positivity
  have hC : 0 ≤ C := div_nonneg (by positivity) hq.le
  obtain ⟨R, hR⟩ := exists_nat_gt (Real.exp H)
  refine ⟨C, hC, R, ?_⟩
  intro r hr
  have hr' : Real.exp H < (r : ℝ) := hR.trans_le (Nat.cast_le.mpr hr)
  have hrpos : 0 < (r : ℝ) := (Real.exp_pos H).trans hr'
  let L := Real.log (r : ℝ)
  let k := annulusCount N r hN
  have hLH : H ≤ L := by
    simpa only [Real.log_exp] using Real.log_le_log (Real.exp_pos H) hr'.le
  have hL1 : 1 ≤ L := by dsimp [H] at hLH; nlinarith [Real.exp_pos d]
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  have hLa : 2*a ≤ L := by dsimp [H] at hLH; nlinarith [Real.exp_pos d]
  have hLe : Real.exp d ≤ L := by dsimp [H] at hLH; linarith
  have hLloga : 0 ≤ Real.log L - d := by
    have h := Real.log_le_log (Real.exp_pos d) hLe
    rw [Real.log_exp] at h
    linarith
  have hcover : L ≤ a + (k : ℝ)*q := by
    have hc : (r : ℝ) ≤ 2 * (N : ℝ) * (4 : ℝ)^k := by
      exact_mod_cast annulusCount_cover N r hN
    have h := Real.log_le_log hrpos hc
    rw [Real.log_mul (by positivity) (by positivity), Real.log_pow] at h
    exact h
  have hkreal : 0 < (k : ℝ) := by
    have hLa' : a < L := by dsimp [H] at hLH; nlinarith [Real.exp_pos d]
    nlinarith
  have hk : 0 < k := by exact_mod_cast hkreal
  have hupper : (k : ℝ)*q ≤ L + q := by
    have hs : 2 * N * 4^(k-1) < r := annulusCount_inside N r hN (by omega)
    have hs' : 2 * (N : ℝ) * (4 : ℝ)^(k-1) < r := by exact_mod_cast hs
    have hl := Real.log_lt_log (by positivity) hs'
    rw [Real.log_mul (by positivity) (by positivity), Real.log_pow] at hl
    have hc : ((k-1 : ℕ) : ℝ) = (k : ℝ)-1 := by
      rw [Nat.cast_sub (by omega), Nat.cast_one]
    rw [hc] at hl
    change a + ((k : ℝ)-1)*q < L at hl
    linarith
  have hlow : L / (2*q) ≤ (k : ℝ) := by
    apply (div_le_iff₀ (by positivity : 0 < 2*q)).2
    nlinarith
  have hklog : Real.log L - d ≤ Real.log (k : ℝ) := by
    have h := Real.log_le_log (div_pos hLpos (by positivity : 0 < 2*q)) hlow
    rw [Real.log_div hLpos.ne' (by positivity)] at h
    have hd' : Real.log (2*q) ≤ d := le_abs_self _
    linarith
  have hprod : (L-a)*(Real.log L-d) ≤ q * (k : ℝ) * Real.log (k : ℝ) := by
    calc
      _ ≤ (q*(k : ℝ)) * (Real.log L-d) :=
        mul_le_mul_of_nonneg_right (by nlinarith [hcover]) hLloga
      _ ≤ _ := mul_le_mul_of_nonneg_left hklog (by positivity)
  have hup : t * (q*(k : ℝ)) ≤ t * (L+q) :=
    mul_le_mul_of_nonneg_left (by nlinarith [hupper]) ht
  have hlogL : Real.log L ≤ L := by
    have h := Real.log_le_sub_one_of_pos hLpos
    linarith
  have habsorb : a * Real.log L ≤ a * L := mul_le_mul_of_nonneg_left hlogL ha
  have hconstant : t*q ≤ t*q*L :=
    le_mul_of_one_le_right (mul_nonneg ht hq.le) hL1
  have hxpos : 0 < (3/4 : ℝ) * B^k / (k.factorial : ℝ) := by positivity
  apply (Real.log_le_iff_le_exp hxpos).1
  have hx : Real.log ((3/4 : ℝ) * B^k / (k.factorial : ℝ)) ≤
      t * (k : ℝ) - (k : ℝ)*Real.log (k : ℝ) := by
    rw [Real.log_div (by positivity) (by positivity),
      Real.log_mul (by norm_num) (by positivity), Real.log_pow]
    have hf := log_factorial_lower k hk
    have hb := mul_le_mul_of_nonneg_left (le_abs_self (Real.log B)) hkreal.le
    have h23 : Real.log (3/4 : ℝ) ≤ 0 := Real.log_nonpos (by norm_num) (by norm_num)
    dsimp [t]
    linarith
  have he : -L * Real.log L / q + C*L =
      (-L * Real.log L + (t+d+a+t*q)*L) / q := by
    dsimp [C]
    ring
  change Real.log ((3/4 : ℝ) * B^k / (k.factorial : ℝ)) ≤ -L * Real.log L / q + C*L
  rw [he]
  apply (le_div_iff₀ hq).2
  have hqx := mul_le_mul_of_nonneg_left hx hq.le
  have had : 0 ≤ a*d := mul_nonneg ha hd
  nlinarith only [hqx, hprod, hup, habsorb, hconstant, had]

end RP3
end StandalonePart67

/- ===== RP3/Full.lean ===== -/
section StandalonePart68

/-!
# Superpolynomial quadrupolar decay in the planar RP³ model

This entry point quantifies over every finite retained nearest-neighbor graph,
all real couplings with |bₑ| ≤ β, and both observation sites.  No annular estimate,
factorization certificate, or representation identity is a theorem parameter.
The observable is (nₓ·nᵧ)²−1/4, with normalized spherical reference measure.
-/
namespace RP3
noncomputable section

/-- The finite-volume superpolynomial bound, uniform in volume and couplings.
The integer radius is exactly the ℓ∞ distance of the lattice sites. -/
theorem superpolynomial_quadrupolar_decay_signed (β : ℝ) (hβ : 0 ≤ β) (p : ℝ) :
    ∃ A : ℝ, 0 < A ∧ ∀ (G : Fourier.LatticeGraph) (b : G.edges → ℝ),
      (∀ e, |b e| ≤ β) → ∀ (x y : G.vertices),
      |correlation (fun e : G.edges => e.val) b x y| ≤
        A * (1 + (Fourier.siteRadius x.val y.val : ℝ))^(-p) := by
  obtain ⟨D, hD, a, ha, hcomparison⟩ :=
    Fourier.LatticeGraph.dyadic_kernel_comparison_signed β hβ
  exact Fourier.LatticeGraph.uniform_decay_of_dyadic_comparison_signed hD a ha hcomparison p

/-- The stronger factorial estimate in the number of separated annuli. -/
theorem factorial_quadrupolar_decay_signed (β : ℝ) (hβ : 0 ≤ β) :
    ∃ D : ℝ, 0 < D ∧ ∃ a : ℕ, 2 ≤ a ∧
      ∀ (G : Fourier.LatticeGraph) (b : G.edges → ℝ),
      (∀ e, |b e| ≤ β) → ∀ (x y : G.vertices),
      let r := (Fourier.siteRadius x.val y.val).toNat
      let k := annulusCount (2^a) r (by positivity)
      |correlation (fun e : G.edges => e.val) b x y| ≤
        (3 : ℝ) / 4 * (D/2)^k/k.factorial := by
  obtain ⟨D, hD, a, ha, hcomparison⟩ :=
    Fourier.LatticeGraph.dyadic_kernel_comparison_signed β hβ
  exact ⟨D, hD, a, ha, fun G b hb x y =>
    Fourier.LatticeGraph.factorial_of_dyadic_comparison_signed hD a ha hcomparison G b hb x y⟩

/-- The explicit uniform version of the logarithmic asymptotic (1.7). -/
theorem logarithmic_quadrupolar_decay_signed (β : ℝ) (hβ : 0 ≤ β) :
    ∃ C ≥ 0, ∃ R : ℕ, ∀ (G : Fourier.LatticeGraph) (b : G.edges → ℝ),
      (∀ e, |b e| ≤ β) → ∀ (x y : G.vertices),
      R ≤ (Fourier.siteRadius x.val y.val).toNat →
      |correlation (fun e : G.edges => e.val) b x y| ≤
        Real.exp (-Real.log (Fourier.siteRadius x.val y.val : ℝ) *
          Real.log (Real.log (Fourier.siteRadius x.val y.val : ℝ)) / Real.log 4 +
          C * Real.log (Fourier.siteRadius x.val y.val : ℝ)) := by
  obtain ⟨D, hD, a, ha, hfactorial⟩ := factorial_quadrupolar_decay_signed β hβ
  obtain ⟨C, hC, R, hlog⟩ := factorial_annulus_logarithmic_bound
    (2^a) (by positivity) (D/2) (by positivity)
  refine ⟨C, hC, R, ?_⟩
  intro G b hb x y hr
  have hn : (((Fourier.siteRadius x.val y.val).toNat : ℕ) : ℝ) =
      (Fourier.siteRadius x.val y.val : ℝ) := by
    exact_mod_cast Int.toNat_of_nonneg (Fourier.siteRadius_nonneg x.val y.val)
  have h := (hfactorial G b hb x y).trans (hlog _ hr)
  simpa only [hn] using h


/-- Backwards-compatible ferromagnetic specialization of the signed theorem. -/
theorem superpolynomial_quadrupolar_decay (β : ℝ) (hβ : 0 ≤ β) (p : ℝ) :
    ∃ A : ℝ, 0 < A ∧ ∀ (G : Fourier.LatticeGraph) (b : G.edges → ℝ),
      (∀ e, 0 ≤ b e ∧ b e ≤ β) → ∀ (x y : G.vertices),
      |correlation (fun e : G.edges => e.val) b x y| ≤
        A * (1 + (Fourier.siteRadius x.val y.val : ℝ))^(-p) := by
  obtain ⟨A, hA, hbound⟩ := superpolynomial_quadrupolar_decay_signed β hβ p
  exact ⟨A, hA, fun G b hb x y => hbound G b
    (fun e => by rw [abs_of_nonneg (hb e).1]; exact (hb e).2) x y⟩

/-- Backwards-compatible ferromagnetic specialization of the signed theorem. -/
theorem factorial_quadrupolar_decay (β : ℝ) (hβ : 0 ≤ β) :
    ∃ D : ℝ, 0 < D ∧ ∃ a : ℕ, 2 ≤ a ∧
      ∀ (G : Fourier.LatticeGraph) (b : G.edges → ℝ),
      (∀ e, 0 ≤ b e ∧ b e ≤ β) → ∀ (x y : G.vertices),
      let r := (Fourier.siteRadius x.val y.val).toNat
      let k := annulusCount (2^a) r (by positivity)
      |correlation (fun e : G.edges => e.val) b x y| ≤
        (3 : ℝ) / 4 * (D/2)^k/k.factorial := by
  obtain ⟨D, hD, a, ha, hbound⟩ := factorial_quadrupolar_decay_signed β hβ
  exact ⟨D, hD, a, ha, fun G b hb x y => hbound G b
    (fun e => by rw [abs_of_nonneg (hb e).1]; exact (hb e).2) x y⟩

/-- Backwards-compatible ferromagnetic specialization of the signed theorem. -/
theorem logarithmic_quadrupolar_decay (β : ℝ) (hβ : 0 ≤ β) :
    ∃ C ≥ 0, ∃ R : ℕ, ∀ (G : Fourier.LatticeGraph) (b : G.edges → ℝ),
      (∀ e, 0 ≤ b e ∧ b e ≤ β) → ∀ (x y : G.vertices),
      R ≤ (Fourier.siteRadius x.val y.val).toNat →
      |correlation (fun e : G.edges => e.val) b x y| ≤
        Real.exp (-Real.log (Fourier.siteRadius x.val y.val : ℝ) *
          Real.log (Real.log (Fourier.siteRadius x.val y.val : ℝ)) / Real.log 4 +
          C * Real.log (Fourier.siteRadius x.val y.val : ℝ)) := by
  obtain ⟨C, hC, R, hbound⟩ := logarithmic_quadrupolar_decay_signed β hβ
  exact ⟨C, hC, R, fun G b hb x y hr => hbound G b
    (fun e => by rw [abs_of_nonneg (hb e).1]; exact (hb e).2) x y hr⟩
end
end RP3
end StandalonePart68

/- ===== RP3/GibbsProbability.lean ===== -/
section StandalonePart69

/-!
# Free-boundary probability measures and their local weak limits

The Gibbs probability measures are constructed from their actual densities.
Their two-spin marginals have the quadrupolar expectation defined in `Model`.
Weak convergence of these marginals therefore preserves the uniform finite-volume
bound with exactly the same constants.
-/
namespace RP3

noncomputable section
open MeasureTheory Filter
open scoped Topology BoundedContinuousFunction

section GibbsMeasure
variable {V E : Type*} [Fintype V] [Fintype E]

/-- Normalized free-boundary Gibbs density with respect to the product surface law. -/
def freeGibbsDensity (edge : E → V × V) (b : E → ℝ) (σ : Configuration V) : ℝ :=
  weight edge b σ / partition edge b

theorem continuous_freeGibbsDensity (edge : E → V × V) (b : E → ℝ) :
    Continuous (freeGibbsDensity edge b) := by
  unfold freeGibbsDensity
  exact (weight edge b).continuous.div_const _

theorem freeGibbsDensity_nonneg (edge : E → V × V) (b : E → ℝ)
    (σ : Configuration V) : 0 ≤ freeGibbsDensity edge b σ :=
  div_nonneg (Real.exp_pos _).le (partition_pos edge b).le

theorem integral_freeGibbsDensity (edge : E → V × V) (b : E → ℝ) :
    ∫ σ, freeGibbsDensity edge b σ ∂referenceLaw = 1 := by
  unfold freeGibbsDensity
  rw [integral_div]
  change partition edge b / partition edge b = 1
  exact div_self (partition_pos edge b).ne'

/-- The actual free-boundary Gibbs measure. -/
def freeGibbsMeasure (edge : E → V × V) (b : E → ℝ) : Measure (Configuration V) :=
  referenceLaw.withDensity (fun σ => ENNReal.ofReal (freeGibbsDensity edge b σ))

instance freeGibbsMeasure_isProbability (edge : E → V × V) (b : E → ℝ) :
    IsProbabilityMeasure (freeGibbsMeasure edge b) := by
  constructor
  rw [freeGibbsMeasure, withDensity_apply _ MeasurableSet.univ,
    Measure.restrict_univ]
  rw [← ofReal_integral_eq_lintegral_ofReal
    ((continuous_freeGibbsDensity edge b).integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _))
    (Eventually.of_forall (freeGibbsDensity_nonneg edge b)), integral_freeGibbsDensity]
  norm_num

/-- The density construction agrees with the normalized expectations in the proof. -/
theorem integral_freeGibbsMeasure (edge : E → V × V) (b : E → ℝ)
    (f : Configuration V → ℝ) :
    ∫ σ, f σ ∂freeGibbsMeasure edge b =
      (∫ σ, f σ * weight edge b σ ∂referenceLaw) / partition edge b := by
  rw [freeGibbsMeasure, integral_withDensity_eq_integral_toReal_smul
    (f := fun σ => ENNReal.ofReal (freeGibbsDensity edge b σ))
    (ENNReal.measurable_ofReal.comp (continuous_freeGibbsDensity edge b).measurable)
    (Eventually.of_forall (fun _ => ENNReal.ofReal_lt_top)), ← integral_div]
  apply integral_congr_ae
  exact Eventually.of_forall fun σ => by
    change (ENNReal.ofReal (freeGibbsDensity edge b σ)).toReal * f σ =
      f σ * weight edge b σ / partition edge b
    rw [ENNReal.toReal_ofReal (freeGibbsDensity_nonneg edge b σ)]
    change weight edge b σ / partition edge b * f σ =
      f σ * weight edge b σ / partition edge b
    ring

/-- Bundle the free-boundary law as a probability measure with the weak topology. -/
def freeGibbsProbability (edge : E → V × V) (b : E → ℝ) :
    ProbabilityMeasure (Configuration V) := ⟨freeGibbsMeasure edge b, inferInstance⟩

/-- The two-spin marginal is a pushforward of the actual finite-volume Gibbs law. -/
def twoSpinMarginal (edge : E → V × V) (b : E → ℝ) (x y : V) :
    ProbabilityMeasure (Spin × Spin) :=
  (freeGibbsProbability edge b).map (fun σ => (σ x, σ y))

/-- Quadrupolar pair test function; compactness makes it bounded. -/
def pairTest : (Spin × Spin) →ᵇ ℝ :=
  BoundedContinuousFunction.mkOfCompact
    ⟨fun st => qPair st.1 st.2, by unfold qPair; fun_prop⟩

theorem integral_twoSpinMarginal (edge : E → V × V) (b : E → ℝ) (x y : V) :
    (∫ st, pairTest st ∂(twoSpinMarginal edge b x y : Measure (Spin × Spin))) =
      correlation edge b x y := by
  change (∫ st, pairTest st ∂Measure.map (fun σ : Configuration V => (σ x, σ y))
    (freeGibbsMeasure edge b)) = _
  rw [integral_map_of_stronglyMeasurable (by fun_prop) pairTest.continuous.stronglyMeasurable,
    integral_freeGibbsMeasure]
  rfl

end GibbsMeasure

/-- A probability law on the full infinite square-lattice spin configuration space. -/
abbrev InfiniteConfiguration := Fourier.Site → Spin

def infinitePairMarginal (μ : ProbabilityMeasure InfiniteConfiguration) (x y : Fourier.Site) :
    ProbabilityMeasure (Spin × Spin) := μ.map (fun σ => (σ x, σ y))

def infiniteCorrelation (μ : ProbabilityMeasure InfiniteConfiguration) (x y : Fourier.Site) : ℝ :=
  ∫ σ, qPair (σ x) (σ y) ∂(μ : Measure InfiniteConfiguration)

theorem integral_infinitePairMarginal (μ : ProbabilityMeasure InfiniteConfiguration)
    (x y : Fourier.Site) :
    (∫ st, pairTest st ∂(infinitePairMarginal μ x y : Measure (Spin × Spin))) =
      infiniteCorrelation μ x y := by
  change (∫ st, pairTest st ∂Measure.map (fun σ : InfiniteConfiguration => (σ x, σ y))
    (μ : Measure InfiniteConfiguration)) = _
  rw [integral_map_of_stronglyMeasurable (by fun_prop) pairTest.continuous.stronglyMeasurable]
  rfl

/-- Convergence of the actual two-spin marginals along one common finite-volume
sequence. A pair-dependent initial segment may be discarded before both sites
belong to the volume. This condition does not refer to an outside filling. -/
def HasLocalPairLimit (G : ℕ → Fourier.LatticeGraph)
    (b : ∀ n, (G n).edges → ℝ) (μ : ProbabilityMeasure InfiniteConfiguration) : Prop :=
  ∀ x y : Fourier.Site, ∃ N : ℕ,
    ∃ (xn yn : ∀ n, (G (n + N)).vertices),
    (∀ n, (xn n).val = x) ∧ (∀ n, (yn n).val = y) ∧
    Tendsto (fun n => twoSpinMarginal (fun e : (G (n + N)).edges => e.val)
        (b (n + N)) (xn n) (yn n)) atTop (𝓝 (infinitePairMarginal μ x y))

/-- Local convergence along finite-volume ferromagnetic free-boundary laws.
Any subsequential local weak limit along an exhaustion satisfies this condition,
with the subsequence itself used as `G`. -/
def IsFreeBoundaryLocalLimit (β : ℝ) (μ : ProbabilityMeasure InfiniteConfiguration) : Prop :=
  ∃ (G : ℕ → Fourier.LatticeGraph) (b : ∀ n, (G n).edges → ℝ),
    (∀ n e, 0 ≤ b n e ∧ b n e ≤ β) ∧ HasLocalPairLimit G b μ

/-- Local convergence along free-boundary laws with arbitrary signed couplings
uniformly bounded in absolute value. -/
def IsSignedFreeBoundaryLocalLimit (β : ℝ)
    (μ : ProbabilityMeasure InfiniteConfiguration) : Prop :=
  ∃ (G : ℕ → Fourier.LatticeGraph) (b : ∀ n, (G n).edges → ℝ),
    (∀ n e, |b n e| ≤ β) ∧ HasLocalPairLimit G b μ

/-- The original ferromagnetic class embeds in the signed-coupling class. -/
theorem IsFreeBoundaryLocalLimit.signed {β : ℝ}
    {μ : ProbabilityMeasure InfiniteConfiguration} (hμ : IsFreeBoundaryLocalLimit β μ) :
    IsSignedFreeBoundaryLocalLimit β μ := by
  obtain ⟨G, b, hb, hlocal⟩ := hμ
  exact ⟨G, b, fun n e => by rw [abs_of_nonneg (hb n e).1]; exact (hb n e).2, hlocal⟩

/-- Embed a finite-volume configuration in the infinite product by a fixed
spin outside the volume. This convention is immaterial for local limits along
an exhaustion. -/
def extendConfiguration (G : Fourier.LatticeGraph) (s₀ : Spin)
    (σ : Configuration G.vertices) : InfiniteConfiguration :=
  fun z => if hz : z ∈ G.vertices then σ ⟨z, hz⟩ else s₀

theorem continuous_extendConfiguration (G : Fourier.LatticeGraph) (s₀ : Spin) :
    Continuous (extendConfiguration G s₀) := by
  apply continuous_pi
  intro z
  by_cases hz : z ∈ G.vertices
  · simpa only [extendConfiguration, hz, dite_true] using
      (continuous_apply (⟨z, hz⟩ : G.vertices))
  · simpa only [extendConfiguration, hz, dite_false] using
      (continuous_const : Continuous (fun _ : Configuration G.vertices => s₀))

/-- Actual finite-volume Gibbs law, embedded as a probability measure on the
infinite spin space for the usual weak topology. -/
def extendedFreeGibbs (G : Fourier.LatticeGraph) (b : G.edges → ℝ) (s₀ : Spin) :
    ProbabilityMeasure InfiniteConfiguration :=
  (freeGibbsProbability (fun e : G.edges => e.val) b).map (extendConfiguration G s₀)

theorem pairMarginal_extendedFreeGibbs (G : Fourier.LatticeGraph) (b : G.edges → ℝ)
    (s₀ : Spin) (x y : Fourier.Site) (hx : x ∈ G.vertices) (hy : y ∈ G.vertices) :
    infinitePairMarginal (extendedFreeGibbs G b s₀) x y =
      twoSpinMarginal (fun e : G.edges => e.val) b ⟨x, hx⟩ ⟨y, hy⟩ := by
  apply Subtype.ext
  change Measure.map (fun σ : InfiniteConfiguration => (σ x, σ y))
      (Measure.map (extendConfiguration G s₀) (freeGibbsMeasure (fun e : G.edges => e.val) b)) =
    Measure.map (fun σ : Configuration G.vertices => (σ ⟨x, hx⟩, σ ⟨y, hy⟩))
      (freeGibbsMeasure (fun e : G.edges => e.val) b)
  rw [Measure.map_map (by fun_prop) (continuous_extendConfiguration G s₀).measurable]
  congr 1
  funext σ
  simp only [Function.comp_def, extendConfiguration, hx, hy, dite_true]

/-- A weak limit of the actual embedded free-boundary laws along an exhaustion
satisfies the two-spin local-limit hypothesis. This also applies to any
subsequence that exhausts the lattice. -/
theorem isFreeBoundaryLocalLimit_of_weak_limit (β : ℝ)
    (G : ℕ → Fourier.LatticeGraph) (b : ∀ n, (G n).edges → ℝ)
    (hb : ∀ n e, 0 ≤ b n e ∧ b n e ≤ β)
    (hexhaust : ∀ z : Fourier.Site, ∀ᶠ n in atTop, z ∈ (G n).vertices)
    (s₀ : Spin) (μ : ProbabilityMeasure InfiniteConfiguration)
    (hμ : Tendsto (fun n => extendedFreeGibbs (G n) (b n) s₀) atTop (𝓝 μ)) :
    IsFreeBoundaryLocalLimit β μ := by
  refine ⟨G, b, hb, ?_⟩
  intro x y
  obtain ⟨N, hN⟩ := eventually_atTop.mp ((hexhaust x).and (hexhaust y))
  let xn : ∀ n, (G (n + N)).vertices := fun n => ⟨x, (hN (n + N) (by omega)).1⟩
  let yn : ∀ n, (G (n + N)).vertices := fun n => ⟨y, (hN (n + N) (by omega)).2⟩
  refine ⟨N, xn, yn, (fun _ => rfl), (fun _ => rfl), ?_⟩
  have hm := ProbabilityMeasure.tendsto_map_of_tendsto_of_continuous
    (fun n => extendedFreeGibbs (G n) (b n) s₀) μ hμ
    (show Continuous (fun σ : InfiniteConfiguration => (σ x, σ y)) by fun_prop)
  have ht := hm.comp (tendsto_add_atTop_nat N)
  convert ht using 1
  · funext n
    exact (pairMarginal_extendedFreeGibbs (G (n + N)) (b (n + N)) s₀ x y
      (hN (n + N) (by omega)).1 (hN (n + N) (by omega)).2).symm
  · rfl

/-- A two-spin weak limit preserves any common bound on quadrupolar expectation. -/
theorem pair_bound_of_weak_limit {ν : ℕ → ProbabilityMeasure (Spin × Spin)}
    {ν₀ : ProbabilityMeasure (Spin × Spin)} (hν : Tendsto ν atTop (𝓝 ν₀))
    {B : ℝ} (hB : ∀ n, |∫ st, pairTest st ∂(ν n : Measure (Spin × Spin))| ≤ B) :
    |∫ st, pairTest st ∂(ν₀ : Measure (Spin × Spin))| ≤ B := by
  have ht := (ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.mp hν) pairTest
  exact le_of_tendsto' ht.abs hB


/-- Transfer any common spatial envelope to a local limit, including envelopes
that apply only to a specified range of site pairs. This lemma retains the exact
finite-volume bound; no enlargement of its constants is needed. -/
theorem HasLocalPairLimit.correlation_bound
    {G : ℕ → Fourier.LatticeGraph} {b : ∀ n, (G n).edges → ℝ}
    {μ : ProbabilityMeasure InfiniteConfiguration} (hlocal : HasLocalPairLimit G b μ)
    (P : Fourier.Site → Fourier.Site → Prop) (B : Fourier.Site → Fourier.Site → ℝ)
    (hbound : ∀ n (x y : (G n).vertices), P x.val y.val →
      |correlation (fun e : (G n).edges => e.val) (b n) x y| ≤ B x.val y.val)
    (x y : Fourier.Site) (hxy : P x y) : |infiniteCorrelation μ x y| ≤ B x y := by
  obtain ⟨N, xn, yn, hx, hy, hlim⟩ := hlocal x y
  rw [← integral_infinitePairMarginal]
  apply pair_bound_of_weak_limit hlim
  intro n
  rw [integral_twoSpinMarginal]
  have hxy' : P (xn n).val (yn n).val := by simpa only [hx n, hy n] using hxy
  simpa only [hx n, hy n] using hbound (n + N) (xn n) (yn n) hxy'

/-- Extend a finite-volume configuration using an arbitrary, site-dependent
configuration outside the volume. No regularity of the outside values is needed. -/
def extendConfigurationWith (G : Fourier.LatticeGraph) (outside : InfiniteConfiguration)
    (σ : Configuration G.vertices) : InfiniteConfiguration :=
  fun z => if hz : z ∈ G.vertices then σ ⟨z, hz⟩ else outside z

theorem continuous_extendConfigurationWith (G : Fourier.LatticeGraph)
    (outside : InfiniteConfiguration) : Continuous (extendConfigurationWith G outside) := by
  apply continuous_pi
  intro z
  by_cases hz : z ∈ G.vertices
  · simpa only [extendConfigurationWith, hz, dite_true] using
      (continuous_apply (⟨z, hz⟩ : G.vertices))
  · simpa only [extendConfigurationWith, hz, dite_false] using
      (continuous_const : Continuous (fun _ : Configuration G.vertices => outside z))

/-- The embedded free-boundary Gibbs measure with an arbitrary outside filling. -/
def extendedFreeGibbsWith (G : Fourier.LatticeGraph) (b : G.edges → ℝ)
    (outside : InfiniteConfiguration) : ProbabilityMeasure InfiniteConfiguration :=
  (freeGibbsProbability (fun e : G.edges => e.val) b).map (extendConfigurationWith G outside)

/-- Constant outside fillings recover the original embedding exactly. -/
theorem extendedFreeGibbsWith_const (G : Fourier.LatticeGraph) (b : G.edges → ℝ)
    (s₀ : Spin) : extendedFreeGibbsWith G b (fun _ => s₀) = extendedFreeGibbs G b s₀ := rfl

theorem pairMarginal_extendedFreeGibbsWith (G : Fourier.LatticeGraph)
    (b : G.edges → ℝ) (outside : InfiniteConfiguration) (x y : Fourier.Site)
    (hx : x ∈ G.vertices) (hy : y ∈ G.vertices) :
    infinitePairMarginal (extendedFreeGibbsWith G b outside) x y =
      twoSpinMarginal (fun e : G.edges => e.val) b ⟨x, hx⟩ ⟨y, hy⟩ := by
  apply Subtype.ext
  change Measure.map (fun σ : InfiniteConfiguration => (σ x, σ y))
      (Measure.map (extendConfigurationWith G outside)
        (freeGibbsMeasure (fun e : G.edges => e.val) b)) =
    Measure.map (fun σ : Configuration G.vertices => (σ ⟨x, hx⟩, σ ⟨y, hy⟩))
      (freeGibbsMeasure (fun e : G.edges => e.val) b)
  rw [Measure.map_map (by fun_prop)
    (continuous_extendConfigurationWith G outside).measurable]
  congr 1
  funext σ
  simp only [Function.comp_def, extendConfigurationWith, hx, hy, dite_true]

/-- Any two outside fillings, which may vary independently with volume and site,
have eventually identical two-spin marginals along an exhaustion. -/
theorem eventually_pairMarginal_extendedFreeGibbsWith_eq
    (G : ℕ → Fourier.LatticeGraph) (b : ∀ n, (G n).edges → ℝ)
    (hexhaust : ∀ z : Fourier.Site, ∀ᶠ n in atTop, z ∈ (G n).vertices)
    (outside₁ outside₂ : ℕ → InfiniteConfiguration) (x y : Fourier.Site) :
    (fun n => infinitePairMarginal (extendedFreeGibbsWith (G n) (b n) (outside₁ n)) x y)
      =ᶠ[atTop]
    (fun n => infinitePairMarginal (extendedFreeGibbsWith (G n) (b n) (outside₂ n)) x y) := by
  filter_upwards [hexhaust x, hexhaust y] with n hx hy
  rw [pairMarginal_extendedFreeGibbsWith _ _ _ _ _ hx hy,
    pairMarginal_extendedFreeGibbsWith _ _ _ _ _ hx hy]

/-- Convergence of the two-spin marginals is independent of every outside-filling
choice, even if the choices vary with volume and lattice site. -/
theorem tendsto_pairMarginal_extendedFreeGibbsWith_iff
    (G : ℕ → Fourier.LatticeGraph) (b : ∀ n, (G n).edges → ℝ)
    (hexhaust : ∀ z : Fourier.Site, ∀ᶠ n in atTop, z ∈ (G n).vertices)
    (outside₁ outside₂ : ℕ → InfiniteConfiguration) (x y : Fourier.Site)
    (ν : ProbabilityMeasure (Spin × Spin)) :
    Tendsto (fun n => infinitePairMarginal
      (extendedFreeGibbsWith (G n) (b n) (outside₁ n)) x y) atTop (𝓝 ν) ↔
    Tendsto (fun n => infinitePairMarginal
      (extendedFreeGibbsWith (G n) (b n) (outside₂ n)) x y) atTop (𝓝 ν) :=
  tendsto_congr' (eventually_pairMarginal_extendedFreeGibbsWith_eq
    G b hexhaust outside₁ outside₂ x y)

/-- A full-configuration weak limit under arbitrary volume- and site-dependent
outside fillings has the intrinsic local pair limits. -/
theorem hasLocalPairLimit_of_weak_limit_with
    (G : ℕ → Fourier.LatticeGraph) (b : ∀ n, (G n).edges → ℝ)
    (hexhaust : ∀ z : Fourier.Site, ∀ᶠ n in atTop, z ∈ (G n).vertices)
    (outside : ℕ → InfiniteConfiguration) (μ : ProbabilityMeasure InfiniteConfiguration)
    (hμ : Tendsto (fun n => extendedFreeGibbsWith (G n) (b n) (outside n)) atTop (𝓝 μ)) :
    HasLocalPairLimit G b μ := by
  intro x y
  obtain ⟨N, hN⟩ := eventually_atTop.mp ((hexhaust x).and (hexhaust y))
  let xn : ∀ n, (G (n + N)).vertices := fun n => ⟨x, (hN (n + N) (by omega)).1⟩
  let yn : ∀ n, (G (n + N)).vertices := fun n => ⟨y, (hN (n + N) (by omega)).2⟩
  refine ⟨N, xn, yn, (fun _ => rfl), (fun _ => rfl), ?_⟩
  have hm := ProbabilityMeasure.tendsto_map_of_tendsto_of_continuous
    (fun n => extendedFreeGibbsWith (G n) (b n) (outside n)) μ hμ
    (show Continuous (fun σ : InfiniteConfiguration => (σ x, σ y)) by fun_prop)
  have ht := hm.comp (tendsto_add_atTop_nat N)
  convert ht using 1
  · funext n
    exact (pairMarginal_extendedFreeGibbsWith (G (n + N)) (b (n + N))
      (outside (n + N)) x y (hN (n + N) (by omega)).1
      (hN (n + N) (by omega)).2).symm
  · rfl

/-- General weak-limit bridge for arbitrary bounded signed couplings and
arbitrary outside fillings. -/
theorem isSignedFreeBoundaryLocalLimit_of_weak_limit_with (β : ℝ)
    (G : ℕ → Fourier.LatticeGraph) (b : ∀ n, (G n).edges → ℝ)
    (hb : ∀ n e, |b n e| ≤ β)
    (hexhaust : ∀ z : Fourier.Site, ∀ᶠ n in atTop, z ∈ (G n).vertices)
    (outside : ℕ → InfiniteConfiguration) (μ : ProbabilityMeasure InfiniteConfiguration)
    (hμ : Tendsto (fun n => extendedFreeGibbsWith (G n) (b n) (outside n)) atTop (𝓝 μ)) :
    IsSignedFreeBoundaryLocalLimit β μ :=
  ⟨G, b, hb, hasLocalPairLimit_of_weak_limit_with G b hexhaust outside μ hμ⟩

/-- General weak-limit bridge retaining the original ferromagnetic API. -/
theorem isFreeBoundaryLocalLimit_of_weak_limit_with (β : ℝ)
    (G : ℕ → Fourier.LatticeGraph) (b : ∀ n, (G n).edges → ℝ)
    (hb : ∀ n e, 0 ≤ b n e ∧ b n e ≤ β)
    (hexhaust : ∀ z : Fourier.Site, ∀ᶠ n in atTop, z ∈ (G n).vertices)
    (outside : ℕ → InfiniteConfiguration) (μ : ProbabilityMeasure InfiniteConfiguration)
    (hμ : Tendsto (fun n => extendedFreeGibbsWith (G n) (b n) (outside n)) atTop (𝓝 μ)) :
    IsFreeBoundaryLocalLimit β μ :=
  ⟨G, b, hb, hasLocalPairLimit_of_weak_limit_with G b hexhaust outside μ hμ⟩

end
end RP3
end StandalonePart69

/- ===== RP3/WeightedSummability.lean ===== -/
section StandalonePart70

/-! Polynomial moments of a superpolynomially decaying lattice function. -/
namespace RP3.Fourier
noncomputable section

private def displacementEquiv (x : Site) : Site ≃ (Fin 2 → ℤ) :=
  (Equiv.subRight x).trans (finTwoArrowEquiv ℤ).symm

private theorem displacement_norm (x y : Site) :
    ‖displacementEquiv x y‖ = (siteRadius x y : ℝ) := by
  simp [displacementEquiv, EisensteinSeries.norm_eq_max_natAbs, siteRadius,
    Nat.cast_max, Int.cast_max]

/-- The harmless `1 + r` at the origin gives a summable lattice envelope. -/
theorem summable_lattice_envelope (x : Site) :
    Summable (fun y : Site => (1 + (siteRadius x y : ℝ)) ^ (-(3:ℝ))) := by
  classical
  have hs : Summable (fun y : Site => (siteRadius x y : ℝ) ^ (-(3:ℝ))) := by
    have h := ((displacementEquiv x).summable_iff).2
      (EisensteinSeries.summable_one_div_norm_rpow (by norm_num : (2:ℝ)<3))
    simpa only [Function.comp_def, displacement_norm] using h
  have hz : Summable (fun y : Site => if y=x then (1:ℝ) else 0) :=
    (hasSum_ite_eq x (1:ℝ)).summable
  have hn (y : Site) : (0:ℝ) ≤ siteRadius x y := by
    exact_mod_cast siteRadius_nonneg x y
  apply (hs.add hz).of_nonneg_of_le
    (fun y => Real.rpow_nonneg (by have := hn y; positivity) _)
  intro y
  by_cases hy : y=x
  · subst y
    simp
  · have hd : displacementEquiv x y ≠ 0 := by
      intro h
      have hx : displacementEquiv x x = 0 := by
        ext i
        fin_cases i <;> simp [displacementEquiv]
      exact hy ((displacementEquiv x).injective (h.trans hx.symm))
    have hr : (0:ℝ) < siteRadius x y := by
      rw [← displacement_norm]
      exact norm_pos_iff.mpr hd
    simp only [hy, ite_false, add_zero]
    exact Real.rpow_le_rpow_of_nonpos hr (by linarith) (by norm_num)

/-- Every polynomially weighted absolute moment is finite.  The hypothesis
is the usual real-exponent superpolynomial bound, with a constant for each
exponent.  The conclusion in fact holds for every real weight exponent. -/
theorem weighted_summable_of_decay (x : Site) (C : Site → ℝ)
    (hC : ∀ p : ℝ, ∃ A > 0, ∀ y,
      |C y| ≤ A * (1 + (siteRadius x y : ℝ)) ^ (-p)) (s : ℝ) :
    Summable (fun y : Site => (1 + (siteRadius x y : ℝ)) ^ s * |C y|) := by
  obtain ⟨A, hA, hbound⟩ := hC (s+3)
  have hn (y : Site) : (0:ℝ) ≤ siteRadius x y := by
    exact_mod_cast siteRadius_nonneg x y
  apply ((summable_lattice_envelope x).mul_left A).of_nonneg_of_le
    (fun y => mul_nonneg (Real.rpow_nonneg (by have := hn y; positivity) _) (abs_nonneg _))
  intro y
  have hr : (0:ℝ) < 1 + (siteRadius x y : ℝ) := by
    have := hn y
    positivity
  calc
    _ ≤ (1 + (siteRadius x y : ℝ)) ^ s *
        (A * (1 + (siteRadius x y : ℝ)) ^ (-(s+3))) :=
      mul_le_mul_of_nonneg_left (hbound y) (Real.rpow_nonneg hr.le _)
    _ = A * (1 + (siteRadius x y : ℝ)) ^ (-(3:ℝ)) := by
      rw [mul_left_comm, ← Real.rpow_add hr]
      congr 2
      ring

end
end RP3.Fourier
end StandalonePart70

/- ===== RP3/LimitCorollary.lean ===== -/
section StandalonePart71

/-!
# Local weak limits and weighted summability

All finite-volume decay envelopes pass to the corresponding local limits with
exactly the same constants. The signed-coupling statements include the original
ferromagnetic statements as corollaries.
-/
namespace RP3
noncomputable section
open MeasureTheory

/-- The signed-coupling superpolynomial bound passes to every local limit with
its original volume-independent constants. -/
theorem superpolynomial_quadrupolar_decay_local_limit_signed
    (β : ℝ) (hβ : 0 ≤ β) (p : ℝ) :
    ∃ A : ℝ, 0 < A ∧ ∀ μ : ProbabilityMeasure InfiniteConfiguration,
      IsSignedFreeBoundaryLocalLimit β μ → ∀ x y : Fourier.Site,
      |infiniteCorrelation μ x y| ≤
        A * (1 + (Fourier.siteRadius x y : ℝ)) ^ (-p) := by
  obtain ⟨A, hA, hbound⟩ := superpolynomial_quadrupolar_decay_signed β hβ p
  refine ⟨A, hA, ?_⟩
  intro μ hμ x y
  obtain ⟨G, b, hb, hlocal⟩ := hμ
  exact hlocal.correlation_bound (fun _ _ => True)
    (fun x y => A * (1 + (Fourier.siteRadius x y : ℝ)) ^ (-p))
    (fun n u v _ => hbound (G n) (b n) (hb n) u v) x y trivial

/-- Corollary 5.1: ferromagnetic local weak limits obey the finite-volume bound
with the same volume-independent constants. -/
theorem superpolynomial_quadrupolar_decay_local_limit (β : ℝ) (hβ : 0 ≤ β) (p : ℝ) :
    ∃ A : ℝ, 0 < A ∧ ∀ μ : ProbabilityMeasure InfiniteConfiguration,
      IsFreeBoundaryLocalLimit β μ → ∀ x y : Fourier.Site,
      |infiniteCorrelation μ x y| ≤
        A * (1 + (Fourier.siteRadius x y : ℝ)) ^ (-p) := by
  obtain ⟨A, hA, hbound⟩ := superpolynomial_quadrupolar_decay_local_limit_signed β hβ p
  exact ⟨A, hA, fun μ hμ => hbound μ hμ.signed⟩

/-- The factorial estimate passes to signed-coupling local limits with exactly
the finite-volume annulus scale and coefficient. -/
theorem factorial_quadrupolar_decay_local_limit_signed (β : ℝ) (hβ : 0 ≤ β) :
    ∃ D : ℝ, 0 < D ∧ ∃ a : ℕ, 2 ≤ a ∧
      ∀ μ : ProbabilityMeasure InfiniteConfiguration,
      IsSignedFreeBoundaryLocalLimit β μ → ∀ x y : Fourier.Site,
      let r := (Fourier.siteRadius x y).toNat
      let k := annulusCount (2^a) r (by positivity)
      |infiniteCorrelation μ x y| ≤ (3 : ℝ) / 4 * (D/2)^k/k.factorial := by
  obtain ⟨D, hD, a, ha, hbound⟩ := factorial_quadrupolar_decay_signed β hβ
  refine ⟨D, hD, a, ha, ?_⟩
  intro μ hμ x y
  obtain ⟨G, b, hb, hlocal⟩ := hμ
  exact hlocal.correlation_bound (fun _ _ => True)
    (fun x y => let k := annulusCount (2^a) (Fourier.siteRadius x y).toNat (by positivity)
      (3 : ℝ) / 4 * (D/2)^k/k.factorial)
    (fun n u v _ => hbound (G n) (b n) (hb n) u v) x y trivial

/-- The factorial estimate in a ferromagnetic local weak limit. -/
theorem factorial_quadrupolar_decay_local_limit (β : ℝ) (hβ : 0 ≤ β) :
    ∃ D : ℝ, 0 < D ∧ ∃ a : ℕ, 2 ≤ a ∧
      ∀ μ : ProbabilityMeasure InfiniteConfiguration,
      IsFreeBoundaryLocalLimit β μ → ∀ x y : Fourier.Site,
      let r := (Fourier.siteRadius x y).toNat
      let k := annulusCount (2^a) r (by positivity)
      |infiniteCorrelation μ x y| ≤ (3 : ℝ) / 4 * (D/2)^k/k.factorial := by
  obtain ⟨D, hD, a, ha, hbound⟩ := factorial_quadrupolar_decay_local_limit_signed β hβ
  exact ⟨D, hD, a, ha, fun μ hμ => hbound μ hμ.signed⟩

/-- The explicit logarithmic rate in signed-coupling local limits, preserving
both the finite-volume coefficient and its distance threshold. -/
theorem logarithmic_quadrupolar_decay_local_limit_signed (β : ℝ) (hβ : 0 ≤ β) :
    ∃ C ≥ 0, ∃ R : ℕ, ∀ μ : ProbabilityMeasure InfiniteConfiguration,
      IsSignedFreeBoundaryLocalLimit β μ → ∀ x y : Fourier.Site,
      R ≤ (Fourier.siteRadius x y).toNat →
      |infiniteCorrelation μ x y| ≤
        Real.exp (-Real.log (Fourier.siteRadius x y : ℝ) *
          Real.log (Real.log (Fourier.siteRadius x y : ℝ)) / Real.log 4 +
          C * Real.log (Fourier.siteRadius x y : ℝ)) := by
  obtain ⟨C, hC, R, hbound⟩ := logarithmic_quadrupolar_decay_signed β hβ
  refine ⟨C, hC, R, ?_⟩
  intro μ hμ x y hr
  obtain ⟨G, b, hb, hlocal⟩ := hμ
  exact hlocal.correlation_bound
    (fun x y => R ≤ (Fourier.siteRadius x y).toNat)
    (fun x y => Real.exp (-Real.log (Fourier.siteRadius x y : ℝ) *
      Real.log (Real.log (Fourier.siteRadius x y : ℝ)) / Real.log 4 +
      C * Real.log (Fourier.siteRadius x y : ℝ)))
    (fun n u v huv => hbound (G n) (b n) (hb n) u v huv) x y hr

/-- The explicit logarithmic rate in ferromagnetic local weak limits. -/
theorem logarithmic_quadrupolar_decay_local_limit (β : ℝ) (hβ : 0 ≤ β) :
    ∃ C ≥ 0, ∃ R : ℕ, ∀ μ : ProbabilityMeasure InfiniteConfiguration,
      IsFreeBoundaryLocalLimit β μ → ∀ x y : Fourier.Site,
      R ≤ (Fourier.siteRadius x y).toNat →
      |infiniteCorrelation μ x y| ≤
        Real.exp (-Real.log (Fourier.siteRadius x y : ℝ) *
          Real.log (Real.log (Fourier.siteRadius x y : ℝ)) / Real.log 4 +
          C * Real.log (Fourier.siteRadius x y : ℝ)) := by
  obtain ⟨C, hC, R, hbound⟩ := logarithmic_quadrupolar_decay_local_limit_signed β hβ
  exact ⟨C, hC, R, fun μ hμ => hbound μ hμ.signed⟩

/-- Every polynomially weighted quadrupolar two-point series is absolutely
summable in a signed-coupling free-boundary local weak limit. -/
theorem weighted_summability_local_limit_signed (β : ℝ) (hβ : 0 ≤ β)
    (μ : ProbabilityMeasure InfiniteConfiguration) (hμ : IsSignedFreeBoundaryLocalLimit β μ)
    (x : Fourier.Site) (s : ℝ) :
    Summable (fun y : Fourier.Site =>
      (1 + (Fourier.siteRadius x y : ℝ))^s * |infiniteCorrelation μ x y|) := by
  apply Fourier.weighted_summable_of_decay x (infiniteCorrelation μ x) _ s
  intro p
  obtain ⟨A, hA, hbound⟩ := superpolynomial_quadrupolar_decay_local_limit_signed β hβ p
  exact ⟨A, hA, fun y => hbound μ hμ x y⟩

/-- Every polynomially weighted quadrupolar two-point series is absolutely
summable in a ferromagnetic free-boundary local weak limit. -/
theorem weighted_summability_local_limit (β : ℝ) (hβ : 0 ≤ β)
    (μ : ProbabilityMeasure InfiniteConfiguration) (hμ : IsFreeBoundaryLocalLimit β μ)
    (x : Fourier.Site) (s : ℝ) :
    Summable (fun y : Fourier.Site =>
      (1 + (Fourier.siteRadius x y : ℝ))^s * |infiniteCorrelation μ x y|) :=
  weighted_summability_local_limit_signed β hβ μ hμ.signed x s

end
end RP3
end StandalonePart71

/- ===== RP3/LogSquareLimits.lean ===== -/
section StandalonePart72

/-!
# Uniform log-square quadrupolar decay

The constants are chosen before the graph, the signed couplings, and the
marked sites.  The same constants pass to every existing free-boundary
local limit.  No existence or uniqueness of an infinite-volume Gibbs state
is assumed or concluded by the limit transfer.
-/
namespace RP3
noncomputable section
open MeasureTheory

/-- All-temperature log-square decay for the actual finite RP³ model with
arbitrary bounded signed couplings. -/
theorem log_square_quadrupolar_decay_signed (β : ℝ) (hβ : 0 ≤ β) :
    ∃ C : ℝ, 0 < C ∧ ∃ c : ℝ, 0 < c ∧
      ∀ (G : Fourier.LatticeGraph) (b : G.edges → ℝ),
      (∀ e, |b e| ≤ β) → ∀ (x y : G.vertices),
      |correlation (fun e : G.edges => e.val) b x y| ≤
        C * Real.exp (-c * (Real.log (2+(Fourier.siteRadius x.val y.val:ℝ)))^2) := by
  obtain ⟨E, hE, F, hF, hcomparison⟩ :=
    Fourier.LatticeGraph.exists_thinKernelComparison_signed β hβ
  exact log_square_of_thin_comparison_signed β E F hE hF hcomparison

/-- Ferromagnetic specialization of the uniform all-temperature theorem. -/
theorem log_square_quadrupolar_decay (β : ℝ) (hβ : 0 ≤ β) :
    ∃ C : ℝ, 0 < C ∧ ∃ c : ℝ, 0 < c ∧
      ∀ (G : Fourier.LatticeGraph) (b : G.edges → ℝ),
      (∀ e, 0 ≤ b e ∧ b e ≤ β) → ∀ (x y : G.vertices),
      |correlation (fun e : G.edges => e.val) b x y| ≤
        C * Real.exp (-c * (Real.log (2+(Fourier.siteRadius x.val y.val:ℝ)))^2) := by
  obtain ⟨C, hC, c, hc, hbound⟩ := log_square_quadrupolar_decay_signed β hβ
  exact ⟨C, hC, c, hc, fun G b hb x y => hbound G b
    (fun e => by rw [abs_of_nonneg (hb e).1]; exact (hb e).2) x y⟩

/-- The all-distance log-square estimate passes to signed-coupling local
limits with exactly the constants chosen in finite volume. -/
theorem log_square_quadrupolar_decay_local_limit_signed (β : ℝ) (hβ : 0 ≤ β) :
    ∃ C : ℝ, 0 < C ∧ ∃ c : ℝ, 0 < c ∧
      ∀ μ : ProbabilityMeasure InfiniteConfiguration,
      IsSignedFreeBoundaryLocalLimit β μ → ∀ x y : Fourier.Site,
      |infiniteCorrelation μ x y| ≤
        C * Real.exp (-c * (Real.log (2+(Fourier.siteRadius x y:ℝ)))^2) := by
  obtain ⟨C, hC, c, hc, hbound⟩ := log_square_quadrupolar_decay_signed β hβ
  refine ⟨C, hC, c, hc, ?_⟩
  intro μ hμ x y
  obtain ⟨G, b, hb, hlocal⟩ := hμ
  exact hlocal.correlation_bound (fun _ _ => True)
    (fun x y => C * Real.exp (-c * (Real.log (2+(Fourier.siteRadius x y:ℝ)))^2))
    (fun n u v _ => hbound (G n) (b n) (hb n) u v) x y trivial

/-- Ferromagnetic free-boundary local limits satisfy the same bound. -/
theorem log_square_quadrupolar_decay_local_limit (β : ℝ) (hβ : 0 ≤ β) :
    ∃ C : ℝ, 0 < C ∧ ∃ c : ℝ, 0 < c ∧
      ∀ μ : ProbabilityMeasure InfiniteConfiguration,
      IsFreeBoundaryLocalLimit β μ → ∀ x y : Fourier.Site,
      |infiniteCorrelation μ x y| ≤
        C * Real.exp (-c * (Real.log (2+(Fourier.siteRadius x y:ℝ)))^2) := by
  obtain ⟨C, hC, c, hc, hbound⟩ := log_square_quadrupolar_decay_local_limit_signed β hβ
  exact ⟨C, hC, c, hc, fun μ hμ => hbound μ hμ.signed⟩

end
