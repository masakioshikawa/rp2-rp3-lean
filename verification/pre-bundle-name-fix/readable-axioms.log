theorem RP2.superpolynomial_quadrupolar_decay_local_limit : ∀ (β : ℝ),
  0 ≤ β →
    ∀ (p : ℝ),
      ∃ A,
        0 < A ∧
          ∀ (μ : MeasureTheory.ProbabilityMeasure RP2.InfiniteConfiguration),
            RP2.IsFreeBoundaryLocalLimit β μ →
              ∀ (x y : RP2.Fourier.Site),
                |RP2.infiniteCorrelation μ x y| ≤ A * (1 + ↑(RP2.Fourier.siteRadius x y)) ^ (-p) :=
fun β hβ p =>
  Exists.casesOn (RP2.superpolynomial_quadrupolar_decay_local_limit_signed β hβ p) fun A h =>
    And.casesOn h fun hA hbound => Exists.intro A ⟨hA, fun μ hμ => hbound μ (RP2.IsFreeBoundaryLocalLimit.signed hμ)⟩
theorem RP2.weighted_summability_local_limit : ∀ (β : ℝ),
  0 ≤ β →
