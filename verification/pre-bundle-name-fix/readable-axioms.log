    ∀ (p : ℝ),
      ∃ A,
        0 < A ∧
          ∀ (G : RP2.Fourier.LatticeGraph) (b : ↥G.edges → ℝ),
            (∀ (e : ↥G.edges), 0 ≤ b e ∧ b e ≤ β) →
              ∀ (x y : ↥G.vertices),
                |RP2.correlation (fun e => ↑e) b x y| ≤ A * (1 + ↑(RP2.Fourier.siteRadius ↑x ↑y)) ^ (-p) :=
fun β hβ p =>
  Exists.casesOn (RP2.superpolynomial_quadrupolar_decay_signed β hβ p) fun A h =>
    And.casesOn h fun hA hbound =>
      Exists.intro A
        ⟨hA, fun G b hb x y =>
          hbound G b (fun e => Eq.mpr (id (congrArg (fun _a => _a ≤ β) (abs_of_nonneg (hb e).left))) (hb e).right) x y⟩
