      RP2.IsFreeBoundaryLocalLimit β μ →
        ∀ (x : RP2.Fourier.Site) (s : ℝ),
          Summable fun y => (1 + ↑(RP2.Fourier.siteRadius x y)) ^ s * |RP2.infiniteCorrelation μ x y| :=
fun β hβ μ hμ x s => RP2.weighted_summability_local_limit_signed β hβ μ (RP2.IsFreeBoundaryLocalLimit.signed hμ) x s
